   //关闭界面 - 修复版
   func CloseChooseCardUI(triggerPlayer entity<Player>) {
      thisEntity<CustomUI>.IsVisible = false
      
      // 开始下一波 - 更新技能数据
      var Skill1DataInGame = GetLocalPlayer()<PlayerJionGame>.Skill1DataInGame
      var Skill2DataInGame = GetLocalPlayer()<PlayerJionGame>.Skill2DataInGame
      var level = GetLocalPlayer()<PlayerJionGame>.level
      var currentSkill = GetLocalPlayer()<PlayerJionGame>.CurrentSkill
      var ability1Level = GetLocalPlayer()<PlayerJionGame>.ability1Level
      var ability2Level = GetLocalPlayer()<PlayerJionGame>.ability2Level
      var ability3Level = GetLocalPlayer()<PlayerJionGame>.ability3Level
      
      // 发送技能数据更新到服务器
      if Skill1DataInGame != nil {
         GetLocalPlayer()<PlayerJionGame>.UpdateSkill1Data()
      }

      if Skill2DataInGame != nil {
         GetLocalPlayer()<PlayerJionGame>.UpdateSkill2Data()
      }

      // 清空之前游戏的卡牌记录
      // ClearSelectedCards()
   }

   // 获取当前关卡通关奖励（PassMoney），用于刷新费用计算
   func GetPassMoneyForLevel(level int) int {
      var passMoney int = 100
      if Map.ContainKey(GetLocalPlayer()<PlayerJionGame>.LevelData, level) {
         var row = GetLocalPlayer()<PlayerJionGame>.LevelData[level]
         if Map.ContainKey(row, "PassMoney") {
            passMoney = row["PassMoney"] as int
         }
      }
      return passMoney
   }

   // 打开三选一界面时调用，重置刷新次数
   func ResetRefreshCount() {
      RefreshCount = 0
   }

   //刷新卡牌；费用 = 通关奖励/2 * 刷新次数（第1次刷新=通关奖励/2，第2次=通关奖励，依此类推）
   func OnRefreshCardsClicked(button entity<UIWidgetButton>, triggerPlayer entity<Player>) {
      SoundFunc.PlayCreatedSound("Click_Common_Default")

      var level = GetLocalPlayer()<PlayerJionGame>.level
      var passMoney = GetPassMoneyForLevel(level)
      RefreshCount = RefreshCount + 1
      var refreshCost = (passMoney / 2) * RefreshCount

      var playerMoney = GetLocalPlayer()<PlayerJionGame>.Money
      if playerMoney < refreshCost {
         // 金币不足，不执行刷新操作；回退刷新次数
         RefreshCount = RefreshCount - 1
         return
      }

      // 扣除金币并写入本地存储（DATA_TotalIFM、SAVE_DATA_Money）
      GetLocalPlayer()<PlayerJionGame>.DeductPlayerCurrency(refreshCost)

      RefreshCard(level)
      CloseTextImage(button, triggerPlayer)
   }

   // 刷新卡牌
   func RefreshCard(level int) {
      thisEntity<CustomUI>.IsVisible = true
      //----------------------------------------------------------------------------------------------------------------//
      var card1BB = GetWidgetByPath(GetLocalPlayer(), thisEntity as entity<CustomUI>, "/ChoiceThreeCardPanel/Card_1/IsChoice")
      card1BB<UIWidget>.IsVisible = false
      var card2BB = GetWidgetByPath(GetLocalPlayer(), thisEntity as entity<CustomUI>, "/ChoiceThreeCardPanel/Card_2/IsChoice")
      card2BB<UIWidget>.IsVisible = false
      var card3BB = GetWidgetByPath(GetLocalPlayer(), thisEntity as entity<CustomUI>, "/ChoiceThreeCardPanel/Card_3/IsChoice")
      card3BB<UIWidget>.IsVisible = false
      //----------------------------------------------------------------------------------------------------------------//
      StartThreeChooseOne(level, GetLocalPlayer()<PlayerJionGame>.CurrentSkill)
      // 刷新后再次更新按钮状态
      UpdateRefreshButtonState()
   }

   // 更新刷新按钮状态；下次刷新费用 = 通关奖励/2 * (当前刷新次数+1)
   func UpdateRefreshButtonState() {
      var level = GetLocalPlayer()<PlayerJionGame>.level
      var passMoney = GetPassMoneyForLevel(level)
      var nextRefreshCost = (passMoney / 2) * (RefreshCount + 1)
      var playerMoney = GetLocalPlayer()<PlayerJionGame>.Money

      var refreshButton = GetWidgetByPath(GetLocalPlayer(), thisEntity as entity<CustomUI>, "/RefreshCards")
      var priceText = GetWidgetByPath(GetLocalPlayer(), thisEntity as entity<CustomUI>, "/RefreshCards/Image/Money")
      var buttonText = GetWidgetByPath(GetLocalPlayer(), thisEntity as entity<CustomUI>, "/RefreshCards/Text")

      if priceText != nil {
         priceText<UIWidgetLabel>.Content = Convert.ToString(nextRefreshCost)
      }
      if refreshButton != nil && priceText != nil {
         if playerMoney < nextRefreshCost {
               // 金币不足，按钮置灰
               refreshButton<UIWidgetButton>.SpriteResource = EResSprite.DisableButton
               // 价格文字变红色
               priceText<UIWidgetLabel>.Color = #FF0000
               // 按钮文字变白色
               buttonText<UIWidgetLabel>.Color = #FFFFFF
         } else {
               // 金币足够，按钮正常显示
               refreshButton<UIWidgetButton>.SpriteResource = EResSprite.guryButton
               // 价格文字白色
               priceText<UIWidgetLabel>.Color = #FFFFFF
               // 按钮文字黑色
               buttonText<UIWidgetLabel>.Color = #000000
         }
      }

      // 更新金钱UI
      var MoneyNumEntity = GetWidgetByPath(GetLocalPlayer(), GetLocalPlayer()<PlayerJionGame>.RighTabIFMUI, "/Panel/Money/logo/Num")
      MoneyNumEntity<UIWidgetLabel>.Content = GetLocalPlayer()<PlayerJionGame>.Money
   }
//————————————————————————————————————————————————————————————————————————————————————————————————//
//————————————————————————————————————————————————————————————————————————————————————————————————//
//————————————————————————————————————————————————————————————————————————————————————————————————//
   // 开始三选一卡牌流程
   func StartThreeChooseOne(level int, currentSkill int) {
      // 生成三个不重复的随机卡牌
      var cards = List<Map<string, object>>{}
      while List.Length(cards) < 3 {
         var newCard Map<string, object> = GenerateRandomCard(currentSkill)
         if newCard != nil {
            // 检查卡牌是否已存在，避免重复
            var isDuplicate = false
            for i, existingCard in cards {
               if existingCard["CardID"] == newCard["CardID"] {
                  isDuplicate = true
                  break
               }
            }
            if isDuplicate == false {
               List.Append(cards, newCard)
               // LogInfo("生成卡牌:" + Convert.ToString(newCard["CardID"]) + "-" + Convert.ToString(newCard["Nature"]))
            }
         } else {
            // LogInfo("技能" + Convert.ToString(currentSkill) + "的所有卡牌都已选择过")
            break
         }
      }
      
      // 显示生成的三个卡牌
      if List.Length(cards) >= 3 {
         var card1 = cards[0]
         var card2 = cards[1]
         var card3 = cards[2]
         // 保存卡牌ID到 CurrentRandomCards
         List.Clear(CurrentRandomCards)
         List.Append(CurrentRandomCards, card1["CardID"] as int)
         List.Append(CurrentRandomCards, card2["CardID"] as int)
         List.Append(CurrentRandomCards, card3["CardID"] as int)
         
         // 卡牌数据显示到UI
         UpdateCardUI(card1, card2, card3)
      } else {
         LogError("卡牌生成数量不足，只有" + Convert.ToString(List.Length(cards)) + "张")
      }

      // 重置已经选择的卡牌
      SelectedCardIndex = 0

       // 更新刷新按钮状态
      UpdateRefreshButtonState()
   }
   
   // 生成随机卡牌（不允许重复选择）
   func GenerateRandomCard(currentSkill int) Map<string, object> {
      var cardDataMap = Map<int, Map<string, object>>{}
      var selectedCards = List<int>{}
      
      // 选择对应的牌库和已选记录
      if currentSkill == 1 {
         cardDataMap = GetLocalPlayer()<PlayerJionGame>.Skill_1_CardData
         selectedCards = SelectedCards_1
      } else if currentSkill == 2 {
         cardDataMap = GetLocalPlayer()<PlayerJionGame>.Skill_2_CardData
         selectedCards = SelectedCards_2
      } else {
         LogError("无效的技能索引:" + Convert.ToString(currentSkill))
         return nil
      }
      
      // 获取所有未选过的卡牌ID
      var availableCardIds = List<int>{}
      for cardId, cardData in cardDataMap {
         var isSelected = false
         for i, selectedId in selectedCards {
            if selectedId == cardId {
               isSelected = true
               break
            }
         }
         if isSelected == false {
            List.Append(availableCardIds, cardId)
         }
      }
      
      // 如果没有可用卡牌，返回空
      if List.Length(availableCardIds) == 0 {
         LogWarning("技能" + Convert.ToString(currentSkill) + "的所有卡牌都已选择过")
         return nil
      }
      
      // 随机选择一个卡牌ID
      var randomIndex = RandomInt(0, List.Length(availableCardIds))
      var randomCardId = availableCardIds[randomIndex]
      
      // 返回对应的卡牌数据
      return cardDataMap[randomCardId]
   }
   
   // 更新卡牌UI（大图标）
   func UpdateCardUI(card1 Map<string, object>, card2 Map<string, object>, card3 Map<string, object>) {
      // 更新卡牌1的UI
      var card1Widget entity<UIWidget> = GetWidgetByPath(GetLocalPlayer(), thisEntity as entity<CustomUI>, "/ChoiceThreeCardPanel/Card_1")
      var card2Widget entity<UIWidget> = GetWidgetByPath(GetLocalPlayer(), thisEntity as entity<CustomUI>, "/ChoiceThreeCardPanel/Card_2")
      var card3Widget entity<UIWidget> = GetWidgetByPath(GetLocalPlayer(), thisEntity as entity<CustomUI>, "/ChoiceThreeCardPanel/Card_3")
      if card1 != nil {
         UpdateSingleCardAppearance(card1Widget, card1)
      }
      if card2 != nil {
         UpdateSingleCardAppearance(card2Widget, card2)
      }
      if card3 != nil {
         UpdateSingleCardAppearance(card3Widget, card3)
      }
      
      // 设置没选择时按钮的颜色
      var next = GetWidgetByPath(GetLocalPlayer(), thisEntity as entity<CustomUI>, "/Next")
      next<UIWidgetButton>.SpriteResource = EResSprite.DisableButton
      var nextText = GetWidgetByPath(GetLocalPlayer(), thisEntity as entity<CustomUI>, "/Next/Text")
      nextText<UIWidgetLabel>.Color = #FFFFFF
   }

   // 更新单个卡牌外观（大图标）
   func UpdateSingleCardAppearance(cardWidget entity<UIWidget>, cardInfo Map<string, object>) {
      // 设置卡牌1的技能说明
      var cardText = GetChildByName(cardWidget,"IFMText")
      var description = GenerateCardDescription(cardInfo)
      cardText<UIWidgetLabel>.Content = description
      // 设置卡牌1的类型显示
      var cardTypeText = GetChildByName(cardWidget,"TYPE")
      var typeText = GenerateCardTypeText(cardInfo)
      cardTypeText<UIWidgetLabel>.Content = "[" + typeText + "]"

      // 设置卡牌稀有度显示
      var rarity = cardInfo["Rarity"] as int
      var rarityColor = FC_Config.CardRarityColor[rarity]
      var cardIconSprite = FC_Config.CardIconSprites[cardInfo["Nature"]]
      var iconEntity = GetChildByName(cardWidget,"icon")
      var rightBG = GetChildByName(cardWidget,"right_smallBG")
      var leftBG = GetChildByName(cardWidget,"left_smallBG")

      iconEntity<UIWidgetImage>.SpriteName = cardIconSprite

      cardWidget<UIWidgetButton>.Color = rarityColor
      iconEntity<UIWidgetImage>.Color = rarityColor
      rightBG<UIWidgetImage>.Color = rarityColor
      leftBG<UIWidgetImage>.Color = rarityColor
   }
   
   
   // 生成卡牌描述文本
   func GenerateCardDescription(card Map<string, object>) string {
      var translationText = Convert.ToString(card["TranslationText"])
      var MathValue = Convert.ToString(card["MathValue"])
      // 直接使用翻译文本
      translationText = LocString{translationText, List<string>{MathValue}}
      return translationText
   }
   
   // 生成卡牌类型文本
   func GenerateCardTypeText(card Map<string, object>) string {
      var translationText = Convert.ToString(card["Typetext"])
      // 直接使用翻译文本
      translationText = LocString{translationText, List<string>{}}
      return translationText
   }
   
   // 更新卡牌稀有度显示（根据稀有度显示不同的边框颜色）
   func UpdateCardRarityUI(cardIndex int, rarity int) {
      // LogInfo("更新卡牌稀有度显示: " + Convert.ToString(cardIndex) + " " + Convert.ToString(rarity))
      var rarityPath = "/ChoiceThreeCardPanel/Card_" + Convert.ToString(cardIndex)
      var rarityWidget = GetWidgetByPath(GetLocalPlayer(), thisEntity as entity<CustomUI>, rarityPath)
      var spriteName = FC_Config.CardRaritySprite[rarity]
      // LogInfo("EresourceSprite: " + Convert.ToString(spriteName))
      if rarityWidget != nil {
         rarityWidget<UIWidgetButton>.SpriteResource = spriteName
      }
   }
