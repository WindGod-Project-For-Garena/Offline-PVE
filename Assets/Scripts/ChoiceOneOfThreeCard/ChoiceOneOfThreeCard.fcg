//————————————————————————————————————————————————————————————————————————————————————————————————//
//————————————————————————————————————————————————————————————————————————————————————————————————//
   // 更新UI显示选择的牌
   func updateHighlightUI(selectedCardIndex int) {
      // LogInfo("选择了第 " + Convert.ToString(selectedCardIndex) + " 张牌")
      
      // 重置所有选择标记
      var card1BB = GetWidgetByPath(GetLocalPlayer(), thisEntity as entity<CustomUI>, "/ChoiceThreeCardPanel/Card_1/IsChoice")
      var card2BB = GetWidgetByPath(GetLocalPlayer(), thisEntity as entity<CustomUI>, "/ChoiceThreeCardPanel/Card_2/IsChoice")
      var card3BB = GetWidgetByPath(GetLocalPlayer(), thisEntity as entity<CustomUI>, "/ChoiceThreeCardPanel/Card_3/IsChoice")
      
      card1BB<UIWidget>.IsVisible = false
      card2BB<UIWidget>.IsVisible = false
      card3BB<UIWidget>.IsVisible = false
      
      // 根据选择的牌位置激活对应的标记
      if selectedCardIndex == 1 {
         card1BB<UIWidget>.IsVisible = true
      } else if selectedCardIndex == 2 {
         card2BB<UIWidget>.IsVisible = true
      } else if selectedCardIndex == 3 {
         card3BB<UIWidget>.IsVisible = true
      }
   }
   
   // 更新已选卡牌列表数据等操作
   func OwnedCardIconClicked_SmallIcon(cardIndex int) {
      // LogInfo("点击位置: 第 " + Convert.ToString(cardIndex) + " 张卡牌")
      
      var currentSkill = GetLocalPlayer()<PlayerJionGame>.CurrentSkill
      // 根据当前技能获取对应的已选卡牌列表
      var selectedCards = List<int>{}
      if currentSkill == 1 {
         selectedCards = SelectedCards_1
      } else if currentSkill == 2 {
         selectedCards = SelectedCards_2
      } else {
         // LogInfo("当前技能: 未知技能")
         return
      }
      
      // 计算显示数量
      var totalCards = List.Length(selectedCards)
      var displayCount int = Round(Math.Min(totalCards, 5) as int)
      
      // LogInfo("已选卡牌总数: " + Convert.ToString(totalCards))
      // LogInfo("显示数量: " + Convert.ToString(displayCount))
      
      // 检查点击的位置是否有卡牌
      if cardIndex <= displayCount && cardIndex > 0 {
         // 计算实际在列表中的索引（显示最近选择的卡牌）
         var actualIndex = totalCards - displayCount + (cardIndex - 1)
         var cardId = selectedCards[actualIndex]
         // 获取卡牌信息
         var cardInfo = GetCardInfoById(cardId, currentSkill)
         if cardInfo != nil {
            // 打印卡牌详细信息
            var translationText = Convert.ToString(cardInfo["TranslationText"])
            var nature = Convert.ToString(cardInfo["Nature"])
            var value = cardInfo["Value"] as float
            var rarity = cardInfo["Rarity"] as int
            var typeText = Convert.ToString(cardInfo["Typetext"])
            var MathValue = Convert.ToString(cardInfo["MathValue"])
            
            // 获取TextImage面板
            var TextImageEntity = GetWidgetByPath(GetLocalPlayer(), thisEntity as entity<CustomUI>, "/NowChoicePanel/TextImage")
            
            // 根据cardIndex计算目标位置
            var targetY float = 0
            // 每个卡牌控件之间距离95
            var baseY = 175
            // 基准位置 - (cardIndex - 1) * 95
            // cardIndex是从1开始的，所以减1
            targetY = baseY - 40 - (cardIndex - 1) * 95
            
            // 设置TextImage面板的位置
            var currentPos = TextImageEntity<UIWidget>.ActualPosition
            TextImageEntity<UIWidget>.ActualPosition = Vector3{currentPos.X, targetY,0}
            
            // 显示TextImage面板
            TextImageEntity<UIWidget>.IsVisible = true
            
            // 根据不同技能设置技能说明文本
            var textWidget = GetWidgetByPath(GetLocalPlayer(), thisEntity as entity<CustomUI>, "/NowChoicePanel/TextImage/Text")
            // 直接使用翻译文本
            var textWidgetTTT = LocString{translationText, List<string>{MathValue}}
            textWidget<UIWidgetLabel>.Content = textWidgetTTT
         } else {
            LogInfo("未找到卡牌ID " + Convert.ToString(cardId) + " 的数据")
         }
      } else {
         // LogInfo("该位置没有卡牌（位置 " + Convert.ToString(cardIndex) + "）")
         // 隐藏TextImage面板
         var TextImageEntity = GetWidgetByPath(GetLocalPlayer(), thisEntity as entity<CustomUI>, "/NowChoicePanel/TextImage")
         TextImageEntity<UIWidget>.IsVisible = false
      }
   }
   
   func CloseTextImage(button entity<UIWidgetButton>, triggerPlayer entity<Player>) {
      var TextImageEntity = GetWidgetByPath(GetLocalPlayer(), thisEntity as entity<CustomUI>, "/NowChoicePanel/TextImage")
      TextImageEntity<UIWidget>.IsVisible = false
   }
   
   // 选择卡牌（当玩家选择某张卡牌时调用）
   func SelectCard(cardId int, currentSkill int) {
      var selectedCards = List<int>{}
      
      if currentSkill == 1 {
         selectedCards = SelectedCards_1
      } else if currentSkill == 2 {
         selectedCards = SelectedCards_2
      } else {
         LogError("无效的技能索引:" + Convert.ToString(currentSkill))
         return
      }
      
      // 检查是否已选择过
      var alreadySelected = false
      for i, selectedId in selectedCards {
         if selectedId == cardId {
            alreadySelected = true
            break
         }
      }
      
      if alreadySelected == false {
         List.Append(selectedCards, cardId)
         // LogInfo("卡牌" + Convert.ToString(cardId) + "已添加到已选列表，技能" + Convert.ToString(currentSkill))
         // LogInfo("当前已选卡牌数量:" + Convert.ToString(List.Length(selectedCards)))
      }
   }
   
   // 应用卡牌效果
   func ApplyCardEffect(cardId int, currentSkill int) {
      var cardDataMap = Map<int, Map<string, object>>{}
   
      if currentSkill == 1 {
         cardDataMap = GetLocalPlayer()<PlayerJionGame>.Skill_1_CardData
      } else if currentSkill == 2 {
         cardDataMap = GetLocalPlayer()<PlayerJionGame>.Skill_2_CardData
      }
      
      var cardInfo = cardDataMap[cardId]
      if cardInfo != nil {
         var nature = Convert.ToString(cardInfo["Nature"])
         var value = cardInfo["Value"] as float
         
         // LogInfo("应用卡牌效果 - 技能" + Convert.ToString(currentSkill) + 
         //         " ID:" + Convert.ToString(cardId) + 
         //         " 属性:" + nature + 
         //         " 数值:" + Convert.ToString(value))
         
         // 根据当前技能和属性应用效果
         GetLocalPlayer()<PlayerJionGame>.ApplySkillCardEffect(currentSkill, nature, value)
      }
   }
   
   // 根据ID和技能获取卡牌信息
   func GetCardInfoById(cardId int, skill int) Map<string, object> {
      if skill == 1 {
         return GetLocalPlayer()<PlayerJionGame>.Skill_1_CardData[cardId]
      } else if skill == 2 {
         return GetLocalPlayer()<PlayerJionGame>.Skill_2_CardData[cardId]
      }
      return nil
   }
   
   // 自动选择最佳卡牌（根据稀有度）
   async func AutoChoiceBestOneCard() {
      // 获取当前技能和卡牌数据
      var currentSkill = GetLocalPlayer()<PlayerJionGame>.CurrentSkill
      var currentRandomCards = CurrentRandomCards
      
      // 根据当前技能选择对应的卡牌数据
      var cardDataMap = Map<int, Map<string, object>>{}
      if currentSkill == 1 {
         cardDataMap = GetLocalPlayer()<PlayerJionGame>.Skill_1_CardData
      } else if currentSkill == 2 {
         cardDataMap = GetLocalPlayer()<PlayerJionGame>.Skill_2_CardData
      } else {
         LogError("无效的技能索引:" + Convert.ToString(currentSkill))
         return
      }
      
      // 使用已经生成的卡牌信息
      var card1 = cardDataMap[currentRandomCards[0]]
      var card2 = cardDataMap[currentRandomCards[1]]
      var card3 = cardDataMap[currentRandomCards[2]]
      
      // 获取三张卡的稀有度
      var rarity1 = card1["Rarity"] as int
      var rarity2 = card2["Rarity"] as int
      var rarity3 = card3["Rarity"] as int
      
      var highestRarity = Math.Max(rarity1, Math.Max(rarity2, rarity3))
      
      // LogInfo("三张卡牌稀有度: " + Convert.ToString(rarity1) + ", " + Convert.ToString(rarity2) + ", " + Convert.ToString(rarity3))
      // LogInfo("最高稀有度: " + Convert.ToString(highestRarity))
      
      // 找出所有最高稀有度的卡牌索引
      var bestCardIndices = List<int>{}
      
      if rarity1 == highestRarity {
         List.Append(bestCardIndices, 1)  // 改为 1,2,3 表示第一、二、三张牌
      }
      if rarity2 == highestRarity {
         List.Append(bestCardIndices, 2)
      }
      if rarity3 == highestRarity {
         List.Append(bestCardIndices, 3)
      }
      
      // 选择最终卡牌
      var selectedIndex = 1  // 默认选择第一张
      
      if List.Length(bestCardIndices) == 1 {
         // 只有一张最高稀有度
         selectedIndex = bestCardIndices[0]
         // LogInfo("唯一最高稀有度，选择卡牌" + Convert.ToString(selectedIndex))
      } else {
         // 多张相同最高稀有度，随机选一个
         var randomIndexInList = RandomInt(0, List.Length(bestCardIndices))
         selectedIndex = bestCardIndices[randomIndexInList]
         // LogInfo("多张相同最高稀有度，随机选择卡牌" + Convert.ToString(selectedIndex))
      }
      
      var selectedCardId = currentRandomCards[selectedIndex - 1]  // 减1因为数组从0开始
      // LogInfo("最终选择 - 位置:" + Convert.ToString(selectedIndex) + " ID:" + Convert.ToString(selectedCardId) + " 稀有度:" + Convert.ToString(highestRarity))
      
      // 选择逻辑
      SelectCard(selectedCardId, currentSkill)
      ApplyCardEffect(selectedCardId, currentSkill)
      
      // 触发选择效果，传递选择的牌位置
      updateHighlightUI(selectedIndex) 
      
      WaitForMillisecond(1000)
      
      // 隐藏选择界面
      thisEntity<CustomUI>.IsVisible = false
      
      // 开始下一波
      PVEController.StartNextWave()
   }
   
   // 初始化已选卡牌面板图标
   func InitNowChoicePanelIcons() {
      // 隐藏所有已选卡牌位置的图标
      for i = 1, 6, 1 {
         var iconPath = "/NowChoicePanel/List/Card (" + Convert.ToString(i) + ")/ICON"
         var iconWidget = GetWidgetByPath(GetLocalPlayer(), thisEntity as entity<CustomUI>, iconPath)
         if iconWidget != nil {
            iconWidget<UIWidget>.IsVisible = false
         } else {
            LogWarning("找不到图标控件: " + iconPath)
         }
      }
      var TextImageEntity = GetWidgetByPath(GetLocalPlayer(), thisEntity as entity<CustomUI>, "/NowChoicePanel/TextImage")
      TextImageEntity<UIWidget>.IsVisible = false
   }
   
   // 清空已选卡牌记录
   func ClearSelectedCards() {
      // 清空技能1已选卡牌
      List.Clear(SelectedCards_1)
      // 清空技能2已选卡牌
      List.Clear(SelectedCards_2)
      // 清空当前随机卡牌列表
      List.Clear(CurrentRandomCards)
      // 重置当前选择的卡牌
      SelectedCardIndex = 0
      // 重置三选一标志位
      GetLocalPlayer()<PlayerJionGame>.IsNextThreeChoiceOne = 0
      // 隐藏所有已选卡牌图标
      InitNowChoicePanelIcons()
      LogInfo("已清空所有已选卡牌记录")
   }
}