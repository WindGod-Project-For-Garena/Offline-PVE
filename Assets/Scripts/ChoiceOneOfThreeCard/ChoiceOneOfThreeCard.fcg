[platform_client]
graph ChoiceOneOfThreeCard {
   IsOver bool = false
   // 当前三选一界面已刷新次数（每次打开三选一界面时重置为 0）
   RefreshCount int = 0
   // 当前选择的卡牌第几张1-3
   SelectedCardIndex int = 0
   // 已选卡牌记录
   SelectedCards_1 List<int> = List<int>{}  // 技能1已选掉的卡牌
   SelectedCards_2 List<int> = List<int>{}  // 技能2已选掉的卡牌
   // 当前随机出来的卡牌
   CurrentRandomCards List<int> = List<int>{}
   //选择卡牌1
   func Card_1(button entity<UIWidgetButton>, triggerPlayer entity<Player>) {
      SoundFunc.PlayCreatedSound("Click_Common_Default")
      if  IsOver == true { return }
      SelectedCardIndex = 1
      // 设置卡牌1的图标
      var card1BB = GetWidgetByPath(GetLocalPlayer(), thisEntity as entity<CustomUI>, "/ChoiceThreeCardPanel/Card_1/IsChoice")
      card1BB<UIWidget>.IsVisible = true
      var card2BB = GetWidgetByPath(GetLocalPlayer(), thisEntity as entity<CustomUI>, "/ChoiceThreeCardPanel/Card_2/IsChoice")
      card2BB<UIWidget>.IsVisible = false
      var card3BB = GetWidgetByPath(GetLocalPlayer(), thisEntity as entity<CustomUI>, "/ChoiceThreeCardPanel/Card_3/IsChoice")
      card3BB<UIWidget>.IsVisible = false
      SetConfirmButtonTextColor()
      CloseTextImage(button, triggerPlayer)
   }
   
   //选择卡牌2
   func Card_2(button entity<UIWidgetButton>, triggerPlayer entity<Player>) {
      SoundFunc.PlayCreatedSound("Click_Common_Default")
      if  IsOver == true { return }
      SelectedCardIndex = 2
      // 设置卡牌2的图标
      var card1BB = GetWidgetByPath(GetLocalPlayer(), thisEntity as entity<CustomUI>, "/ChoiceThreeCardPanel/Card_1/IsChoice")
      card1BB<UIWidget>.IsVisible = false
      var card2BB = GetWidgetByPath(GetLocalPlayer(), thisEntity as entity<CustomUI>, "/ChoiceThreeCardPanel/Card_2/IsChoice")
      card2BB<UIWidget>.IsVisible = true
      var card3BB = GetWidgetByPath(GetLocalPlayer(), thisEntity as entity<CustomUI>, "/ChoiceThreeCardPanel/Card_3/IsChoice")
      card3BB<UIWidget>.IsVisible = false
      SetConfirmButtonTextColor()
      CloseTextImage(button, triggerPlayer)
   }

   //选择卡牌3
   func Card_3(button entity<UIWidgetButton>, triggerPlayer entity<Player>) {
      SoundFunc.PlayCreatedSound("Click_Common_Default")
      if  IsOver == true { return }
      SelectedCardIndex = 3
      // 设置卡牌3的图标
      var card1BB = GetWidgetByPath(GetLocalPlayer(), thisEntity as entity<CustomUI>, "/ChoiceThreeCardPanel/Card_1/IsChoice")
      card1BB<UIWidget>.IsVisible = false
      var card2BB = GetWidgetByPath(GetLocalPlayer(), thisEntity as entity<CustomUI>, "/ChoiceThreeCardPanel/Card_2/IsChoice")
      card2BB<UIWidget>.IsVisible = false
      var card3BB = GetWidgetByPath(GetLocalPlayer(), thisEntity as entity<CustomUI>, "/ChoiceThreeCardPanel/Card_3/IsChoice")
      card3BB<UIWidget>.IsVisible = true
      SetConfirmButtonTextColor()
      CloseTextImage(button, triggerPlayer)
   }

   //设置选择后的颜色
   func SetConfirmButtonTextColor() {
      var Next = GetWidgetByPath(GetLocalPlayer(), thisEntity as entity<CustomUI>, "/Next")
      Next<UIWidgetButton>.SpriteResource = EResSprite.yellowButton
      var NextText = GetWidgetByPath(GetLocalPlayer(), thisEntity as entity<CustomUI>, "/Next/Text")
      NextText<UIWidgetLabel>.Color = #000000
   }

   // 已选择卡牌位置1
   func Card_1_Choice(button entity<UIWidgetButton>, triggerPlayer entity<Player>) {
      SoundFunc.PlayCreatedSound("Click_Common_Default")
      OwnedCardIconClicked_SmallIcon(1)
   }

   // 已选择卡牌位置2
   func Card_2_Choice(button entity<UIWidgetButton>, triggerPlayer entity<Player>) {
      SoundFunc.PlayCreatedSound("Click_Common_Default")
      OwnedCardIconClicked_SmallIcon(2)
   }

   // 已选择卡牌位置3
   func Card_3_Choice(button entity<UIWidgetButton>, triggerPlayer entity<Player>) {
      SoundFunc.PlayCreatedSound("Click_Common_Default")
      OwnedCardIconClicked_SmallIcon(3)
   }

   // 已选择卡牌位置4
   func Card_4_Choice(button entity<UIWidgetButton>, triggerPlayer entity<Player>) {
      SoundFunc.PlayCreatedSound("Click_Common_Default")
      OwnedCardIconClicked_SmallIcon(4)
   }

   // 已选择卡牌位置5
   func Card_5_Choice(button entity<UIWidgetButton>, triggerPlayer entity<Player>) {
      SoundFunc.PlayCreatedSound("Click_Common_Default")
      OwnedCardIconClicked_SmallIcon(5)
   }  
//————————————————————————————————————————————————————————————————————————————————————————————————//
//————————————————————————————————————————————————————————————————————————————————————————————————//
//————————————————————————————————————————————————————————————————————————————————————————————————//
   //下一波开始
   async func OnConfirmBtnClicked(button entity<UIWidgetButton>, triggerPlayer entity<Player>) {
      SoundFunc.PlayCreatedSound("Click_Common_Default")

      CloseTextImage(button, triggerPlayer)
      if  IsOver == true { return }
      WaitForNextFrame()
      IsOver = true
      var currentSelectedCardIndex = SelectedCardIndex
      if currentSelectedCardIndex == 0 {
         // LogInfo("没有选择卡牌，无法开始下一波")
         IsOver = false
         return
      }
      
      // 获取当前技能和随机卡牌
      var currentSkill = GetLocalPlayer()<PlayerJionGame>.CurrentSkill
      var currentRandomCards = CurrentRandomCards
      
      // 验证数据有效性
      // LogInfo(currentRandomCards)
      if List.Length(currentRandomCards) < 3 {
         LogError("卡牌数据无效，无法获取卡牌ID")
         IsOver = false
         return
      }
      
      // 根据选择的牌位置获取对应的卡牌ID
      var selectedCardId = 0
      if currentSelectedCardIndex == 1 {
         selectedCardId = currentRandomCards[0]
      } else if currentSelectedCardIndex == 2 {
         selectedCardId = currentRandomCards[1]
      } else if currentSelectedCardIndex == 3 {
         selectedCardId = currentRandomCards[2]
      }
      
      if selectedCardId == 0 {
         LogError("卡牌ID无效，无法应用效果")
         IsOver = false
         return
      }
      
      // 获取卡牌数据验证是否存在
      var cardDataMap = Map<int, Map<string, object>>{}
      if currentSkill == 1 {
         cardDataMap = GetLocalPlayer()<PlayerJionGame>.Skill_1_CardData
      } else if currentSkill == 2 {
         cardDataMap = GetLocalPlayer()<PlayerJionGame>.Skill_2_CardData
      }
      
      var cardInfo = cardDataMap[selectedCardId]
      if cardInfo == nil {
         return
      }
      
      // 更新UI显示选择的牌
      updateHighlightUI(currentSelectedCardIndex)
      
      // 应用卡牌效果 - 参考AutoChoiceBestOneCard的调用方式
      SelectCard(selectedCardId, currentSkill)
      ApplyCardEffect(selectedCardId, currentSkill)

      // 恢复玩家移动
      SetBehaviorStatus(GetLocalPlayer()<PlayerJionGame>.currPlayer, PlayerBehaviorType.Move, PlayerBehaviorStatusType.Enable)

      // 更新已选卡牌展示面板的图标
      UpdateSelectedCardIcons(selectedCardId, currentSkill)

      // 等待UI更新
      WaitForMillisecond(1000)
      
      // 隐藏倒计时UI
      // var SecondDownUI = GetLocalPlayer()<PlayerJionGame>.SecondDownUI
      // SecondDownUI<CustomUI>.IsVisible = false
      
      // 关闭选择界面并发送下一波事件
      thisEntity<CustomUI>.IsVisible = false

      // 停止三选一界面音效
      SoundFunc.PauseTheSound("Menu_Pickup")
      
      // 调用Close函数更新技能数据
      CloseChooseCardUI(triggerPlayer)

      CreateBuiltInUIClient(out var createdEntity3, BuiltInUIType.OpeningBannerHud)
		createdEntity3<UIOpeningBanner>.IsVisible = true
		createdEntity3<UIOpeningBanner>.ThemeColor = #00FFD5FF

		createdEntity3<UIOpeningBanner>.Icon = EResSprite.UI_RuinSurvivor_Icon01

      // 目标标题：波次
      var nextWave = PVEController.CurrentWave + 1
      var WaveText = LocString{"Wave", List<string>{}}
      createdEntity3<UIOpeningBanner>.Title = WaveText + " " + nextWave

      // 目标详情：1～4 波存活一分钟，第 5 波显示击杀 BOSS
      if nextWave == 5 {
         createdEntity3<UIOpeningBanner>.Description = LocString{"KILL_BOSS_TEXT", List<string>{}}
      } else {
         var Objective_SurviveText = LocString{"Objective_Survive", List<string>{}}
         createdEntity3<UIOpeningBanner>.Description = Objective_SurviveText + " 01:00"
      }

      // 等待UI更新
      WaitForMillisecond(4000)

      // 开始下一波事件
      PVEController.StartNextWave()

      GetLocalPlayer()<PlayerJionGame>.ShowDownSixLogo()

      IsOver = false
   }
//————————————————————————————————————————————————————————————————————————————————————————————————//
//————————————————————————————————————————————————————————————————————————————————————————————————//
//————————————————————————————————————————————————————————————————————————————————————————————————//
   // 更新已选卡牌图标（左侧列表）
   func UpdateSelectedCardIcons(cardId int, currentSkill int) {
      // 获取当前技能对应的已选卡牌列表
      var selectedCards = List<int>{}
      if currentSkill == 1 {
         selectedCards = SelectedCards_1
      } else if currentSkill == 2 {
         selectedCards = SelectedCards_2
      }
      
      // 获取已选卡牌总数
      var totalCards = List.Length(selectedCards)
      // LogInfo("已选卡牌总数: " + Convert.ToString(totalCards))
      
      // 只显示最近5张卡牌，计算要更新的位置
      var displayPosition = 0
      if totalCards <= 5 {
         // 如果不足5张，新卡牌放在第一个位置
         displayPosition = totalCards
      } else {
         // 如果超过5张，新卡牌总是放在第一个位置，其他卡牌向后移动
         displayPosition = 1
      }
      
      // 更新对应位置的图标
      UpdateSingleCardIcon(displayPosition, cardId, currentSkill)
      
      // 如果超过5张卡牌，需要重新排列其他卡牌的位置
      if totalCards > 5 {
         // 获取最近选择的5张卡牌ID（包括新选择的）
         var recentCards = List<int>{}
         for i = Math.Max(0, totalCards - 5), totalCards - 1, 1 {
            var recentCardId = selectedCards[i]
            List.Append(recentCards, recentCardId)
         }
         
         // 更新5个位置的图标
         for i = 1, 6, 1 {
            if i <= List.Length(recentCards) {
               var cardIdToShow = recentCards[i - 1]
               UpdateSingleCardIcon(i, cardIdToShow, currentSkill)
            } else {
               // 清空多余位置的图标
               ClearCardIcon(i)
            }
         }
      }
   }
   
   // 更新单个卡牌位置的图标(小图标)
   func UpdateSingleCardIcon(position int, cardId int, currentSkill int) {
      var cardInfo = GetCardInfoById(cardId, currentSkill)
      var rarity = cardInfo["Rarity"] as int
      var iconKey = cardInfo["Nature"]
      var iconSprite = FC_Config.CardIconSprites[iconKey]
      var rarityColor = FC_Config.CardRarityColor[rarity]
      // 按钮路径
      var buttonPath = "/NowChoicePanel/List/Card (" + Convert.ToString(position) + ")"
      // 获取图标控件
      var buttonWidget = GetWidgetByPath(GetLocalPlayer(), thisEntity as entity<CustomUI>, buttonPath)
      var iconWidget = GetChildByName(buttonWidget, "ICON")


      if buttonWidget != nil {
         // 设置按钮的图标
         buttonWidget<UIWidgetButton>.Color = rarityColor
         iconWidget<UIWidget>.IsVisible = true
         iconWidget<UIWidgetImage>.SpriteName = iconSprite
         iconWidget<UIWidgetImage>.Color = rarityColor
         // 根据卡牌ID设置不同的图标
         // iconWidget<UIWidgetImage>.SetImage("CardIcon_" + Convert.ToString(cardId))
         // LogInfo("已更新位置 " + Convert.ToString(position) + " 的图标")
      } else {
         LogError("找不到按钮控件: " + buttonPath)
      }
   }
   
   // 清空卡牌图标（小图标）
   func ClearCardIcon(position int) {
      var iconPath = "/NowChoicePanel/List/Card (" + Convert.ToString(position) + ")/ICON"
      var iconWidget = GetWidgetByPath(GetLocalPlayer(), thisEntity as entity<CustomUI>, iconPath)
      if iconWidget != nil {
         iconWidget<UIWidget>.IsVisible = false
         // LogInfo("已清空位置 " + Convert.ToString(position) + " 的图标")
      }
   }
