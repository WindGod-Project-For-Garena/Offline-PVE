import "StdLibrary.fcc" as StdLib
import "EditorGenLib.fcc" as EditorLib
import "Playable.fcc" as Playable
import "BehaviourTree.fcc" as BehaviourTree
import "Camera.fcc" as Camera
import "Math.fcc" as Math
import "Combat.fcc" as Combat
import "../CustomEvent.fcc" as CustomEvent
import "../PVE/FC_PVEMonsterManager.fcg" as PVEMonsterManager
import "Animation.fcc" as Animation
import "Physics.fcc" as Physics
import "../PlayerJionGame/PlayerJionGame.fcg" as PlayerJionGame
import "../Global/FC_Global_MobSkillHandler.fcg" as MobSkillHandler
import "../C_HitBox.fcg" as HitBox
import "Avatar.fcc" as Avatar
import "Offline.fcc" as Offline
import "List.fcc" as List

[platform_client]
graph FC_NormalZombie {
    //Executed when entity is created
	LastHitPlayer entity<Player> = nil
	hitPos Vector3 = Vector3{0,0,0}
    tickInterval int = 1
	// 钻出地面预警时长(ms)，与 DisplayWarningCircle 一致，用于延迟伤害到预警结束
	DrillWarnDuration int = 2000
	DrillWarnStartTime int = 0


	event OnAwake() {
        WaitForNextFrame()
        Init()
    }

	event OnMobActived() {
		CreateFromPrefab(out var headHitbox, EResPrefab.HitBox_BossFlower_Tongue)
		AddScript(headHitbox, EResFCG.C_HitBox)
        SetParentClient(GetSkeletonPartByName(thisEntity, "Bone007"), headHitbox<Transform>, false)
		headHitbox<HitBox>.SetOwner(thisEntity, "Head")

		CreateFromPrefab(out var bodyHitBox, EResPrefab.HitBox_BossFlower_Body)
		AddScript(bodyHitBox, EResFCG.C_HitBox)
        SetParentClient(GetSkeletonPartByName(thisEntity, "Bone106"), bodyHitBox<Transform>, false)
		bodyHitBox<HitBox>.SetOwner(thisEntity, "Body")


		CreateFromPrefab(out var bodyHitBox2, EResPrefab.HitBox_BossFlower_Body2)
		AddScript(bodyHitBox2, EResFCG.C_HitBox)
        SetParentClient(GetSkeletonPartByName(thisEntity, "Bone006"), bodyHitBox2<Transform>, false)
		bodyHitBox2<HitBox>.SetOwner(thisEntity, "Body")



		AddScript(thisEntity, EResFCG.C_HitBox)
		thisEntity<HitBox>.SetOwner(thisEntity, "Body")
	}

	//funcID: Init
	async func Init() {
		thisEntity<BevTreeAttachableForClient>.AttachTarget<BevTree>.TickInterval = tickInterval
		thisEntity<Mob>.HateGainInterval = 3000
		thisEntity<Mob>.DetectRange = 30
		thisEntity<Mob>.StatusDic = Map<string, object>{
			"InAttack": false as bool,
			"InDrill": false as bool,

			//普通攻击
			"LastAttackTime_NormalAttack": globalEntity<Global>.GameTimeCount as int,
			"CD_NormalAttack": 3000 as int,
			"Duration_NormalAttack": 1450 as int,
			"Range_NormalAttack": 5.0 as float,//这里必须加小数点

			//射击攻击
			"LastAttackTime_ShootAttack": globalEntity<Global>.GameTimeCount as int,
			"CD_ShootAttack": 5000 as int,
			"Duration_ShootAttack": 1200 as int,
			"Range_ShootAttack": 30.0 as float,//这里必须加小数点

			//连射攻击
			"LastAttackTime_BigShootAttack": globalEntity<Global>.GameTimeCount as int,
			"CD_BigShootAttack": 8000 as int,
			"Duration_BigShootAttack": 4200 as int,
			"Range_BigShootAttack": 30.0 as float,//这里必须加小数点

			//钻地攻击
			"LastAttackTime_DrillAttack": globalEntity<Global>.GameTimeCount as int,
			"CD_DrillAttack": 10000 as int,
			"Duration_DrillAttack": 8750 as int,
			"Range_DrillAttack": 30.0 as float,//这里必须加小数点
		}


		//WaitForMillisecond(2000)
		
		//DispatchEventWithPlatform_Deprecated(100002, thisEntity, true, List<object>{thisEntity<CustomComponent31897461>.ZombieInfo["InitSpeed"]})
		
        // for index3, element4 in GetAllPlayers() {
        //     SetAttackableEntity(element4, thisEntity, 1)
        // }
	}
	func startShootAttack() {
		var curTarget = thisEntity<Mob>.CurrTarget
	//	LogInfo("startGarenadeSkill: curTarget: " + curTarget)
		SingleRaycast(curTarget<Player>.Position + Vector3{0,0.5,0}, Vector3{0,-3,0}, 5, List<int>{0}, false, out var hitEntities, out var hitPoint, out var hitDistances, out var hitNormals)
		hitPos = hitPoint+Vector3{0,0.05,0}
	//	LogInfo("hitpoint:"+hitPos)
		start MobSkillHandler.releaseSkill_FlowerBossShootAttack(thisEntity as entity<Mob>,hitPos,2)

	}

	func startBigShootAttack() {
		var curTarget = thisEntity<Mob>.CurrTarget
		start MobSkillHandler.releaseSkill_FlowerBossBigShootAttack(thisEntity as entity<Mob>,curTarget)
	}

	
	

	//eventID: 91//r;Zn+-uY8Ahq`0JH4Yr{ //animation
	event MobAttackEvent_AC(attackName string) {
		var curTarget = thisEntity<Mob>.CurrTarget
		var zombieName string = thisEntity<Mob>.MobName
		// LogInfo("MobAttackEvent_AC: attackName: " + attackName)

		if (attackName == "NormalAttack") {
			if (curTarget != nil && (Distance(curTarget as entity<Player><Player>.Position, thisEntity as entity<LevelObject><Transform>.Position) <= 5.0)) {		
				Offline.DealDamage(curTarget as entity<Combatable>, nil, DamageType.Monster, GetDamage())
			}
		}else if (attackName == "ShootAttack") {
			//start MobSkillHandler.releaseSkill_FlowerZombieShootAttack(thisEntity as entity<Mob>,curTarget<Player>.Position)
		}
	
	}

	event MobDeathEvent_AC() {
		PVEMonsterManager.DestroyDeath(thisEntity as entity<LevelObject>)
	}

	event ZombieAnimationEvent_AC(eventName string) {
		if (eventName == "FBossDrillIn") {
			thisEntity<Transform>.Position = thisEntity<Transform>.Position + Vector3{0,-10,0}
			thisEntity<Mob>.StatusDic["InDrill"] = true
		}else if (eventName == "FBossWarn") {
			hitPos = Vector3{0,-0.2,0}
			DrillWarnStartTime = globalEntity<Global>.GameTimeCount
			var curTarget = thisEntity<Mob>.CurrTarget
			if (curTarget != nil) {
				SingleRaycast(curTarget<Player>.Position + Vector3{0,0.5,0}, Vector3{0,-3,0}, 5, List<int>{0}, false, out var hitEntities, out var hitPoint, out var hitDistances, out var hitNormals)
				hitPos = hitPoint
				hitPos = SetYClient(hitPos,0.1)
			}
			// 地面预警时长(DrillWarnDuration)，伤害会在预警结束后才结算
			start MobSkillHandler.DisplayWarningCircle(hitPos,1.5,DrillWarnDuration)
		}else if (eventName == "FBossDrillOut") {
			// 等预警时长结束后再钻出并造成伤害，与地面圈一致
			start DelayedDrillOutDamage()
		}
	}

	// 延迟到预警结束后再钻出并结算伤害（动画里 DrillOut 比 Warn 早约1秒，需补齐剩余预警时间）
	async func DelayedDrillOutDamage() {
		var elapsed int = globalEntity<Global>.GameTimeCount - DrillWarnStartTime
		var remaining int = DrillWarnDuration - elapsed
		if remaining > 0 {
			WaitForMillisecond(remaining)
		}
		thisEntity<Transform>.Position = hitPos
		thisEntity<Mob>.StatusDic["InDrill"] = false
		var players = getPlayersInRange(thisEntity<Transform>.Position, 30.0)
		for i, player in players {
			Offline.DealDamage(player as entity<Combatable>, nil, DamageType.Monster, GetDamage())
		}
	}

	event OnDamageMob(mob entity<Entity>, part string, damage int, player entity<Player>) {
		//LogInfo("mob: " + mob + "thisEntity: " + thisEntity)
		if (thisEntity<Mob>.StatusDic["InDrill"] as bool) {
			//临时处理，会跳伤害但是实际不会受伤
			return
		}

		//处理仇恨值
		if mob<Mob>.HateGainTime > globalEntity<Global>.GameTimeCount - thisEntity<Mob>.HateGainInterval {
			mob<Mob>.HateTarget = player
			mob<Mob>.HateGainTime = globalEntity<Global>.GameTimeCount
		}

		//处理血量，如果血量小于0，则死亡
		if (mob<Mob>.HP > 0) {  // 只在活着的时候处理伤害
			mob<Mob>.HP = mob<Mob>.HP - damage
			if (mob<Mob>.HP <= 0) {
				mob<Mob>.HP = 0
				PVEMonsterManager.NoItemDropDeath(thisEntity as entity<LevelObject>)
				start GetLocalPlayer()<PlayerJionGame>.KillInfo(part)
			}
		}
	}

	//funcID: GetDamage
	func GetDamage() int {
		return Floor((thisEntity<Mob>.Damage))
	}

	func getPlayersInRange(position Vector3,range float) List<entity<Player>> {
        var players List<entity<Player>> = List<entity<Player>>{}
        for i, player in GetAllPlayers() {
            if (Math.Distance(player<Player>.Position, position) <= range) {
                List.Append(players, player)
            }
        }
        return players
     }
}