import "StdLibrary.fcc" as StdLib
import "EditorGenLib.fcc" as EditorLib
import "Playable.fcc" as Playable
import "Physics.fcc" as Physics
import "Camera.fcc" as Camera

[platform_client]
graph FC_ZombieComponent {
    //Executed when entity is created
    moveTween entity<Tween> = nil
	tweenDuration float = 2000

    event OnAwake() {

    }
    	//funcID: CreateMoveTween
	func CreateMoveTween(velocity Vector3) {	
		var verticalOffset Vector3 = Vector3{0, 0.5, 0}
		var vectorToTarget Vector3 = velocity * tweenDuration/1000

		var endPos Vector3 = thisEntity<Transform>.Position + vectorToTarget
		//如果射綫打到更近，则换endPos和duration -- 后续制作，需要配合场景的层级更好实现
		//SingleRaycast(thisEntity<Transform>.Position + verticalOffset, velocity, 5, List<int>{}, false, out var hitEntities, out var hitPoint, out var hitDistances, out var hitNormals)
		
		
		// if hitPoint != nil && hitDistances[0] < Magnitude(endPos - thisEntity<Transform>.Position) {
		// 	endPos = hitPoint
		// 	tweenDuration = hitDistances[0] * 1000
		// }

		if moveTween != nil{
			//LogInfo("create move tween: " + endPos + "currPostion" + thisEntity<Transform>.Position)
			moveTween<Tween>.Duration = tweenDuration
			moveTween<Tween>.EndValue = endPos
			moveTween<Tween>.StartValue = thisEntity<Transform>.Position
			Play(moveTween,true)
		}else{
			
			CreateTween(thisEntity,Transform.Position,thisEntity<Transform>.Position,
				endPos,TweenStyle.Once,CreateCurve({0.25, 0.1, 0.25, 1}),tweenDuration,out var tweenEntity,true)
			moveTween = tweenEntity
		
		}
	}

	func StopMoveTween() {
		if moveTween != nil{
			Pause(moveTween)
			//Destroy(moveTween)
		}
	}
}