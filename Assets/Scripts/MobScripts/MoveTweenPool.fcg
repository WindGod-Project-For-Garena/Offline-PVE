import "StdLibrary.fcc" as StdLib
import "EditorGenLib.fcc" as EditorLib
import "List.fcc" as list
import "Playable.fcc" as Playable
import "LevelObject.fcc" as LevelObject

// 僵尸移动 Tween 对象池：移动时从池中取 Tween，停止移动时归还池；池空则新建。
[platform_client]
static graph MoveTweenPool {
    moveTweenPool List<entity<Tween>> = List<entity<Tween>>{}

    // 从池中获取一个移动 Tween，池空则新建。绑定到 owner，设置起点、终点、时长并播放。
    func GetMoveTween(owner entity<LevelObject>, startPos Vector3, endPos Vector3, duration float, out var tweenEntity entity<Tween>) {
        if list.Length(moveTweenPool) > 0 {
            tweenEntity = moveTweenPool[0]
            list.Remove(moveTweenPool, tweenEntity)
            tweenEntity<Tween>.Target = owner
            tweenEntity<Tween>.StartValue = startPos
            tweenEntity<Tween>.EndValue = endPos
            tweenEntity<Tween>.Duration = duration
            Play(tweenEntity, true)
        } else {
            CreateTween(owner, Transform.Position, startPos, endPos, TweenStyle.Once, CreateCurve({0.25, 0.1, 0.25, 1}), duration, out var newTween, true)
            tweenEntity = newTween
        }
    }

    // 停止并归还 Tween 到池中，供其他僵尸复用。
    func ReturnMoveTween(tween entity<Tween>) {
        if tween == nil { return }
        Pause(tween)
        list.Append(moveTweenPool, tween)
    }
}
