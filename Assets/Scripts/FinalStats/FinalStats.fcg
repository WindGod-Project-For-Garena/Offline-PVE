import "StdLibrary.fcc" as StdLib
import "EditorGenLib.fcc" as EditorLib
import "Player.fcc" as Player
import "Items.fcc" as Items
import "Hud.fcc" as Hud
import "../SkillUI/SkillUI.fcg" as SkillUI
import "Math.fcc" as Math
import "Map.fcc" as Map
import "CSVData.fcc" as CSVData
import "../SoundFunc/SoundFunc.fcg" as SoundFunc
import "List.fcc" as List
import "Convert.fcc" as Convert
import "Strings.fcc" as strings
import "Offline.fcc" as Offline
import "../PVE/PVEController.fcg" as PVEController
import "../PlayerJionGame/PlayerJionGame.fcg" as PlayerJionGame
import "../ChoiceOneOfThreeCard/ChoiceOneOfThreeCard.fcg" as ChoiceOneOfThreeCard

[platform_client]
graph FinalStats {
    func BackNewHome(button entity<UIWidgetButton>, triggerPlayer entity<Player>) {
        SoundFunc.PlayCreatedSound("Click_Common_Default")
        SoundFunc.PlayCreatedSound("MainMenu")
        GetLocalPlayer()<PlayerJionGame>.SaveAllLocalData()

        var GameOverFinalUI = GetLocalPlayer()<PlayerJionGame>.GameOverFinalUI
        GameOverFinalUI<CustomUI>.IsVisible = false

        // 离开结算时清空已选卡牌，避免下一局残留
        GetLocalPlayer()<PlayerJionGame>.ChoiceThreeCardUI<ChoiceOneOfThreeCard>.ClearSelectedCards()
        
        var ChoiceHeroUI = GetLocalPlayer()<PlayerJionGame>.ChoiceHeroUI
        ChoiceHeroUI<CustomUI>.IsVisible = true

        // 更新按钮状态
        GetLocalPlayer()<PlayerJionGame>.UpdateLevelDisplay()

        Offline.Revive()

        // 更新玩家位置
        GetLocalPlayer()<PlayerJionGame>.SetPlayerPosition()

        // 更新选择英雄面板的金钱显示
        GetLocalPlayer()<PlayerJionGame>.UpdateChoiceHeroPanelMoney()
    }
    
    // 再来一局：重生、保留武器与技能、清空选卡，从当前关卡第一波重新开始
    // 赢/输后玩家可能死亡，用 GetAllPlayers()[0] 取玩家实体，避免 GetLocalPlayer/triggerPlayer 在结算后异常
    async func ContinueGame(button entity<UIWidgetButton>, triggerPlayer entity<Player>) {
        SoundFunc.PlayCreatedSound("Click_Common_Default")

        var allPlayers = GetAllPlayers()
        if List.Length(allPlayers) < 1 {
            return
        }
        var playerEntity entity<Player> = allPlayers[0]
        playerEntity<PlayerJionGame>.SaveAllLocalData()

        playerEntity<PlayerJionGame>.Hide_Skill_Detail()

        var currentLevel = playerEntity<PlayerJionGame>.level
        var currentSkill = playerEntity<PlayerJionGame>.CurrentSkill
        if currentSkill == 0 {
            currentSkill = 1
        }
        if currentLevel < 1 {
            currentLevel = 1
        }

        var GameOverFinalUI = playerEntity<PlayerJionGame>.GameOverFinalUI
        GameOverFinalUI<CustomUI>.IsVisible = false

        WaitForNextFrame()

        Offline.Revive()
        playerEntity<PlayerJionGame>.SetPlayerPosition()

        WaitForNextFrame()
        WaitForMillisecond(100)

        playerEntity<PlayerJionGame>.level = currentLevel
        playerEntity<PlayerJionGame>.CurrentSkill = currentSkill
        wait playerEntity<PlayerJionGame>.ChoiceHeroOver(currentLevel, currentSkill)

        WaitForNextFrame()
        WaitForMillisecond(50)

        playerEntity<PlayerJionGame>.ChoiceThreeCardUI<ChoiceOneOfThreeCard>.ClearSelectedCards()
        playerEntity<PlayerJionGame>.ResetInGameData()
        playerEntity<PlayerJionGame>.ResetDamageData()
        playerEntity<PlayerJionGame>.AmmoJudgement = 0

        playerEntity<PlayerJionGame>.CurrentSkill = currentSkill
        var skillMultiplier float = 1.0 * playerEntity<PlayerJionGame>.ability3Level + 1
        playerEntity<PlayerJionGame>.SkillUI<SkillUI>.skillMultiplier = skillMultiplier
        start playerEntity<PlayerJionGame>.displaySkillByIndex(currentSkill)

        playerEntity<PlayerJionGame>.RighTabIFMUI<CustomUI>.IsVisible = true
        var MoneyEntity = GetWidgetByPath(playerEntity, playerEntity<PlayerJionGame>.RighTabIFMUI, "/Money")
        MoneyEntity<UIWidget>.IsVisible = false
        var MoneyNumEntity = GetWidgetByPath(playerEntity, playerEntity<PlayerJionGame>.RighTabIFMUI, "/Panel/Money/logo/Num")
        MoneyNumEntity<UIWidgetLabel>.Content = playerEntity<PlayerJionGame>.Money
        var KillCountEntity = GetWidgetByPath(playerEntity, playerEntity<PlayerJionGame>.RighTabIFMUI, "/Panel/Killed/logo/Num")
        KillCountEntity<UIWidgetLabel>.Content = 0
        playerEntity<PlayerJionGame>.KillCount = 0
        playerEntity<PlayerJionGame>.KillCountTAG = 0
        playerEntity<PlayerJionGame>.KillCountSound = 0

        var ChoiceThreeCardUIEntity = playerEntity<PlayerJionGame>.ChoiceThreeCardUI
        for i = 1, 6, 1 {
            var buttonPath = "/NowChoicePanel/List/Card (" + Convert.ToString(i) + ")"
            var buttonWidget = GetWidgetByPath(playerEntity, ChoiceThreeCardUIEntity, buttonPath)
            if buttonWidget != nil {
                buttonWidget<UIWidgetButton>.Color = #FFFFFF
            }
        }

        PVEController.PVELevelStartInitialization(currentLevel)
        start playerEntity<PlayerJionGame>.ShowChoiceThreeCardUI(currentLevel)

        SoundFunc.PauseTheSound("MainMenu")
        SoundFunc.PlayCreatedSound("Menu_Pickup")
    }
}