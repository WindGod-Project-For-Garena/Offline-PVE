[platform_client]
graph Popup {
    func ClosePopup(button entity<UIWidgetButton>, triggerPlayer entity<Player>) {
        var PopupUI = GetLocalPlayer()<PlayerJionGame>.PopupUI
        PopupUI<CustomUI>.IsVisible = false
    }
}