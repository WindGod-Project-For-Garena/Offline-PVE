import "StdLibrary.fcc" as StdLib
import "EditorGenLib.fcc" as EditorLib
import "Player.fcc" as Player
import "Hud.fcc" as Hud
import "Math.fcc" as Math
import "Camera.fcc" as Camera
import "../SoundFunc/SoundFunc.fcg" as SoundFunc
import "Playable.fcc" as Playable
import "Animation.fcc" as Animation
import "../PlayerJionGame/PlayerJionGame.fcg" as PlayerJionGame
import "Convert.fcc" as Convert


[platform_client]
graph GiftedPanel {
     // 当前选中的天赋卡牌ID
     CurrentSelectedCardId int = 0
     
     //前往选择角色开始游戏面板
     func ToNewHome(button entity<UIWidgetButton>, triggerPlayer entity<Player>) {
          SoundFunc.PlayCreatedSound("Click_Common_Default")

          var ChoiceHeroUIEntity = GetLocalPlayer()<PlayerJionGame>.ChoiceHeroUI
          ChoiceHeroUIEntity<CustomUI>.IsVisible = true
          var GiftedUIEntity = GetLocalPlayer()<PlayerJionGame>.GiftedUI
          GiftedUIEntity<CustomUI>.IsVisible = false
          
          // 离开天赋面板时重置选中状态
          ResetSelection()
     }

     // Debug一键牛逼
     func DebugOneKey(button entity<UIWidgetButton>, triggerPlayer entity<Player>) {
          SoundFunc.PlayCreatedSound("Click_Common_Default")

          for i = 0,50,1 {
               GetLocalPlayer()<PlayerJionGame>.DrawGiftedCard()
          }
     }

     // 抽卡功能
     func DrawCard(button entity<UIWidgetButton>, triggerPlayer entity<Player>) {
          SoundFunc.PlayCreatedSound("Click_Common_Default")

          GetLocalPlayer()<PlayerJionGame>.DrawGiftedCard()
          // 抽卡后重置选中状态
          ResetSelection()
     }

     // 重置所有卡牌的选中状态
     func ResetSelection() {
          for cardId = 1, 11, 1 {
               HideISCHOICEForCard(cardId)
          }
          CurrentSelectedCardId = 0
          // 隐藏详情面板
          HideDetailPanel()
     }

     // 隐藏指定卡牌的ISCHOICE
     func HideISCHOICEForCard(cardId int) {
          var listParent = GetWidgetByPath(GetLocalPlayer(), GetLocalPlayer()<PlayerJionGame>.GiftedUI, "/Panel/List")
          var cardIndex = Convert.ToString("Card (" + cardId + ")")
          var cardEntity = GetChildByName(listParent, cardIndex)
          
          if cardEntity != nil {
               var HasCardPanelEntity = GetChildByName(cardEntity, "HasCardPanel")
               if HasCardPanelEntity != nil {
                    var isChoiceEntity = GetChildByName(HasCardPanelEntity, "ISCHOICE")
                    if isChoiceEntity != nil {
                         isChoiceEntity<UIWidget>.IsVisible = false
                    }
               }
          }
     }

     // 显示指定卡牌的ISCHOICE
     func ShowISCHOICEForCard(cardId int) {
          var listParent = GetWidgetByPath(GetLocalPlayer(), GetLocalPlayer()<PlayerJionGame>.GiftedUI, "/Panel/List")
          var cardIndex = Convert.ToString("Card (" + cardId + ")")
          var cardEntity = GetChildByName(listParent, cardIndex)
          
          if cardEntity != nil {
               var HasCardPanelEntity = GetChildByName(cardEntity, "HasCardPanel")
               if HasCardPanelEntity != nil {
                    var isChoiceEntity = GetChildByName(HasCardPanelEntity, "ISCHOICE")
                    if isChoiceEntity != nil {
                         isChoiceEntity<UIWidget>.IsVisible = true
                    }
               }
          }
     }

     // 显示卡牌1详情
     func Card1(button entity<UIWidgetButton>, triggerPlayer entity<Player>) {
          SoundFunc.PlayCreatedSound("Click_Common_Default")
          SelectCardAndShowDetails(1)
     }

     // 显示卡牌2详情
     func Card2(button entity<UIWidgetButton>, triggerPlayer entity<Player>) {
          SoundFunc.PlayCreatedSound("Click_Common_Default")
          SelectCardAndShowDetails(2)
     }

     // 显示卡牌3详情
     func Card3(button entity<UIWidgetButton>, triggerPlayer entity<Player>) {
          SoundFunc.PlayCreatedSound("Click_Common_Default")
          SelectCardAndShowDetails(3)
     }

     // 显示卡牌4详情
     func Card4(button entity<UIWidgetButton>, triggerPlayer entity<Player>) {
          SoundFunc.PlayCreatedSound("Click_Common_Default")
          SelectCardAndShowDetails(4)
     }

     // 显示卡牌5详情
     func Card5(button entity<UIWidgetButton>, triggerPlayer entity<Player>) {
          SoundFunc.PlayCreatedSound("Click_Common_Default")
          SelectCardAndShowDetails(5)
     }

     // 显示卡牌6详情
     func Card6(button entity<UIWidgetButton>, triggerPlayer entity<Player>) {
          SoundFunc.PlayCreatedSound("Click_Common_Default")
          SelectCardAndShowDetails(6)
     }

     // 显示卡牌7详情
     func Card7(button entity<UIWidgetButton>, triggerPlayer entity<Player>) {
          SoundFunc.PlayCreatedSound("Click_Common_Default")
          SelectCardAndShowDetails(7)
     }

     // 显示卡牌8详情
     func Card8(button entity<UIWidgetButton>, triggerPlayer entity<Player>) {
          SoundFunc.PlayCreatedSound("Click_Common_Default")
          SelectCardAndShowDetails(8)
     }

     // 显示卡牌9详情
     func Card9(button entity<UIWidgetButton>, triggerPlayer entity<Player>) {
          SoundFunc.PlayCreatedSound("Click_Common_Default")
          SelectCardAndShowDetails(9)
     }

     // 显示卡牌10详情
     func Card10(button entity<UIWidgetButton>, triggerPlayer entity<Player>) {
          SoundFunc.PlayCreatedSound("Click_Common_Default")
          SelectCardAndShowDetails(10)
     }

          // 选择卡牌并显示详情的统一函数
     func SelectCardAndShowDetails(cardId int) {
          // 首先检查卡牌是否已激活（已抽到过）
          var giftedCardCount = GetLocalPlayer()<PlayerJionGame>.Gifted_Card_Count
          var currentCount = 0
          if giftedCardCount[cardId] != nil {
               currentCount = giftedCardCount[cardId]
          }
          
          // 如果卡牌未激活（currentCount = 0）
          if currentCount <= 0 {
               // 点击未激活卡牌时，重置所有选中状态
               ResetSelection()
               return
          }
          
          // 如果点击的是已选中的卡牌，则取消选择
          if CurrentSelectedCardId == cardId {
               ResetSelection()
               return
          }
          
          // 记录之前选中的卡牌ID
          var prevSelected = CurrentSelectedCardId
          
          // 设置当前选中的卡牌ID
          CurrentSelectedCardId = cardId
          
          // 隐藏之前选中的ISCHOICE
          if prevSelected > 0 {
               HideISCHOICEForCard(prevSelected)
          }
          
          // 显示当前选中的ISCHOICE
          ShowISCHOICEForCard(cardId)
          
          // 更新PlayerJionGame中的选中ID
          GetLocalPlayer()<PlayerJionGame>.currentSelectedCardId = cardId
          
          // 显示卡牌详情
          ShowCardDetails(cardId)
     }

     // 显示卡牌详情的统一函数
     func ShowCardDetails(cardId int) {
          // 从PlayerJionGame获取卡牌数据
          var giftedCardData = GetLocalPlayer()<PlayerJionGame>.Gifted_CardData
          var cardInfo = giftedCardData[cardId]
          if cardInfo == nil {
               LogWarning("卡牌" + Convert.ToString(cardId) + "的数据不存在")
               return
          }
          // 获取卡牌信息
          var giftedNameText = Convert.ToString(cardInfo["GiftedName"])
          var translationText = Convert.ToString(cardInfo["TranslationText"])
          var MathValue = Convert.ToString(cardInfo["MathValue"])
          var nature = Convert.ToString(cardInfo["Nature"])
          var rarity = cardInfo["Rarity"] as int
          // 获取当前卡牌已抽取次数
          var giftedCardCount = GetLocalPlayer()<PlayerJionGame>.Gifted_Card_Count
          var currentCount = 0
          if giftedCardCount[cardId] != nil {
               currentCount = giftedCardCount[cardId]
          }
          // 判断卡牌是否已抽到过
          var isCardCollected = (currentCount > 0)  // 这个变量可以以后用于控制是否显示文字
          // 构建技能名称文本
          var skillNameText = giftedNameText
          // 构建技能描述文本
          var skillDescText = ""
          if isCardCollected {
               // 已抽到过的情况
               var skillNameTTT = LocString{translationText, List<string>{}}
               var Have = LocString{"HOLDING_QUANTITY", List<string>{}}
               var MaxTTT = LocString{"LIMIT_REACHED", List<string>{}}
               skillDescText = skillNameTTT
               // 获取最大抽取次数
               var maxCount = GetLocalPlayer()<PlayerJionGame>.GetMaxDrawCount(nature)
               // 添加持有数量信息
               if maxCount != 99999999 {
                    // 有最大限制的情况
                    skillDescText = skillDescText + "，" + Have + Convert.ToString(currentCount)
                    if currentCount >= maxCount {
                         skillDescText = skillDescText + MaxTTT
                    } else {
                         skillDescText = skillDescText + "/" + Convert.ToString(maxCount)
                    }
               } else {
                    // 无限制的情况
                    skillDescText = skillDescText + "，" + Have + Convert.ToString(currentCount)
               }
          } else {
               // 没有抽到过的情况
               skillNameText = ""
               skillDescText = ""
          }
          // 显示到UI
          UpdateCardDetailUI(skillNameText, skillDescText, rarity , MathValue)
     }
    
    // 更新卡牌详情UI显示
     func UpdateCardDetailUI(skillNameText string, skillDescText string, rarity int , MathValue string) {
          if skillNameText == "" && skillDescText == "" {
               // 如果名称和描述都是空，说明卡牌未解锁，直接返回
               return
          }
          // 技能描述文本面板
          var skillPanelWidget = GetWidgetByPath(GetLocalPlayer(), GetLocalPlayer()<PlayerJionGame>.GiftedUI, "/Panel/GiftIFMPanel/SubTitleCCCC")
          if skillPanelWidget != nil {
               skillPanelWidget<UIWidget>.IsVisible = true
          }

          // 技能名称文本控件
          var skillNameWidget = GetWidgetByPath(GetLocalPlayer(), GetLocalPlayer()<PlayerJionGame>.GiftedUI, "/Panel/GiftIFMPanel/SubTitleCCCC/GiftIFMTitle")
          if skillNameWidget != nil {
               // 直接使用翻译文本
               var skillNameTTT = LocString{skillNameText, List<string>{}}
               skillNameWidget<UIWidgetLabel>.Content = skillNameTTT
          }
          
          // 技能描述文本控件
          var skillDescWidget = GetWidgetByPath(GetLocalPlayer(), GetLocalPlayer()<PlayerJionGame>.GiftedUI, "/Panel/GiftIFMPanel/SubTitleCCCC/GiftIFMTitle/GiftIFMSubtitle")
          if skillDescWidget != nil {
               // 直接使用翻译文本
               var skillDescTTT = LocString{skillDescText, List<string>{MathValue}}
               skillDescWidget<UIWidgetLabel>.Content = skillDescTTT
          }
          
          // 显示详情面板
          var detailPanel = GetWidgetByPath(GetLocalPlayer(), GetLocalPlayer()<PlayerJionGame>.GiftedUI, "/Panel/GiftIFMPanel/SubTitleCCCC/GiftIFMTitle/GiftIFMSubtitle")
          if detailPanel != nil {
               detailPanel<UIWidget>.IsVisible = true
          }
     }

     // 隐藏详情面板
     func HideDetailPanel() {
          var skillPanelWidget = GetWidgetByPath(GetLocalPlayer(), GetLocalPlayer()<PlayerJionGame>.GiftedUI, "/Panel/GiftIFMPanel/SubTitleCCCC")
          if skillPanelWidget != nil {
               skillPanelWidget<UIWidget>.IsVisible = false
          }
          // 清空文本内容
          var skillNameWidget = GetWidgetByPath(GetLocalPlayer(), GetLocalPlayer()<PlayerJionGame>.GiftedUI, "/Panel/GiftIFMPanel/SubTitleCCCC/GiftIFMTitle")
          if skillNameWidget != nil {
               skillNameWidget<UIWidgetLabel>.Content = ""
          }
          var skillDescWidget = GetWidgetByPath(GetLocalPlayer(), GetLocalPlayer()<PlayerJionGame>.GiftedUI, "/Panel/GiftIFMPanel/SubTitleCCCC/GiftIFMTitle/GiftIFMSubtitle")
          if skillDescWidget != nil {
               skillDescWidget<UIWidgetLabel>.Content = ""
          }
     }
    
     // 关闭详情面板
     async func CloseDetailPanel(button entity<UIWidgetButton>, triggerPlayer entity<Player>) {
          SoundFunc.PlayCreatedSound("Click_Common_Default")

          var PopupPanel = GetWidgetByPath(GetLocalPlayer(), GetLocalPlayer()<PlayerJionGame>.GiftedUI, "/PopupPanel")
          PopupPanel<UIWidget>.IsVisible = false
          
          // 重置选中状态
          ResetSelection()
     }
}