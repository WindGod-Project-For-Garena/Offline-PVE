import "StdLibrary.fcc" as StdLib
import "EditorGenLib.fcc" as EditorLib
import "Player.fcc" as Player
import "../SoundFunc/SoundFunc.fcg" as SoundFunc
import "Hud.fcc" as Hud
import "Math.fcc" as Math
import "Camera.fcc" as Camera
import "Playable.fcc" as Playable
import "Animation.fcc" as Animation
import "../PlayerJionGame/PlayerJionGame.fcg" as PlayerJionGame


[platform_client]
graph ChoiceHero {
     //退出游戏
     func ToNewHome(button entity<UIWidgetButton>, triggerPlayer entity<Player>) {
          SoundFunc.PlayCreatedSound("Click_Common_Default")
          // SetPlayerCanQuitMidway(GetLocalPlayer()<PlayerJionGame>.currPlayer, true)
          QuitGameClient(true)
     }

     // 角色1的两个技能介绍详情
     func ShowHero1_Skill1_Detail(button entity<UIWidgetButton>, triggerPlayer entity<Player>) {
          SoundFunc.PlayCreatedSound("Click_Common_Default")

          var Skill1_Detail_Entity = GetWidgetByPath(GetLocalPlayer(), thisEntity as entity<CustomUI>, "/ChoiceHero/TextImage")
          Skill1_Detail_Entity<UIWidget>.IsVisible = true
          Skill1_Detail_Entity<UIWidget>.ActualPosition = Vector3{-140, -200,0} 
          // 技能名字
          var Skill1_Detail_TitleEntity = GetWidgetByPath(GetLocalPlayer(), thisEntity as entity<CustomUI>, "/ChoiceHero/TextImage/Title")
          var LocStrText1 = LocString{"SKILL_BOMBARD", List<string>{}}
          Skill1_Detail_TitleEntity<UIWidgetLabel>.Content = LocStrText1
          // 技能详情
          var Skill1_Detail_TEXTEntity = GetWidgetByPath(GetLocalPlayer(), thisEntity as entity<CustomUI>, "/ChoiceHero/TextImage/Title/Text")
          var LocStrText2 = LocString{"SKILL_BOMB_DESC", List<string>{}}
          Skill1_Detail_TEXTEntity<UIWidgetLabel>.Content = LocStrText2
     }
     
     func ShowHero1_Skill2_Detail(button entity<UIWidgetButton>, triggerPlayer entity<Player>) {
