          Skill1_Detail_Entity<UIWidget>.ActualPosition = Vector3{-10, -200,0}
          // 技能名字
          var Skill1_Detail_TitleEntity = GetWidgetByPath(GetLocalPlayer(), thisEntity as entity<CustomUI>, "/ChoiceHero/TextImage/Title")
          var LocStrText1 = LocString{"SKILL_GRENADE", List<string>{}}
          Skill1_Detail_TitleEntity<UIWidgetLabel>.Content = LocStrText1
          // 技能详情
          var Skill1_Detail_TEXTEntity = GetWidgetByPath(GetLocalPlayer(), thisEntity as entity<CustomUI>, "/ChoiceHero/TextImage/Title/Text")
          var LocStrText2 = LocString{"SKILL_GRENADE_DESC", List<string>{}}
          Skill1_Detail_TEXTEntity<UIWidgetLabel>.Content = LocStrText2
     }

