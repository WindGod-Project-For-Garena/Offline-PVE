     // 隐藏技能介绍详情
     func Hide_Skill_Detail(button entity<UIWidgetButton>, triggerPlayer entity<Player>) {
          var Skill1_Detail_Entity = GetWidgetByPath(GetLocalPlayer(), thisEntity as entity<CustomUI>, "/ChoiceHero/TextImage")
          Skill1_Detail_Entity<UIWidget>.IsVisible = false
     }
}