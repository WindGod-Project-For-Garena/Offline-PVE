import "StdLibrary.fcc" as StdLib
import "EditorGenLib.fcc" as EditorLib
import "Player.fcc" as Player
import "Hud.fcc" as Hud
import "Math.fcc" as Math
import "Camera.fcc" as Camera
import "Playable.fcc" as Playable
import "Animation.fcc" as Animation
import "../PlayerJionGame/PlayerJionGame.fcg" as PlayerJionGame


[platform_client]
graph HeroPanel {
    //前往选择角色开始游戏面板
     func ToNewHome(button entity<UIWidgetButton>, triggerPlayer entity<Player>) {
          var ChoiceHeroUIEntity = GetLocalPlayer()<PlayerJionGame>.ChoiceHeroUI
          ChoiceHeroUIEntity<CustomUI>.IsVisible = true
          var HeroUIEntity = GetLocalPlayer()<PlayerJionGame>.HeroUI
          HeroUIEntity<CustomUI>.IsVisible = false
     }

     //选择角色1
     func ToHero1(button entity<UIWidgetButton>, triggerPlayer entity<Player>) {
          var hero int = 1
          GetLocalPlayer()<PlayerJionGame>.InitAllCardBookUI(hero)
          var HeroEntity1 = GetWidgetByPath(GetLocalPlayer(), GetLocalPlayer()<PlayerJionGame>.HeroUI, "/HeroIFMPanel/HeroIFMPanel_1")
          var HeroEntity2 = GetWidgetByPath(GetLocalPlayer(), GetLocalPlayer()<PlayerJionGame>.HeroUI, "/HeroIFMPanel/HeroIFMPanel_2")
          HeroEntity1<UIWidget>.IsVisible = true
          HeroEntity2<UIWidget>.IsVisible = false
          // 按钮颜色
          var HeroButtonEntity1 = GetWidgetByPath(GetLocalPlayer(), GetLocalPlayer()<PlayerJionGame>.HeroUI, "/Hero1")
          var HeroButtonEntity2 = GetWidgetByPath(GetLocalPlayer(), GetLocalPlayer()<PlayerJionGame>.HeroUI, "/Hero2")
          HeroButtonEntity1<UIWidgetButton>.Color = #F8BC27
          HeroButtonEntity2<UIWidgetButton>.Color = #000000
          // 按钮文字颜色
          var HeroTextEntity1 = GetChildByName(HeroButtonEntity1, "Text")
          var HeroTextEntity2 = GetChildByName(HeroButtonEntity2, "Text")
          HeroTextEntity1<UIWidgetLabel>.Color = #000000
          HeroTextEntity2<UIWidgetLabel>.Color = #FFFFFFFF
     }

     //选择角色2
     func ToHero2(button entity<UIWidgetButton>, triggerPlayer entity<Player>) {
          var hero int = 2
          GetLocalPlayer()<PlayerJionGame>.InitAllCardBookUI(hero)
          var HeroEntity1 = GetWidgetByPath(GetLocalPlayer(), GetLocalPlayer()<PlayerJionGame>.HeroUI, "/HeroIFMPanel/HeroIFMPanel_1")
          var HeroEntity2 = GetWidgetByPath(GetLocalPlayer(), GetLocalPlayer()<PlayerJionGame>.HeroUI, "/HeroIFMPanel/HeroIFMPanel_2")
          HeroEntity1<UIWidget>.IsVisible = false
          HeroEntity2<UIWidget>.IsVisible = true
          // 按钮颜色
          var HeroButtonEntity1 = GetWidgetByPath(GetLocalPlayer(), GetLocalPlayer()<PlayerJionGame>.HeroUI, "/Hero1")
          var HeroButtonEntity2 = GetWidgetByPath(GetLocalPlayer(), GetLocalPlayer()<PlayerJionGame>.HeroUI, "/Hero2")
          HeroButtonEntity1<UIWidgetButton>.Color = #000000
          HeroButtonEntity2<UIWidgetButton>.Color = #F8BC27
          // 按钮文字颜色
          var HeroTextEntity1 = GetChildByName(HeroButtonEntity1, "Text")
          var HeroTextEntity2 = GetChildByName(HeroButtonEntity2, "Text")
          HeroTextEntity1<UIWidgetLabel>.Color = #FFFFFFFF
          HeroTextEntity2<UIWidgetLabel>.Color = #000000
     }
}