import "StdLibrary.fcc" as StdLib
import "EditorGenLib.fcc" as EditorLib

[platform_client]
static graph FC_Config {
    //Executed when entity is created
    MobPrefabIDs Map<string, EResPrefab> = Map<string, EResPrefab>{}
    CardRaritySprite Map<int, EResSprite> = Map<int, EResSprite>{}
    CardIconSprites Map<string, EResSprite> = Map<string, EResSprite>{}
    GiftedCardIDs Map<string, EResSprite> = Map<string, EResSprite>{}
    CardRarityColor Map<int, Color> = Map<int, Color>{}
    event OnAwake() {
        // 怪物预制体ID
        MobPrefabIDs = Map<string, EResPrefab>{
            "NormalZombie": EResPrefab.NormalZombie,
            "NormalZombie_Blue": EResPrefab.NormalZombie,
            "NormalZombie_Red": EResPrefab.NormalZombie,
            "GrenadeZombie": EResPrefab.GrenadeZombie,
            "GrenadeZombie_Red": EResPrefab.GrenadeZombie,
            "ShieldZombie": EResPrefab.ShieldZombie,
            "ShieldZombie_Gold": EResPrefab.ShieldZombie,
            "BossButcher": EResPrefab.BossButcher,
            "BossFlower": EResPrefab.BossFlower,
            "AxeZombie": EResPrefab.AxeZombie,
        }
        // 卡牌稀有度图标
        CardRaritySprite = Map<int, EResSprite>{
            0: EResSprite.FF_ingame_hud_RandomBuff_Grey,
            1: EResSprite.FF_ingame_hud_RandomBuff_Blue,
            2: EResSprite.FF_ingame_hud_RandomBuff_Purple,
            3: EResSprite.FF_ingame_hud_RandomBuff_Yellow,
        }

        // 卡牌稀有度颜色
        CardRarityColor = Map<int, Color>{
           0:#FFFFFF,
           1:#2C92C2,
           2:#9F34EA,
           3:#FFBA00,
        }

    
        // 技能卡牌图标
        CardIconSprites = Map<string, EResSprite>{
            "movespeed": EResSprite.MoveSpeed,
            "WeaponDamage": EResSprite.WeaponDamage,
            "LightningAmount": EResSprite.Skill_General,
            "SkillDamage": EResSprite.SkillDamage,
            "SkillAmount": EResSprite.Skill_General,
            "LightningRange": EResSprite.SkillRange,
            "LightningExplosion": EResSprite.Skill_General,
            "WeaponLightningProb": EResSprite.SkillProb,
            "ReloadBuff": EResSprite.Weapon_ReloadSpeed,
            "ReloadSpeed": EResSprite.Weapon_ReloadSpeed,
            "SkillCD": EResSprite.SkillCD,
            "ReloadNow": EResSprite.Weapon_ReloadSpeed,
            "WeaponMaxMagazine": EResSprite.Weapon_Maganize,
            "AttackSpeed": EResSprite.Weapon_AttackSpeed,
            "SkillRange": EResSprite.SkillRange,
            "SkillFireDamage": EResSprite.SkillDamage,
            "WeaponBoomRange": EResSprite.SkillRange,
            "WeaponBoomProbability": EResSprite.SkillProb,
            "WeaponDoubleBoom": EResSprite.Skill_General,
            "WeaponBoomDamage": EResSprite.SkillDamage,
        }

        // 天赋卡牌图标
        GiftedCardIDs = Map<string, EResSprite>{
            "SkillDamage": EResSprite.SkillDamage,
            "WeaponDamage": EResSprite.WeaponDamage,
            "HP": EResSprite.HP,
            "MoveSpeed": EResSprite.MoveSpeed,
        }
    }
}