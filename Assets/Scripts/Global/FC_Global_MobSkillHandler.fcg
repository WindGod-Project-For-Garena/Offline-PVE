import "StdLibrary.fcc" as StdLib
import "EditorGenLib.fcc" as EditorLib
import "List.fcc" as List
import "Map.fcc" as Map
import "Playable.fcc" as Playable
import "Animation.fcc" as Animation
import "Math.fcc" as Math
import "Combat.fcc" as Combat
import "Hud.fcc" as Hud
import "Offline.fcc" as Offline

[platform_client]
static graph FC_Global_MobSkillHandler {
    //Executed when entity is created
    event OnAwake() {

    }



   

    async func releaseSkill_GrenadeZombieNormalAttack(mob entity<Mob>,position Vector3,scale float) {
        LogInfo("releaseSkill_GrenadeZombieNormalAttack: position: " + position)
        var projectileEffect entity<Effect> = nil
        var skillEffect entity<Effect> = nil
        var projectileTween entity<Tween> = nil
        var skillAlphaTween entity<Tween> = nil

        var skillDamage int = mob<Mob>.Damage

        //var hitPlayerList List<entity<Player>> = List<entity<Player>>{}

        
		CreateEffectClient(out var effect2, VFXType.Trailing, LoopType.Once, false)
		projectileEffect = effect2 as entity<Effect>
		projectileEffect<Visibility>.IsVisible = false

		CreateTween(projectileEffect,Transform.Position,Vector3{0,0,0},
			Vector3{0,0,0},TweenStyle.Once,CreateCurve({0.25, 0.1, 0.25, 1}),800,out var tweenEntity,false)
		projectileTween = tweenEntity

		CreateFromPrefab(out var onGroundEffect,EResPrefab.SkillEffect_GrenadeZombie)
		skillEffect = onGroundEffect as entity<Effect>
		skillEffect<Visibility>.IsVisible = false
        skillEffect<Transform>.Scale = Vector3{scale*1.7,scale*0.4,scale*1.7}

		CreateTween(skillEffect,Effect.DiffuseAlpha,0,1,TweenStyle.Once,CreateCurve({0.25, 0.1, 0.25, 1}),1000,out var tweenEntity2,false)
		skillAlphaTween = tweenEntity2

    
        projectileEffect<Effect>.Color = #1c6b1e
        skillEffect<Effect>.Color = #1c6b1e

        skillEffect<Effect>.DiffuseAlpha = 100
        projectileEffect<Visibility>.IsVisible = true

        projectileTween<Tween>.StartValue = mob<Transform>.Position + Vector3{0,1.2,0}

        projectileTween<Tween>.EndValue = position
        Play(projectileTween,true)

        //隐藏Warning特效
        WaitForMillisecond(800)
        //Destroy(warningEffect as entity<Entity>)
        Destroy(projectileEffect as entity<Entity>)

        //显示技能特效
        skillEffect<Visibility>.IsVisible = true
        skillEffect<Transform>.Position = position
        Play(skillEffect,true)


        //检测技能特效是否命中目标
        for i, player in GetAllPlayers() {
            if (Math.Distance(player<Player>.Position, position) <= scale) {
                Offline.DealDamage(player as entity<Combatable>, nil, DamageType.Monster, skillDamage)
            }
        }
        
        WaitForMillisecond(1000)
        //隐藏技能特效
        skillAlphaTween<Tween>.StartValue = 100
        skillAlphaTween<Tween>.EndValue = 0
        Play(skillAlphaTween,true)

        WaitForMillisecond(1000)
        Destroy(skillEffect as entity<Entity>)
        Destroy(skillAlphaTween as entity<Entity>)
        Destroy(projectileTween as entity<Entity>)


    }
    //火焰版本
    async func releaseSkill_GrenadeZombieNormalAttack2(mob entity<Mob>,position Vector3,scale float) {
        var projectileEffect entity<Effect> = nil
        var skillEffect entity<Effect> = nil
        var projectileTween entity<Tween> = nil
        var skillAlphaTween entity<Tween> = nil

        var dotDamageScale float = 0.5

        var skillFogEffect entity<Effect> = nil
        var skillFogTween entity<Tween> = nil

        var skillDamage int = mob<Mob>.Damage

        //var hitPlayerList List<entity<Player>> = List<entity<Player>>{}

        
		CreateEffectClient(out var effect2, VFXType.Trailing, LoopType.Once, false)
		projectileEffect = effect2 as entity<Effect>
		projectileEffect<Visibility>.IsVisible = false

		CreateTween(projectileEffect,Transform.Position,Vector3{0,0,0},
			Vector3{0,0,0},TweenStyle.Once,CreateCurve({0.25, 0.1, 0.25, 1}),800,out var tweenEntity,false)
		projectileTween = tweenEntity

		CreateFromPrefab(out var onGroundEffect,EResPrefab.SkillEffect_GrenadeZombie)
		skillEffect = onGroundEffect as entity<Effect>
		skillEffect<Visibility>.IsVisible = false
        skillEffect<Transform>.Scale = Vector3{scale*1.7,scale*0.2,scale*1.7}

        skillFogEffect = GetChildByIndex(skillEffect,0) as entity<Effect>
        

		CreateTween(skillEffect,Effect.DiffuseAlpha,100,0,TweenStyle.Once,CreateCurve({0.25, 0.1, 0.25, 1}),1000,out var tweenEntity2,false)
		skillAlphaTween = tweenEntity2

        CreateTween(skillFogEffect,Effect.DiffuseAlpha,100,0,TweenStyle.Once,CreateCurve({0.25, 0.1, 0.25, 1}),1000,out var tweenEntity3,false)
        skillFogTween = tweenEntity3
       
        projectileEffect<Effect>.Color = #B52222
        skillEffect<Effect>.Color = #B52222
        
        skillEffect<Effect>.DiffuseAlpha = 100
        projectileEffect<Visibility>.IsVisible = true
        projectileTween<Tween>.StartValue = mob<Transform>.Position + Vector3{0,1.2,0}


        projectileTween<Tween>.EndValue = position
        Play(projectileTween,true)

        //隐藏Warning特效
        WaitForMillisecond(800)
        //Destroy(warningEffect as entity<Entity>)
        Destroy(projectileEffect as entity<Entity>)

        //显示技能特效
        skillEffect<Visibility>.IsVisible = true
        skillEffect<Transform>.Position = position
        skillFogEffect<Visibility>.IsVisible = true
        skillFogEffect<Transform>.Position = position - Vector3{0,0.5*scale,0}
        Play(skillEffect,true)


        //检测技能特效是否命中目标
        for i, player in GetAllPlayers() {
            if (Math.Distance(player<Player>.Position, position) <= scale) {
                Offline.DealDamage(player as entity<Combatable>, nil, DamageType.Monster, skillDamage)
            }
        }

        //2次额外伤害判断
        WaitForMillisecond(1000)
        for i, player in GetAllPlayers() {
            if (Math.Distance(player<Player>.Position, position) <= scale) {
                Offline.DealDamage(player as entity<Combatable>, nil, DamageType.Monster, Floor(1.0*skillDamage*dotDamageScale))
            }
        }   
        WaitForMillisecond(1000)
        for i, player in GetAllPlayers() {
            if (Math.Distance(player<Player>.Position, position) <= scale) {
                Offline.DealDamage(player as entity<Combatable>, nil, DamageType.Monster, Floor(1.0*skillDamage*dotDamageScale))
            }
        }   

        WaitForMillisecond(1000)
        //隐藏技能特效
        Play(skillAlphaTween,true)
        Play(skillFogTween,true)
        

        WaitForMillisecond(1000)
        Destroy(skillEffect as entity<Entity>)
        Destroy(skillAlphaTween as entity<Entity>)
        Destroy(projectileTween as entity<Entity>)


    }


    async func releaseSkill_ShieldZombieAOEAttack(mob entity<Mob>)  {
        var Range1 float = 15.0
		var Range2 float = 20.0
		var Range3 float = 25.0
		var time1 int = 1500
		var time2 int = 2800
		var time3 int = 3900
		var pos = mob<Transform>.Position
		pos.Y = -0.2

        var skillDamage int = mob<Mob>.Damage
        var damageScale1 float = 0.5
        var damageScale2 float = 1
        var damageScale3 float = 1.5


        var explosionEffect entity<Effect> = nil
        var areaEffect entity<Effect> = nil



        //Offline.DealDamage(target as entity<Combatable>, nil, DamageType.Monster, Math.Ceil(1.5*GetDamage() )) // 技能双倍伤害
					
        


		//1轮伤害判断
		WaitForMillisecond(time1)
        //判断是否活着
        if (mob<Mob>.HP >= 0) {
            CreateFromPrefab(out var effectEntity,EResPrefab.ShieldZombie_AOE)
            explosionEffect = effectEntity as entity<Effect>
            areaEffect = GetChildByIndex(effectEntity,0) as entity<Effect>

            //设置爆炸特效和区域特效的缩放
		    explosionEffect<Transform>.Scale = Vector3{Range1,Range1,Range1}

            //设置爆炸特效和区域特效的位置为怪物位置
		    explosionEffect<Transform>.Position = pos
            Play(explosionEffect,true)
            Play(areaEffect,true)      
            
            var players = getPlayersInRange(pos,Range1)
            for i, player in players {
                Offline.DealDamage(player as entity<Combatable>, mob as entity<Combatable>, DamageType.Monster, Floor(damageScale1*skillDamage))
            }

        }else{
            return
        }


		//2轮伤害判断
		WaitForMillisecond(time2-time1)
		if (mob<Mob>.HP >= 0) {
			explosionEffect<Transform>.Scale = Vector3{Range2,Range2,Range2}
            Play(explosionEffect,true)
            Play(areaEffect,true)
            var players = getPlayersInRange(pos,Range2)
            for i, player in players {
                Offline.DealDamage(player as entity<Combatable>, mob as entity<Combatable>, DamageType.Monster, Floor(damageScale2*skillDamage))
            }
		}else{
            Destroy(explosionEffect)
            return
		}

        //3轮伤害判断
        WaitForMillisecond(time3-time2)
        if (mob<Mob>.HP >= 0) {
            explosionEffect<Transform>.Scale = Vector3{Range3,Range3,Range3}
            Play(explosionEffect,true)
            Play(areaEffect,true)
            var players = getPlayersInRange(pos,Range3)
            for i, player in players {
                Offline.DealDamage(player as entity<Combatable>, mob as entity<Combatable>, DamageType.Monster, Floor(damageScale3*skillDamage))
            }
        }else{
            Destroy(explosionEffect)
            return
        }

		WaitForMillisecond(1500)
		Destroy(explosionEffect)
		
         
     }
    //————————————————————————————————————————————————————————————————————————————————//
    //盾牌僵尸特效处理程序
    async func DisplayWarningSquare(position Vector3,rotation Vector3,length float,width float,duration int) {
        CreateEffectClient(out var WarningEffect, VFXType.Spawnpoint, LoopType.Once, false)
       WarningEffect<Transform>.Position = position
       WarningEffect<Transform>.Rotation = rotation
		// 设置特效缩放
		WarningEffect<Transform>.Scale = Vector3{length, 0.02, width}
		// 设置特效颜色
		WarningEffect<Effect>.Color = #FF0000
        WarningEffect<Effect>.DiffuseAlpha = 20
		// 等待1秒
		WaitForMillisecond(duration)
		// Destroy(tweenEntity)
		Destroy(WarningEffect)
    }

     //这个方程只给某个怪物创建
     async func DisplayWarningCircle(position Vector3,scale float,duration int)  {
        // LogInfo("displayWarningEffect scale: " + scale)
         CreateCustomUIClient(out var warningEffect,EResUI.WarningEffect)
         warningEffect<CustomUI>.InScene = true
         warningEffect<CustomUI>.WorldPosition = position
         warningEffect<CustomUI>.Rotation = Vector3{90,0,0}
         warningEffect<CustomUI>.Scale = Vector3{scale*1.5,scale*1.5,scale*1.5}
         var image_center entity<UIWidget> = GetWidgetFromCustomUI(nil, warningEffect, EResUIWarningEffect.Image_center)
         CreateTween(image_center,UIWidget.SizeDelta,Vector2{0,0},Vector2{Math.Ceil(scale*250),
             Math.Ceil(scale*250)},TweenStyle.Once,CreateCurve({0.25, 0.1, 0.25, 1}),duration,out var tweenEntity,true)
 
 
         WaitForMillisecond(duration)
         Destroy(warningEffect as entity<Entity>)
         Destroy(tweenEntity as entity<Entity>)
         
     }

     func getPlayersInRange(position Vector3,range float) List<entity<Player>> {
        var players List<entity<Player>> = List<entity<Player>>{}
        for i, player in GetAllPlayers() {
            if (Math.Distance(player<Player>.Position, position) <= range) {
                List.Append(players, player)
            }
        }
        return players
     }

}