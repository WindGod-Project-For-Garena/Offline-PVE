[platform_client]
static graph FC_Global_MobSkillHandler {
    //Executed when entity is created
    event OnAwake() {

    }



   

    async func releaseSkill_GrenadeZombieNormalAttack(mob entity<Mob>,position Vector3,scale float) {
        //LogInfo("releaseSkill_GrenadeZombieNormalAttack: position: " + position)
        var projectileEffect entity<Effect> = nil
        var skillEffect entity<Effect> = nil
        var projectileTween entity<Tween> = nil
        var skillAlphaTween entity<Tween> = nil

        var skillDamage int = mob<Mob>.Damage

        //var hitPlayerList List<entity<Player>> = List<entity<Player>>{}

        
		CreateEffectClient(out var effect2, VFXType.Trailing, LoopType.Once, false)
		projectileEffect = effect2 as entity<Effect>
		projectileEffect<Visibility>.IsVisible = false

		CreateTween(projectileEffect,Transform.Position,Vector3{0,0,0},
			Vector3{0,0,0},TweenStyle.Once,CreateCurve({0.25, 0.1, 0.25, 1}),800,out var tweenEntity,false)
		projectileTween = tweenEntity

		CreateFromPrefab(out var onGroundEffect,EResPrefab.SkillEffect_GrenadeZombie)
		skillEffect = onGroundEffect as entity<Effect>
		skillEffect<Visibility>.IsVisible = false
        skillEffect<Transform>.Scale = Vector3{scale*1.7,scale*0.4,scale*1.7}

		CreateTween(skillEffect,Effect.DiffuseAlpha,0,1,TweenStyle.Once,CreateCurve({0.25, 0.1, 0.25, 1}),1000,out var tweenEntity2,false)
		skillAlphaTween = tweenEntity2

    
        projectileEffect<Effect>.Color = #1c6b1e
        skillEffect<Effect>.Color = #1c6b1e

        skillEffect<Effect>.DiffuseAlpha = 100
        projectileEffect<Visibility>.IsVisible = true

        projectileTween<Tween>.StartValue = mob<Transform>.Position + Vector3{0,1.2,0}

        projectileTween<Tween>.EndValue = position
        Play(projectileTween,true)

        //隐藏Warning特效
        WaitForMillisecond(800)
        //Destroy(warningEffect as entity<Entity>)
        Destroy(projectileEffect as entity<Entity>)

        //显示技能特效
        skillEffect<Visibility>.IsVisible = true
        skillEffect<Transform>.Position = position
        Play(skillEffect,true)


        //检测技能特效是否命中目标
        for i, player in GetAllPlayers() {
            if (Math.Distance(player<Player>.Position, position) <= scale) {
                Offline.DealDamage(player as entity<Combatable>, nil, DamageType.Monster, skillDamage)
            }
        }
        
        WaitForMillisecond(1000)
        //隐藏技能特效
        skillAlphaTween<Tween>.StartValue = 100
        skillAlphaTween<Tween>.EndValue = 0
        Play(skillAlphaTween,true)

        WaitForMillisecond(1000)
        Destroy(skillEffect as entity<Entity>)
        Destroy(skillAlphaTween as entity<Entity>)
        Destroy(projectileTween as entity<Entity>)


    }
    //火焰版本
    async func releaseSkill_GrenadeZombieNormalAttack2(mob entity<Mob>,position Vector3,scale float) {
        var projectileEffect entity<Effect> = nil
        var skillEffect entity<Effect> = nil
        var projectileTween entity<Tween> = nil
        var skillAlphaTween entity<Tween> = nil

        var dotDamageScale float = 0.5

        var skillFogEffect entity<Effect> = nil
        var skillFogTween entity<Tween> = nil

        var skillDamage int = mob<Mob>.Damage

        //var hitPlayerList List<entity<Player>> = List<entity<Player>>{}

        
		CreateEffectClient(out var effect2, VFXType.Trailing, LoopType.Once, false)
		projectileEffect = effect2 as entity<Effect>
		projectileEffect<Visibility>.IsVisible = false

		CreateTween(projectileEffect,Transform.Position,Vector3{0,0,0},
			Vector3{0,0,0},TweenStyle.Once,CreateCurve({0.25, 0.1, 0.25, 1}),800,out var tweenEntity,false)
		projectileTween = tweenEntity

		CreateFromPrefab(out var onGroundEffect,EResPrefab.SkillEffect_GrenadeZombie)
		skillEffect = onGroundEffect as entity<Effect>
		skillEffect<Visibility>.IsVisible = false
        skillEffect<Transform>.Scale = Vector3{scale*1.7,scale*0.2,scale*1.7}

        skillFogEffect = GetChildByIndex(skillEffect,0) as entity<Effect>
        

		CreateTween(skillEffect,Effect.DiffuseAlpha,100,0,TweenStyle.Once,CreateCurve({0.25, 0.1, 0.25, 1}),1000,out var tweenEntity2,false)
		skillAlphaTween = tweenEntity2

        CreateTween(skillFogEffect,Effect.DiffuseAlpha,100,0,TweenStyle.Once,CreateCurve({0.25, 0.1, 0.25, 1}),1000,out var tweenEntity3,false)
        skillFogTween = tweenEntity3
       
        projectileEffect<Effect>.Color = #B52222
        skillEffect<Effect>.Color = #B52222
        
        skillEffect<Effect>.DiffuseAlpha = 100
        projectileEffect<Visibility>.IsVisible = true
        projectileTween<Tween>.StartValue = mob<Transform>.Position + Vector3{0,1.2,0}


        projectileTween<Tween>.EndValue = position
        Play(projectileTween,true)

        //隐藏Warning特效
        WaitForMillisecond(800)
        //Destroy(warningEffect as entity<Entity>)
        Destroy(projectileEffect as entity<Entity>)

        //显示技能特效
        skillEffect<Visibility>.IsVisible = true
        skillEffect<Transform>.Position = position
        skillFogEffect<Visibility>.IsVisible = true
        skillFogEffect<Transform>.Position = position - Vector3{0,0.5*scale,0}
        Play(skillEffect,true)


        //检测技能特效是否命中目标
        for i, player in GetAllPlayers() {
            if (Math.Distance(player<Player>.Position, position) <= scale) {
                Offline.DealDamage(player as entity<Combatable>, nil, DamageType.Monster, skillDamage)
            }
        }

        //2次额外伤害判断
        WaitForMillisecond(1000)
        for i, player in GetAllPlayers() {
            if (Math.Distance(player<Player>.Position, position) <= scale) {
                Offline.DealDamage(player as entity<Combatable>, nil, DamageType.Monster, Floor(1.0*skillDamage*dotDamageScale))
            }
        }   
        WaitForMillisecond(1000)
        for i, player in GetAllPlayers() {
            if (Math.Distance(player<Player>.Position, position) <= scale) {
                Offline.DealDamage(player as entity<Combatable>, nil, DamageType.Monster, Floor(1.0*skillDamage*dotDamageScale))
            }
        }   

        WaitForMillisecond(1000)
        //隐藏技能特效
        Play(skillAlphaTween,true)
        Play(skillFogTween,true)
        

        WaitForMillisecond(1000)
        Destroy(skillEffect as entity<Entity>)
        Destroy(skillAlphaTween as entity<Entity>)
        Destroy(projectileTween as entity<Entity>)


    }


    async func releaseSkill_ShieldZombieAOEAttack(mob entity<Mob>)  {
        var Range1 float = 10.0
		var Range2 float = 15.0
		var Range3 float = 20.0
		var time1 int = 1500
		var time2 int = 2800
		var time3 int = 3900
		var pos = mob<Transform>.Position
		pos = SetYClient(pos,-0.2)

        var skillDamage int = mob<Mob>.Damage
        var damageScale1 float = 0.5
        var damageScale2 float = 1
        var damageScale3 float = 1.5


        var explosionEffect entity<Effect> = nil
        var areaEffect entity<Effect> = nil



        //Offline.DealDamage(target as entity<Combatable>, nil, DamageType.Monster, Math.Ceil(1.5*GetDamage() )) // 技能双倍伤害
		//1轮伤害判断
		WaitForMillisecond(time1-500)
        //判断是否活着
        if (mob<Mob>.HP >= 0) {
            CreateFromPrefab(out var effectEntity,EResPrefab.ShieldZombie_AOE)
            explosionEffect = effectEntity as entity<Effect>
            areaEffect = GetChildByIndex(effectEntity,0) as entity<Effect>

            //设置爆炸特效和区域特效的缩放
		    explosionEffect<Transform>.Scale = Vector3{Range1,Range1,Range1}

            //设置爆炸特效和区域特效的位置为怪物位置
		    explosionEffect<Transform>.Position = pos
            Play(explosionEffect,true)
            Play(areaEffect,true)      
            var realRange = 0.5*Range1

            WaitForMillisecond(500)
            if (mob<Mob>.HP >= 0) {
                var players = getPlayersInRange(pos,realRange)
                for i, player in players {
                    Offline.DealDamage(player as entity<Combatable>, mob as entity<Combatable>, DamageType.Monster, Floor(damageScale1*skillDamage))
                }
            }

        }else{
            return
        }


		//2轮伤害判断
		WaitForMillisecond(time2-time1-500)
		if (mob<Mob>.HP >= 0) {
			explosionEffect<Transform>.Scale = Vector3{Range2,Range2,Range2}
            Play(explosionEffect,true)
            Play(areaEffect,true)
            var realRange = 0.5*Range2
            WaitForMillisecond(500)
            if (mob<Mob>.HP >= 0) {
                var players = getPlayersInRange(pos,realRange)
                for i, player in players {
                    Offline.DealDamage(player as entity<Combatable>, mob as entity<Combatable>, DamageType.Monster, Floor(damageScale2*skillDamage))
                }
            }
		}else{
            Destroy(explosionEffect)
            return
		}

        //3轮伤害判断
        WaitForMillisecond(time3-time2-500)
        if (mob<Mob>.HP >= 0) {
            explosionEffect<Transform>.Scale = Vector3{Range3,Range3,Range3}
            Play(explosionEffect,true)
            Play(areaEffect,true)
            var realRange = 0.5*Range3
            WaitForMillisecond(500)
            if (mob<Mob>.HP >= 0) {
                var players = getPlayersInRange(pos,realRange)
                for i, player in players {
                    Offline.DealDamage(player as entity<Combatable>, mob as entity<Combatable>, DamageType.Monster, Floor(damageScale3*skillDamage))
                }
            }
        }else{
            Destroy(explosionEffect)
            return
        }

		WaitForMillisecond(1500)
		Destroy(explosionEffect)
		
         
     }
    //FBoss钻地攻击
    async func releaseSkill_FlowerBossDrillAttack(mob entity<Mob>,target entity<Player>) {
        var curTarget = target
        var direction Vector3 = Normalize(curTarget<Player>.Position - mob<Transform>.Position)
        direction = SetYClient(direction,0)
        var centerPos Vector3 = mob<Transform>.Position
        centerPos = SetYClient(centerPos,-0.2)
        
    }

     
    //————————————————————————————————————————————————————————————————————————————————//
    //Flowerboss射击攻击

    //Flowerboss连射攻击
    async func releaseSkill_FlowerBossBigShootAttack(mob entity<Mob>,target entity<Player>) {
        var randRange float = 2.0
		var curTarget = target

        var optionIndex int = 0
        optionIndex = RandomInt(0, 2)
        //距离大于7则使用0
        if (Math.Distance(mob<Transform>.Position, curTarget<Player>.Position) > 8) {
            optionIndex = 0
        }
        if (optionIndex == 0) {
            //循环7个随机点位
            var interval int = 500
            for i = 0,7,1 {
                if (mob<Mob>.HP <= 0) {
                    return
                }
                var centerPos Vector3 = curTarget<Player>.Position
                centerPos = SetYClient(centerPos,-0.2)
                //获取随机点位
                var randPos Vector3 = centerPos + Vector3{RandomFloat(-randRange, randRange), 0, RandomFloat(-randRange, randRange)}
                randPos = SetYClient(randPos,-0.2)
                var dist = Distance(randPos, centerPos)
                var direction = Normalize(randPos - centerPos)
                //中心朝向打射线,打到射线为墙壁则返回墙前的点位
                SingleRaycast(centerPos + Vector3{0,0.5,0}, direction, dist, List<int>{0}, false, out var hitEntities, out var hitPoint, out var hitDistances, out var hitNormals)
                if hitEntities != nil {
                    //LogInfo("hitEntities: "+hitEntities)
                    randPos = hitPoint - direction * 0.5
                    randPos = SetYClient(randPos,-0.2)
                }
                //LogInfo("after randPos: " + randPos)
                start releaseSkill_FlowerBossShootAttack(mob as entity<Mob>,randPos,2)
                WaitForMillisecond(interval)
            }
        }else if (optionIndex == 1) {
            //循环5次渐进扇形点位，每次3个，离怪物朝目标方向,距离递增，角度为-30到30度
            var interval int = 800
            var direction Vector3 = Normalize(curTarget<Player>.Position - mob<Transform>.Position)
            direction = SetYClient(direction,0)
            var centerPos Vector3 = mob<Transform>.Position
            var distanceIncrement float = 3.0
            centerPos = SetYClient(centerPos,-0.2)
            var direction1 Vector3 = RotateVector(direction,Quaternion{0, 0.2164, 0,0.9763})
            var direction2 Vector3 = RotateVector(direction,Quaternion{0, -0.2164, 0,0.9763})

            for i = 1,6,1 {
                if (mob<Mob>.HP <= 0) {
                    return
                }
                LogInfo("i: " + i)
                // var w = Math.Cos(angle/2)
                // var y = Math.Sin(angle/2)


                //三维空间，要计算3个点位，中心到目标方向偏移30度的方向固定距离，以及偏移-30度方向

                var point1 Vector3 = centerPos + direction * distanceIncrement*i
                var point2 Vector3 = centerPos + direction1 * distanceIncrement*i
                var point3 Vector3 = centerPos + direction2 * distanceIncrement*i
                //LogInfo("after randPos: " + randPos)
                start releaseSkill_FlowerBossShootAttack(mob as entity<Mob>,point1,2)
                start releaseSkill_FlowerBossShootAttack(mob as entity<Mob>,point2,2)
                start releaseSkill_FlowerBossShootAttack(mob as entity<Mob>,point3,2)
                WaitForMillisecond(interval)
            }
        }

		

		

    }

    //Flowerboss射击攻击
    async func releaseSkill_FlowerBossShootAttack(mob entity<Mob>,position Vector3,scale float) {
        var castingTime int = 1150
        var dropTime int = 1000
        var skillDamage int = mob<Mob>.Damage

        //球特效创建
        CreateFromPrefab(out var ballEffect,EResPrefab.SkillEffect_FBoss_Ball)
        var offset Vector3 = Vector3{0,5,0}

        
        //显示警告圈
        start DisplayWarningCircle(position,scale,castingTime+dropTime)

        //球出现：设置位置和渐显Tween
        start Local_displayBallEffect(ballEffect as entity<Effect>,position,offset,castingTime)

         WaitForMillisecond(castingTime)
        if (mob<Mob>.HP >= 0) {
            //球特效下落
            start Local_ballDropping(ballEffect as entity<Effect>,position,offset,dropTime,scale,skillDamage) 
        }else{
            WaitForMillisecond(3000)
            Destroy(ballEffect as entity<Entity>)
           
        }

        
    }
    



    //处理球特效出现
    async func Local_displayBallEffect(ballEffect entity<Effect>,position Vector3,offset Vector3, castingTime int) {
        ballEffect<Transform>.Position = position + offset
        CreateTween(ballEffect,Transform.Scale,Vector3{0,0,0},Vector3{1,1,1},TweenStyle.Once,CreateCurve({0.25, 0.1, 0.25, 1}),castingTime,out var tweenEntity,false)
        Play(tweenEntity,true)
        CreateTween(ballEffect,Effect.DiffuseAlpha,0,100,TweenStyle.Once,CreateCurve({0.25, 0.1, 0.25, 1}),castingTime,out var tweenEntity2,false)
        Play(tweenEntity2,true)
        WaitForMillisecond(3000)
        Destroy(tweenEntity as entity<Entity>)
        Destroy(tweenEntity2 as entity<Entity>)
       
    }
    //处理球特效下落
    async func Local_ballDropping(ballEffect entity<Effect>,position Vector3,offset Vector3, dropTime int,scale float,skillDamage int) {
        var explosionEffect entity<Effect> = nil
        
        CreateTween(ballEffect,Transform.Position,position + offset,position - Vector3{0, 0.2, 0},TweenStyle.Once,CreateCurve({0.25, 0.1, 0.25, 1}),dropTime,out var tweenEntity3,false)
        var posTween entity<Tween> = tweenEntity3
        Play(posTween,true)

        WaitForMillisecond(dropTime)

        Destroy(ballEffect as entity<Entity>)
        CreateFromPrefab(out var eEffect,EResPrefab.SkillEffect_FBoss_Explosion)
        explosionEffect = eEffect as entity<Effect>
        explosionEffect<Transform>.Position = position
        explosionEffect<Transform>.Scale = Vector3{scale,scale,scale}
       

        var players = getPlayersInRange(position,scale)
        for i, player in players {
            Offline.DealDamage(player as entity<Combatable>, nil, DamageType.Monster, skillDamage)
        }

    }

    //Flowerboss射击攻击结束
    //————————————————————————————————————————————————————————————————————————————————//
    
    async func releaseSkill_ButcherBossSlash(mob entity<Mob>, tarPos Vector3) {
        var skillRange float = 10.0        //冲击距离
		var speed float = 10.0            //冲击速度
		var warningDuration int = 1600  // 毫秒
		var warningLength float = 15.0
		var warningWidth float = 2.5
        var currPos Vector3 = mob<Transform>.Position
        var damage int = mob<Mob>.Damage
       

		var direction = Normalize(tarPos - currPos)
        direction = SetYClient(direction,0)


        var realTragePos = currPos + direction * (1+warningLength)
        var realStartPos = currPos + direction * 1

        var effectOffset float = warningLength/2+1 // 特效在怪物前方的偏移距离
		var effectPos = mob<Transform>.Position + mob<Transform>.Forward * effectOffset
		effectPos = SetYClient(effectPos,-0.2)

		var rotation Vector3 = mob<Transform>.Rotation + Vector3{0, 90, 0}


		// 地面播放开始时的预警特效
        start skill_ButcherBoss_CreateHandsUpEffect(currPos)
		start DisplayWarningSquare(effectPos, rotation,warningLength, warningWidth, warningDuration)
        WaitForMillisecond(warningDuration)

        //开始创建技能
        if (mob<Mob>.HP >= 0) {
            CreateFromPrefab(out var skillEffect, EResPrefab.SkillEffect_ButcherBoss_Slash3)
            var trigger = GetChildByIndex(GetChildByIndex(skillEffect,0),0)
            trigger<Trigger_ButherBossSlashEffect>._damage = damage

            var duration float= skillRange/speed*1000
            LogInfo("duration: " + duration)
            // 创建移动tween
            CreateTween(
                skillEffect,
                Transform.Position,
                realStartPos,
                realTragePos,
                TweenStyle.Once,
                CreateCurve({0, 0, 1, 1}),
                duration,
                out var tweenEntity,
                true,
            )
            // 设置碰撞检测 - 使用start启动异步函数
            //检测碰撞
            WaitForMillisecond(Floor(duration))
            Destroy(skillEffect)
            Destroy(tweenEntity)
        }else{
            return
        }
	}


    //冲击波击中玩家后
    async func skill_ButcherBoss_OnBallEffectHitPlayer(damage int,effect entity,player entity<Player>) {
        var position = effect<Transform>.Position
        Destroy(effect)
        //创建爆炸特效
        //CreateFromPrefab(out var explosionEffect,EResPrefab.SkillEffect_ButcherBoss_Slash1)
        //explosionEffect<Transform>.Position = position
        Offline.DealDamage(player as entity<Combatable>, nil, DamageType.Monster, damage)
        // WaitForMillisecond(3000)
        // Destroy(explosionEffect)

    }
    async func skill_ButcherBoss_CreateHandsUpEffect(position Vector3) {
        CreateFromPrefab(out var explosionEffect,EResPrefab.SkillEffect_ButcherBoss_Slash1)
        explosionEffect<Transform>.Position = position
        WaitForMillisecond(3000)
        Destroy(explosionEffect)
    }


    //————————————————————————————————————————————————————————————————————————————————//
    //盾牌僵尸特效处理程序
    async func DisplayWarningSquare(position Vector3,rotation Vector3,length float,width float,duration int) {
        
        CreateEffectClient(out var WarningEffect, VFXType.Spawnpoint, LoopType.Once, false)
        WarningEffect<Transform>.Position = position
        WarningEffect<Transform>.Rotation = rotation
		// 设置特效缩放
		WarningEffect<Transform>.Scale = Vector3{length, 0.02, width}
		// 设置特效颜色
		WarningEffect<Effect>.Color = #FF0000
        WarningEffect<Effect>.DiffuseAlpha = 20
		// 等待1秒
		WaitForMillisecond(duration)
		// Destroy(tweenEntity)
		Destroy(WarningEffect)
    }

     //这个方程只给某个怪物创建
     async func DisplayWarningCircle(position Vector3,radius float,duration int)  {
       // LogInfo("DisplayWarningSquare position: " + position)
        //这里头圈填满的时间和圈的大小有点问题
        //LogInfo("displayWarningEffect scale: " + scale)
        //LogInfo("DisplayWarningCircle duration: " + duration)
         CreateCustomUIClient(out var warningEffect,EResUI.WarningEffect)
         warningEffect<CustomUI>.InScene = true
         warningEffect<CustomUI>.WorldPosition = position
         warningEffect<CustomUI>.Rotation = Vector3{90,0,0}


         warningEffect<CustomUI>.Scale = Vector3{radius*1.5,radius*1.5,radius*1.5}
         var image_center entity<UIWidget> = GetWidgetFromCustomUI(nil, warningEffect, EResUIWarningEffect.Image_center)
         CreateTween(image_center,UIWidget.SizeDelta,Vector2{0,0},Vector2{Math.Ceil(375),
             Math.Ceil(375)},TweenStyle.Once,CreateCurve({0.25, 0.1, 0.25, 1}),duration,out var tweenEntity,true)
 
 
         WaitForMillisecond(duration)
         Destroy(warningEffect as entity<Entity>)
         Destroy(tweenEntity as entity<Entity>)
         
     }


     func getPlayersInRange(position Vector3,range float) List<entity<Player>> {
        var players List<entity<Player>> = List<entity<Player>>{}
        for i, player in GetAllPlayers() {
            if (Math.Distance(player<Player>.Position, position) <= range) {
                List.Append(players, player)
            }
        }
        return players
     }

}