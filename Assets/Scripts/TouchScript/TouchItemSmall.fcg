import "StdLibrary.fcc" as StdLib
import "EditorGenLib.fcc" as EditorLib
import "LevelObject.fcc" as LevelObject
import "../PlayerJionGame/PlayerJionGame.fcg" as PlayerJionGame
import "../PVE/FC_PVEMonsterManager.fcg" as FC_PVEMonsterManager
import "Math.fcc" as Math
import "Items.fcc" as Items

[platform_client]
graph TouchItem {
    event OnPlayerEnter(player entity<Player>) { 
        LogInfo(thisEntity<Transform>.Parent)
        var ITEMSmall = thisEntity<Transform>.Parent
        // 启动buff计时（防止重复启动）
        if !GetLocalPlayer()<PlayerJionGame>.buffTimerRunning {
            start GetLocalPlayer()<PlayerJionGame>.BuffTimerLoop()
        }
        // 应用妙妙道具效果
        start Effect_ITEM_Giving(player, ITEMSmall)
    }

    // 妙妙道具效果实现
    async func Effect_ITEM_Giving(player entity<Player>, ITEMSmall entity) {
        // 判断是哪个效果
        var buff = GetChildren(ITEMSmall)
        var light = GetChildren(buff[0])
        var ICON = light[0] as entity<LevelObject>
        // 根据道具类型应用不同效果
        var iconResource = ICON<Icon>.Resource
        if iconResource == EResSprite.WeaponDamage {
            // 武器伤害加成
            var value = 0.2
            GetLocalPlayer()<PlayerJionGame>.ApplyWeaponDamageBonus(player,value)
            
        } else if iconResource == EResSprite.SkillDamage {
            // 技能伤害提升
            var value = 0.2
            GetLocalPlayer()<PlayerJionGame>.ApplySkillDamageBonus(player,value)

        } else if iconResource == EResSprite.HP {
            // 生命值提升
            var value = 0.2
            GetLocalPlayer()<PlayerJionGame>.ApplyHealthBonus(player,value)
        }
        // 删除道具实体
        Destroy(ITEMSmall)
    }
}