import "StdLibrary.fcc" as StdLib
import "../ChoiceOneOfThreeCard/ChoiceOneOfThreeCard.fcg" as ChoiceOneOfThreeCard
import "EditorGenLib.fcc" as EditorLib
import "Player.fcc" as Player
import "Workflow.fcc" as Workflow
import "Convert.fcc" as Convert
import "../CustomEvent.fcc" as CustomEvent
import "../PlayerJionGame/PlayerJionGame.fcg" as PlayerJionGame
import "Offline.fcc" as Offline
import "Items.fcc" as Items
import "Combat.fcc" as Combat

[platform_client]
graph Reload {
    event OnReload(){
        var SkillIndex = GetLocalPlayer()<PlayerJionGame>.CurrentSkill
        var currPlayer =  GetLocalPlayer()<PlayerJionGame>.currPlayer
        var currentWeapon =  GetLocalPlayer()<PlayerJionGame>.currentWeapon
        GetLocalPlayer()<PlayerJionGame>.AmmoJudgement = 0
        if (SkillIndex == 1) {
            Offline.AddItem(ItemIDType.SGAmmo, 5, out var createdEntity)
        }

        if (SkillIndex == 2) {
            Offline.AddItem(ItemIDType.SMGAmmo, 30, out var createdEntity)
            var ReloadBuff = GetLocalPlayer()<PlayerJionGame>.Skill2DataInGame["ReloadBuff"] as float
            if  ReloadBuff < 1 {
                var ReloadForward = 0.0648
                currentWeapon<Weapon>.FiringInterval = ReloadBuff * currentWeapon<Weapon>.FiringInterval
                // LogInfo("武器攻击间隔已调整" + currentWeapon<Weapon>.FiringInterval)
                WaitForMillisecond(1000)
                currentWeapon<Weapon>.FiringInterval = ReloadForward
            }
        }
    }
}