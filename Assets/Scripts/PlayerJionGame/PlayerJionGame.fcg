                    finalSpeed = currentSpeed + (outerSpeed * value)
                }
                Skill1DataInGame["AttackSpeed"] = finalSpeed
                LogInfo("攻击速度: " + Convert.ToString(Skill1DataInGame["AttackSpeed"]))
                
            } else if attributeName == "ReloadSpeed" {
                // 换弹速度加成（减少换弹时间）- 百分比
                var finalSpeed = 0.0
                if IsNextThreeChoiceOne == 0 {
                    var outerSpeed = Skill1DataWithOuterBonus["ReloadSpeed"] as float
                    // 换弹时间减少
                    finalSpeed = outerSpeed * (1.0 + value)
                    // 记录当前总减少百分比
                    Skill1DataInGame["ReloadSpeed_Reduction"] = value
                } else if IsNextThreeChoiceOne == 1 {
                    var outerSpeed = Skill1DataWithOuterBonus["ReloadSpeed"] as float
                    // 获取当前总减少百分比
                    var totalReduction = value  // 初始为本次减少值
                    // 累加之前的总减少百分比
                    totalReduction = Skill1DataInGame["ReloadSpeed_Reduction"] as float + value
                    // 从基础速度上计算最终速度
                    finalSpeed = outerSpeed * (1.0 + totalReduction)
                    // 更新总减少百分比记录
                    Skill1DataInGame["ReloadSpeed_Reduction"] = totalReduction
                }
                Skill1DataInGame["ReloadSpeed"] = finalSpeed
                LogInfo("换弹速度: " + Convert.ToString(Skill1DataInGame["ReloadSpeed"]))

            } else if attributeName == "WeaponMaxMagazine" {
                // 弹匣容量加成 - 固定值
