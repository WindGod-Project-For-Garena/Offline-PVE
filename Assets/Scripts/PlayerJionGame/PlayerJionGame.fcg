    // 显示当前所有属性
    func ShowAllAttributes() {
        LogInfo("=== 当前所有属性 ===")
        LogInfo("--- 玩家基础属性 ---")
        for key, value in PlayerData {
            LogInfo(key + ": " + Convert.ToString(value))
        }
        
        LogInfo("--- 技能1属性 ---")
        for key, value in Skill1Data {
            LogInfo(key + ": " + Convert.ToString(value))
        }
        
        LogInfo("--- 技能2属性 ---")
        for key, value in Skill2Data {
            LogInfo(key + ": " + Convert.ToString(value))
        }
        LogInfo("==================")
    }

    // 更新天赋卡牌UI显示
    func UpdateGiftedCardUI(cardInfo Map<string, object>) {
        var cardId = cardInfo["CardID"] as int
        var nature = Convert.ToString(cardInfo["Nature"])
        var value = cardInfo["Value"] as float
        var translationText = Convert.ToString(cardInfo["TranslationText"])
        var GiftedNameText = Convert.ToString(cardInfo["GiftedName"])
        var rarity = cardInfo["Rarity"] as int
        var currentCount = Gifted_Card_Count[cardId]
        var maxCount = GetMaxDrawCount(nature)
        // 获取列表父节点
        var listParent = GetWidgetByPath(GetLocalPlayer(), GiftedUI, "/Panel/List")
        // 获取对应的卡牌实体 (Card1到Card10)
        var cardIndex = Convert.ToString("Card (" + cardId + ")")
        var cardEntity = GetChildByName(listParent, cardIndex)

        // 更新卡牌图标
        var HasCardPanelEntity = GetChildByName(cardEntity, "HasCardPanel")
        var iconEntity = GetChildByName(HasCardPanelEntity, "icon")
        if iconEntity != nil {
            // iconEntity.SetImage("GiftedIcon_" + Convert.ToString(cardId))
        }

        // 更新天赋卡牌说明
        var textEntity = GetChildByName(HasCardPanelEntity, "IFMText")
        if textEntity != nil {
            textEntity<UIWidgetLabel>.Content = GiftedNameText
        }
        
        // 更新抽中次数显示
        var NumTextEntity = GetChildByName(cardEntity, "NumText")
        if NumTextEntity != nil {
            NumTextEntity<UIWidget>.IsVisible = true
            NumTextEntity<UIWidgetLabel>.Content = "x" + Convert.ToString(currentCount)
        }
        
        // 根据稀有度设置卡牌颜色
        if cardEntity != nil {
            if rarity == 1 {
                // 普通 - 蓝色
                cardEntity<UIWidgetButton>.Color = #1B92D6
            } else if rarity == 2 {
                // 稀有 - 紫色
                cardEntity<UIWidgetButton>.Color = #6C00FF
            } else if rarity == 3 {
                // 史诗 - 金色
                cardEntity<UIWidgetButton>.Color = #FFD700
            }
        }
        
        // 处理卡牌状态显示
        if currentCount >= maxCount && maxCount != 9999 {
            // 已抽满的情况
            var maxImageEntity = GetChildByName(cardEntity, "MaxText")
            if maxImageEntity != nil {
                maxImageEntity<UIWidget>.IsVisible = true
                maxImageEntity<UIWidgetLabel>.Content = "MAX"
            }
        } else {
            // 未抽满的情况
            var maxImageEntity = GetChildByName(cardEntity, "MaxText")
            if maxImageEntity != nil {
                maxImageEntity<UIWidget>.IsVisible = false
            }
        }
        
        // 点亮卡牌：隐藏IconImage，显示HasCardPanel
        var iconImageEntity = GetChildByName(cardEntity, "IconImage")
        if iconImageEntity != nil {
            iconImageEntity<UIWidget>.IsVisible = false  // 隐藏未点亮状态
        }
        var hasCardPanelEntity = GetChildByName(cardEntity, "HasCardPanel")
        if hasCardPanelEntity != nil {
            hasCardPanelEntity<UIWidget>.IsVisible = true  // 显示已点亮状态
        }
        // 显示天赋界面
        GiftedUI<CustomUI>.IsVisible = true
    }

    // 初始化所有天赋卡牌UI状态
    func InitAllGiftedCardUI() {
        // 获取列表父节点
        var listParent = GetWidgetByPath(GetLocalPlayer(), GiftedUI, "/Panel/List")
        for cardId = 1, 11, 1 {
            var cardInfo = Gifted_CardData[cardId]
            if cardInfo != nil {
                // 根据当前计数更新UI状态
                UpdateSingleGiftedCardUI(cardId, listParent)
            }
        }
        var currentConfig = GetCurrentDrawConfig()
        var currentPrice = currentConfig["Price"] as int
        // 更新剩余价格显示
        var NowMoneyText = GetWidgetByPath(GetLocalPlayer(), GiftedUI, "/Func/MoneyPanel/Money/text")
        if NowMoneyText != nil {
            NowMoneyText<UIWidgetLabel>.Content = Convert.ToString(Money)
        }
        // 更新当前阶段价格显示
        var priceText = GetWidgetByPath(GetLocalPlayer(), GiftedUI, "/DrawBadgePanel/Image/Money")
        if priceText != nil {
            priceText<UIWidgetLabel>.Content = Convert.ToString(currentPrice)
        }
        // 技能名称文本控件
        var skillNameWidget = GetWidgetByPath(GetLocalPlayer(), GiftedUI, "/Panel/GiftIFMPanel/GiftIFMTitle")
        if skillNameWidget != nil {
            skillNameWidget<UIWidgetLabel>.Content = ""
        }
        // 技能描述文本控件
        var skillDescWidget = GetWidgetByPath(GetLocalPlayer(), GiftedUI, "/Panel/GiftIFMPanel/GiftIFMTitle/GiftIFMSubtitle")
        if skillDescWidget != nil {
            skillDescWidget<UIWidgetLabel>.Content = ""
        }
        // 初始化时显示天赋加成百分比
        DisplayGiftedCardBonusesInUI()
    }

    // 更新单个卡牌的UI状态
    func UpdateSingleGiftedCardUI(cardId int, listParent entity<Entity>) {
        var cardInfo = Gifted_CardData[cardId]
        var currentCount = GetCardDrawCount(cardId)
        var cardIndex = Convert.ToString("Card (" + cardId + ")")
        var cardEntity = GetChildByName(listParent, cardIndex)
        if currentCount > 0 {
            // 已点亮的状态
            var iconImageEntity = GetChildByName(cardEntity, "IconImage")
            if iconImageEntity != nil {
                iconImageEntity<UIWidget>.IsVisible = false
            }
            var hasCardPanelEntity = GetChildByName(cardEntity, "HasCardPanel")
            if hasCardPanelEntity != nil {
                hasCardPanelEntity<UIWidget>.IsVisible = true
            }
            var NumTextEntity = GetChildByName(cardEntity, "NumText")
            if NumTextEntity != nil {
                NumTextEntity<UIWidget>.IsVisible = true
            }
            // 检查是否需要显示MAX
            var nature = Convert.ToString(cardInfo["Nature"])
            var maxCount = GetMaxDrawCount(nature)
            if currentCount >= maxCount && maxCount != 9999 {
                var maxImageEntity = GetChildByName(cardEntity, "MaxText")
                if maxImageEntity != nil {
                    maxImageEntity<UIWidget>.IsVisible = true
                    maxImageEntity<UIWidgetLabel>.Content = "MAX"
                }
            } else {
                var maxImageEntity = GetChildByName(cardEntity, "MaxText")
                if maxImageEntity != nil {
                    maxImageEntity<UIWidget>.IsVisible = false
                }
            }
        } else {
            // 未点亮的状态
            var iconImageEntity = GetChildByName(cardEntity, "IconImage")
            if iconImageEntity != nil {
                iconImageEntity<UIWidget>.IsVisible = true
            }
            var hasCardPanelEntity = GetChildByName(cardEntity, "HasCardPanel")
            if hasCardPanelEntity != nil {
                hasCardPanelEntity<UIWidget>.IsVisible = false
            }
            var maxImageEntity = GetChildByName(cardEntity, "MaxText")
            if maxImageEntity != nil {
                maxImageEntity<UIWidget>.IsVisible = false
            }
            var NumTextEntity = GetChildByName(cardEntity, "NumText")
            if NumTextEntity != nil {
                NumTextEntity<UIWidget>.IsVisible = false
            }
        }
    }

    // 获取卡牌当前抽取次数
    func GetCardDrawCount(cardId int) int {
        if Gifted_Card_Count[cardId] != nil {
            return Gifted_Card_Count[cardId]
        }
        return 0
    }
