    // 更新按钮状态
    func UpdateLevelDisplay() {
        var buttonRight = GetWidgetByPath(GetLocalPlayer(), ChoiceHeroUI, "/ChoiceLevel/Button_right")
        var buttonLeft = GetWidgetByPath(GetLocalPlayer(), ChoiceHeroUI, "/ChoiceLevel/Button_left")
        var leveltext = GetWidgetByPath(GetLocalPlayer(), ChoiceHeroUI, "/ChoiceLevel/LevelNum")
        // 更新按钮状态
        UpdateLeftButtonState(buttonLeft)
        UpdateRightButtonState(buttonRight)
        var levelNumTTT = LocString{"LEVEL_FORMAT", List<string>{level}}
        leveltext<UIWidgetLabel>.Content = levelNumTTT
    }

    // 检测当前是否是最高的解锁关卡
    func IsMaxUnlockedLevel() bool {
        return level >= MaxLevel
    }

    // 更新右按钮状态
    func UpdateRightButtonState(buttonRight entity<UIWidget>) {
        if buttonRight != nil {
            if IsMaxUnlockedLevel() {
                // 到达最高解锁关卡，置灰右按钮
                buttonRight<UIWidgetButton>.Color = #808080  // 灰色
            } else {
                // 未到达最高解锁关卡，恢复按钮状态
                buttonRight<UIWidgetButton>.Color = #FFBA00  // 橙色
            }
        }
    }

    // 更新左按钮状态
    func UpdateLeftButtonState(buttonLeft entity<UIWidget>) {
        if buttonLeft != nil {
            if level <= 1 {
                // 到达第一关，置灰左按钮
                buttonLeft<UIWidgetButton>.Color = #808080  // 灰色
            } else {
                // 不是第一关，恢复按钮状态
                buttonLeft<UIWidgetButton>.Color = #FFBA00  // 橙色
            }
        }
    }
//———————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————//
//———————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————//
    // 主计时器循环
    async func BuffTimerLoop() {
        // 如果已经在运行，直接返回
        if buffTimerRunning {
            LogInfo("Buff计时器已在运行中")
            return
        }
        
        // 设置运行标志
        buffTimerRunning = true
        
        while buffTimerRunning {
            var hasActiveBuff = false
            
            // 更新武器buff计时器
            if weaponBuffTimerActive && weaponBuffTimer > 0 {
                weaponBuffTimer = weaponBuffTimer - 1000  // 每1000毫秒减少
                hasActiveBuff = true
                if weaponBuffTimer <= 0 {
                    weaponBuffTimerActive = false
                    LogInfo("武器伤害buff已过期")
                    // 触发恢复逻辑
                    start RemoveWeaponDamageBonus()
                }
            }
            
            // 更新技能buff计时器
            if skillBuffTimerActive && skillBuffTimer > 0 {
                skillBuffTimer = skillBuffTimer - 1000  // 每1000毫秒减少
                hasActiveBuff = true
                if skillBuffTimer <= 0 {
                    skillBuffTimerActive = false
                    LogInfo("技能伤害buff已过期")
                    // 触发恢复逻辑
                    start RemoveSkillDamageBonus()
                }
            }
            
            // 如果没有任何活动的buff，退出循环
            if !hasActiveBuff {
                buffTimerRunning = false
                LogInfo("所有buff已过期，停止计时器")
                break
            }
            
            LogInfo("武器伤害buff剩余时间: " + weaponBuffTimer + "，技能伤害buff剩余时间: " + skillBuffTimer)
            // 等待1秒
            WaitForMillisecond(1000)
        }
    }

    // 停止所有计时器并恢复伤害
    async func StopAllBuffsAndReset() {
         LogInfo("停止所有buff并恢复伤害")
    
        // 立即恢复所有伤害
        if weaponBuffTimerActive {
            start RemoveWeaponDamageBonus()
            weaponBuffTimerActive = false
            weaponBuffTimer = 0
        }
        
        if skillBuffTimerActive {
            start RemoveSkillDamageBonus()
            skillBuffTimerActive = false
            skillBuffTimer = 0
            skillDamageBonusPercent = 0.0
        }
        
        // 重置所有临时存储
        tempOriginalSkill1Damage = 0
        tempOriginalSkill2Damage = 0
    }

    // 应用武器伤害加成
    func ApplyWeaponDamageBonus(player entity<Player>, value float) {
        // 应用伤害加成逻辑
        if CurrentSkill == 1 {
            var currentDamage = Skill1DataInGame["WeaponDamage"] as int
            var finalDamage = currentDamage + Round(currentDamage * value) as int
            currentWeapon<Weapon>.Damage = finalDamage
        } else if CurrentSkill == 2 {
            var currentDamage = Skill2DataInGame["WeaponDamage"] as int
            var finalDamage = currentDamage + Round(currentDamage * value) as int
            currentWeapon<Weapon>.Damage = finalDamage
        }
        
        // 重置计时器（重新开始10秒）
        weaponBuffTimer = 10000  // 10秒
        weaponBuffTimerActive = true
        // 确保计时器循环运行
        if !buffTimerRunning {
            start BuffTimerLoop()
        }
        LogInfo("武器伤害buff激活，持续10秒")
    }

    // 删除所有掉落道具
    func RemoveAllDrops() {
        for key,Value in DropItemList {
            Destroy(Value)
        }
    }

    // 拾取掉落物的特效效果
    async func PickUpDropEffect(player entity<Player> , BuffColor Color) {
        // 创建并且播放特效
		CreateEffectClient(out var ItemEfect, VFXType.Line, LoopType.Loop, true)
        var PlayerItemEfect = ItemEfect
        var PlayerPos = player<Player>.Position
        PlayerItemEfect<Transform>.Position = PlayerPos
        PlayerItemEfect<Effect>.Color = BuffColor
        SetParentClient(player,PlayerItemEfect,true)

        // 销毁掉落物
        WaitForMillisecond(2000)
        Destroy(PlayerItemEfect)
    }

    // 应用技能伤害加成
    func ApplySkillDamageBonus(player entity<Player>, value float) {
        // 检查是否已经有buff在生效
        if skillBuffTimerActive {
            // 如果已有buff，比较加成值
            if value > skillDamageBonusPercent {
                
                // 先恢复原始值
                start RemoveSkillDamageBonus()
                
                // 然后应用新的buff
                skillDamageBonusPercent = value
                
                // 重新计算伤害（基于原始值）
                if CurrentSkill == 1 && tempOriginalSkill1Damage > 0 {
                    var finalSkillDamage = tempOriginalSkill1Damage + Round(tempOriginalSkill1Damage * value) as int
                    Skill1DataInGame["SkillDamage"] = finalSkillDamage
                } else if CurrentSkill == 2 && tempOriginalSkill2Damage > 0 {
                    var finalSkillDamage = tempOriginalSkill2Damage + Round(tempOriginalSkill2Damage * value) as int
                    Skill2DataInGame["SkillDamage"] = finalSkillDamage
                }
            }
            
            // 重置计时器（重新开始10秒）
            skillBuffTimer = 10000  // 10秒
            return
        }
        
        // 没有buff在生效，应用新的buff
        skillDamageBonusPercent = value
        
        // 应用技能伤害加成逻辑
        if CurrentSkill == 1 {
            // 获取当前的技能伤害
            var currentSkillDamage = Skill1DataInGame["SkillDamage"] as int
            
            // 保存原始值
            tempOriginalSkill1Damage = currentSkillDamage
            
            // 计算加成后的伤害
            var finalSkillDamage = tempOriginalSkill1Damage + Round(tempOriginalSkill1Damage * value) as int
            Skill1DataInGame["SkillDamage"] = finalSkillDamage
            
        } else if CurrentSkill == 2 {
            // 获取当前的技能伤害
            var currentSkillDamage = Skill2DataInGame["SkillDamage"] as int
            
            // 保存原始值
            tempOriginalSkill2Damage = currentSkillDamage
            
            // 计算加成后的伤害
            var finalSkillDamage = tempOriginalSkill2Damage + Round(tempOriginalSkill2Damage * value) as int
            Skill2DataInGame["SkillDamage"] = finalSkillDamage
            
        }
        
        // 设置buff生效标志和计时器
        skillBuffTimerActive = true
        skillBuffTimer = 10000  // 10秒
        
        // 确保计时器循环运行
        if !buffTimerRunning {
            start BuffTimerLoop()
        }
    }

    func ApplyHealthBonus(player entity<Player>,value float) {
        // 生命值提升 - 瞬间回血百分比
        var finalHealth = 0
        var currentHealth = currPlayer<Player>.HP as int
        finalHealth = currentHealth + Round(currentHealth * value) as int
        if finalHealth > currPlayer<Player>.MaxHP {
            finalHealth = currPlayer<Player>.MaxHP
        }
        currPlayer<Player>.HP = finalHealth
    }

    //+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++//
    //+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++//

    // 恢复武器伤害
    async func RemoveWeaponDamageBonus() {
        if CurrentSkill == 1 {
            var originalDamage = Skill1DataInGame["WeaponDamage"] as int
            currentWeapon<Weapon>.Damage = originalDamage
        } else if CurrentSkill == 2 {
            var originalDamage = Skill2DataInGame["WeaponDamage"] as int
            currentWeapon<Weapon>.Damage = originalDamage
        }
    }

    // 恢复技能伤害
    async func RemoveSkillDamageBonus() {
        if CurrentSkill == 1 {
            if tempOriginalSkill1Damage > 0 {
                // 恢复到保存的原始值
                Skill1DataInGame["SkillDamage"] = tempOriginalSkill1Damage
                LogInfo("技能1伤害恢复为: " + Convert.ToString(tempOriginalSkill1Damage))
                tempOriginalSkill1Damage = 0  // 重置以备下次使用
            }
        } else if CurrentSkill == 2 {
            if tempOriginalSkill2Damage > 0 {
                // 恢复到保存的原始值
                Skill2DataInGame["SkillDamage"] = tempOriginalSkill2Damage
                LogInfo("技能2伤害恢复为: " + Convert.ToString(tempOriginalSkill2Damage))
                tempOriginalSkill2Damage = 0  // 重置以备下次使用
            }
        }
        
        // 重置加成百分比
        skillDamageBonusPercent = 0.0
    }
