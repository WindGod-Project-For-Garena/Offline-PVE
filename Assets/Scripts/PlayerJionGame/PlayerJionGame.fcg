                    finalDamage = currentDamage + Round(outerDamage * value) as int
                }
                Skill2DataInGame["WeaponDamage"] = finalDamage
                LogInfo("局内武器伤害: " + Convert.ToString(Skill2DataInGame["WeaponDamage"]))
                
            } else if attributeName == "AttackSpeed" {
                // 攻击速度加成 - 百分比
                var finalSpeed = 0.0
                if IsNextThreeChoiceOne == 0 {
                    var outerSpeed = Skill2DataWithOuterBonus["AttackSpeed"] as float
                    finalSpeed = outerSpeed * (1.0 + value)
                } else if IsNextThreeChoiceOne == 1 {
                    var currentSpeed = Skill2DataInGame["AttackSpeed"] as float
                    var outerSpeed = Skill2DataWithOuterBonus["AttackSpeed"] as float
                    finalSpeed = currentSpeed + (outerSpeed * value)
                }
                Skill2DataInGame["AttackSpeed"] = finalSpeed
                LogInfo("攻击速度: " + Convert.ToString(Skill2DataInGame["AttackSpeed"]))
                
            } else if attributeName == "ReloadSpeed" {
                // 换弹速度加成（减少换弹时间）- 百分比
                var finalSpeed = 0.0
                if IsNextThreeChoiceOne == 0 {
                    var outerSpeed = Skill2DataWithOuterBonus["ReloadSpeed"] as float
                    // 换弹时间减少
                    finalSpeed = outerSpeed * (1.0 + value)
                    // 记录当前总减少百分比
                    Skill2DataInGame["ReloadSpeed_Reduction"] = value
                } else if IsNextThreeChoiceOne == 1 {
                    var outerSpeed = Skill2DataWithOuterBonus["ReloadSpeed"] as float
                    // 获取当前总减少百分比
                    var totalReduction = value  // 初始为本次减少值
                    // 累加之前的总减少百分比
                    totalReduction = Skill2DataInGame["ReloadSpeed_Reduction"] as float + value
                    // 从基础速度上计算最终速度
                    finalSpeed = outerSpeed * (1.0 + totalReduction)
                    // 更新总减少百分比记录
                    Skill2DataInGame["ReloadSpeed_Reduction"] = totalReduction
                }
                Skill2DataInGame["ReloadSpeed"] = finalSpeed
                LogInfo("换弹速度: " + Convert.ToString(Skill2DataInGame["ReloadSpeed"]))

            } else if attributeName == "WeaponMaxMagazine" {
                // 弹匣容量加成 - 固定值
                var finalMagazine = 0
                if IsNextThreeChoiceOne == 0 {
                    var outerMagazine = Skill2DataWithOuterBonus["WeaponMaxMagazine"] as int
                    finalMagazine = outerMagazine + Round(value) as int
                } else if IsNextThreeChoiceOne == 1 {
                    var currentMagazine = Skill2DataInGame["WeaponMaxMagazine"] as int
                    finalMagazine = currentMagazine + Round(value) as int
                }
                Skill2DataInGame["WeaponMaxMagazine"] = finalMagazine
                LogInfo("弹匣容量: " + Convert.ToString(Skill2DataInGame["WeaponMaxMagazine"]))
            }
            // 更新玩家技能二属性（使用局内数据）
            UpdateSkill2Data()
        }
        // 更新玩家当前属性（使用局内数据）
        UpdatePlayerAttributes()
        IsNextThreeChoiceOne = 0
    }

    func OnCardSelected(selectedCardIndex int) {
        LogInfo("选择了第 " + Convert.ToString(selectedCardIndex) + " 张牌")
        
        // 重置所有选择标记
        var card1BB = GetWidgetByPath(GetLocalPlayer(), ChoiceThreeCardUI, "/ChoiceThreeCardPanel/Card_1/IsChoice")
        var card2BB = GetWidgetByPath(GetLocalPlayer(), ChoiceThreeCardUI, "/ChoiceThreeCardPanel/Card_2/IsChoice")
        var card3BB = GetWidgetByPath(GetLocalPlayer(), ChoiceThreeCardUI, "/ChoiceThreeCardPanel/Card_3/IsChoice")
        
        card1BB<UIWidget>.IsVisible = false
        card2BB<UIWidget>.IsVisible = false
        card3BB<UIWidget>.IsVisible = false
        
        // 根据选择的牌位置激活对应的标记
        if selectedCardIndex == 1 {
            card1BB<UIWidget>.IsVisible = true
        } else if selectedCardIndex == 2 {
            card2BB<UIWidget>.IsVisible = true
        } else if selectedCardIndex == 3 {
            card3BB<UIWidget>.IsVisible = true
        }
    }
