    // 显示当前所有属性
    func ShowAllAttributes() {
        LogInfo("=== 当前所有属性 ===")
        LogInfo("--- 玩家基础属性 ---")
        for key, value in PlayerData {
            LogInfo(key + ": " + Convert.ToString(value))
        }
        
        LogInfo("--- 技能1属性 ---")
        for key, value in Skill1Data {
            LogInfo(key + ": " + Convert.ToString(value))
        }
        
        LogInfo("--- 技能2属性 ---")
        for key, value in Skill2Data {
            LogInfo(key + ": " + Convert.ToString(value))
        }
        LogInfo("==================")
    }

    // 更新天赋卡牌UI显示
    func UpdateGiftedCardUI(cardInfo Map<string, object>) {
        var cardId = cardInfo["CardID"] as int
        var nature = Convert.ToString(cardInfo["Nature"])
        var value = cardInfo["Value"] as float
        var translationText = Convert.ToString(cardInfo["TranslationText"])
        var GiftedNameText = Convert.ToString(cardInfo["GiftedName"])
        var rarity = cardInfo["Rarity"] as int
        var currentCount = Gifted_Card_Count[cardId]
        var maxCount = GetMaxDrawCount(nature)
        // 获取列表父节点
        var listParent = GetWidgetByPath(GetLocalPlayer(), GiftedUI, "/Panel/List")
        // 获取对应的卡牌实体 (Card1到Card10)
        var cardIndex = Convert.ToString("Card (" + cardId + ")")
        var cardEntity = GetChildByName(listParent, cardIndex)

        // 更新卡牌图标
        var HasCardPanelEntity = GetChildByName(cardEntity, "HasCardPanel")
        var iconEntity = GetChildByName(HasCardPanelEntity, "icon")
        if iconEntity != nil {
            // iconEntity.SetImage("GiftedIcon_" + Convert.ToString(cardId))
        }

        // 更新天赋卡牌说明
        var textEntity = GetChildByName(HasCardPanelEntity, "IFMText")
        if textEntity != nil {
            // 直接使用翻译文本
            var textTTT = LocString{GiftedNameText, List<string>{level}}
            textEntity<UIWidgetLabel>.Content = textTTT
        }
        
        // 更新抽中次数显示
        var NumTextEntity = GetChildByName(cardEntity, "NumText")
        if NumTextEntity != nil {
            NumTextEntity<UIWidget>.IsVisible = true
            NumTextEntity<UIWidgetLabel>.Content = "x" + Convert.ToString(currentCount)
        }
        
        // 更具稀有度更新边框颜色
        var ICONBBEntity = GetChildByName(HasCardPanelEntity, "ICONBB")
        if ICONBBEntity != nil {
            var iconColor = FC_Config.CardRarityColor[rarity]
            ICONBBEntity<UIWidgetImage>.Color = iconColor
        }
        
        // 处理卡牌状态显示
        if currentCount >= maxCount && maxCount != 9999 {
            // 已抽满的情况
            var maxImageEntity = GetChildByName(cardEntity, "MaxText")
            if maxImageEntity != nil {
                maxImageEntity<UIWidget>.IsVisible = true
                maxImageEntity<UIWidgetLabel>.Content = "MAX"
            }
        } else {
            // 未抽满的情况
            var maxImageEntity = GetChildByName(cardEntity, "MaxText")
            if maxImageEntity != nil {
                maxImageEntity<UIWidget>.IsVisible = false
            }
        }
        
        // 点亮卡牌：隐藏IconImage，显示HasCardPanel
        var iconImageEntity = GetChildByName(cardEntity, "Text")
        if iconImageEntity != nil {
            iconImageEntity<UIWidget>.IsVisible = false  // 隐藏未点亮状态
        }
        var hasCardPanelEntity = GetChildByName(cardEntity, "HasCardPanel")
        if hasCardPanelEntity != nil {
            hasCardPanelEntity<UIWidget>.IsVisible = true  // 显示已点亮状态
            // 显示图标
            var iconImageEntity = GetChildByName(hasCardPanelEntity, "icon")
            if iconImageEntity != nil {
                iconImageEntity<UIWidget>.IsVisible = true
                var nature = cardInfo["Nature"]
                var iconKey = "Skill_Just_Do_It"  // 通用默认值

                // 设置图标稀有度颜色
                var rarity = cardInfo["Rarity"] as int
                var iconColor = FC_Config.CardRarityColor[rarity]
                iconImageEntity<UIWidgetImage>.Color = iconColor
                
                // 检查配置中是否存在该nature对应的图标
                if (nature != nil && nature != "") {
                    if (FC_Config.GiftedCardIDs[nature] != nil) {
                        iconKey = nature  // 如果配置中有，直接使用nature作为key
                    }
                }
                iconImageEntity<UIWidgetImage>.SpriteName = FC_Config.GiftedCardIDs[iconKey]
            }
        }
        // 显示天赋界面
        GiftedUI<CustomUI>.IsVisible = true
    }

    // 初始化所有天赋卡牌UI状态
    func InitAllGiftedCardUI() {
        // 获取列表父节点
        var listParent = GetWidgetByPath(GetLocalPlayer(), GiftedUI, "/Panel/List")
        for cardId = 1, 11, 1 {
            var cardInfo = Gifted_CardData[cardId]
            if cardInfo != nil {
                // 获取当前卡牌的抽取次数
                var currentCount = GetCardDrawCount(cardId)
                // 更新单个卡牌UI
                UpdateSingleGiftedCardUI(cardId, listParent, currentCount, cardInfo)
            }
        }
        var currentConfig = GetCurrentDrawConfig()
        var currentPrice = currentConfig["Price"] as int
        // 更新剩余价格显示
        var NowMoneyText = GetWidgetByPath(GetLocalPlayer(), GiftedUI, "/Func/MoneyPanel/Money/text")
        if NowMoneyText != nil {
            NowMoneyText<UIWidgetLabel>.Content = Convert.ToString(Money)
        }
        // 更新当前阶段价格显示
        var priceText = GetWidgetByPath(GetLocalPlayer(), GiftedUI, "/DrawBadgePanel/Image/Money")
        if priceText != nil {
            priceText<UIWidgetLabel>.Content = Convert.ToString(currentPrice)
        }
        // 技能名称文本控件
        var skillNameWidget = GetWidgetByPath(GetLocalPlayer(), GiftedUI, "/Panel/GiftIFMPanel/SubTitleCCCC/GiftIFMTitle")
        if skillNameWidget != nil {
            skillNameWidget<UIWidgetLabel>.Content = ""
        }
        // 技能描述文本控件
        var skillDescWidget = GetWidgetByPath(GetLocalPlayer(), GiftedUI, "/Panel/GiftIFMPanel/SubTitleCCCC/GiftIFMTitle/GiftIFMSubtitle")
        if skillDescWidget != nil {
            skillDescWidget<UIWidgetLabel>.Content = ""
        }
        // 技能描述文本面板
        var skillPanelWidget = GetWidgetByPath(GetLocalPlayer(), GiftedUI, "/Panel/GiftIFMPanel/SubTitleCCCC")
        if skillPanelWidget != nil {
            skillPanelWidget<UIWidget>.IsVisible = false
        }
        // 重置所有卡牌的选中状态
        for cardId = 1, 11, 1 {
            var listParent = GetWidgetByPath(GetLocalPlayer(), GiftedUI, "/Panel/List")
            var cardIndex = Convert.ToString("Card (" + cardId + ")")
            var cardEntity = GetChildByName(listParent, cardIndex)
            
            if cardEntity != nil {
                var HasCardPanelEntity = GetChildByName(cardEntity, "HasCardPanel")
                if HasCardPanelEntity != nil {
                        var isChoiceEntity = GetChildByName(HasCardPanelEntity, "ISCHOICE")
                        if isChoiceEntity != nil {
                            isChoiceEntity<UIWidget>.IsVisible = false
                        }
                }
            }
        }
        // 初始化时显示天赋加成百分比
        DisplayGiftedCardBonusesInUI()
        // 初始化时更新抽卡按钮状态
        var currentPrice1 = GetCurrentDrawPrice()
        UpdateDrawButtonState(currentPrice1)
    }

    // 更新单个卡牌的UI状态
    func UpdateSingleGiftedCardUI(cardId int, listParent entity<Entity>, currentCount int, cardInfo Map<string, object>) {
        var cardIndex = Convert.ToString("Card (" + cardId + ")")
        var cardEntity = GetChildByName(listParent, cardIndex)
        
        if cardEntity == nil {
            LogWarning("找不到卡牌UI: " + cardIndex)
            return
        }
        
        if currentCount > 0 {
            // 已点亮的状态
            var iconImageEntity = GetChildByName(cardEntity, "IconImage")
            if iconImageEntity != nil {
                iconImageEntity<UIWidget>.IsVisible = false
            }

            var TextEntity = GetChildByName(cardEntity, "Text")
            if TextEntity != nil {
                TextEntity<UIWidget>.IsVisible = false
            }
            
            var hasCardPanelEntity = GetChildByName(cardEntity, "HasCardPanel")
            if hasCardPanelEntity != nil {
                hasCardPanelEntity<UIWidget>.IsVisible = true
                
                // 设置卡牌图标
                var iconImage = GetChildByName(hasCardPanelEntity, "icon")
                if iconImage != nil {
                    iconImage<UIWidget>.IsVisible = true
                    var nature = cardInfo["Nature"]
                    var iconKey = "Skill_Just_Do_It"
                    
                    // 设置图标稀有度颜色
                    var rarity = cardInfo["Rarity"] as int
                    var iconColor = FC_Config.CardRarityColor[rarity]
                    iconImage<UIWidgetImage>.Color = iconColor
                    
                    // 检查配置中是否存在该nature对应的图标
                    if (nature != nil && nature != "") {
                        if (FC_Config.GiftedCardIDs[nature] != nil) {
                            iconKey = nature
                        }
                    }
                    iconImage<UIWidgetImage>.SpriteName = FC_Config.GiftedCardIDs[iconKey]
                }
                
                // 更新卡牌描述
                var textEntity = GetChildByName(hasCardPanelEntity, "IFMText")
                if textEntity != nil {
                    var GiftedNameText = Convert.ToString(cardInfo["GiftedName"])
                    var textTTT = LocString{GiftedNameText, List<string>{level}}
                    textEntity<UIWidgetLabel>.Content = textTTT
                }
                
                // 更新边框颜色
                var ICONBBEntity = GetChildByName(hasCardPanelEntity, "ICONBB")
                if ICONBBEntity != nil {
                    var rarity = cardInfo["Rarity"] as int
                    var iconColor = FC_Config.CardRarityColor[rarity]
                    ICONBBEntity<UIWidgetImage>.Color = iconColor
                }
            }
            
            // 显示数量
            var NumTextEntity = GetChildByName(cardEntity, "NumText")
            if NumTextEntity != nil {
                NumTextEntity<UIWidget>.IsVisible = true
                NumTextEntity<UIWidgetLabel>.Content = "x" + Convert.ToString(currentCount)
            }
            
            // 检查是否需要显示MAX
            var nature = Convert.ToString(cardInfo["Nature"])
            var maxCount = GetMaxDrawCount(nature)
            if currentCount >= maxCount && maxCount != 9999 {
                var maxImageEntity = GetChildByName(cardEntity, "MaxText")
                if maxImageEntity != nil {
                    maxImageEntity<UIWidget>.IsVisible = true
                    maxImageEntity<UIWidgetLabel>.Content = "MAX"
                }
            } else {
                var maxImageEntity = GetChildByName(cardEntity, "MaxText")
                if maxImageEntity != nil {
                    maxImageEntity<UIWidget>.IsVisible = false
                }
            }
        } else {
            // 未点亮的状态
            var iconImageEntity = GetChildByName(cardEntity, "IconImage")
            if iconImageEntity != nil {
                iconImageEntity<UIWidget>.IsVisible = true
            }

            var TextEntity = GetChildByName(cardEntity, "Text")
            if TextEntity != nil {
                TextEntity<UIWidget>.IsVisible = true
            }
            
            var hasCardPanelEntity = GetChildByName(cardEntity, "HasCardPanel")
            if hasCardPanelEntity != nil {
                hasCardPanelEntity<UIWidget>.IsVisible = false
            }
            
            var maxImageEntity = GetChildByName(cardEntity, "MaxText")
            if maxImageEntity != nil {
                maxImageEntity<UIWidget>.IsVisible = false
            }
            
            var NumTextEntity = GetChildByName(cardEntity, "NumText")
            if NumTextEntity != nil {
                NumTextEntity<UIWidget>.IsVisible = false
            }
        }
    }

    // 获取卡牌当前抽取次数
    func GetCardDrawCount(cardId int) int {
        if DATA_Gifted_Card_Count == nil || List.Length(DATA_Gifted_Card_Count) <= cardId {
            return 0
        }
        return DATA_Gifted_Card_Count[cardId]
    }

    // 重新应用所有已抽取卡牌的效果
    func ApplyAllSavedCardEffects() {
        for cardId = 1, 11, 1 {
            var currentCount = GetCardDrawCount(cardId)
            if currentCount > 0 {
                // 多次应用卡牌效果（根据抽取次数）
                for i = 0, currentCount, 1 {
                    ApplyGiftedCardEffect(cardId)
                }
            }
        }
        LogInfo("所有牌效果应用完成")
    }
