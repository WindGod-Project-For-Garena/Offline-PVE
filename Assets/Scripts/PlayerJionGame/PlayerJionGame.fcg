    // 更新空排行榜显示
    func UpdateEmptyRankingDisplay() {
        LogInfo("排行榜无数据，显示空状态")
        var Part2 = GetWidgetByPath(GetLocalPlayer(), RankingListUI, "/RankPanel/TitleBoard/IFMPanel/IFMPanelBB/LevelAmountIFM/TitleIFM/Part2")
        var Part3 = GetWidgetByPath(GetLocalPlayer(), RankingListUI, "/RankPanel/TitleBoard/IFMPanel/IFMPanelBB/LevelAmountIFM/TitleIFM/Part3")
        Part2<UIWidget>.IsVisible = false
        Part3<UIWidget>.IsVisible = true
    }

    // 序列化单条记录为string
    func SerializeRankingRecord(level int, bossKillTime string, heroName string) string {
        return Convert.ToString(level) + "|" + bossKillTime + "|" + heroName
    }

    // 解析string为排行榜记录
    func ParseRankingRecord(recordStr string) Map<string, object> {
        var parts = strings.Split(recordStr, "|")
        var record = Map<string, object>{}
        
        if List.Length(parts) >= 3 {
            // 使用Convert.StringToInt转换
            Convert.StringToInt(parts[0], out var levelInt, out var isSuccess)
            record["Level"] = levelInt
            record["bossKillTime"] = parts[1]
            record["HeroName"] = parts[2]
            // 解析时间字符串为秒数（用于排序）
            // 格式: "mm:ss"
            var timeParts = strings.Split(parts[1], ":")
            if List.Length(timeParts) >= 2 {
                Convert.StringToInt(timeParts[0], out var minutes, out var success1)
                Convert.StringToInt(timeParts[1], out var seconds, out var success2)
                record["ClearTime"] = minutes * 60 + seconds
            }
        }
        
        return record
    }

    // 序列化整个排行榜
    func SerializeRankingList() List<string> {
        var serializedList = List<string>{}
        
        for i = 0, List.Length(RankingListMap), 1 {
            var record = RankingListMap[i]
            var level = 0
            var bossKillTime = ""
            var heroName = ""
            
            // 安全地获取值
            if record["Level"] != nil {
                level = record["Level"] as int
            }
            if record["bossKillTime"] != nil {
                bossKillTime = record["bossKillTime"] as string
            }
            if record["HeroName"] != nil {
                heroName = record["HeroName"] as string
            }
            
            var serializedStr = SerializeRankingRecord(level, bossKillTime, heroName)
            List.Append(serializedList, serializedStr)
        }
        
        return serializedList
    }

    // 解析排行榜string列表
    func ParseRankingList(serializedList List<string>) List<Map<string, object>> {
        var parsedList = List<Map<string, object>>{}
        
        for i = 0, List.Length(serializedList), 1 {
            var recordStr = serializedList[i]
            var record = ParseRankingRecord(recordStr)
            
            if Map.Length(record) > 0 {
                List.Append(parsedList, record)
            }
        }
        
        return parsedList
    }
}