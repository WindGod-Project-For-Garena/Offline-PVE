                    var totalReduction = value  // 初始为本次减少值
                    // 累加之前的总减少百分比
                    totalReduction = Skill2DataInGame["ReloadSpeed_Reduction"] as float + value
                    // 从基础速度上计算最终速度
                    finalSpeed = outerSpeed * (1.0 + totalReduction)
                    // 更新总减少百分比记录
                    Skill2DataInGame["ReloadSpeed_Reduction"] = totalReduction
                }
                Skill2DataInGame["ReloadSpeed"] = finalSpeed
                LogInfo("换弹速度: " + Convert.ToString(Skill2DataInGame["ReloadSpeed"]))

            } else if attributeName == "WeaponMaxMagazine" {
                // 弹匣容量加成 - 固定值
                var finalMagazine = 0
                if IsNextThreeChoiceOne == 0 {
                    var outerMagazine = Skill2DataWithOuterBonus["WeaponMaxMagazine"] as int
                    finalMagazine = outerMagazine + Round(value) as int
                } else if IsNextThreeChoiceOne == 1 {
                    var currentMagazine = Skill2DataInGame["WeaponMaxMagazine"] as int
                    finalMagazine = currentMagazine + Round(value) as int
                }
                Skill2DataInGame["WeaponMaxMagazine"] = finalMagazine
                LogInfo("弹匣容量: " + Convert.ToString(Skill2DataInGame["WeaponMaxMagazine"]))
            }
            // 更新玩家技能二属性（使用局内数据）
            UpdateSkill2Data()
        }
        // 更新玩家当前属性（使用局内数据）
        UpdatePlayerAttributes()
        IsNextThreeChoiceOne = 0
    }
//———————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————//
//—————————————————————————————————————————————————以下为天赋卡片的数据————————————————————————————————————————————————————————//
//—————————————————————————————————————————————————以下为天赋卡片的数据————————————————————————————————————————————————————————//
//———————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————//
    // 注入天赋卡片的数据
    func InjectGifted_CardData() {
        // 解析CSV
        Map.Clear(Gifted_CardData)
        for cardId = 1, 11, 1 {
            var cardInfo = Map<string, object>{}
            cardInfo["CardID"] = cardId
            // 从CSV读取卡牌数据，从第三行开始读取
            var cardRow = CSVData.ReadCSVRow(EResCSV.GiftedData, cardId + 2)
            cardInfo["Nature"] = cardRow[1]
            cardInfo["Value"] = cardRow[2] as List<float>
            cardInfo["Rarity"] = cardRow[3] as List<int>
            cardInfo["TranslationText"] = cardRow[4]
            cardInfo["MathValue"] = cardRow[5]
            cardInfo["GiftedName"] = cardRow[6]
            Gifted_CardData[cardId] = cardInfo
            // 在显示时格式化浮点数，保留两位小数
            // LogInfo(Gifted_CardData[cardId])
        }
        LogInfo("天赋卡片注入完成")
    }

    // 注入天赋卡片概率数据
    func InjectGiftCardProbabilityData() {
        // 解析CSV
        List.Clear(Gifted_CardProbability)
        for rowIndex = 1, 11, 1 {
            var configInfo = Map<string, object>{}
            // 从CSV读取概率数据，从第三行开始读取
            var configRow = CSVData.ReadCSVRow(EResCSV.GiftCardProbabilityData, rowIndex + 2)
            configInfo["MinCount"] = configRow[0] as int
            configInfo["Price"] = configRow[1] as int
            configInfo["CommonProb"] = configRow[2] as float
            configInfo["RareProb"] = configRow[3] as float
            configInfo["EpicProb"] = configRow[4] as float
            List.Append(Gifted_CardProbability, configInfo)
            // LogInfo("抽卡配置" + Convert.ToString(rowIndex) + ": " + Convert.ToString(configInfo))
        }
        LogInfo("天赋卡片概率数据注入完成")
    }
//———————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————//
    // 获取当前抽卡配置
    func GetCurrentDrawConfig() Map<string, object> {
        for i, config in Gifted_CardProbability {
            if TotalDrawCount >= config["MinCount"] as int {
                // 检查是否是最后一个配置
                if i == List.Length(Gifted_CardProbability) - 1 {
                    return config
                }
                // 检查下一个配置的最小次数是否大于当前抽卡次数
                var nextConfig = Gifted_CardProbability[i + 1]
                if TotalDrawCount < nextConfig["MinCount"] as int {
                    return config
                }
            }
        }
        // 默认返回第一个配置
        return Gifted_CardProbability[0]
    }

    // 获取当前抽卡价格
    func GetCurrentDrawPrice() int {
        var config = GetCurrentDrawConfig()
        return config["Price"] as int
    }

    // 根据概率随机选择卡牌稀有度
    func SelectCardByProbability() int {
        var config = GetCurrentDrawConfig()
        var randomValue = RandomFloat(0.0, 1.0)
        var commonProb = config["CommonProb"] as float
        var rareProb = config["RareProb"] as float
        var epicProb = config["EpicProb"] as float
        LogInfo("当前概率 - 普通:" + Convert.ToString(commonProb) + " 稀有:" + Convert.ToString(rareProb) + " 史诗:" + Convert.ToString(epicProb))
        if randomValue < commonProb {
            return 1  // 普通
        } else if randomValue < commonProb + rareProb {
            return 2  // 稀有
        } else {
            return 3  // 史诗
        }
    }

    // 根据稀有度筛选可抽取的卡牌
    func GetAvailableCardsByRarity(targetRarity int) List<int> {
        var availableCardIds = List<int>{}
        for cardId, cardData in Gifted_CardData {
            var nature = Convert.ToString(cardData["Nature"])
            var currentCount = 0
            if Gifted_Card_Count[cardId] != nil {
                currentCount = Gifted_Card_Count[cardId]
            }
            
            // 检查是否达到最大抽取次数
            var maxCount = GetMaxDrawCount(nature)
            if currentCount < maxCount {
                // 检查稀有度是否匹配
                var cardRarity = cardData["Rarity"] as int
                if cardRarity == targetRarity {
                    List.Append(availableCardIds, cardId)
                }
            }
        }
        
        return availableCardIds
    }
//———————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————//
//———————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————//
//———————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————//
    // 抽卡
    func DrawGiftedCard() {
        // 获取当前抽卡价格
        var currentPrice = GetCurrentDrawPrice()
        var currentConfig = GetCurrentDrawConfig()
        
        // 检查玩家是否有足够的货币
        if  Money < currentPrice {
            LogWarning("货币不足，需要" + Convert.ToString(currentPrice))
            // 确保UI状态正确更新
            UpdateDrawButtonState(currentPrice)
            return
        }
        
        // 扣除货币
        DeductPlayerCurrency(currentPrice)
        
        // 根据概率选择稀有度
        var selectedRarity = SelectCardByProbability()
        
        // 获取该稀有度下可抽取的卡牌
        var availableCardIds = GetAvailableCardsByRarity(selectedRarity)
        
        // 如果该稀有度没有可抽取的卡牌，降级到下一个稀有度
        if List.Length(availableCardIds) == 0 {
            if selectedRarity == 3 {  // 史诗降级到稀有
                availableCardIds = GetAvailableCardsByRarity(2)
                if List.Length(availableCardIds) == 0 {
                    availableCardIds = GetAvailableCardsByRarity(1)  // 稀有降级到普通
                }
            } else if selectedRarity == 2 {  // 稀有降级到普通
                availableCardIds = GetAvailableCardsByRarity(1)
            }
        }
        
        // 如果仍然没有可抽取的卡牌，获取所有可抽取的卡牌
        if List.Length(availableCardIds) == 0 {
            LogWarning("特定稀有度没有可抽取的卡牌，获取所有可抽取卡牌")
            availableCardIds = List<int>{}
            for cardId, cardData in Gifted_CardData {
                var nature = Convert.ToString(cardData["Nature"])
                var currentCount = 0
                if Gifted_Card_Count[cardId] != nil {
                    currentCount = Gifted_Card_Count[cardId]
                }
                var maxCount = GetMaxDrawCount(nature)
                if currentCount < maxCount {
                    List.Append(availableCardIds, cardId)
                }
            }
        }
        
        // 如果没有可抽取的卡牌，提示并返回
        if List.Length(availableCardIds) == 0 {
            LogWarning("所有卡牌都已达到最大抽取次数")
            return
        }
        // 随机选择一张卡牌
        var randomIndex = RandomInt(0, List.Length(availableCardIds))
        var selectedCardId = availableCardIds[randomIndex]
        var selectedCard = Gifted_CardData[selectedCardId]
        // 更新卡牌计数
        var currentCount = 0
        if List.Length(Gifted_Card_Count) > selectedCardId {
            currentCount = Gifted_Card_Count[selectedCardId]
        }
        // 确保List长度足够
        while List.Length(Gifted_Card_Count) <= selectedCardId {
            List.Append(Gifted_Card_Count, 0)
        }
        // 设置新的数量
        Gifted_Card_Count[selectedCardId] = currentCount + 1
        DATA_Gifted_Card_Count = Gifted_Card_Count
        LogInfo("DATA_Gifted_Card_Count: " + DATA_Gifted_Card_Count)
        
        // 更新总抽卡次数
        TotalDrawCount = TotalDrawCount + 1
        DATA_TotalIFM[0] = TotalDrawCount

        // 保存本地数据
        SAVE_DATA_Gifted(DATA_Gifted_Card_Count, DATA_TotalIFM)
        
        // 应用卡牌效果
        ApplyGiftedCardEffect(selectedCardId)
        
        // 更新UI显示
        UpdateGiftedCardUI(selectedCard)
        
        // 更新抽卡UI显示（价格、概率等）
        UpdateDrawCardUI()

        // 更新天赋加成百分比显示
        DisplayGiftedCardBonusesInUI()

        // 弹出弹框显示抽到的卡牌
        ShowDrawCardPopup(selectedCard)

        currentSelectedCardId = selectedCardId

    }

    func ShowDrawCardPopup(cardInfo Map<string, object>) {
        SoundFunc.PlayCreatedSound("Page_Default_Open")

        // 弹出弹框显示抽到的卡牌
        var PopupPanel = GetWidgetByPath(GetLocalPlayer(), GiftedUI, "/PopupPanel")
        PopupPanel<UIWidget>.IsVisible = true
        
        var cardId = cardInfo["CardID"] as int
        var nature = Convert.ToString(cardInfo["Nature"])
        var value = cardInfo["Value"] as float
        var translationText = Convert.ToString(cardInfo["TranslationText"])
        var GiftedNameText = Convert.ToString(cardInfo["GiftedName"])
        var rarity = cardInfo["Rarity"] as int
        var currentCount = Gifted_Card_Count[cardId]
        var maxCount = GetMaxDrawCount(nature)

        // 更新天赋卡牌说明
        var PopupText = GetWidgetByPath(GetLocalPlayer(), GiftedUI, "/PopupPanel/Bb/ICONBb/Text")
        if PopupText != nil {
            // 直接使用翻译文本
            var PopupTextTTT = LocString{GiftedNameText, List<string>{}}
            PopupText<UIWidgetLabel>.Content = PopupTextTTT
        }

        // 更具稀有度更新边框颜色
        var PopupBorderBBEntity = GetWidgetByPath(GetLocalPlayer(), GiftedUI, "/PopupPanel/Bb/ICONBb")
        var PopupBorderEntity = GetWidgetByPath(GetLocalPlayer(), GiftedUI, "/PopupPanel/Bb/ICONBb/ICONBB/Icon")
        var EresourceSprite = FC_Config.CardRaritySprite[rarity]
        if PopupBorderEntity != nil {
            PopupBorderEntity<UIWidgetImage>.Color = FC_Config.CardRarityColor[rarity]
            if rarity == 1 {
                // 普通 - 蓝色
                PopupBorderBBEntity<UIWidgetImage>.SpriteName = EResSprite.FF_ingame_hud_RandomBuff_Blue
            } else if rarity == 2 {
                // 稀有 - 紫色
                PopupBorderBBEntity<UIWidgetImage>.SpriteName = EResSprite.FF_ingame_hud_RandomBuff_Purple
            } else if rarity == 3 {
                // 史诗 - 金色
                PopupBorderBBEntity<UIWidgetImage>.SpriteName = EResSprite.FF_ingame_hud_RandomBuff_Yellow
            }
        }

        // 更新卡牌图标
        var PopupIconEntity = GetWidgetByPath(GetLocalPlayer(), GiftedUI, "/PopupPanel/Bb/ICONBb/ICONBB/Icon/GiftICON")
        if PopupIconEntity != nil {
            // 显示图标
            PopupIconEntity<UIWidget>.IsVisible = true
            var nature = cardInfo["Nature"]
            var iconKey = "Skill_Just_Do_It"  // 通用默认值

            // 设置图标稀有度颜色
            var rarity = cardInfo["Rarity"] as int
            var iconColor = FC_Config.CardRarityColor[rarity]
            PopupIconEntity<UIWidgetImage>.Color = iconColor
            
            // 检查配置中是否存在该nature对应的图标
            if (nature != nil && nature != "") {
                if (FC_Config.GiftedCardIDs[nature] != nil) {
                    iconKey = nature  // 如果配置中有，直接使用nature作为key
                }
            }
            PopupIconEntity<UIWidgetImage>.SpriteName = FC_Config.GiftedCardIDs[iconKey]
        }
    }

