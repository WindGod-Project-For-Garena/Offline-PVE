        } else if rank == 2 {
            rankSuffix = "/NUM (2)"
        } else if rank == 3 {
            rankSuffix = "/NUM (3)"
        } else if rank == 4 {
            rankSuffix = "/NUM (4)"
        } else if rank == 5 {
            rankSuffix = "/NUM (5)"
        } else if rank == 6 {
            rankSuffix = "/NUM (6)"
        } else if rank == 7 {
            rankSuffix = "/NUM (7)"
        } else if rank == 8 {
            rankSuffix = "/NUM (8)"
        } else if rank == 9 {
            rankSuffix = "/NUM (9)"
        } else if rank == 10 {
            rankSuffix = "/NUM (10)"
        } else {
            return
        }
        var rankPanel = GetWidgetByPath(GetLocalPlayer(), RankingListUI, "/RankPanel/TitleBoard/IFMPanel/IFMPanelBB/LevelAmountIFM/TitleIFM/Part2/RollPanel" + rankSuffix)
