    // 应用卡牌效果
    func ApplyGiftedCardEffect(cardId int) {
        var cardInfo = Gifted_CardData[cardId]
        if cardInfo == nil {
            return
        }
        var nature = Convert.ToString(cardInfo["Nature"])
        var value = cardInfo["Value"] as float
        
        LogInfo("应用天赋卡牌效果: " + nature + " 值: " + Convert.ToString(value))
        
        // 局外天赋加成：基于原始基础数据计算
        if nature == "HP" {
            // HP是固定值加成
            var baseHP = PlayerData["HP"] as int
            var currentOuterHP = 0
            if PlayerDataWithOuterBonus["HP"] != nil {
                currentOuterHP = Round(PlayerDataWithOuterBonus["HP"] as int)
            } else {
                currentOuterHP = baseHP
            }
            PlayerDataWithOuterBonus["HP"] = currentOuterHP + value as int
            LogInfo("局外HP: 基础" + Convert.ToString(baseHP) + " + " + Convert.ToString(value) + " = " + Convert.ToString(PlayerDataWithOuterBonus["HP"]))
        
        } else if nature == "MoveSpeed" {
            // 移速：百分比加成
            var baseSpeed = PlayerData["MoveSpeed"] as float
            var currentMultiplier = 1.0
            if PlayerDataWithOuterBonus["MoveSpeed_Multiplier"] != nil {
                currentMultiplier = PlayerDataWithOuterBonus["MoveSpeed_Multiplier"] as float
            }
            PlayerDataWithOuterBonus["MoveSpeed_Multiplier"] = currentMultiplier + value
            PlayerDataWithOuterBonus["MoveSpeed"] = baseSpeed * PlayerDataWithOuterBonus["MoveSpeed_Multiplier"] as float
            LogInfo("局外移速: 基础" + Convert.ToString(baseSpeed) + " × " + Convert.ToString(PlayerDataWithOuterBonus["MoveSpeed_Multiplier"]) + " = " + Convert.ToString(PlayerDataWithOuterBonus["MoveSpeed"]))

        } else if nature == "WeaponDamage" {
            // 武器伤害：百分比加成
            var baseDamage1 = Skill1Data["WeaponDamage"] as int
            var baseDamage2 = Skill2Data["WeaponDamage"] as int
            var currentMultiplier = 1.0

            // 技能1
            if Skill1DataWithOuterBonus["WeaponDamage_Multiplier"] != nil {
                currentMultiplier = Skill1DataWithOuterBonus["WeaponDamage_Multiplier"] as float
            }
            Skill1DataWithOuterBonus["WeaponDamage_Multiplier"] = currentMultiplier + value
            Skill1DataWithOuterBonus["WeaponDamage"] = Round(baseDamage1 * Skill1DataWithOuterBonus["WeaponDamage_Multiplier"] as float) as int
            LogInfo("局外武器1伤害: 基础" + Convert.ToString(baseDamage1) + " × " + Convert.ToString(Skill1DataWithOuterBonus["WeaponDamage_Multiplier"]) + " = " + Convert.ToString(Skill1DataWithOuterBonus["WeaponDamage"]))

            // 技能2
            if Skill2DataWithOuterBonus["WeaponDamage_Multiplier"] != nil {
                currentMultiplier = Skill2DataWithOuterBonus["WeaponDamage_Multiplier"] as float
            }
            Skill2DataWithOuterBonus["WeaponDamage_Multiplier"] = currentMultiplier + value
            Skill2DataWithOuterBonus["WeaponDamage"] = Round(baseDamage2 * Skill2DataWithOuterBonus["WeaponDamage_Multiplier"] as float) as int
            LogInfo("局外武器2伤害: 基础" + Convert.ToString(baseDamage2) + " × " + Convert.ToString(Skill2DataWithOuterBonus["WeaponDamage_Multiplier"]) + " = " + Convert.ToString(Skill2DataWithOuterBonus["WeaponDamage"]))

        } else if nature == "SkillDamage" {
            // 技能伤害：同时影响技能1和技能2
            var baseSkill1Damage = Skill1Data["SkillDamage"] as int
            var baseSkill2Damage = Skill2Data["SkillDamage"] as int
            
            // 技能1
            var currentMultiplier1 = 1.0
            if Skill1DataWithOuterBonus["SkillDamage_Multiplier"] != nil {
                currentMultiplier1 = Skill1DataWithOuterBonus["SkillDamage_Multiplier"] as float
            }
            Skill1DataWithOuterBonus["SkillDamage_Multiplier"] = currentMultiplier1 + value
            Skill1DataWithOuterBonus["SkillDamage"] = Round(baseSkill1Damage * Skill1DataWithOuterBonus["SkillDamage_Multiplier"] as float) as int
            LogInfo("局外技能伤害: 技能1 基础" + Convert.ToString(baseSkill1Damage) + " × " + Convert.ToString(Skill1DataWithOuterBonus["SkillDamage_Multiplier"]) + " = " + Convert.ToString(Skill1DataWithOuterBonus["SkillDamage"]))
            
            // 技能2
            var currentMultiplier2 = 1.0
            if Skill2DataWithOuterBonus["SkillDamage_Multiplier"] != nil {
                currentMultiplier2 = Skill2DataWithOuterBonus["SkillDamage_Multiplier"] as float
            }
            Skill2DataWithOuterBonus["SkillDamage_Multiplier"] = currentMultiplier2 + value
            Skill2DataWithOuterBonus["SkillDamage"] = Round(baseSkill2Damage * Skill2DataWithOuterBonus["SkillDamage_Multiplier"] as float) as int
            LogInfo("局外技能伤害: 技能2 基础" + Convert.ToString(baseSkill2Damage) + " × " + Convert.ToString(Skill2DataWithOuterBonus["SkillDamage_Multiplier"]) + " = " + Convert.ToString(Skill2DataWithOuterBonus["SkillDamage"]))
        }
        
        // 将局外数据复制到局内数据（开始游戏时）
        CopyToInGameData()
        // 更新玩家当前属性（使用局内数据）
        UpdatePlayerAttributes()
    }

    // 更新玩家当前属性（使用局内数据）
    func UpdatePlayerAttributes() {
        // 更新玩家当前属性（使用局内数据）
        currPlayer<Player>.MaxHP = Round(PlayerDataInGame["HP"] as int)
        currPlayer<Player>.HP = Round(PlayerDataInGame["HP"] as int)
        currPlayer<Player>.RunSpeedScale = PlayerDataInGame["MoveSpeed"] as float
    }

    // 更新技能1数据
    func UpdateSkill1Data() {
        if CurrentSkill == 1 {
            LogInfo(currentWeapon)
            //设置武器伤害
            var weaponDamage = Round(Skill1DataInGame["WeaponDamage"] as int)
            currentWeapon<Weapon>.Damage = weaponDamage
            //设置武器换弹速度
            var ReloadSpeed = Skill1DataInGame["ReloadSpeed"] as float
            currentWeapon<Weapon>.ReloadSpeedFactor = ReloadSpeed
            //设置武器攻击速度
            var AttackSpeed = Skill1DataInGame["AttackSpeed"] as float
            currentWeapon<Weapon>.AttackInterval = AttackSpeed
            //设置武器弹匣容量
            var AmmoMagSize = Skill1DataInGame["WeaponMaxMagazine"] as int
            currentWeapon<Weapon>.AmmoMagSize = AmmoMagSize
        }
    }

    // 更新技能2数据
    func UpdateSkill2Data() {
        if CurrentSkill == 2 {
            LogInfo(currentWeapon)
            //设置武器伤害
            var weaponDamage = Round(Skill2DataInGame["WeaponDamage"] as int)
            currentWeapon<Weapon>.Damage = weaponDamage
            //设置武器换弹速度
            var ReloadSpeed = Skill2DataInGame["ReloadSpeed"] as float
            currentWeapon<Weapon>.ReloadSpeedFactor = ReloadSpeed
            //设置武器攻击速度
            var AttackSpeed = Skill2DataInGame["AttackSpeed"] as float
            currentWeapon<Weapon>.AttackInterval = AttackSpeed
            //设置武器弹匣容量
            var AmmoMagSize = Skill2DataInGame["WeaponMaxMagazine"] as int
            currentWeapon<Weapon>.AmmoMagSize = AmmoMagSize
            currentWeapon<Weapon>.CurrentAmmo = currentWeapon<Weapon>.AmmoMagSize
        }
    }
