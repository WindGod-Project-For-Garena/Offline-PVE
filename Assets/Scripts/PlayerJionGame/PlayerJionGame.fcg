    // 玩家复活删除武器
    event OnPlayerRevived(player entity<Player>, revivalSource PlayerReviveSourceType){
        Offline.DestroyItem(ItemIDType.M1887X, 1)
        Offline.DestroyItem(ItemIDType.SGAmmo, 999)
        Offline.DestroyItem(ItemIDType.GoldMP5_III, 1)
        Offline.DestroyItem(ItemIDType.SGAmmo, 999)
    }

    // DEbug的初始化
    func S_Debug_NextWave() {
        IsCountdownActive = false
        Offline.DestroyItem(ItemIDType.M1887X, 1)
        Offline.DestroyItem( ItemIDType.SGAmmo, 999)
        Offline.DestroyItem(ItemIDType.GoldMP5_III, 1)
        Offline.DestroyItem( ItemIDType.SGAmmo, 999)
        currPlayer<Player>.MaxHP = Round(PlayerDataWithOuterBonus["HP"] as int)
        currPlayer<Player>.HP = Round(PlayerDataWithOuterBonus["HP"] as int)
        currPlayer<Player>.RunSpeedScale = PlayerDataWithOuterBonus["MoveSpeed"] as float
        start PVEController.OnGameComplete()
        // 关闭无关UI
        ChoiceThreeCardUI<CustomUI>.IsVisible = false
    }
