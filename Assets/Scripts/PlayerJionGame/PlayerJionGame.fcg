                }
                Skill1DataInGame["WeaponMaxMagazine"] = finalMagazine
                LogInfo("弹匣容量: " + Convert.ToString(Skill1DataInGame["WeaponMaxMagazine"]))
            }
            // 更新玩家技能一属性（使用局内数据）
            UpdateSkill1Data()
        }
        //=========================================================================================================//
        // 技能2专属属性
