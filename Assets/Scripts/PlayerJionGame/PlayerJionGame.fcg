    // 初始化所有卡牌图鉴UI状态
    func InitAllCardBookUI(hero int) {
        // 获取列表父节点
        var listGrandfather = GetWidgetByPath(GetLocalPlayer(), HeroUI, "/Panel/RollPanel")
        var listParent = GetChildByName(listGrandfather, "List")
        if hero == 1 {
            // 职业1有33张卡牌
            for cardId = 1, 33, 1 {
                var cardInfo = Skill_1_CardData[cardId]
                if cardInfo != nil {
                    // 根据当前计数更新UI状态
                    UpdateSingleCardBookUI(cardId, listParent ,cardInfo)
                }
            }
            // 隐藏多余的卡牌（如果有的话）
            for cardId = 33, 40, 1 {
                var cardEntity = GetChildByName(listParent, "Card (" + Convert.ToString(cardId) + ")")
                if cardEntity != nil {
                    cardEntity<UIWidget>.IsVisible = false
                }
            }
        }
        if hero == 2 {
            // 职业2有31张卡牌
            for cardId = 1, 31, 1 {
                var cardInfo = Skill_2_CardData[cardId]
                if cardInfo != nil {
                    // 根据当前计数更新UI状态
                    UpdateSingleCardBookUI(cardId, listParent ,cardInfo)
                }
            }
            // 隐藏多余的卡牌（31-33张）
            for cardId = 31, 40, 1 {
                var cardEntity = GetChildByName(listParent, "Card (" + Convert.ToString(cardId) + ")")
                if cardEntity != nil {
                    cardEntity<UIWidget>.IsVisible = false
                }
            }
        }
    }

    // 更新单个卡牌的UI状态
    func UpdateSingleCardBookUI(cardId int, listParent entity<Entity> ,cardInfo Map<string, object>) {
        var cardEntity = GetChildByName(listParent, "Card (" + Convert.ToString(cardId) + ")")
        if cardEntity == nil {
            LogWarning("卡牌实体不存在: Card (" + Convert.ToString(cardId) + ")")
            return
        }
        // 确保卡牌显示
        cardEntity<UIWidget>.IsVisible = true
        if cardInfo == nil {
            LogWarning("卡牌数据不存在，ID:" + Convert.ToString(cardId))
            return
        }
        // 显示面板
        var hasCardPanelEntity = GetChildByName(cardEntity, "HasCardPanel")
        if hasCardPanelEntity != nil {
            hasCardPanelEntity<UIWidget>.IsVisible = true
        }
        //——————————————————————————————————————————————————————————————————————————————————————————————//
        // 显示图标
        var iconImageEntity = GetChildByName(cardEntity, "IconImage")
        if iconImageEntity != nil {
            iconImageEntity<UIWidget>.IsVisible = false
        }
        var hasCardIconEntity = GetChildByName(hasCardPanelEntity, "icon")
        if hasCardIconEntity != nil {
            // 设置卡牌图标
            // hasCardIconEntity<UIWidgetImage>.SetImage("CardIcon_" + Convert.ToString(cardId))
            hasCardIconEntity<UIWidget>.IsVisible = true
        }
        //——————————————————————————————————————————————————————————————————————————————————————————————//
        // 显示详细信息
        var IFMTextEntity = GetChildByName(hasCardPanelEntity, "IFMText")
        if IFMTextEntity != nil {
            var description = GenerateCardDescription(cardInfo)
            IFMTextEntity<UIWidgetLabel>.Content = description
            IFMTextEntity<UIWidget>.IsVisible = true
        }
        //——————————————————————————————————————————————————————————————————————————————————————————————//
        // 设置稀有度显示
        var rarity = cardInfo["Rarity"] as int
        UpdateCardBookRarityUI(cardEntity, rarity)
    }

    // 更新卡牌图鉴稀有度显示（根据稀有度显示不同的边框颜色）
    func UpdateCardBookRarityUI(cardEntity entity<Entity>, rarity int) {
        if cardEntity != nil {
            // 根据稀有度设置不同的颜色
            if rarity == 1 {
                // 普通 - 蓝色
                cardEntity<UIWidgetButton>.Color = #1B92D6
            } else if rarity == 2 {
                // 稀有 - 紫色
                cardEntity<UIWidgetButton>.Color = #6C00FF
            } else if rarity == 3 {
                // 史诗 - 金色
                cardEntity<UIWidgetButton>.Color = #FFD700
            }
        }
    }
//———————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————//
//—————————————————————————————————————————————————以下为結算統計相关方程——————————————————————————————————————————————————————//
//—————————————————————————————————————————————————以下为結算統計相关方程——————————————————————————————————————————————————————//
//———————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————//
    func ToClient_ShowFinalStats(currTime int, GameStartTime int, IsGameSuccess bool, totalTime int, CurrentLevel int) {
        GameOverFinalUI<CustomUI>.IsVisible = true
        var StepEntity = GetWidgetByPath(GetLocalPlayer(), GameOverFinalUI, "/Panel/HeroPanel/GameOverIFM/StepPanel/Step/Name")                             //當前關卡
        var IsPassOrNoEntity = GetWidgetByPath(GetLocalPlayer(), GameOverFinalUI, "/Panel/FuncPanel/IsPassOrNo")                                            //通關狀態
        var PassTimeEntity = GetWidgetByPath(GetLocalPlayer(), GameOverFinalUI, "/Panel/HeroPanel/GameOverIFM/PassTimePanel/PassTime/text")                 //通關時間
        var BossKillTimeEntity = GetWidgetByPath(GetLocalPlayer(), GameOverFinalUI, "/Panel/HeroPanel/GameOverIFM/BossKillTimePanel/BossKillTime/text")     //殺死BOSS時間
        var GetMoneyEntity = GetWidgetByPath(GetLocalPlayer(), GameOverFinalUI, "/Panel/HeroPanel/GameOverIFM/GetMoneyPanel/GetMoney/text")                 //獲得金錢

        var Hero1Entity = GetWidgetByPath(GetLocalPlayer(), GameOverFinalUI, "/Panel/HeroPanel/HeroIfmPanel/Hero1IFMPanel")                  //使用角色1
        var Hero2Entity = GetWidgetByPath(GetLocalPlayer(), GameOverFinalUI, "/Panel/HeroPanel/HeroIfmPanel/Hero2IFMPanel")                  //使用角色2

        var HeroDamage1Entity = GetWidgetByPath(GetLocalPlayer(), GameOverFinalUI, "/Panel/DamageNum/Skill_1_Damage_IFM")                  //使用角色1伤害
        var HeroDamage2Entity = GetWidgetByPath(GetLocalPlayer(), GameOverFinalUI, "/Panel/DamageNum/Skill_2_Damage_IFM")                  //使用角色2伤害

        if  CurrentSkill == 1 {
            Hero1Entity<UIWidget>.IsVisible = true
            HeroDamage1Entity<UIWidget>.IsVisible = true
            Hero2Entity<UIWidget>.IsVisible = false
            HeroDamage2Entity<UIWidget>.IsVisible = false

        }
        if  CurrentSkill == 2 {
            Hero1Entity<UIWidget>.IsVisible = false
            HeroDamage1Entity<UIWidget>.IsVisible = false
            Hero2Entity<UIWidget>.IsVisible = true
            HeroDamage2Entity<UIWidget>.IsVisible = true
        }

        //  通關顯示
        if  IsGameSuccess == true {
            IsPassOrNoEntity<UIWidgetLabel>.Content = "VICTORY"
            IsPassOrNoEntity<UIWidgetLabel>.Color = #F1BF48
        } else {
            IsPassOrNoEntity<UIWidgetLabel>.Content = "DEFEAT"
            IsPassOrNoEntity<UIWidgetLabel>.Color = #A3A3A3FF
        }

        StepEntity<UIWidgetLabel>.Content = "第" + Convert.ToString(CurrentLevel) + "关"  

        var Time string = PVEController.FormatTimeMMSS(totalTime)
        PassTimeEntity<UIWidgetLabel>.Content = Convert.ToString(Time)
        BossKillTimeEntity<UIWidgetLabel>.Content = Convert.ToString(Time)

        GetMoneyEntity<UIWidgetLabel>.Content = 1000

        // ==================== 显示已选择的三选一卡牌 ====================
        // 获取已选择的卡牌列表
        var selectedCards = List<int>{}
        if CurrentSkill == 1 {
            selectedCards = SelectedCards_1
        } else if CurrentSkill == 2 {
            selectedCards = SelectedCards_2
        }
        
        // 获取NowCard列表的父节点
        var nowCardListParent = GetWidgetByPath(GetLocalPlayer(), GameOverFinalUI, "/Panel/NowCard/List")
        
        // 隐藏所有的卡牌位置（最多显示5个）
        for i = 1, 6, 1 {
            var cardPath = "Card (" + Convert.ToString(i) + ")"
            var cardEntity = GetChildByName(nowCardListParent, cardPath)
            if cardEntity != nil {
                cardEntity<UIWidget>.IsVisible = false
            }
        }
        
        // 显示实际已选择的卡牌（最多显示5张）
        var displayCount = Math.Min(List.Length(selectedCards), 6)

        for i = 0, displayCount, 1 {
            var cardIndex = i + 1
            var cardId = selectedCards[i]
            
            var cardPath = "Card (" + Convert.ToString(cardIndex) + ")"
            var cardEntity = GetChildByName(nowCardListParent, cardPath)
            
            if cardEntity != nil {
                // 显示卡牌位置
                cardEntity<UIWidget>.IsVisible = true
                
                // 获取卡牌信息
                var cardInfo = GetCardInfoById(cardId, CurrentSkill)
                if cardInfo != nil {
                    // 获取HasCardPanel
                    var hasCardPanel = GetChildByName(cardEntity, "HasCardPanel")
                    if hasCardPanel != nil {
                        // 设置技能文字
                        var ifmText = GetChildByName(hasCardPanel, "IFMText")
                        if ifmText != nil {
                            var description = GenerateCardDescription(cardInfo)
                            ifmText<UIWidgetLabel>.Content = description
                        }
                        
                        // 设置图标
                        var iconWidget = GetChildByName(hasCardPanel, "icon")
                        if iconWidget != nil {
                            //iconWidget<UIWidgetImage>.SetImage("CardIcon_" + Convert.ToString(cardId))
                            iconWidget<UIWidget>.IsVisible = true
                        }
                    }
                } else {
                    LogWarning("未找到卡牌ID " + Convert.ToString(cardId) + " 的信息")
                }
            } else {
                LogWarning("找不到卡牌UI位置: " + cardPath)
            }
        }
        //=======================显示相关伤害统计======================//
        var AllDamageEntity = GetWidgetByPath(GetLocalPlayer(), GameOverFinalUI, "/Panel/DamageNum/AllDamage/Bb/AllDamage/Num")  //总伤害
        var Weapon1DamageEntity = GetWidgetByPath(GetLocalPlayer(), GameOverFinalUI, "/Panel/DamageNum/Skill_1_Damage_IFM/Weapon/Weapon/Name")      //武器1普攻
        var Skill1DamageEntity = GetWidgetByPath(GetLocalPlayer(), GameOverFinalUI, "/Panel/DamageNum/Skill_1_Damage_IFM/Boom/Boom/text")           //技能1伤害
        var BurningDamageEntity = GetWidgetByPath(GetLocalPlayer(), GameOverFinalUI, "/Panel/DamageNum/Skill_1_Damage_IFM/Fire/Fire/text")          //燃烧伤害
        var GrenadeDamageEntity = GetWidgetByPath(GetLocalPlayer(), GameOverFinalUI, "/Panel/DamageNum/Skill_1_Damage_IFM/GunBoom/GunBoom/text")    //榴弹爆炸伤害

        var Weapon2DamageEntity = GetWidgetByPath(GetLocalPlayer(), GameOverFinalUI, "/Panel/DamageNum/Skill_2_Damage_IFM/Weapon/Weapon/Name")      //武器2普攻
        var Skill2DamageEntity = GetWidgetByPath(GetLocalPlayer(), GameOverFinalUI, "/Panel/DamageNum/Skill_2_Damage_IFM/Elect/Boom/text")           //技能2伤害
        var LightningExplosionDamageEntity = GetWidgetByPath(GetLocalPlayer(), GameOverFinalUI, "/Panel/DamageNum/Skill_2_Damage_IFM/Fire/Fire/text") //闪电爆炸伤害
        var LightningDamageEntity = GetWidgetByPath(GetLocalPlayer(), GameOverFinalUI, "/Panel/DamageNum/Skill_2_Damage_IFM/GunBoom/GunBoom/text")    //闪电伤害

        if CurrentSkill == 1 {
            AllDamage = WeaponDamage + Skill1Damage + BurningDamage + GrenadeDamage
        }
        if CurrentSkill == 2 {
            AllDamage = WeaponDamage + Skill2Damage + LightningExplosionDamage + LightningDamage
        }
        AllDamageEntity<UIWidgetLabel>.Content = Convert.ToString(AllDamage)

        Weapon1DamageEntity<UIWidgetLabel>.Content = Convert.ToString(WeaponDamage)
        Skill1DamageEntity<UIWidgetLabel>.Content = Convert.ToString(Skill1Damage)
        BurningDamageEntity<UIWidgetLabel>.Content = Convert.ToString(BurningDamage)
        GrenadeDamageEntity<UIWidgetLabel>.Content = Convert.ToString(GrenadeDamage)

        Weapon2DamageEntity<UIWidgetLabel>.Content = Convert.ToString(WeaponDamage)
        Skill2DamageEntity<UIWidgetLabel>.Content = Convert.ToString(Skill2Damage)
        LightningExplosionDamageEntity<UIWidgetLabel>.Content = Convert.ToString(LightningExplosionDamage)
        LightningDamageEntity<UIWidgetLabel>.Content = Convert.ToString(LightningDamage)
        //============================================================//
        //恢复默认选择技能1
        CurrentSkill = 1
        ToClient_GameComplete()
    }
//———————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————//
    func ToClient_DisplaySkillThreeChoiceOne() {
        ChoiceThreeCardUI<CustomUI>.IsVisible = true
        IsNextThreeChoiceOne = 1       //打开标志位
        RefeshCard(level, ability1Level, ability2Level, ability3Level)
        // start ShowSecondDown(10000)
        // 隐藏波次和时间信息
        TimeInGameUI<CustomUI>.IsVisible = false
    }

    func ToClient_GameComplete() {
        // 隐藏所有技能面板
        for i = 1, 3,1{
            var skillPanel = GetWidgetByPath(GetLocalPlayer(), SkillUI, "/Skill_" + i)
            var joyStickAmount = GetWidgetByPath(GetLocalPlayer(), SkillUI, "/Skill_" + i + "/JoyStickFillAmount")
            skillPanel<UIWidget>.IsVisible = false
            joyStickAmount<UIWidget>.IsVisible = false
        }
        // 重置数据
        ResetInGameData()
        // 清空已选卡牌记录
        ClearSelectedCards()
        // 重置伤害数据
        ResetDamageData()
        // 恢复默认没有选择卡牌 
        NowChoiceCard = 0
        // 重置子弹判定
        AmmoJudgement = 0
    }

    // 重置伤害数据
    func ResetDamageData() {
        AllDamage  = 0       // 伤害统计

        WeaponDamage  = 0    // 武器伤害统计
        
        Skill1Damage  = 0    // 技能1伤害统计
        BurningDamage  = 0   // 燃烧伤害统计
        GrenadeDamage  = 0   // 榴弹伤害统计

        Skill2Damage  = 0                    // 技能2伤害统计
        LightningExplosionDamage  = 0        // 闪电爆炸伤害统计
        LightningDamage  = 0                 // 闪电伤害统计
    }
    //———————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————//

    // 重置数据
    func ResetInGameData() {
        CopyToInGameData()
        LogInfo("局内数据已重置为局外天赋加成数据")
    }

    func displaySkillByIndex(index int) {
        // 隐藏所有技能面板
        for i = 1, 3,1{
            var skillPanel = GetWidgetByPath(GetLocalPlayer(), SkillUI, "/Skill_" + i)
            var joyStickAmount = GetWidgetByPath(GetLocalPlayer(), SkillUI, "/Skill_" + i + "/JoyStickFillAmount")
            skillPanel<UIWidget>.IsVisible = false
            joyStickAmount<UIWidget>.IsVisible = false
        }
        
        // 显示当前选中的技能
        var currentSkillPanel = GetWidgetByPath(GetLocalPlayer(), SkillUI, "/Skill_" + index)
        var currentJoyStick = GetWidgetByPath(GetLocalPlayer(), SkillUI, "/Skill_" + index + "/JoyStickFillAmount")
        currentSkillPanel<UIWidget>.IsVisible = true
        currentJoyStick<UIWidget>.IsVisible = false
    }
