    // 获取剩余可用卡牌数量
    func GetAvailableCardCount(CurrentSkill int) int {
        var cardDataMap = Map<int, Map<string, object>>{}
        var selectedCards = List<int>{}
        if CurrentSkill == 1 {
            cardDataMap = Skill_1_CardData
            selectedCards = SelectedCards_1
        } else if CurrentSkill == 2 {
            cardDataMap = Skill_2_CardData
            selectedCards = SelectedCards_2
        }
        return Map.Length(cardDataMap) - List.Length(selectedCards)
    }

    func UpdateCardUI(card1 Map<string, object>, card2 Map<string, object>, card3 Map<string, object>) {
        // 更新卡牌1的UI
        if card1 != nil {
            //——————————————————————————————————————————————————————————————————————————————————————————————//
            // 设置卡牌1的图标
            var card1Icon = GetWidgetByPath(GetLocalPlayer(), ChoiceThreeCardUI, "/ChoiceThreeCardPanel/Card_1/icon")
            // card1Icon<UIWidgetImage>.SetImage("CardIcon_" + Convert.ToString(card1["CardID"]))
            //——————————————————————————————————————————————————————————————————————————————————————————————//
            // 设置卡牌1的技能说明
            var card1Text = GetWidgetByPath(GetLocalPlayer(), ChoiceThreeCardUI, "/ChoiceThreeCardPanel/Card_1/IFMText")
            var description = GenerateCardDescription(card1)
            card1Text<UIWidgetLabel>.Content = description
            //——————————————————————————————————————————————————————————————————————————————————————————————//
            // 设置卡牌1的稀有度显示
            var rarity1 = card1["Rarity"] as int
            UpdateCardRarityUI(1, rarity1)
        }
        // 更新卡牌2的UI
        if card2 != nil {
            //——————————————————————————————————————————————————————————————————————————————————————————————//
            // 设置卡牌2的图标
            var card2Icon = GetWidgetByPath(GetLocalPlayer(), ChoiceThreeCardUI, "/ChoiceThreeCardPanel/Card_2/icon")
            // card2Icon<UIWidgetImage>.SetImage("CardIcon_" + Convert.ToString(card2["CardID"]))
            //——————————————————————————————————————————————————————————————————————————————————————————————//
            // 设置卡牌2的技能说明
            var card2Text = GetWidgetByPath(GetLocalPlayer(), ChoiceThreeCardUI, "/ChoiceThreeCardPanel/Card_2/IFMText")
            var description = GenerateCardDescription(card2)
            card2Text<UIWidgetLabel>.Content = description
            //——————————————————————————————————————————————————————————————————————————————————————————————//
            // 设置卡牌2的稀有度显示
            var rarity2 = card2["Rarity"] as int
            UpdateCardRarityUI(2, rarity2)
        }
        // 更新卡牌3的UI
        if card3 != nil {
            //——————————————————————————————————————————————————————————————————————————————————————————————//
            // 设置卡牌3的图标
            var card3Icon = GetWidgetByPath(GetLocalPlayer(), ChoiceThreeCardUI, "/ChoiceThreeCardPanel/Card_3/icon")
            // card3Icon<UIWidgetImage>.SetImage("CardIcon_" + Convert.ToString(card3["CardID"]))
            //——————————————————————————————————————————————————————————————————————————————————————————————//
            // 设置卡牌3的技能说明
            var card3Text = GetWidgetByPath(GetLocalPlayer(), ChoiceThreeCardUI, "/ChoiceThreeCardPanel/Card_3/IFMText")
            var description = GenerateCardDescription(card3)
            card3Text<UIWidgetLabel>.Content = description
            //——————————————————————————————————————————————————————————————————————————————————————————————//
            // 设置卡牌2的稀有度显示
            var rarity3 = card3["Rarity"] as int
            UpdateCardRarityUI(3, rarity3)
        }
        LogInfo("卡牌UI更新完成")
    }
    // 生成卡牌描述文本
    func GenerateCardDescription(card Map<string, object>) string {
        var translationText = Convert.ToString(card["TranslationText"])
        // 如果有翻译文本，直接使用
        if translationText != "" && translationText != "None" {
            return translationText
        }
    }
    // 更新卡牌稀有度显示（根据稀有度显示不同的边框颜色）
    func UpdateCardRarityUI(cardIndex int, rarity int) {
        var rarityPath = "/ChoiceThreeCardPanel/Card_" + Convert.ToString(cardIndex)
        var rarityWidget = GetWidgetByPath(GetLocalPlayer(), ChoiceThreeCardUI, rarityPath)
        if rarityWidget != nil {
            // 根据稀有度设置不同的颜色
            if rarity == 1 {
                // 普通 - 蓝色
                rarityWidget<UIWidgetButton>.Color = #1B92D6
            } else if rarity == 2 {
                // 稀有 - 紫色
                rarityWidget<UIWidgetButton>.Color = #6C00FF
            } else if rarity == 3 {
                // 史诗 - 金色
                rarityWidget<UIWidgetButton>.Color = #FFD700
            }
        }
    }
//———————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————//
//—————————————————————————————————————————————————以下为天赋卡片的数据————————————————————————————————————————————————————————//
//—————————————————————————————————————————————————以下为天赋卡片的数据————————————————————————————————————————————————————————//
//———————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————//
    // 注入天赋卡片的数据
    func InjectGifted_CardData() {
        // 解析CSV
        Map.Clear(Gifted_CardData)
        for cardId = 1, 11, 1 {
            var cardInfo = Map<string, object>{}
            cardInfo["CardID"] = cardId
            // 从CSV读取卡牌数据，从第三行开始读取
            var cardRow = CSVData.ReadCSVRow(EResCSV.GiftedData, cardId + 2)
            cardInfo["Nature"] = cardRow[1]
            cardInfo["Value"] = cardRow[2] as List<float>
            cardInfo["Rarity"] = cardRow[3] as List<int>
            cardInfo["TranslationText"] = cardRow[4]
            cardInfo["Sktchtext"] = cardRow[5]
            Gifted_CardData[cardId] = cardInfo
            // 在显示时格式化浮点数，保留两位小数
            // LogInfo(Gifted_CardData[cardId])
        }
        LogInfo("天赋卡片注入完成")
    }

    // 注入天赋卡片概率数据
    func InjectGiftCardProbabilityData() {
        // 解析CSV
        List.Clear(Gifted_CardProbability)
        for rowIndex = 1, 11, 1 {
            var configInfo = Map<string, object>{}
            // 从CSV读取概率数据，从第三行开始读取
            var configRow = CSVData.ReadCSVRow(EResCSV.GiftCardProbabilityData, rowIndex + 2)
            configInfo["MinCount"] = configRow[0] as int
            configInfo["Price"] = configRow[1] as int
            configInfo["CommonProb"] = configRow[2] as float
            configInfo["RareProb"] = configRow[3] as float
            configInfo["EpicProb"] = configRow[4] as float
            List.Append(Gifted_CardProbability, configInfo)
            // LogInfo("抽卡配置" + Convert.ToString(rowIndex) + ": " + Convert.ToString(configInfo))
        }
        LogInfo("天赋卡片概率数据注入完成")
    }
//———————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————//
    // 获取当前抽卡配置
    func GetCurrentDrawConfig() Map<string, object> {
        for i, config in Gifted_CardProbability {
            if TotalDrawCount >= config["MinCount"] as int {
                // 检查是否是最后一个配置
                if i == List.Length(Gifted_CardProbability) - 1 {
                    return config
                }
                // 检查下一个配置的最小次数是否大于当前抽卡次数
                var nextConfig = Gifted_CardProbability[i + 1]
                if TotalDrawCount < nextConfig["MinCount"] as int {
                    return config
                }
            }
        }
        // 默认返回第一个配置
        return Gifted_CardProbability[0]
    }

    // 获取当前抽卡价格
    func GetCurrentDrawPrice() int {
        var config = GetCurrentDrawConfig()
        return config["Price"] as int
    }

    // 根据概率随机选择卡牌稀有度
    func SelectCardByProbability() int {
        var config = GetCurrentDrawConfig()
        var randomValue = RandomFloat(0.0, 1.0)
        var commonProb = config["CommonProb"] as float
        var rareProb = config["RareProb"] as float
        var epicProb = config["EpicProb"] as float
        LogInfo("当前概率 - 普通:" + Convert.ToString(commonProb) + " 稀有:" + Convert.ToString(rareProb) + " 史诗:" + Convert.ToString(epicProb))
        if randomValue < commonProb {
            return 1  // 普通
        } else if randomValue < commonProb + rareProb {
            return 2  // 稀有
        } else {
            return 3  // 史诗
        }
    }

    // 根据稀有度筛选可抽取的卡牌
    func GetAvailableCardsByRarity(targetRarity int) List<int> {
        var availableCardIds = List<int>{}
        for cardId, cardData in Gifted_CardData {
            var nature = Convert.ToString(cardData["Nature"])
            var currentCount = 0
            if Gifted_Card_Count[cardId] != nil {
                currentCount = Gifted_Card_Count[cardId]
            }
            
            // 检查是否达到最大抽取次数
            var maxCount = GetMaxDrawCount(nature)
            if currentCount < maxCount {
                // 检查稀有度是否匹配
                var cardRarity = cardData["Rarity"] as int
                if cardRarity == targetRarity {
                    List.Append(availableCardIds, cardId)
                }
            }
        }
        
        return availableCardIds
    }

    // 抽卡
    func DrawCard() {
        // 获取当前抽卡价格
        var currentPrice = GetCurrentDrawPrice()
        var currentConfig = GetCurrentDrawConfig()
        
        // LogInfo("开始抽卡 - 总次数:" + Convert.ToString(TotalDrawCount) + 
        //         " 价格:" + Convert.ToString(currentPrice) +
        //         " 阶段:" + Convert.ToString(currentConfig["MinCount"]) + "+")
        
        // 检查玩家是否有足够的货币
        if  Money < currentPrice {
            LogWarning("货币不足，需要" + Convert.ToString(currentPrice))
            return
        }
        
        // 扣除货币
        DeductPlayerCurrency(currentPrice)
        
        // 根据概率选择稀有度
        var selectedRarity = SelectCardByProbability()
        
        // 获取该稀有度下可抽取的卡牌
        var availableCardIds = GetAvailableCardsByRarity(selectedRarity)
        
        // 如果该稀有度没有可抽取的卡牌，降级到下一个稀有度
        if List.Length(availableCardIds) == 0 {
            if selectedRarity == 3 {  // 史诗降级到稀有
                availableCardIds = GetAvailableCardsByRarity(2)
                if List.Length(availableCardIds) == 0 {
                    availableCardIds = GetAvailableCardsByRarity(1)  // 稀有降级到普通
                }
            } else if selectedRarity == 2 {  // 稀有降级到普通
                availableCardIds = GetAvailableCardsByRarity(1)
            }
        }
        
        // 如果仍然没有可抽取的卡牌，获取所有可抽取的卡牌
        if List.Length(availableCardIds) == 0 {
            LogWarning("特定稀有度没有可抽取的卡牌，获取所有可抽取卡牌")
            availableCardIds = List<int>{}
            for cardId, cardData in Gifted_CardData {
                var nature = Convert.ToString(cardData["Nature"])
                var currentCount = 0
                if Gifted_Card_Count[cardId] != nil {
                    currentCount = Gifted_Card_Count[cardId]
                }
                var maxCount = GetMaxDrawCount(nature)
                if currentCount < maxCount {
                    List.Append(availableCardIds, cardId)
                }
            }
        }
        
        // 如果没有可抽取的卡牌，提示并返回
        if List.Length(availableCardIds) == 0 {
            LogWarning("所有卡牌都已达到最大抽取次数")
            return
        }
        // 随机选择一张卡牌
        var randomIndex = RandomInt(0, List.Length(availableCardIds))
        var selectedCardId = availableCardIds[randomIndex]
        var selectedCard = Gifted_CardData[selectedCardId]
        // 更新卡牌计数
        var currentCount = 0
        if Gifted_Card_Count[selectedCardId] != nil {
            currentCount = Gifted_Card_Count[selectedCardId]
        }
        Gifted_Card_Count[selectedCardId] = currentCount + 1
        
        // 更新总抽卡次数
        TotalDrawCount = TotalDrawCount + 1
        
        // 应用卡牌效果
        ApplyGiftedCardEffect(selectedCardId)
        
        // 更新UI显示
        UpdateGiftedCardUI(selectedCard)
        
        // 更新抽卡UI显示（价格、概率等）
        UpdateDrawCardUI()
    }

    // 扣除玩家货币
    func DeductPlayerCurrency(price int) {
        Money = Money - price
    }

    // 更新抽卡UI显示（价格、概率等信息）
    func UpdateDrawCardUI() {
        var currentConfig = GetCurrentDrawConfig()
        var currentPrice = currentConfig["Price"] as int
        var commonProb = currentConfig["CommonProb"] as float * 100
        var rareProb = currentConfig["RareProb"] as float * 100
        var epicProb = currentConfig["EpicProb"] as float * 100
        // 更新剩余价格显示
        var NowMoneyText = GetWidgetByPath(GetLocalPlayer(), GiftedUI, "/Panel/MoneyPanel/Text/MoneyText")
        if NowMoneyText != nil {
            NowMoneyText<UIWidgetLabel>.Content = Convert.ToString(Money)
        }
        // 更新当前阶段价格显示
        var priceText = GetWidgetByPath(GetLocalPlayer(), GiftedUI, "/Panel/DrawCard/Image/Money")
        if priceText != nil {
            priceText<UIWidgetLabel>.Content = Convert.ToString(currentPrice)
        }
    }

    // 获取卡牌最大抽取次数
    func GetMaxDrawCount(nature string) int {
        // 需要限制最高等级就在这个条件后面加
        if nature == "HP" || nature == "MoveSpeed" {
            return 5
        }
        // 其他属性无限制
        return 99999999
    }

    // 应用卡牌效果
    func ApplyGiftedCardEffect(cardId int) {
        var cardInfo = Gifted_CardData[cardId]
        if cardInfo == nil {
            return
        }
        var nature = Convert.ToString(cardInfo["Nature"])
        var value = cardInfo["Value"] as float
        
        LogInfo("应用天赋卡牌效果: " + nature + " 值: " + Convert.ToString(value))
        
        // 局外天赋加成：基于原始基础数据计算
        if nature == "HP" {
            // HP是固定值加成
            var baseHP = PlayerData["HP"] as int
            var currentOuterHP = 0
            if PlayerDataWithOuterBonus["HP"] != nil {
                currentOuterHP = Round(PlayerDataWithOuterBonus["HP"] as int)
            } else {
                currentOuterHP = baseHP
            }
            PlayerDataWithOuterBonus["HP"] = currentOuterHP + value as int
            LogInfo("局外HP: 基础" + Convert.ToString(baseHP) + " + " + Convert.ToString(value) + " = " + Convert.ToString(PlayerDataWithOuterBonus["HP"]))
        } else if nature == "MoveSpeed" {
            // 移速：百分比加成
            var baseSpeed = PlayerData["MoveSpeed"] as float
            var currentMultiplier = 1.0
            if PlayerDataWithOuterBonus["MoveSpeed_Multiplier"] != nil {
                currentMultiplier = PlayerDataWithOuterBonus["MoveSpeed_Multiplier"] as float
            }
            PlayerDataWithOuterBonus["MoveSpeed_Multiplier"] = currentMultiplier + value
            PlayerDataWithOuterBonus["MoveSpeed"] = baseSpeed * PlayerDataWithOuterBonus["MoveSpeed_Multiplier"] as float
            LogInfo("局外移速: 基础" + Convert.ToString(baseSpeed) + " × " + Convert.ToString(PlayerDataWithOuterBonus["MoveSpeed_Multiplier"]) + " = " + Convert.ToString(PlayerDataWithOuterBonus["MoveSpeed"]))
        } else if nature == "WeaponDamage" {
            // 武器伤害：百分比加成
            var baseDamage = PlayerData["WeaponDamage"] as int
            var currentMultiplier = 1.0
            if PlayerDataWithOuterBonus["WeaponDamage_Multiplier"] != nil {
                currentMultiplier = PlayerDataWithOuterBonus["WeaponDamage_Multiplier"] as float
            }
            PlayerDataWithOuterBonus["WeaponDamage_Multiplier"] = currentMultiplier + value
            PlayerDataWithOuterBonus["WeaponDamage"] = Round(baseDamage * PlayerDataWithOuterBonus["WeaponDamage_Multiplier"] as float) as int
            LogInfo("局外武器伤害: 基础" + Convert.ToString(baseDamage) + " × " + Convert.ToString(PlayerDataWithOuterBonus["WeaponDamage_Multiplier"]) + " = " + Convert.ToString(PlayerDataWithOuterBonus["WeaponDamage"]))
        } else if nature == "SkillDamage" {
            // 技能伤害：同时影响技能1和技能2
            var baseSkill1Damage = Skill1Data["SkillDamage"] as int
            var baseSkill2Damage = Skill2Data["SkillDamage"] as int
            
            // 技能1
            var currentMultiplier1 = 1.0
            if Skill1DataWithOuterBonus["SkillDamage_Multiplier"] != nil {
                currentMultiplier1 = Skill1DataWithOuterBonus["SkillDamage_Multiplier"] as float
            }
            Skill1DataWithOuterBonus["SkillDamage_Multiplier"] = currentMultiplier1 + value
            Skill1DataWithOuterBonus["SkillDamage"] = Round(baseSkill1Damage * Skill1DataWithOuterBonus["SkillDamage_Multiplier"] as float) as int
            
            // 技能2
            var currentMultiplier2 = 1.0
            if Skill2DataWithOuterBonus["SkillDamage_Multiplier"] != nil {
                currentMultiplier2 = Skill2DataWithOuterBonus["SkillDamage_Multiplier"] as float
            }
            Skill2DataWithOuterBonus["SkillDamage_Multiplier"] = currentMultiplier2 + value
            Skill2DataWithOuterBonus["SkillDamage"] = Round(baseSkill2Damage * Skill2DataWithOuterBonus["SkillDamage_Multiplier"] as float) as int
            
            LogInfo("局外技能伤害: 技能1 基础" + Convert.ToString(baseSkill1Damage) + " × " + Convert.ToString(Skill1DataWithOuterBonus["SkillDamage_Multiplier"]) + " = " + Convert.ToString(Skill1DataWithOuterBonus["SkillDamage"]))
            LogInfo("局外技能伤害: 技能2 基础" + Convert.ToString(baseSkill2Damage) + " × " + Convert.ToString(Skill2DataWithOuterBonus["SkillDamage_Multiplier"]) + " = " + Convert.ToString(Skill2DataWithOuterBonus["SkillDamage"]))
        }
        
        // 将局外数据复制到局内数据（开始游戏时）
        CopyToInGameData()
        
        // 发送属性到服务器     更新玩家当前属性（使用局内数据）
        DispatchEventToEntity(OnPlayerAttributesUpdate, globalEntity, PlatformType.Server, List<object>{PlayerDataInGame,PlayerDataWithOuterBonus})
    }

    // 显示当前所有属性
    func ShowAllAttributes() {
        LogInfo("=== 当前所有属性 ===")
        LogInfo("--- 玩家基础属性 ---")
        for key, value in PlayerData {
            LogInfo(key + ": " + Convert.ToString(value))
        }
        
        LogInfo("--- 技能1属性 ---")
        for key, value in Skill1Data {
            LogInfo(key + ": " + Convert.ToString(value))
        }
        
        LogInfo("--- 技能2属性 ---")
        for key, value in Skill2Data {
            LogInfo(key + ": " + Convert.ToString(value))
        }
        LogInfo("==================")
    }

    // 更新天赋卡牌UI显示
    func UpdateGiftedCardUI(cardInfo Map<string, object>) {
        var cardId = cardInfo["CardID"] as int
        var nature = Convert.ToString(cardInfo["Nature"])
        var value = cardInfo["Value"] as float
        var translationText = Convert.ToString(cardInfo["TranslationText"])
        var rarity = cardInfo["Rarity"] as int
        var currentCount = Gifted_Card_Count[cardId]
        var maxCount = GetMaxDrawCount(nature)
        // 获取列表父节点
        var listParent = GetWidgetByPath(GetLocalPlayer(), GiftedUI, "/Panel/List")
        // 获取对应的卡牌实体 (Card1到Card10)
        var cardIndex = Convert.ToString("Card" + cardId)
        var cardEntity = GetChildByName(listParent, cardIndex)

        // 更新卡牌图标
        var HasCardPanelEntity = GetChildByName(cardEntity, "HasCardPanel")
        var iconEntity = GetChildByName(HasCardPanelEntity, "icon")
        if iconEntity != nil {
            // iconEntity.SetImage("GiftedIcon_" + Convert.ToString(cardId))
        }

        // 更新天赋卡牌说明
        var textEntity = GetChildByName(HasCardPanelEntity, "IFMText")
        if textEntity != nil {
            textEntity<UIWidgetLabel>.Content = translationText
        }
        
        // 更新抽中次数显示
        var NumTextEntity = GetChildByName(cardEntity, "NumImage")
        var numTextEntity = GetChildByName(NumTextEntity, "NumText")
        if numTextEntity != nil {
            numTextEntity<UIWidgetLabel>.Content = Convert.ToString(currentCount)
        }
        
        // 根据稀有度设置卡牌颜色
        if cardEntity != nil {
            if rarity == 1 {
                // 普通 - 蓝色
                cardEntity<UIWidgetButton>.Color = #1B92D6
            } else if rarity == 2 {
                // 稀有 - 紫色
                cardEntity<UIWidgetButton>.Color = #6C00FF
            } else if rarity == 3 {
                // 史诗 - 金色
                cardEntity<UIWidgetButton>.Color = #FFD700
            }
        }
        
        // 处理卡牌状态显示
        if currentCount >= maxCount && maxCount != 9999 {
            // 已抽满的情况
            var maxImageEntity = GetChildByName(cardEntity, "MaxImage")
            if maxImageEntity != nil {
                maxImageEntity<UIWidget>.Active = true
            }
            var MaxTextEntity = GetChildByName(cardEntity, "MaxImage")
            var maxTextEntity = GetChildByName(MaxTextEntity, "MaxText")
            if maxTextEntity != nil {
                maxTextEntity<UIWidgetLabel>.Content = "MAX"
            }
        } else {
            // 未抽满的情况
            var maxImageEntity = GetChildByName(cardEntity, "MaxImage")
            if maxImageEntity != nil {
                maxImageEntity<UIWidget>.Active = false
            }
        }
        
        // 点亮卡牌：隐藏IconImage，显示HasCardPanel
        var iconImageEntity = GetChildByName(cardEntity, "IconImage")
        if iconImageEntity != nil {
            iconImageEntity<UIWidget>.Active = false  // 隐藏未点亮状态
        }
        var hasCardPanelEntity = GetChildByName(cardEntity, "HasCardPanel")
        if hasCardPanelEntity != nil {
            hasCardPanelEntity<UIWidget>.Active = true  // 显示已点亮状态
        }
        // 显示天赋界面
        GiftedUI<CustomUI>.IsVisible = true
    }

    // 初始化所有天赋卡牌UI状态
    func InitAllGiftedCardUI() {
        // 获取列表父节点
        var listParent = GetWidgetByPath(GetLocalPlayer(), GiftedUI, "/Panel/List")
        for cardId = 1, 11, 1 {
            var cardInfo = Gifted_CardData[cardId]
            if cardInfo != nil {
                // 根据当前计数更新UI状态
                UpdateSingleGiftedCardUI(cardId, listParent)
            }
        }
        var currentConfig = GetCurrentDrawConfig()
        var currentPrice = currentConfig["Price"] as int
        // 更新剩余价格显示
        var NowMoneyText = GetWidgetByPath(GetLocalPlayer(), GiftedUI, "/Panel/MoneyPanel/Text/MoneyText")
        if NowMoneyText != nil {
            NowMoneyText<UIWidgetLabel>.Content = Convert.ToString(Money)
        }
        // 更新当前阶段价格显示
        var priceText = GetWidgetByPath(GetLocalPlayer(), GiftedUI, "/Panel/DrawCard/Image/Money")
        if priceText != nil {
            priceText<UIWidgetLabel>.Content = Convert.ToString(currentPrice)
        }
    }

    // 更新单个卡牌的UI状态
    func UpdateSingleGiftedCardUI(cardId int, listParent entity<Entity>) {
        var cardInfo = Gifted_CardData[cardId]
        var currentCount = GetCardDrawCount(cardId)
        var cardEntity = GetChildByName(listParent, "Card" + Convert.ToString(cardId))
        if currentCount > 0 {
            // 已点亮的状态
            var iconImageEntity = GetChildByName(cardEntity, "IconImage")
            if iconImageEntity != nil {
                iconImageEntity<UIWidget>.Active = false
            }
            var hasCardPanelEntity = GetChildByName(cardEntity, "HasCardPanel")
            if hasCardPanelEntity != nil {
                hasCardPanelEntity<UIWidget>.Active = true
            }
            // 检查是否需要显示MAX
            var nature = Convert.ToString(cardInfo["Nature"])
            var maxCount = GetMaxDrawCount(nature)
            if currentCount >= maxCount && maxCount != 9999 {
                var maxImageEntity = GetChildByName(cardEntity, "MaxImage")
                if maxImageEntity != nil {
                    maxImageEntity<UIWidget>.Active = true
                }
            } else {
                var maxImageEntity = GetChildByName(cardEntity, "MaxImage")
                if maxImageEntity != nil {
                    maxImageEntity<UIWidget>.Active = false
                }
            }
        } else {
            // 未点亮的状态
            var iconImageEntity = GetChildByName(cardEntity, "IconImage")
            if iconImageEntity != nil {
                iconImageEntity<UIWidget>.Active = true
            }
            var hasCardPanelEntity = GetChildByName(cardEntity, "HasCardPanel")
            if hasCardPanelEntity != nil {
                hasCardPanelEntity<UIWidget>.Active = false
            }
            var maxImageEntity = GetChildByName(cardEntity, "MaxImage")
            if maxImageEntity != nil {
                maxImageEntity<UIWidget>.Active = false
            }
        }
    }

    // 获取卡牌当前抽取次数
    func GetCardDrawCount(cardId int) int {
        if Gifted_Card_Count[cardId] != nil {
            return Gifted_Card_Count[cardId]
        }
        return 0
    }
