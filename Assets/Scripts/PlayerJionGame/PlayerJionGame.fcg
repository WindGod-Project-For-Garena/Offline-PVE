    // 获取剩余可用卡牌数量
    func GetAvailableCardCount(CurrentSkill int) int {
        var cardDataMap = Map<int, Map<string, object>>{}
        var selectedCards = List<int>{}
        if CurrentSkill == 1 {
            cardDataMap = Skill_1_CardData
            selectedCards = SelectedCards_1
        } else if CurrentSkill == 2 {
            cardDataMap = Skill_2_CardData
            selectedCards = SelectedCards_2
        }
        return Map.Length(cardDataMap) - List.Length(selectedCards)
    }

