    // 自动选择当前最好的一张牌
//———————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————//
//———————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————//
    // 选择卡牌（当玩家选择某张卡牌时调用）
    
    // 应用三选一卡牌效果
    func ApplySkillCardEffect(skillNum int, attributeName string, value float) {
        // 玩家基础属性（基于局外天赋加成数据再应用局内加成）
        if attributeName == "movespeed" {
            // 移动速度加成 - 百分比
            var finalSpeed = 0.0
            if IsNextThreeChoiceOne == 0 {
                // 第一次选择：局外移速 × (1 + 加成)
                var outerSpeed = PlayerDataWithOuterBonus["MoveSpeed"] as float
                finalSpeed = outerSpeed * (1.0 + value)
            } else if IsNextThreeChoiceOne == 1 {
                // 后续选择：当前移速 + (局外移速 × 加成)
                var currentSpeed = PlayerDataInGame["MoveSpeed"] as float
                var outerSpeed = PlayerDataWithOuterBonus["MoveSpeed"] as float
                finalSpeed = currentSpeed + (outerSpeed * value)
            }
            PlayerDataInGame["MoveSpeed"] = finalSpeed
            LogInfo("局内移速: " + Convert.ToString(PlayerDataInGame["MoveSpeed"]))
        }
        
        // 技能1专属属性
        if skillNum == 1 {
            if attributeName == "SkillRange" {
                // 爆裂轰炸范围 - 固定值
                var finalRange = 0.0
                if IsNextThreeChoiceOne == 0 {
                    var outerRange = Skill1DataWithOuterBonus["SkillRange"] as float
                    finalRange = outerRange + value
                } else if IsNextThreeChoiceOne == 1 {
                    var currentRange = Skill1DataInGame["SkillRange"] as float
                    finalRange = currentRange + value
                }
                Skill1DataInGame["SkillRange"] = finalRange
                LogInfo("技能1范围: " + Convert.ToString(Skill1DataInGame["SkillRange"]))
                
            } else if attributeName == "SkillCD" {
                // 爆裂轰炸冷却减少 - 百分比
                var finalCD = 0
                if IsNextThreeChoiceOne == 0 {
                    var outerCD = Skill1DataWithOuterBonus["SkillCD"] as int
                    finalCD = Round(outerCD * (1.0 - value)) as int
                    // 记录当前总减少百分比
                    Skill1DataInGame["SkillCD_Reduction"] = value
                } else if IsNextThreeChoiceOne == 1 {
                    var outerCD = Skill1DataWithOuterBonus["SkillCD"] as int
                    // 获取当前总减少百分比
                    var totalReduction = value  // 初始为本次减少值
                    if Skill1DataInGame["SkillCD_Reduction"] != nil {
                        // 累加之前的总减少百分比
                        totalReduction = Skill1DataInGame["SkillCD_Reduction"] as float + value
                    }
                    // 从基础CD上计算最终CD
                    finalCD = Round(outerCD * (1.0 - totalReduction)) as int
                    // 更新总减少百分比记录
                    Skill1DataInGame["SkillCD_Reduction"] = totalReduction
                }
                Skill1DataInGame["SkillCD"] = finalCD
                LogInfo("技能1冷却: " + Convert.ToString(Skill1DataInGame["SkillCD"]))

            } else if attributeName == "SkillDamage" {
                // 爆裂轰炸伤害加成 - 百分比
                var finalDamage = 0
                if IsNextThreeChoiceOne == 0 {
                    var outerDamage = Skill1DataWithOuterBonus["SkillDamage"] as int
                    finalDamage = Round(outerDamage * (1.0 + value)) as int
                } else if IsNextThreeChoiceOne == 1 {
                    var currentDamage = Skill1DataInGame["SkillDamage"] as int
                    var outerDamage = Skill1DataWithOuterBonus["SkillDamage"] as int
                    finalDamage = currentDamage + Round(outerDamage * value) as int
                }
                Skill1DataInGame["SkillDamage"] = finalDamage
                LogInfo("技能1伤害: " + Convert.ToString(Skill1DataInGame["SkillDamage"]))
                
            } else if attributeName == "SkillAmount" {
                // 爆裂轰炸连续释放次数 - 固定值
                var finalAmount = 0
                if IsNextThreeChoiceOne == 0 {
                    finalAmount = Round(value) as int
                } else if IsNextThreeChoiceOne == 1 {
                    finalAmount = Round(value) as int
                }
                Skill1DataInGame["SkillAmount"] = finalAmount
                LogInfo("技能1释放次数: " + Convert.ToString(Skill1DataInGame["SkillAmount"]))
                
            } else if attributeName == "SkillFireDamage" {
                // 爆裂轰炸燃烧伤害 - 百分比
                var finalFireDamage = 0
                if IsNextThreeChoiceOne == 0 {
                    var outerFireDamage = Skill1DataWithOuterBonus["SkillFireDamage"] as int
                    finalFireDamage = Round(outerFireDamage * (1.0 + value)) as int
                } else if IsNextThreeChoiceOne == 1 {
                    var currentFireDamage = Skill1DataInGame["SkillFireDamage"] as int
                    var outerFireDamage = Skill1DataWithOuterBonus["SkillFireDamage"] as int
                    finalFireDamage = currentFireDamage + Round(outerFireDamage * value) as int
                }
                Skill1DataInGame["SkillFireDamage"] = finalFireDamage
                LogInfo("技能1燃烧伤害: " + Convert.ToString(Skill1DataInGame["SkillFireDamage"]))
                
            } else if attributeName == "WeaponBoomRange" {
                // 榴弹爆炸范围 - 固定值
                var finalBoomRange = 0
                if IsNextThreeChoiceOne == 0 {
                    var outerBoomRange = Skill1DataWithOuterBonus["WeaponBoomRange"] as int
                    finalBoomRange = Round(outerBoomRange + value) as int
                } else if IsNextThreeChoiceOne == 1 {
                    var currentBoomRange = Skill1DataInGame["WeaponBoomRange"] as int
                    finalBoomRange =  Round(currentBoomRange + value) as int
                }
                Skill1DataInGame["WeaponBoomRange"] = finalBoomRange
                LogInfo("榴弹爆炸范围: " + Convert.ToString(Skill1DataInGame["WeaponBoomRange"]))
                
            } else if attributeName == "WeaponBoomProbability" {
                // 普攻触发榴弹概率 - 固定值（百分比）
                var finalProbability = 0.0
                if IsNextThreeChoiceOne == 0 {
                    var outerProbability = Skill1DataWithOuterBonus["WeaponBoomProbability"] as float
                    finalProbability = Math.Min(1.0, outerProbability + value) as int
                } else if IsNextThreeChoiceOne == 1 {
                    var currentProbability = Skill1DataInGame["WeaponBoomProbability"] as float
                    finalProbability = Math.Min(1.0, currentProbability + value) as int
                }
                Skill1DataInGame["WeaponBoomProbability"] = finalProbability
                LogInfo("榴弹触发概率: " + Convert.ToString(Skill1DataInGame["WeaponBoomProbability"] as float * 100) + "%")
                
            } else if attributeName == "WeaponDoubleBoom" {
                // 榴弹二次爆炸 - 固定值
                var finalDoubleBoom = 0
                if IsNextThreeChoiceOne == 0 {
                    finalDoubleBoom = Round(value) as int
                } else if IsNextThreeChoiceOne == 1 {
                    finalDoubleBoom = Round(value) as int
                }
                Skill1DataInGame["WeaponDoubleBoom"] = finalDoubleBoom
                LogInfo("榴弹二次爆炸: " + Convert.ToString(Skill1DataInGame["WeaponDoubleBoom"]))
                
            } else if attributeName == "WeaponBoomDamage" {
                // 榴弹伤害加成 - 百分比
                var finalBoomDamage = 0
                if IsNextThreeChoiceOne == 0 {
                    var outerBoomDamage = Skill1DataWithOuterBonus["WeaponBoomDamage"] as int
                    finalBoomDamage = Round(outerBoomDamage * (1.0 + value)) as int
                } else if IsNextThreeChoiceOne == 1 {
                    var currentBoomDamage = Skill1DataInGame["WeaponBoomDamage"] as int
                    var outerBoomDamage = Skill1DataWithOuterBonus["WeaponBoomDamage"] as int
                    finalBoomDamage = currentBoomDamage + Round(outerBoomDamage * value) as int
                }
                Skill1DataInGame["WeaponBoomDamage"] = finalBoomDamage
                LogInfo("榴弹伤害: " + Convert.ToString(Skill1DataInGame["WeaponBoomDamage"]))
                
            } else if attributeName == "ReloadNow" {
                // 技能后立即装弹
                Skill1DataInGame["ReloadNow"] = 1
                LogInfo("获得技能后立即装弹效果")
                
            // 以下为武器相关属性更新==============================================================================//
            } else if attributeName == "WeaponDamage" {
                // 武器伤害加成 - 百分比
                var finalDamage = 0
                if IsNextThreeChoiceOne == 0 {
                    var outerDamage = Skill1DataWithOuterBonus["WeaponDamage"] as int
                    finalDamage = Round(outerDamage * (1.0 + value)) as int
                } else if IsNextThreeChoiceOne == 1 {
                    var currentDamage = Skill1DataInGame["WeaponDamage"] as int
                    var outerDamage = Skill1DataWithOuterBonus["WeaponDamage"] as int
                    finalDamage = currentDamage + Round(outerDamage * value) as int
                }
                Skill1DataInGame["WeaponDamage"] = finalDamage
                LogInfo("局内武器伤害: " + Convert.ToString(Skill1DataInGame["WeaponDamage"]))
                
            } else if attributeName == "AttackSpeed" {
                // 攻击速度加成 - 百分比
                var finalSpeed = 0.0
                if IsNextThreeChoiceOne == 0 {
                    var outerSpeed = Skill1DataWithOuterBonus["AttackSpeed"] as float
                    finalSpeed = outerSpeed * (1.0 + value)
                } else if IsNextThreeChoiceOne == 1 {
                    var currentSpeed = Skill1DataInGame["AttackSpeed"] as float
