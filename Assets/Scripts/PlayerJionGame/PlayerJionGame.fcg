    event OnPlayerJoin(player entity<Player>) {
        if GetLocalPlayer() == player {
            // CreateCustomUIClient(out var ui, EResUI.HomeUI)
            // HomeUI = ui

            currPlayer = player
   
            CreateCustomUIClient(out var ChoiceHeroUIEntity, EResUI.ChoiceHero)
            ChoiceHeroUI = ChoiceHeroUIEntity 
            ChoiceHeroUIEntity<CustomUI>.IsVisible = true
            var skill1 entity<UIWidgetButton> = GetWidgetFromCustomUI(GetLocalPlayer(),ChoiceHeroUIEntity , EResUIChoiceHero.Hero_1) as entity<UIWidgetButton>
            var skill2 entity<UIWidgetButton> = GetWidgetFromCustomUI(GetLocalPlayer(),ChoiceHeroUIEntity , EResUIChoiceHero.Hero_2) as entity<UIWidgetButton>
            var skill3 entity<UIWidgetButton> = GetWidgetFromCustomUI(GetLocalPlayer(),ChoiceHeroUIEntity , EResUIChoiceHero.Hero_3) as entity<UIWidgetButton>
            skill1<UIWidgetButton>.Color = #FF8900
            skill2<UIWidgetButton>.Color = #F2A245
            skill3<UIWidgetButton>.Color = #F2A245
            //默认选择第一个技能
            var skillIndex int = 1
            displaySkillByIndex(skillIndex)

            CreateCustomUIClient(out var inGameDebugUIEntity, EResUI.InGameDebug)
            inGameDebugUI = inGameDebugUIEntity

            CreateCustomUIClient(out var SkillUIEntity, EResUI.SkillUI)
            SkillUI = SkillUIEntity
            SkillUIEntity<CustomUI>.IsVisible = true

            CreateCustomUIClient(out var HeroPanelUIEntity, EResUI.HeroPanel)
            HeroUI = HeroPanelUIEntity
            HeroPanelUIEntity<CustomUI>.IsVisible = false

            CreateCustomUIClient(out var GiftedPanelUIEntity, EResUI.GiftedPanel)
            GiftedUI = GiftedPanelUIEntity
            GiftedPanelUIEntity<CustomUI>.IsVisible = false

            CreateCustomUIClient(out var ChoiceThreeCardUIEntity, EResUI.ChoiceThreeCard)
            ChoiceThreeCardUI = ChoiceThreeCardUIEntity
            ChoiceThreeCardUIEntity<CustomUI>.IsVisible = false

            CreateCustomUIClient(out var SecondDownUIEntity, EResUI.SecondDown)
            SecondDownUI = SecondDownUIEntity
            SecondDownUIEntity<CustomUI>.IsVisible = false

            CreateCustomUIClient(out var GameOverFinalUIEntity, EResUI.GameOverFinal)
            GameOverFinalUI = GameOverFinalUIEntity
            GameOverFinalUIEntity<CustomUI>.IsVisible = false

            CreateCustomUIClient(out var TimeInGameUIEntity, EResUI.TimeInGame)
            TimeInGameUI = TimeInGameUIEntity
            TimeInGameUIEntity<CustomUI>.IsVisible = false

            CreateCustomUIClient(out var WaveCompleteUIEntity, EResUI.WaveComplete)
            WaveCompleteUI = WaveCompleteUIEntity
            WaveCompleteUIEntity<CustomUI>.IsVisible = false

            CreateCustomUIClient(out var PopupUIEntity, EResUI.Popup)
            PopupUI = PopupUIEntity
            PopupUIEntity<CustomUI>.IsVisible = false

            CreateCustomUIClient(out var bossHPBar, EResUI.BossHP)
            BossHPBar = bossHPBar
            bossHPBar<CustomUI>.IsVisible = false

            var Skill_1Panel = GetWidgetByPath(GetLocalPlayer(), SkillUI, "/Skill_1")
            Skill_1Panel<UIWidget>.IsVisible = false
            var JoyStickButton_1 = GetWidgetByPath(GetLocalPlayer(), SkillUI, "/Skill_1/JoyStickFillAmount")
            JoyStickButton_1<UIWidget>.IsVisible = false

            var Skill_2Panel = GetWidgetByPath(GetLocalPlayer(), SkillUI, "/Skill_2")
            Skill_2Panel<UIWidget>.IsVisible = false
            var JoyStickButton_2 = GetWidgetByPath(GetLocalPlayer(), SkillUI, "/Skill_2/JoyStickFillAmount")
            JoyStickButton_2<UIWidget>.IsVisible = false

            var Skill_3Panel = GetWidgetByPath(GetLocalPlayer(), SkillUI, "/Skill_3")
            Skill_3Panel<UIWidget>.IsVisible = false
            var JoyStickButton_3 = GetWidgetByPath(GetLocalPlayer(), SkillUI, "/Skill_3/JoyStickFillAmount")
            JoyStickButton_3<UIWidget>.IsVisible = false

            InjectSkill_1_CardData()
            InjectSkill_2_CardData()
            InjectGifted_CardData()
            InjectGiftCardProbabilityData()
            InitAllGiftedCardUI()
            // 初始化已选卡牌展示面板
            InitNowChoicePanelIcons()
            // 初始化局外天赋加成后数据（复制基础数据）
            CopyToOuterBonusData()
            // 初始化局内数据（复制局外数据）
            CopyToInGameData()
            IsNextThreeChoiceOne = 0
        }
    }
//———————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————//
// 初始化已选卡牌展示面板图标
    func InitNowChoicePanelIcons() {
        // 隐藏所有已选卡牌位置的图标
        for i = 1, 6, 1 {
            var iconPath = "/NowChoicePanel/List/Card (" + Convert.ToString(i) + ")/ICON"
            var iconWidget = GetWidgetByPath(GetLocalPlayer(), ChoiceThreeCardUI, iconPath)
            if iconWidget != nil {
                iconWidget<UIWidget>.IsVisible = false
            } else {
                LogWarning("找不到图标控件: " + iconPath)
            }
        }
    }
//———————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————//
// 选择完角色
    async func ChoiceHeroOver(level int, skillIndex int, ability1Level int, ability2Level int, ability3Level int) {
        weaponMultiplier = 1.0 * ability1Level + 1
        healthMultiplier = 1.0 * ability2Level + 1
        skillMultiplier = 1.0 * ability3Level + 1
        CurrentSkill = skillIndex
        //删除武器
        Destroy(currentWeapon)
        //发放武器
        if  skillIndex == 1 {
            Offline.DestroyItem(ItemIDType.M1887X, 1)
            Offline.DestroyItem(ItemIDType.SMGAmmo, 30)
            Offline.DestroyItem(ItemIDType.SGAmmo, 30)
            WaitForNextFrame()
            Offline.AddItem(ItemIDType.M1887X, 1, out var itemList)
            Offline.AddItem(ItemIDType.SGAmmo, 30, out var createdEntity)
            currentWeapon = itemList[0] as entity<Weapon>
        }

        if skillIndex == 2 {
            Offline.DestroyItem(ItemIDType.GoldMP5_III, 1)
            Offline.DestroyItem(ItemIDType.SGAmmo, 30)
            Offline.DestroyItem(ItemIDType.SMGAmmo, 30)
            WaitForNextFrame()
            Offline.AddItem(ItemIDType.GoldMP5_III, 1, out var itemList)
            Offline.AddItem(ItemIDType.SMGAmmo, 30, out var createdEntity)
            currentWeapon = itemList[0] as entity<Weapon>
        }
    }
//———————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————//
    // 清空已选卡牌记录
    func ClearSelectedCards() {
        // 清空技能1已选卡牌
        List.Clear(SelectedCards_1)
        // 清空技能2已选卡牌
        List.Clear(SelectedCards_2)
        // 清空当前随机卡牌列表
        List.Clear(CurrentRandomCards)
        // 重置当前选择的卡牌
        NowChoiceCard = 0
        // 重置三选一标志位
        IsNextThreeChoiceOne = 0
         // 隐藏所有已选卡牌图标
        InitNowChoicePanelIcons()
        LogInfo("已清空所有已选卡牌记录")
    }

    // 复制基础数据到局外加成数据
    func CopyToOuterBonusData() {
        // 复制玩家基础数据
        for key, value in PlayerData {
            PlayerDataWithOuterBonus[key] = value
        }
        // 复制技能1基础数据
        for key, value in Skill1Data {
            Skill1DataWithOuterBonus[key] = value
        }
        // 复制技能2基础数据
        for key, value in Skill2Data {
            Skill2DataWithOuterBonus[key] = value
        }
        LogInfo("局外天赋加成数据已初始化（复制基础数据）")
    }

    // 复制局外数据到局内数据
    func CopyToInGameData() {
        // 复制局外玩家数据到局内
        for key, value in PlayerDataWithOuterBonus {
            PlayerDataInGame[key] = value
        }
        // 复制局外技能1数据到局内
        for key, value in Skill1DataWithOuterBonus {
            Skill1DataInGame[key] = value
        }
        // 复制局外技能2数据到局内
        for key, value in Skill2DataWithOuterBonus {
            Skill2DataInGame[key] = value
        }
        LogInfo("局内数据已初始化（复制局外数据）")
    }
//———————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————//
    // 注入技能1的卡牌数据
    func InjectSkill_1_CardData() {
        // 解析CSV
        Map.Clear(Skill_1_CardData)
        for cardId = 1, 33, 1 {
            var cardInfo = Map<string, object>{}
            cardInfo["CardID"] = cardId
            // 从CSV读取卡牌数据，从第三行开始读取
            var cardRow = CSVData.ReadCSVRow(EResCSV.Skill_1_CardData, cardId + 2)
            cardInfo["Nature"] = cardRow[1]
            cardInfo["Value"] = cardRow[2] as List<float>
            cardInfo["Rarity"] = cardRow[3] as List<int>
            cardInfo["TranslationText"] = cardRow[4]
            cardInfo["Sktchtext"] = cardRow[5]
            cardInfo["Typetext"] = cardRow[6]
            Skill_1_CardData[cardId] = cardInfo
            // 在显示时格式化浮点数，保留两位小数
            // LogInfo(Skill_1_CardData[cardId])
        }
        LogInfo("技能1卡牌数据注入完成")
    }
    
    // 注入技能2的卡牌数据
    func InjectSkill_2_CardData() {
        // 解析CSV
        Map.Clear(Skill_2_CardData)
        for cardId = 1, 31, 1 {
            var cardInfo = Map<string, object>{}
            cardInfo["CardID"] = cardId
            // 从CSV读取卡牌数据，从第三行开始读取
            var cardRow = CSVData.ReadCSVRow(EResCSV.Skill_2_CardData, cardId + 2)
            cardInfo["Nature"] = cardRow[1]
            cardInfo["Value"] = cardRow[2] as List<float>
            cardInfo["Rarity"] = cardRow[3] as List<int>
            cardInfo["TranslationText"] = cardRow[4]
            cardInfo["Sktchtext"] = cardRow[5]
            cardInfo["Typetext"] = cardRow[6]
            Skill_2_CardData[cardId] = cardInfo
            // 在显示时格式化浮点数，保留两位小数
            // LogInfo(Skill_2_CardData[cardId])
        }
        LogInfo("技能2卡牌数据注入完成")
    }
