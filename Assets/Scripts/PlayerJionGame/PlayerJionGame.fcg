            JoyStickButton_3<UIWidget>.Active = false

            InjectSkill_1_CardData()
            InjectSkill_2_CardData()
            InjectGifted_CardData()
            InjectGiftCardProbabilityData()
            InitAllGiftedCardUI()
            // 初始化局外天赋加成后数据（复制基础数据）
            CopyToOuterBonusData()
            // 初始化局内数据（复制局外数据）
            CopyToInGameData()
            IsNextThreeChoiceOne = 0
        }
    }
//———————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————//
    // 复制基础数据到局外加成数据
    func CopyToOuterBonusData() {
        // 复制玩家基础数据
        for key, value in PlayerData {
            PlayerDataWithOuterBonus[key] = value
        }
        // 复制技能1基础数据
        for key, value in Skill1Data {
            Skill1DataWithOuterBonus[key] = value
        }
        // 复制技能2基础数据
        for key, value in Skill2Data {
            Skill2DataWithOuterBonus[key] = value
        }
        LogInfo("局外天赋加成数据已初始化（复制基础数据）")
    }

    // 复制局外数据到局内数据
    func CopyToInGameData() {
        // 复制局外玩家数据到局内
        for key, value in PlayerDataWithOuterBonus {
            PlayerDataInGame[key] = value
        }
        // 复制局外技能1数据到局内
        for key, value in Skill1DataWithOuterBonus {
            Skill1DataInGame[key] = value
        }
        // 复制局外技能2数据到局内
        for key, value in Skill2DataWithOuterBonus {
            Skill2DataInGame[key] = value
        }
        LogInfo("局内数据已初始化（复制局外数据）")
    }
//———————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————//
    // 注入技能1的卡牌数据
    func InjectSkill_1_CardData() {
        // 解析CSV
        Map.Clear(Skill_1_CardData)
        for cardId = 1, 33, 1 {
            var cardInfo = Map<string, object>{}
            cardInfo["CardID"] = cardId
            // 从CSV读取卡牌数据，从第三行开始读取
            var cardRow = CSVData.ReadCSVRow(EResCSV.Skill_1_CardData, cardId + 2)
            cardInfo["Nature"] = cardRow[1]
            cardInfo["Value"] = cardRow[2] as List<float>
            cardInfo["Rarity"] = cardRow[3] as List<int>
            cardInfo["TranslationText"] = cardRow[4]
            cardInfo["Sktchtext"] = cardRow[5]
            Skill_1_CardData[cardId] = cardInfo
            // 在显示时格式化浮点数，保留两位小数
            // LogInfo(Skill_1_CardData[cardId])
        }
        LogInfo("技能1卡牌数据注入完成")
    }
    
    // 注入技能2的卡牌数据
    func InjectSkill_2_CardData() {
        // 解析CSV
        Map.Clear(Skill_2_CardData)
        for cardId = 1, 31, 1 {
            var cardInfo = Map<string, object>{}
            cardInfo["CardID"] = cardId
            // 从CSV读取卡牌数据，从第三行开始读取
            var cardRow = CSVData.ReadCSVRow(EResCSV.Skill_2_CardData, cardId + 2)
            cardInfo["Nature"] = cardRow[1]
            cardInfo["Value"] = cardRow[2] as List<float>
            cardInfo["Rarity"] = cardRow[3] as List<int>
            cardInfo["TranslationText"] = cardRow[4]
            cardInfo["Sktchtext"] = cardRow[5]
            Skill_2_CardData[cardId] = cardInfo
            // 在显示时格式化浮点数，保留两位小数
            // LogInfo(Skill_2_CardData[cardId])
        }
        LogInfo("技能2卡牌数据注入完成")
    }
//———————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————//
    //显示三选一卡牌界面
    async func ShowChoiceThreeCardUI(level int, ability1Level int, ability2Level int, ability3Level int){
        level = level
        ability1Level = ability1Level
        ability2Level = ability2Level
        ability3Level = ability3Level
        ChoiceThreeCardUI<CustomUI>.IsVisible = true
        IsNextThreeChoiceOne = 0       //关闭标志位
        StartThree_choose_One(level, CurrentSkill, ability1Level, ability2Level, ability3Level)
        start ShowSecondDown(10000)
    }

    func  RefeshCard(level int, ability1Level int, ability2Level int, ability3Level int) {
        level = level
        ability1Level = ability1Level
        ability2Level = ability2Level
        ability3Level = ability3Level
        ChoiceThreeCardUI<CustomUI>.IsVisible = true
        StartThree_choose_One(level, CurrentSkill, ability1Level, ability2Level, ability3Level)
    }
    
    async func ShowSecondDown(time int) {
        SecondDownUI<CustomUI>.IsVisible = true
        var SecondDownText = GetWidgetByPath(GetLocalPlayer(), SecondDownUI, "/SecondDown/TextBackBoard/Text")
        while time >= 0 {
            SecondDownText<UIWidgetLabel>.Content = (time / 1000)
            WaitForMillisecond(1000)
            time = time - 1000
            if time == 0 {
                AutoChoiceBestOneCard()
                DispatchEventToEntity(ToServer_StartNextWave, globalEntity, PlatformType.Server, List<object>{})
                SecondDownUI<CustomUI>.IsVisible = false
            }
            if  SecondDownUI<CustomUI>.IsVisible == false{
                LogInfo("打断计时打断计时打断计时打断计时打断计时")
                time = -1
                break
            }
        }
    }

    // 自动选择当前最好的一张牌
    func AutoChoiceBestOneCard() {
        // 使用已经生成的卡牌信息
        var card1 = Skill_1_CardData[CurrentRandomCards[0]]
        var card2 = Skill_1_CardData[CurrentRandomCards[1]]
        var card3 = Skill_1_CardData[CurrentRandomCards[2]]
        
        // 获取三张卡的稀有度
        var rarity1 = card1["Rarity"] as int
        var rarity2 = card2["Rarity"] as int
        var rarity3 = card3["Rarity"] as int
        
        var highestRarity = Math.Max(rarity1, Math.Max(rarity2, rarity3))
        
        LogInfo("三张卡牌稀有度: " + Convert.ToString(rarity1) + ", " + Convert.ToString(rarity2) + ", " + Convert.ToString(rarity3))
        LogInfo("最高稀有度: " + Convert.ToString(highestRarity))
        
        // 找出所有最高稀有度的卡牌索引
        var bestCardIndices = List<int>{}
        
        if rarity1 == highestRarity {
            List.Append(bestCardIndices, 0)
        }
        if rarity2 == highestRarity {
            List.Append(bestCardIndices, 1)
        }
        if rarity3 == highestRarity {
            List.Append(bestCardIndices, 2)
        }
        
        // 选择最终卡牌
        var selectedIndex = 0
        
        if List.Length(bestCardIndices) == 1 {
            // 只有一张最高稀有度
            selectedIndex = bestCardIndices[0]
            LogInfo("唯一最高稀有度，选择卡牌" + Convert.ToString(selectedIndex + 1))
        } else {
            // 多张相同最高稀有度，随机选一个
            var randomIndexInList = RandomInt(0, List.Length(bestCardIndices))
            selectedIndex = bestCardIndices[randomIndexInList]
            LogInfo("多张相同最高稀有度，随机选择卡牌" + Convert.ToString(selectedIndex + 1))
        }
        
        var selectedCardId = CurrentRandomCards[selectedIndex]
        LogInfo("最终选择 - 位置:" + Convert.ToString(selectedIndex + 1) + " ID:" + Convert.ToString(selectedCardId) + " 稀有度:" + Convert.ToString(highestRarity))
        
        // 选择逻辑
        SelectCard(selectedCardId, CurrentSkill)
        ApplyCardEffect(selectedCardId, CurrentSkill)
        
        // 隐藏选择界面
        ChoiceThreeCardUI<CustomUI>.IsVisible = false
        
        // 触发选择效果
        // OnCardSelected(selectedCardId, selectedIndex)

        //开始下一波
        DispatchEventToEntity(OnGameStartClick, globalEntity, PlatformType.Server, List<object>{level, CurrentSkill,ability1Level,ability2Level,ability3Level})
    }
//———————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————//
    func StartThree_choose_One(level int, CurrentSkill int, ability1Level int, ability2Level int, ability3Level int){
        // 生成三个不重复的随机卡牌
        var cards = List<Map<string, object>>{}
        while List.Length(cards) < 3 {
            var newCard Map<string, object> = GenerateRandomCard(CurrentSkill)
            if  newCard != nil {
                // 检查卡牌是否已存在，避免重复
                var isDuplicate = false
                for i, existingCard in cards {
                    if existingCard["CardID"] == newCard["CardID"] {
                        isDuplicate = true
                        break
                    }
                }
                if isDuplicate == false {
                    List.Append(cards, newCard)
                    LogInfo("生成卡牌:" + Convert.ToString(newCard["CardID"]) + "-" + Convert.ToString(newCard["Nature"]))
                }
            } else {
                LogInfo("技能" + Convert.ToString(CurrentSkill) + "的所有卡牌都已选择过")
                break
            }
        }
        
        // 显示生成的三个卡牌
        if List.Length(cards) >= 3 {
            var card1 = cards[0]
            var card2 = cards[1]
            var card3 = cards[2]
            // 保存卡牌ID到 CurrentRandomCards
            List.Clear(CurrentRandomCards)
            List.Append(CurrentRandomCards, card1["CardID"] as int)
            List.Append(CurrentRandomCards, card2["CardID"] as int)
            List.Append(CurrentRandomCards, card3["CardID"] as int)
            
            LogInfo("=== 三选一卡牌生成完成 ===")
            LogInfo("卡牌1 - ID:" + Convert.ToString(card1["CardID"]) + "属性:" + Convert.ToString(card1["Nature"]))
            LogInfo("卡牌2 - ID:" + Convert.ToString(card2["CardID"]) + "属性:" + Convert.ToString(card2["Nature"]))
            LogInfo("卡牌3 - ID:" + Convert.ToString(card3["CardID"]) + "属性:" + Convert.ToString(card3["Nature"]))
            
            // 卡牌数据显示到UI
            UpdateCardUI(card1, card2, card3)
        } else {
            LogError("卡牌生成数量不足，只有" + Convert.ToString(List.Length(cards)) + "张")
        }
    }
//———————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————//
    // 生成随机卡牌（不允许重复选择）
    func GenerateRandomCard(CurrentSkill int) Map<string, object> {
        var cardDataMap = Map<int, Map<string, object>>{}
        var selectedCards = List<int>{}
        
        // 选择对应的牌库和已选记录
        if CurrentSkill == 1 {
            cardDataMap = Skill_1_CardData
            selectedCards = SelectedCards_1
        } else if CurrentSkill == 2 {
            cardDataMap = Skill_2_CardData
            selectedCards = SelectedCards_2
        } else {
            LogError("无效的技能索引:" + Convert.ToString(CurrentSkill))
            return nil
        }
        
        // 获取所有未选过的卡牌ID
        var availableCardIds = List<int>{}
        for cardId, cardData in cardDataMap {
            var isSelected = false
            for i, selectedId in selectedCards {
                if selectedId == cardId {
                    isSelected = true
                    break
                }
            }
            if isSelected == false {
                List.Append(availableCardIds, cardId)
            }
        }
        
        // 如果没有可用卡牌，返回空
        if List.Length(availableCardIds) == 0 {
            LogWarning("技能" + Convert.ToString(CurrentSkill) + "的所有卡牌都已选择过")
            return nil
        }
        
        // 随机选择一个卡牌ID
        var randomIndex = RandomInt(0, List.Length(availableCardIds))
        var randomCardId = availableCardIds[randomIndex]
        
        // 返回对应的卡牌数据
        return cardDataMap[randomCardId]
    }
//———————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————//
    // 选择卡牌（当玩家选择某张卡牌时调用）
    func SelectCard(cardId int, CurrentSkill int) {
        var selectedCards = List<int>{}
        
        if CurrentSkill == 1 {
            selectedCards = SelectedCards_1
        } else if CurrentSkill == 2 {
            selectedCards = SelectedCards_2
        } else {
            LogError("无效的技能索引:" + Convert.ToString(CurrentSkill))
            return
        }
        
        // 检查是否已选择过
        var alreadySelected = false
        for i, selectedId in selectedCards {
            if selectedId == cardId {
                alreadySelected = true
                break
            }
        }
        
        if alreadySelected == false {
            List.Append(selectedCards, cardId)
            LogInfo("卡牌" + Convert.ToString(cardId) + "已添加到已选列表，技能" + Convert.ToString(CurrentSkill))
            LogInfo("当前已选卡牌数量:" + Convert.ToString(List.Length(selectedCards)))
        }
    }
