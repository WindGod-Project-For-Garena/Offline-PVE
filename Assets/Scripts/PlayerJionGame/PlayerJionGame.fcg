    // 初始化所有卡牌图鉴UI状态
    func InitAllCardBookUI(hero int) {
        // 获取列表父节点
        var listGrandfather = GetWidgetByPath(GetLocalPlayer(), HeroUI, "/Panel/RollPanel")
        var listParent = GetChildByName(listGrandfather, "List")
        if hero == 1 {
            // 职业1有33张卡牌
            for cardId = 1, 33, 1 {
                var cardInfo = Skill_1_CardData[cardId]
                if cardInfo != nil {
                    // 根据当前计数更新UI状态
                    UpdateSingleCardBookUI(cardId, listParent ,cardInfo)
                }
            }
            // 隐藏多余的卡牌（如果有的话）
            for cardId = 33, 40, 1 {
                var cardEntity = GetChildByName(listParent, "Card (" + Convert.ToString(cardId) + ")")
                if cardEntity != nil {
                    cardEntity<UIWidget>.IsVisible = false
                }
            }
        }
        if hero == 2 {
            // 职业2有31张卡牌
            for cardId = 1, 31, 1 {
                var cardInfo = Skill_2_CardData[cardId]
                if cardInfo != nil {
                    // 根据当前计数更新UI状态
                    UpdateSingleCardBookUI(cardId, listParent ,cardInfo)
                }
            }
            // 隐藏多余的卡牌（31-33张）
            for cardId = 31, 40, 1 {
                var cardEntity = GetChildByName(listParent, "Card (" + Convert.ToString(cardId) + ")")
                if cardEntity != nil {
                    cardEntity<UIWidget>.IsVisible = false
                }
            }
        }
    }

    // 更新单个卡牌的UI状态
    func UpdateSingleCardBookUI(cardId int, listParent entity<Entity> ,cardInfo Map<string, object>) {
        var cardEntity = GetChildByName(listParent, "Card (" + Convert.ToString(cardId) + ")")
        if cardEntity == nil {
            LogWarning("卡牌实体不存在: Card (" + Convert.ToString(cardId) + ")")
            return
        }
        // 确保卡牌显示
        cardEntity<UIWidget>.IsVisible = true
        if cardInfo == nil {
            LogWarning("卡牌数据不存在，ID:" + Convert.ToString(cardId))
            return
        }
        // 显示面板
        var hasCardPanelEntity = GetChildByName(cardEntity, "HasCardPanel")
        if hasCardPanelEntity != nil {
            hasCardPanelEntity<UIWidget>.IsVisible = true
        }
        //——————————————————————————————————————————————————————————————————————————————————————————————//
        // 显示图标
        var iconImageEntity = GetChildByName(hasCardPanelEntity, "icon")
        if iconImageEntity != nil {
            iconImageEntity<UIWidget>.IsVisible = true
            var nature = cardInfo["Nature"]
            var iconKey = "Skill_Just_Do_It"  // 通用默认值

            // 设置图标稀有度颜色
            var rarity = cardInfo["Rarity"] as int
            var iconColor = FC_Config.CardRarityColor[rarity]
            iconImageEntity<UIWidgetImage>.Color = iconColor
            
            // 检查配置中是否存在该nature对应的图标
            if (nature != nil && nature != "") {
                if (FC_Config.CardIconSprites[nature] != nil) {
                    iconKey = nature  // 如果配置中有，直接使用nature作为key
                }
            }
            
            iconImageEntity<UIWidgetImage>.SpriteName = FC_Config.CardIconSprites[iconKey]
        }
        //——————————————————————————————————————————————————————————————————————————————————————————————//
        // 显示详细信息
        var IFMTextEntity = GetChildByName(hasCardPanelEntity, "IFMText")
        if IFMTextEntity != nil {
            var description = ChoiceThreeCardUI<ChoiceOneOfThreeCard>.GenerateCardDescription(cardInfo)
            IFMTextEntity<UIWidgetLabel>.Content = description
            IFMTextEntity<UIWidget>.IsVisible = true
        }
        //——————————————————————————————————————————————————————————————————————————————————————————————//
        // 设置稀有度显示
        var rarity = cardInfo["Rarity"] as int
        UpdateCardBookRarityUI(hasCardPanelEntity, rarity)
    }

    // 更新卡牌图鉴稀有度显示（根据稀有度显示不同的边框颜色）
    func UpdateCardBookRarityUI(hasCardPanelEntity entity<Entity>, rarity int) {
        // 更具稀有度更新边框颜色
        var ICONBBEntity = GetChildByName(hasCardPanelEntity, "BackBoard")
        var tableftEntity = GetChildByName(ICONBBEntity, "tableft")
        var tabrightEntity = GetChildByName(ICONBBEntity, "tabright")
        var iconColor = FC_Config.CardRarityColor[rarity]
        tableftEntity<UIWidgetImage>.Color = iconColor
        tabrightEntity<UIWidgetImage>.Color = iconColor
        ICONBBEntity<UIWidgetImage>.Color = iconColor
       
    }
