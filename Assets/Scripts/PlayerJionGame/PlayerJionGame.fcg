    // 重置数据
    func ResetInGameData() {
        CopyToInGameData()
        LogInfo("局内数据已重置为局外天赋加成数据")
    }

    async func displaySkillByIndex(index int) {
        // 隐藏所有技能面板
        for i = 1, 3,1{
            var skillJoyStik = GetWidgetByPath(GetLocalPlayer(), SkillUI, "/Skill_" + i)
            var joyStickAmount = GetWidgetByPath(GetLocalPlayer(), SkillUI, "/Skill_" + i + "/JoyStickFillAmount")
            skillJoyStik<UIWidget>.IsVisible = false
            joyStickAmount<UIWidget>.IsVisible = false
        }
        WaitForNextFrame()
        // 显示当前选中的技能
        LogInfo("显示技能面板索引: " + Convert.ToString(index))
        var skillJoyStik = GetWidgetByPath(GetLocalPlayer(), SkillUI, "/Skill_" + index)
        var joyStickAmount = GetWidgetByPath(GetLocalPlayer(), SkillUI, "/Skill_" + index + "/JoyStickFillAmount")
        skillJoyStik<UIWidget>.IsVisible = true
        joyStickAmount<UIWidget>.IsVisible = false
    }
//———————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————//
//————————————————————————————————————————————————————击杀显示功能—————————————————————————————————————————————————————————————//
//———————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————//
    // 显示击杀信息
    async func KillInfo(part string) {
        KillCount = KillCount + 1
        KillCountTAG = KillCountTAG + 1
        KillCountSound = KillCountSound + 1

        var One = GetWidgetByPath(GetLocalPlayer(), KillShowBoardUI, "/Panel/One/One_Icon")
        var Ten = GetWidgetByPath(GetLocalPlayer(), KillShowBoardUI, "/Panel/Ten/Ten_Icon")
        // 更新总击杀数UI
        var TotalKillsEntity = GetWidgetByPath(GetLocalPlayer(), RighTabIFMUI, "/Panel/Killed/logo/Num")
        TotalKillsEntity<UIWidgetLabel>.Content = KillCount

        // 播放击杀音效
        if KillCountSound == 1 {
            SoundFunc.PlayCreatedSound("Notice_KnockedDown_01")
        }
        if KillCountSound == 2 {
            SoundFunc.PlayCreatedSound("Notice_KnockedDown_02")
        }
        if KillCountSound == 3 {
            SoundFunc.PlayCreatedSound("Notice_KnockedDown_03")
        }
        if KillCountSound == 4 {
            SoundFunc.PlayCreatedSound("Notice_KnockedDown_04")
        }
        if KillCountSound == 5 {
            SoundFunc.PlayCreatedSound("Notice_Ace")
            KillCountSound = 0
        }

        // 显示爆头标志
        if  part == "Head" {
            KillShowBoardUI<CustomUI>.IsVisible = true
            One<UIWidget>.IsVisible = true
            Ten<UIWidget>.IsVisible = false

            One<UIWidgetImage>.Alpha = 0.0

            start OutKillTween(One)
        }

        // 显示十杀标志
        if  KillCountTAG == 10 {
            KillShowBoardUI<CustomUI>.IsVisible = true
            One<UIWidget>.IsVisible = false
            Ten<UIWidget>.IsVisible = true

            Ten<UIWidgetImage>.Alpha = 0.0
            
            start OutKillTween(Ten)

            KillCountTAG = 0
        }
    }

    async func OutKillTween(num entity<UIWidget>) {
        // 创建弹出动画
        CreateTween(
            num,
            UIWidgetImage.Alpha,
            0.0,
            1.0,
            TweenStyle.Once,
            CreateCurve({0.0, 0.0, 1.0, 1.0}),
            500,
            out var OutTween,
            true,
        )
        WaitForMillisecond(500)
        Destroy(OutTween)
        WaitForMillisecond(1000)
        // 创建消失动画
        CreateTween(
            num,
            UIWidgetImage.Alpha,
            1.0,
            0.0,
            TweenStyle.Once,
            CreateCurve({0.0, 0.0, 1.0, 1.0}),
            500,
            out var CloseTween,
            true,
        )
        WaitForMillisecond(500)
        Destroy(CloseTween)
        KillShowBoardUI<CustomUI>.IsVisible = false
    }
//————————————————————————————————————————————————————排行榜功能—————————————————————————————————————————————————————————————//
//———————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————//
//———————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————//
    // 初始化排行榜
    func InitRankingList() {
        List.Clear(RankingList)
        LogInfo("排行榜数据已初始化")
    }

    // 设置当前角色名称（在选择角色时调用）
    func SetCurrentHeroName(skillIndex int) {
        if skillIndex == 1 {
            CurrentHeroName = "近卫爆破手"
        } else if skillIndex == 2 {
            CurrentHeroName = "风暴游击手"
        }
        LogInfo("当前使用角色: " + CurrentHeroName)
    }

    // 游戏胜利时处理排行榜
    func ProcessRankingOnVictory() {
        if !PVEController.IsGameSuccess {
            return  // 只有游戏胜利才记录
        }
        
        // 获取BOSS击杀时间（毫秒）
        var BossliveTime = FC_PVEMonsterManager.BossliveTime
        var BossKillTime = BossliveTime / 1000  // 转换为秒
        var bossKillTimeStr string = PVEController.FormatTimeMMSS(BossKillTime)
        
        LogInfo("游戏胜利: 关卡" + FC_PVEMonsterManager.CurrentLevel + ", 时间" + bossKillTimeStr + ", 角色" + CurrentHeroName)
        
        // 尝试添加到排行榜
        TryAddToRankingList(FC_PVEMonsterManager.CurrentLevel, bossKillTimeStr, CurrentHeroName, BossKillTime)
        
        // 保存到本地存储
        SaveRankingListToStorage()
    }
    
    // 尝试添加到排行榜
    func TryAddToRankingList(level int, bossKillTimeStr string, heroName string, BossKillTime int) bool {
        // 创建新记录
        var newRecord = Map<string, object>{}
        newRecord["Level"] = level
        newRecord["bossKillTime"] = bossKillTimeStr
        newRecord["HeroName"] = heroName
        newRecord["ClearTime"] = BossKillTime
        
        // 检查是否需要添加
        if !ShouldAddToRanking(newRecord) {
            LogInfo("记录未达到排行榜要求，不添加")
            return false
        }
        
        // 添加并排序
        AddAndSortToRanking(newRecord)
        
        // 更新最高记录
        UpdateHighestRecords(level, BossKillTime)
        
        LogInfo("成功添加到排行榜")
        return true
    }

    // 检查是否需要添加到排行榜
    func ShouldAddToRanking(newRecord Map<string, object>) bool {
        var newLevel = 0
        var newTime = 0
        if newRecord["Level"] != nil {
            newLevel = newRecord["Level"] as int
        }
        if newRecord["ClearTime"] != nil {
            newTime = newRecord["ClearTime"] as int
        }
        
        // 如果排行榜未满，直接加入
        if List.Length(RankingListMap) < MaxRankingEntries {
            return true
        }
        
        // 排行榜已满，检查是否比最后一名好
        var lastRecord = RankingListMap[List.Length(RankingListMap) - 1]
        var lastLevel = 0
        var lastTime = 0
        if lastRecord["Level"] != nil {
            lastLevel = lastRecord["Level"] as int
        }
        if lastRecord["ClearTime"] != nil {
            lastTime = lastRecord["ClearTime"] as int
        }
        
        // 比较规则：关卡越高越好，关卡相同时间越短越好
        return newLevel > lastLevel || (newLevel == lastLevel && newTime < lastTime)
    }

    // 添加并排序到排行榜
    func AddAndSortToRanking(newRecord Map<string, object>) {
        var newLevel = 0
        var newTime = 0
        if newRecord["Level"] != nil {
            newLevel = newRecord["Level"] as int
        }
        if newRecord["ClearTime"] != nil {
            newTime = newRecord["ClearTime"] as int
        }
        
        // 查找插入位置
        var insertIndex = List.Length(RankingListMap)
        for i = 0, List.Length(RankingListMap), 1 {
            var record = RankingListMap[i]
            var recordLevel = 0
            var recordTime = 0
            if record["Level"] != nil {
                recordLevel = record["Level"] as int
            }
            if record["ClearTime"] != nil {
                recordTime = record["ClearTime"] as int
            }
            
            // 排序规则：关卡降序，相同关卡时间升序
            if newLevel > recordLevel {
                insertIndex = i
                break
            } else if newLevel == recordLevel && newTime < recordTime {
                insertIndex = i
                break
            }
        }
        
        // 插入新记录
        List.Insert(RankingListMap, insertIndex, newRecord)
        
        // 保持最大数量限制
        if List.Length(RankingListMap) > MaxRankingEntries {
            List.RemoveAt(RankingListMap, MaxRankingEntries)
        }
        
        LogInfo("当前排行榜记录数: " + List.Length(RankingListMap))
    }

    // 更新最高记录
    func UpdateHighestRecords(level int, BossKillTime int) {
        // 更新最高关卡
        if level > HighestLevel {
            HighestLevel = level
            FastestTime = BossKillTime  // 新关卡的最快时间
            LogInfo("更新最高关卡: " + HighestLevel)
        // 如果是同一关卡且时间更短，更新最快时间
        } else if level == HighestLevel && (FastestTime == 0 || BossKillTime < FastestTime) {
            FastestTime = BossKillTime
            LogInfo("更新最快通关时间: " + FastestTime + "秒")
        }
    }

    // 保存排行榜到本地存储
    func SaveRankingListToStorage() {
        LogInfo("开始保存排行榜数据，共" + List.Length(RankingListMap) + "条记录")
        var player_id UUID = currPlayer<Player>.UserUID
        
        // 序列化排行榜数据
        DATA_RankingList = SerializeRankingList()
        
        // 保存序列化的string列表
        WriteToLocalDataStore("RankingList", player_id, RankingList_KEY, DATA_RankingList, "", out var status_code1)
        LogInfo("数据存储完成，状态码: " + ToString(status_code1))
    }

    // 从已加载的排行榜数据中更新最高记录
    func UpdateHighestFromLoadedRanking() {
        if List.Length(RankingListMap) > 0 {
            // 排行榜第一条就是最好的记录
            var bestRecord = RankingListMap[0]
            if bestRecord["Level"] != nil {
                HighestLevel = bestRecord["Level"] as int
            }
            if bestRecord["ClearTime"] != nil {
                FastestTime = bestRecord["ClearTime"] as int
            }
            LogInfo("从排行榜加载最高记录: 关卡" + HighestLevel + ", 时间" + FastestTime + "秒")
        }
    }

    //-------------------------------------------------UI显示部分--------------------------------------------------//
    // 显示排行榜UI并更新显示
    func ShowRankingListUI() {
        // 显示排行榜UI
        RankingListUI<CustomUI>.IsVisible = true
        LogInfo("显示排行榜UI")
        
        // 更新排行榜数据显示
        UpdateRankingListDisplay()
    }

    // 更新排行榜数据显示
    func UpdateRankingListDisplay() {
        // 获取排行榜数据
        var rankingData = RankingListMap
        var dataCount = List.Length(rankingData)
        LogInfo("开始更新排行榜显示，共" + dataCount + "条记录")
        
        // 如果没有数据，显示空状态
        if dataCount == 0 {
            UpdateEmptyRankingDisplay()
            return
        }
        
        var Part2 = GetWidgetByPath(GetLocalPlayer(), RankingListUI, "/RankPanel/TitleBoard/IFMPanel/IFMPanelBB/LevelAmountIFM/TitleIFM/Part2")
        var Part3 = GetWidgetByPath(GetLocalPlayer(), RankingListUI, "/RankPanel/TitleBoard/IFMPanel/IFMPanelBB/LevelAmountIFM/TitleIFM/Part3")
        Part2<UIWidget>.IsVisible = true
        Part3<UIWidget>.IsVisible = false

        // 显示排行榜条目（最多显示MaxRankingEntries条）
        var displayCount = Math.Min(dataCount, MaxRankingEntries)
        
        for i = 0, displayCount, 1 {
            var record = rankingData[i]
            var rank = i + 1
            // 更新每个排名的显示
            UpdateRankingEntryDisplay(rank, record)
        }
        
        // 隐藏多余的排名显示
        for i = displayCount, MaxRankingEntries, 1 {
            HideRankingEntry(i + 1)
        }
        
        LogInfo("排行榜显示更新完成，显示了" + displayCount + "条记录")
    }

    // 更新单个排名条目显示
    func UpdateRankingEntryDisplay(rank int, record Map<string, object>) {
        // 获取关卡、时间和角色名称
        var level = 0
        var bossKillTime = ""
        var heroName = ""
        if record["Level"] != nil {
            level = record["Level"] as int
        }
        if record["bossKillTime"] != nil {
            bossKillTime = record["bossKillTime"] as string
        }
        if record["HeroName"] != nil {
            heroName = record["HeroName"] as string
        }
        // 根据排名构建路径后缀
        var rankSuffix = ""
        if rank == 1 {
            rankSuffix = "/NUM (1)"
        } else if rank == 2 {
            rankSuffix = "/NUM (2)"
        } else if rank == 3 {
            rankSuffix = "/NUM (3)"
        } else if rank == 4 {
            rankSuffix = "/NUM (4)"
        } else if rank == 5 {
            rankSuffix = "/NUM (5)"
        } else if rank == 6 {
            rankSuffix = "/NUM (6)"
        } else if rank == 7 {
            rankSuffix = "/NUM (7)"
        } else if rank == 8 {
            rankSuffix = "/NUM (8)"
        } else if rank == 9 {
            rankSuffix = "/NUM (9)"
        } else if rank == 10 {
            rankSuffix = "/NUM (10)"
        } else {
            LogWarning("无效的排名: " + rank)
            return
        }
        // 显示该排名区域
        var rankPanel = GetWidgetByPath(GetLocalPlayer(), RankingListUI, "/RankPanel/TitleBoard/IFMPanel/IFMPanelBB/LevelAmountIFM/TitleIFM/Part2/RollPanel" + rankSuffix)
        if rankPanel != nil {
            rankPanel<UIWidget>.IsVisible = true
        }
        // 更新关卡显示
        var levelPath = "/RankPanel/TitleBoard/IFMPanel/IFMPanelBB/LevelAmountIFM/TitleIFM/Part2/RollPanel" + rankSuffix + "/NUMBEROFLEVELS"
        var levelText = GetWidgetByPath(GetLocalPlayer(), RankingListUI, levelPath)
        levelText<UIWidgetLabel>.Content = Convert.ToString(level)
        // 更新角色显示
        var rolePath = "/RankPanel/TitleBoard/IFMPanel/IFMPanelBB/LevelAmountIFM/TitleIFM/Part2/RollPanel" + rankSuffix + "/ROLE"
        var roleText = GetWidgetByPath(GetLocalPlayer(), RankingListUI, rolePath)
        var heroNameText = ""
        if  heroName == "风暴游击手" {
            heroNameText = LocString{"HERO_RAIDER", List<string>{}}
        } else {
            heroNameText = LocString{"HERO_BREACHER", List<string>{}}
        }
        roleText<UIWidgetLabel>.Content = heroNameText
        // 更新时间显示
        var timePath = "/RankPanel/TitleBoard/IFMPanel/IFMPanelBB/LevelAmountIFM/TitleIFM/Part2/RollPanel" + rankSuffix + "/Time"
        var timeText = GetWidgetByPath(GetLocalPlayer(), RankingListUI, timePath)
        timeText<UIWidgetLabel>.Content = bossKillTime
        LogInfo("排名" + rank + "更新: 关卡" + level + ", 角色" + heroName + ", 时间" + bossKillTime)
    }

    // 隐藏排名条目
    func HideRankingEntry(rank int) {
        var rankSuffix = ""
        if rank == 1 {
