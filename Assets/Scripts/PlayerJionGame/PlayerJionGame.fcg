//———————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————//
    // 更新已选卡牌列表数据等操作
    func OnNowChoiceCardClicked(cardIndex int) {
        LogInfo("点击位置: 第 " + Convert.ToString(cardIndex) + " 张卡牌")
        
        // 根据当前技能获取对应的已选卡牌列表
        var selectedCards = List<int>{}
        if CurrentSkill == 1 {
            selectedCards = SelectedCards_1
        } else if CurrentSkill == 2 {
            selectedCards = SelectedCards_2
        } else {
            LogInfo("当前技能: 未知技能")
            return
        }
        
        // 计算显示数量
        var totalCards = List.Length(selectedCards)
        var displayCount int = Round(Math.Min(totalCards, 5) as int)
        
        LogInfo("已选卡牌总数: " + Convert.ToString(totalCards))
        LogInfo("显示数量: " + Convert.ToString(displayCount))
        
        // 检查点击的位置是否有卡牌
        if cardIndex <= displayCount && cardIndex > 0 {
            // 计算实际在列表中的索引（显示最近选择的卡牌）
            var actualIndex = totalCards - displayCount + (cardIndex - 1)
            var cardId = selectedCards[actualIndex]
            // 获取卡牌信息
            var cardInfo = GetCardInfoById(cardId, CurrentSkill)
            if cardInfo != nil {
                // 打印卡牌详细信息
                var translationText = Convert.ToString(cardInfo["TranslationText"])
                var nature = Convert.ToString(cardInfo["Nature"])
                var value = cardInfo["Value"] as float
                var rarity = cardInfo["Rarity"] as int
                var typeText = Convert.ToString(cardInfo["Typetext"])
                var sktchtext = Convert.ToString(cardInfo["Sktchtext"])
                
                LogInfo("属性文本: " + translationText)
                LogInfo("稀有度: " + Convert.ToString(rarity))
                LogInfo("类型文本: " + typeText)
                
                // 根据不同技能显示技能说明
                if CurrentSkill == 1 {
                    LogInfo("=== 技能1说明 ===")
                } else if CurrentSkill == 2 {
                    LogInfo("=== 技能2说明 ===")
                }
            } else {
                LogInfo("未找到卡牌ID " + Convert.ToString(cardId) + " 的数据")
            }
        } else {
            LogInfo("该位置没有卡牌（位置 " + Convert.ToString(cardIndex) + "）")
        }
    }
    
    // 根据ID和技能获取卡牌信息
    func GetCardInfoById(cardId int, skill int) Map<string, object> {
        if skill == 1 {
            return Skill_1_CardData[cardId]
        } else if skill == 2 {
            return Skill_2_CardData[cardId]
        }
        return nil
    }
//———————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————//
//—————————————————————————————————————————————————以下为天赋卡片的数据————————————————————————————————————————————————————————//
//—————————————————————————————————————————————————以下为天赋卡片的数据————————————————————————————————————————————————————————//
//———————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————//
    // 注入天赋卡片的数据
    func InjectGifted_CardData() {
        // 解析CSV
        Map.Clear(Gifted_CardData)
        for cardId = 1, 11, 1 {
            var cardInfo = Map<string, object>{}
            cardInfo["CardID"] = cardId
            // 从CSV读取卡牌数据，从第三行开始读取
            var cardRow = CSVData.ReadCSVRow(EResCSV.GiftedData, cardId + 2)
            cardInfo["Nature"] = cardRow[1]
            cardInfo["Value"] = cardRow[2] as List<float>
            cardInfo["Rarity"] = cardRow[3] as List<int>
            cardInfo["TranslationText"] = cardRow[4]
            cardInfo["Sktchtext"] = cardRow[5]
            cardInfo["GiftedName"] = cardRow[6]
            Gifted_CardData[cardId] = cardInfo
            // 在显示时格式化浮点数，保留两位小数
            // LogInfo(Gifted_CardData[cardId])
        }
        LogInfo("天赋卡片注入完成")
    }

    // 注入天赋卡片概率数据
    func InjectGiftCardProbabilityData() {
        // 解析CSV
        List.Clear(Gifted_CardProbability)
        for rowIndex = 1, 11, 1 {
            var configInfo = Map<string, object>{}
            // 从CSV读取概率数据，从第三行开始读取
            var configRow = CSVData.ReadCSVRow(EResCSV.GiftCardProbabilityData, rowIndex + 2)
            configInfo["MinCount"] = configRow[0] as int
            configInfo["Price"] = configRow[1] as int
            configInfo["CommonProb"] = configRow[2] as float
            configInfo["RareProb"] = configRow[3] as float
            configInfo["EpicProb"] = configRow[4] as float
            List.Append(Gifted_CardProbability, configInfo)
            // LogInfo("抽卡配置" + Convert.ToString(rowIndex) + ": " + Convert.ToString(configInfo))
        }
        LogInfo("天赋卡片概率数据注入完成")
    }
//———————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————//
    // 获取当前抽卡配置
    func GetCurrentDrawConfig() Map<string, object> {
        for i, config in Gifted_CardProbability {
            if TotalDrawCount >= config["MinCount"] as int {
                // 检查是否是最后一个配置
                if i == List.Length(Gifted_CardProbability) - 1 {
                    return config
                }
                // 检查下一个配置的最小次数是否大于当前抽卡次数
                var nextConfig = Gifted_CardProbability[i + 1]
                if TotalDrawCount < nextConfig["MinCount"] as int {
                    return config
                }
            }
        }
        // 默认返回第一个配置
        return Gifted_CardProbability[0]
    }

    // 获取当前抽卡价格
    func GetCurrentDrawPrice() int {
        var config = GetCurrentDrawConfig()
        return config["Price"] as int
    }

    // 根据概率随机选择卡牌稀有度
    func SelectCardByProbability() int {
        var config = GetCurrentDrawConfig()
        var randomValue = RandomFloat(0.0, 1.0)
        var commonProb = config["CommonProb"] as float
        var rareProb = config["RareProb"] as float
        var epicProb = config["EpicProb"] as float
        LogInfo("当前概率 - 普通:" + Convert.ToString(commonProb) + " 稀有:" + Convert.ToString(rareProb) + " 史诗:" + Convert.ToString(epicProb))
        if randomValue < commonProb {
            return 1  // 普通
        } else if randomValue < commonProb + rareProb {
            return 2  // 稀有
        } else {
            return 3  // 史诗
        }
    }

    // 根据稀有度筛选可抽取的卡牌
    func GetAvailableCardsByRarity(targetRarity int) List<int> {
        var availableCardIds = List<int>{}
        for cardId, cardData in Gifted_CardData {
            var nature = Convert.ToString(cardData["Nature"])
            var currentCount = 0
            if Gifted_Card_Count[cardId] != nil {
                currentCount = Gifted_Card_Count[cardId]
            }
            
            // 检查是否达到最大抽取次数
            var maxCount = GetMaxDrawCount(nature)
            if currentCount < maxCount {
                // 检查稀有度是否匹配
                var cardRarity = cardData["Rarity"] as int
                if cardRarity == targetRarity {
                    List.Append(availableCardIds, cardId)
                }
            }
        }
        
        return availableCardIds
    }
//———————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————//
//———————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————//
//———————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————//
    // 抽卡
    func DrawCard() {
        // 获取当前抽卡价格
        var currentPrice = GetCurrentDrawPrice()
        var currentConfig = GetCurrentDrawConfig()
        
        // 检查玩家是否有足够的货币
        if  Money < currentPrice {
            LogWarning("货币不足，需要" + Convert.ToString(currentPrice))
            return
        }
        
        // 扣除货币
        DeductPlayerCurrency(currentPrice)
        
        // 根据概率选择稀有度
        var selectedRarity = SelectCardByProbability()
        
        // 获取该稀有度下可抽取的卡牌
        var availableCardIds = GetAvailableCardsByRarity(selectedRarity)
        
        // 如果该稀有度没有可抽取的卡牌，降级到下一个稀有度
        if List.Length(availableCardIds) == 0 {
            if selectedRarity == 3 {  // 史诗降级到稀有
                availableCardIds = GetAvailableCardsByRarity(2)
                if List.Length(availableCardIds) == 0 {
                    availableCardIds = GetAvailableCardsByRarity(1)  // 稀有降级到普通
                }
            } else if selectedRarity == 2 {  // 稀有降级到普通
                availableCardIds = GetAvailableCardsByRarity(1)
            }
        }
        
        // 如果仍然没有可抽取的卡牌，获取所有可抽取的卡牌
        if List.Length(availableCardIds) == 0 {
            LogWarning("特定稀有度没有可抽取的卡牌，获取所有可抽取卡牌")
            availableCardIds = List<int>{}
            for cardId, cardData in Gifted_CardData {
                var nature = Convert.ToString(cardData["Nature"])
                var currentCount = 0
                if Gifted_Card_Count[cardId] != nil {
                    currentCount = Gifted_Card_Count[cardId]
                }
                var maxCount = GetMaxDrawCount(nature)
                if currentCount < maxCount {
                    List.Append(availableCardIds, cardId)
                }
            }
        }
        
        // 如果没有可抽取的卡牌，提示并返回
        if List.Length(availableCardIds) == 0 {
            LogWarning("所有卡牌都已达到最大抽取次数")
            return
        }
        // 随机选择一张卡牌
        var randomIndex = RandomInt(0, List.Length(availableCardIds))
        var selectedCardId = availableCardIds[randomIndex]
        var selectedCard = Gifted_CardData[selectedCardId]
        // 更新卡牌计数
        var currentCount = 0
        if Gifted_Card_Count[selectedCardId] != nil {
            currentCount = Gifted_Card_Count[selectedCardId]
        }
        Gifted_Card_Count[selectedCardId] = currentCount + 1
        
        // 更新总抽卡次数
        TotalDrawCount = TotalDrawCount + 1
        
        // 应用卡牌效果
        ApplyGiftedCardEffect(selectedCardId)
        
        // 更新UI显示
        UpdateGiftedCardUI(selectedCard)
        
        // 更新抽卡UI显示（价格、概率等）
        UpdateDrawCardUI()

        // 更新天赋加成百分比显示
        DisplayGiftedCardBonusesInUI()

        // 弹出弹框显示抽到的卡牌
        ShowDrawCardPopup(selectedCard)
    }

    func ShowDrawCardPopup(cardInfo Map<string, object>) {
        // 弹出弹框显示抽到的卡牌
        PopupUI<CustomUI>.IsVisible = true
        
        var cardId = cardInfo["CardID"] as int
        var nature = Convert.ToString(cardInfo["Nature"])
        var value = cardInfo["Value"] as float
        var translationText = Convert.ToString(cardInfo["TranslationText"])
        var GiftedNameText = Convert.ToString(cardInfo["GiftedName"])
        var rarity = cardInfo["Rarity"] as int
        var currentCount = Gifted_Card_Count[cardId]
        var maxCount = GetMaxDrawCount(nature)

        // 更新天赋卡牌说明
        var PopupText = GetWidgetByPath(GetLocalPlayer(), PopupUI, "/Panel/Bb/ICONBb/Text")
        if PopupText != nil {
            PopupText<UIWidgetLabel>.Content = GiftedNameText
        }

        // 更新卡牌图标
        var PopupIconEntity = GetWidgetByPath(GetLocalPlayer(), PopupUI, "/Panel/Bb/ICONBb/ICON")
        if PopupIconEntity != nil {
            // PopupIconEntity.SetImage("GiftedIcon_" + Convert.ToString(cardId))
        }
    }

    // 扣除玩家货币
    func DeductPlayerCurrency(price int) {
        Money = Money - price
    }

    // 更新抽卡UI显示（价格、概率等信息）
    func UpdateDrawCardUI() {
        var currentConfig = GetCurrentDrawConfig()
        var currentPrice = currentConfig["Price"] as int
        var commonProb = currentConfig["CommonProb"] as float * 100
        var rareProb = currentConfig["RareProb"] as float * 100
        var epicProb = currentConfig["EpicProb"] as float * 100
        // 更新剩余价格显示
        var NowMoneyText = GetWidgetByPath(GetLocalPlayer(), GiftedUI, "/Func/MoneyPanel/Money/text")
        if NowMoneyText != nil {
            NowMoneyText<UIWidgetLabel>.Content = Convert.ToString(Money)
        }
        // 更新当前阶段价格显示
        var priceText = GetWidgetByPath(GetLocalPlayer(), GiftedUI, "/DrawBadgePanel/Image/Money")
        if priceText != nil {
            priceText<UIWidgetLabel>.Content = Convert.ToString(currentPrice)
        }
    }
//———————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————//
//———————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————//
//———————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————//
    // 计算天赋卡牌总加成百分比
    func CalculateGiftedCardBonusPercentages() Map<string, float> {
        var totalBonuses = Map<string, float>{}
        // 初始化所有天赋类型
        var bonusTypes = List<string>{"HP", "MoveSpeed", "WeaponDamage", "SkillDamage"}
        for i, type in bonusTypes {
            totalBonuses[type] = 0.0
        }
        // 遍历所有已抽取的天赋卡牌
        for cardId, count in Gifted_Card_Count {
            if count > 0 {
                var cardInfo = Gifted_CardData[cardId]
                if cardInfo != nil {
                    var nature = Convert.ToString(cardInfo["Nature"])
                    var value = cardInfo["Value"] as float
                    var currentCount = count
                    // 累加该天赋类型的总加成
                    if totalBonuses[nature] != nil {
                        totalBonuses[nature] = totalBonuses[nature] + (value * currentCount)
                    } else {
                        totalBonuses[nature] = value * currentCount
                    }
                }
            }
        }
        // 计算百分比（有些是固定值，有些是百分比）
        var result = Map<string, float>{}
        for bonusType, totalValue in totalBonuses {
            if bonusType == "HP" {
                // HP显示为固定值
                result["HP"] = totalValue
            } else if bonusType == "MoveSpeed" {
                // 移动速度是百分比加成，直接显示
                result["MoveSpeed"] = totalValue * 100.0
            } else if bonusType == "WeaponDamage" {
                // 武器伤害是百分比加成
                result["WeaponDamage"] = totalValue * 100.0
            } else if bonusType == "SkillDamage" {
                // 技能伤害是百分比加成
                result["SkillDamage"] = totalValue * 100.0
            } else {
                // 其他类型保持原值
                result[bonusType] = totalValue * 100.0
            }
        }
        return result
    }

    // 在UI中显示天赋卡牌加成百分比
    func DisplayGiftedCardBonusesInUI() {
        // 计算所有天赋的加成百分比
        var bonuses = CalculateGiftedCardBonusPercentages()
        // HP加成显示
        var hpBonusWidget = GetWidgetByPath(GetLocalPlayer(), GiftedUI, "/AllPanel/IFMLang/HP/HPLogo/Name/Num")
        if hpBonusWidget != nil {
            var hpBonus = 0.0
            if bonuses["HP"] != nil {
                hpBonus = bonuses["HP"]
            }
            hpBonusWidget<UIWidgetLabel>.Content = "+"+Convert.ToString(Math.Round(hpBonus))
        }
        // 移动速度加成显示
        var moveSpeedBonusWidget = GetWidgetByPath(GetLocalPlayer(), GiftedUI, "/AllPanel/IFMLang/MoveSpeed/MoveSpeedLogo/Name/Num")
        if moveSpeedBonusWidget != nil {
            var moveSpeedBonus = 0.0
            if bonuses["MoveSpeed"] != nil {
                moveSpeedBonus = bonuses["MoveSpeed"]
            }
            moveSpeedBonusWidget<UIWidgetLabel>.Content = "+"+Convert.ToString(Math.Round(moveSpeedBonus)) + "%"
        }
        // 武器伤害加成显示
        var weaponDamageBonusWidget = GetWidgetByPath(GetLocalPlayer(), GiftedUI, "/AllPanel/IFMLang/WeaponDamage/WeaponDamageLogo/Name/Num")
        if weaponDamageBonusWidget != nil {
            var weaponDamageBonus = 0.0
            if bonuses["WeaponDamage"] != nil {
                weaponDamageBonus = bonuses["WeaponDamage"]
            }
            weaponDamageBonusWidget<UIWidgetLabel>.Content = "+"+Convert.ToString(Math.Round(weaponDamageBonus)) + "%"
        }
        // 技能伤害加成显示
        var skillDamageBonusWidget = GetWidgetByPath(GetLocalPlayer(), GiftedUI, "/AllPanel/IFMLang/SKillDamage/SkillLogo/Name/Num")
        if skillDamageBonusWidget != nil {
            var skillDamageBonus = 0.0
            if bonuses["SkillDamage"] != nil {
                skillDamageBonus = bonuses["SkillDamage"]
            }
            skillDamageBonusWidget<UIWidgetLabel>.Content = "+"+Convert.ToString(Math.Round(skillDamageBonus)) + "%"
        }
        LogInfo("天赋卡牌加成百分比已更新到UI")
    }

    // 获取卡牌最大抽取次数
    func GetMaxDrawCount(nature string) int {
        // 需要限制最高等级就在这个条件后面加
        if nature == "HP" || nature == "MoveSpeed" {
            return 5
        }
        // 其他属性无限制
        return 99999999
    }
//———————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————//
//———————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————//
//———————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————//
    // 应用卡牌效果
    func ApplyGiftedCardEffect(cardId int) {
        var cardInfo = Gifted_CardData[cardId]
        if cardInfo == nil {
            return
        }
        var nature = Convert.ToString(cardInfo["Nature"])
        var value = cardInfo["Value"] as float
        
        LogInfo("应用天赋卡牌效果: " + nature + " 值: " + Convert.ToString(value))
        
        // 局外天赋加成：基于原始基础数据计算
        if nature == "HP" {
            // HP是固定值加成
            var baseHP = PlayerData["HP"] as int
            var currentOuterHP = 0
            if PlayerDataWithOuterBonus["HP"] != nil {
                currentOuterHP = Round(PlayerDataWithOuterBonus["HP"] as int)
            } else {
                currentOuterHP = baseHP
            }
            PlayerDataWithOuterBonus["HP"] = currentOuterHP + value as int
            LogInfo("局外HP: 基础" + Convert.ToString(baseHP) + " + " + Convert.ToString(value) + " = " + Convert.ToString(PlayerDataWithOuterBonus["HP"]))
        
        } else if nature == "MoveSpeed" {
            // 移速：百分比加成
            var baseSpeed = PlayerData["MoveSpeed"] as float
            var currentMultiplier = 1.0
            if PlayerDataWithOuterBonus["MoveSpeed_Multiplier"] != nil {
                currentMultiplier = PlayerDataWithOuterBonus["MoveSpeed_Multiplier"] as float
            }
            PlayerDataWithOuterBonus["MoveSpeed_Multiplier"] = currentMultiplier + value
            PlayerDataWithOuterBonus["MoveSpeed"] = baseSpeed * PlayerDataWithOuterBonus["MoveSpeed_Multiplier"] as float
            LogInfo("局外移速: 基础" + Convert.ToString(baseSpeed) + " × " + Convert.ToString(PlayerDataWithOuterBonus["MoveSpeed_Multiplier"]) + " = " + Convert.ToString(PlayerDataWithOuterBonus["MoveSpeed"]))

        } else if nature == "WeaponDamage" {
            // 武器伤害：百分比加成
            var baseDamage1 = Skill1Data["WeaponDamage"] as int
            var baseDamage2 = Skill2Data["WeaponDamage"] as int
            var currentMultiplier = 1.0

            // 技能1
            if Skill1DataWithOuterBonus["WeaponDamage_Multiplier"] != nil {
                currentMultiplier = Skill1DataWithOuterBonus["WeaponDamage_Multiplier"] as float
            }
            Skill1DataWithOuterBonus["WeaponDamage_Multiplier"] = currentMultiplier + value
            Skill1DataWithOuterBonus["WeaponDamage"] = Round(baseDamage1 * Skill1DataWithOuterBonus["WeaponDamage_Multiplier"] as float) as int
            LogInfo("局外武器1伤害: 基础" + Convert.ToString(baseDamage1) + " × " + Convert.ToString(Skill1DataWithOuterBonus["WeaponDamage_Multiplier"]) + " = " + Convert.ToString(Skill1DataWithOuterBonus["WeaponDamage"]))

            // 技能2
            if Skill2DataWithOuterBonus["WeaponDamage_Multiplier"] != nil {
                currentMultiplier = Skill2DataWithOuterBonus["WeaponDamage_Multiplier"] as float
            }
            Skill2DataWithOuterBonus["WeaponDamage_Multiplier"] = currentMultiplier + value
            Skill2DataWithOuterBonus["WeaponDamage"] = Round(baseDamage2 * Skill2DataWithOuterBonus["WeaponDamage_Multiplier"] as float) as int
            LogInfo("局外武器2伤害: 基础" + Convert.ToString(baseDamage2) + " × " + Convert.ToString(Skill2DataWithOuterBonus["WeaponDamage_Multiplier"]) + " = " + Convert.ToString(Skill2DataWithOuterBonus["WeaponDamage"]))

        } else if nature == "SkillDamage" {
            // 技能伤害：同时影响技能1和技能2
            var baseSkill1Damage = Skill1Data["SkillDamage"] as int
            var baseSkill2Damage = Skill2Data["SkillDamage"] as int
            
            // 技能1
            var currentMultiplier1 = 1.0
            if Skill1DataWithOuterBonus["SkillDamage_Multiplier"] != nil {
                currentMultiplier1 = Skill1DataWithOuterBonus["SkillDamage_Multiplier"] as float
            }
            Skill1DataWithOuterBonus["SkillDamage_Multiplier"] = currentMultiplier1 + value
            Skill1DataWithOuterBonus["SkillDamage"] = Round(baseSkill1Damage * Skill1DataWithOuterBonus["SkillDamage_Multiplier"] as float) as int
            LogInfo("局外技能伤害: 技能1 基础" + Convert.ToString(baseSkill1Damage) + " × " + Convert.ToString(Skill1DataWithOuterBonus["SkillDamage_Multiplier"]) + " = " + Convert.ToString(Skill1DataWithOuterBonus["SkillDamage"]))
            
            // 技能2
            var currentMultiplier2 = 1.0
            if Skill2DataWithOuterBonus["SkillDamage_Multiplier"] != nil {
                currentMultiplier2 = Skill2DataWithOuterBonus["SkillDamage_Multiplier"] as float
            }
            Skill2DataWithOuterBonus["SkillDamage_Multiplier"] = currentMultiplier2 + value
            Skill2DataWithOuterBonus["SkillDamage"] = Round(baseSkill2Damage * Skill2DataWithOuterBonus["SkillDamage_Multiplier"] as float) as int
            LogInfo("局外技能伤害: 技能2 基础" + Convert.ToString(baseSkill2Damage) + " × " + Convert.ToString(Skill2DataWithOuterBonus["SkillDamage_Multiplier"]) + " = " + Convert.ToString(Skill2DataWithOuterBonus["SkillDamage"]))
        }
        
        // 将局外数据复制到局内数据（开始游戏时）
        CopyToInGameData()
        // 更新玩家当前属性（使用局内数据）
        UpdatePlayerAttributes()
    }

    // 更新玩家当前属性（使用局内数据）
    func UpdatePlayerAttributes() {
        // 更新玩家当前属性（使用局内数据）
        currPlayer<Player>.MaxHP = Round(PlayerDataInGame["HP"] as int)
        currPlayer<Player>.HP = Round(PlayerDataInGame["HP"] as int)
        currPlayer<Player>.RunSpeedScale = PlayerDataInGame["MoveSpeed"] as float
    }

    // 更新技能1数据
    func UpdateSkill1Data() {
        if CurrentSkill == 1 {
            LogInfo(currentWeapon)
            //设置武器伤害
            var weaponDamage = Round(Skill1DataInGame["WeaponDamage"] as int)
            currentWeapon<Weapon>.Damage = weaponDamage
            //设置武器换弹速度
            var ReloadSpeed = Skill1DataInGame["ReloadSpeed"] as float
            currentWeapon<Weapon>.ReloadSpeedFactor = ReloadSpeed
            //设置武器攻击速度
            var AttackSpeed = Skill1DataInGame["AttackSpeed"] as float
            currentWeapon<Weapon>.AttackInterval = AttackSpeed
            //设置武器弹匣容量
            var AmmoMagSize = Skill1DataInGame["WeaponMaxMagazine"] as int
            currentWeapon<Weapon>.AmmoMagSize = AmmoMagSize
        }
    }

    // 更新技能2数据
    func UpdateSkill2Data() {
        if CurrentSkill == 2 {
            LogInfo(currentWeapon)
            //设置武器伤害
            var weaponDamage = Round(Skill2DataInGame["WeaponDamage"] as int)
            currentWeapon<Weapon>.Damage = weaponDamage
            //设置武器换弹速度
            var ReloadSpeed = Skill2DataInGame["ReloadSpeed"] as float
            currentWeapon<Weapon>.ReloadSpeedFactor = ReloadSpeed
            //设置武器攻击速度
            var AttackSpeed = Skill2DataInGame["AttackSpeed"] as float
            currentWeapon<Weapon>.AttackInterval = AttackSpeed
            //设置武器弹匣容量
            var AmmoMagSize = Skill2DataInGame["WeaponMaxMagazine"] as int
            currentWeapon<Weapon>.AmmoMagSize = AmmoMagSize
            currentWeapon<Weapon>.CurrentAmmo = currentWeapon<Weapon>.AmmoMagSize
        }
    }
