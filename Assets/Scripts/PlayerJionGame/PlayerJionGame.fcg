    // 自动选择当前最好的一张牌
    async func AutoChoiceBestOneCard() {
        // 使用已经生成的卡牌信息
        var card1 = Skill_1_CardData[CurrentRandomCards[0]]
        var card2 = Skill_1_CardData[CurrentRandomCards[1]]
        var card3 = Skill_1_CardData[CurrentRandomCards[2]]
        
        // 获取三张卡的稀有度
        var rarity1 = card1["Rarity"] as int
        var rarity2 = card2["Rarity"] as int
        var rarity3 = card3["Rarity"] as int
        
        var highestRarity = Math.Max(rarity1, Math.Max(rarity2, rarity3))
        
        LogInfo("三张卡牌稀有度: " + Convert.ToString(rarity1) + ", " + Convert.ToString(rarity2) + ", " + Convert.ToString(rarity3))
        LogInfo("最高稀有度: " + Convert.ToString(highestRarity))
        
        // 找出所有最高稀有度的卡牌索引
        var bestCardIndices = List<int>{}
        
        if rarity1 == highestRarity {
            List.Append(bestCardIndices, 1)  // 改为 1,2,3 表示第一、二、三张牌
        }
        if rarity2 == highestRarity {
            List.Append(bestCardIndices, 2)
        }
        if rarity3 == highestRarity {
            List.Append(bestCardIndices, 3)
        }
        
        // 选择最终卡牌
        var selectedIndex = 1  // 默认选择第一张
        
        if List.Length(bestCardIndices) == 1 {
            // 只有一张最高稀有度
            selectedIndex = bestCardIndices[0]
            LogInfo("唯一最高稀有度，选择卡牌" + Convert.ToString(selectedIndex))
        } else {
            // 多张相同最高稀有度，随机选一个
            var randomIndexInList = RandomInt(0, List.Length(bestCardIndices))
            selectedIndex = bestCardIndices[randomIndexInList]
            LogInfo("多张相同最高稀有度，随机选择卡牌" + Convert.ToString(selectedIndex))
        }
        
        var selectedCardId = CurrentRandomCards[selectedIndex - 1]  // 减1因为数组从0开始
        LogInfo("最终选择 - 位置:" + Convert.ToString(selectedIndex) + " ID:" + Convert.ToString(selectedCardId) + " 稀有度:" + Convert.ToString(highestRarity))
        
        // 选择逻辑
        SelectCard(selectedCardId, CurrentSkill)
        ApplyCardEffect(selectedCardId, CurrentSkill)

        // 触发选择效果，传递选择的牌位置
        OnCardSelected(selectedIndex)  // 传递选择的牌位置

        WaitForMillisecond(1000)

        // 隐藏选择界面
        ChoiceThreeCardUI<CustomUI>.IsVisible = false
        
        // 开始下一波
        PVEController.StartNextWave()
    }
//———————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————//
    func StartThree_choose_One(level int, CurrentSkill int, ability1Level int, ability2Level int, ability3Level int){
        // 生成三个不重复的随机卡牌
        var cards = List<Map<string, object>>{}
        while List.Length(cards) < 3 {
            var newCard Map<string, object> = GenerateRandomCard(CurrentSkill)
            if  newCard != nil {
                // 检查卡牌是否已存在，避免重复
                var isDuplicate = false
                for i, existingCard in cards {
                    if existingCard["CardID"] == newCard["CardID"] {
                        isDuplicate = true
                        break
                    }
                }
                if isDuplicate == false {
                    List.Append(cards, newCard)
                    LogInfo("生成卡牌:" + Convert.ToString(newCard["CardID"]) + "-" + Convert.ToString(newCard["Nature"]))
                }
            } else {
                LogInfo("技能" + Convert.ToString(CurrentSkill) + "的所有卡牌都已选择过")
                break
            }
        }
        
        // 显示生成的三个卡牌
        if List.Length(cards) >= 3 {
            var card1 = cards[0]
            var card2 = cards[1]
            var card3 = cards[2]
            // 保存卡牌ID到 CurrentRandomCards
            List.Clear(CurrentRandomCards)
            List.Append(CurrentRandomCards, card1["CardID"] as int)
            List.Append(CurrentRandomCards, card2["CardID"] as int)
            List.Append(CurrentRandomCards, card3["CardID"] as int)
            
            // 卡牌数据显示到UI
            UpdateCardUI(card1, card2, card3)
        } else {
            LogError("卡牌生成数量不足，只有" + Convert.ToString(List.Length(cards)) + "张")
        }

        // 重置已经选择的卡牌
        NowChoiceCard = 0
    }
//———————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————//
    // 生成随机卡牌（不允许重复选择）
    func GenerateRandomCard(CurrentSkill int) Map<string, object> {
        var cardDataMap = Map<int, Map<string, object>>{}
        var selectedCards = List<int>{}
        
        // 选择对应的牌库和已选记录
        if CurrentSkill == 1 {
            cardDataMap = Skill_1_CardData
            selectedCards = SelectedCards_1
        } else if CurrentSkill == 2 {
            cardDataMap = Skill_2_CardData
            selectedCards = SelectedCards_2
        } else {
            LogError("无效的技能索引:" + Convert.ToString(CurrentSkill))
            return nil
        }
        
        // 获取所有未选过的卡牌ID
        var availableCardIds = List<int>{}
        for cardId, cardData in cardDataMap {
            var isSelected = false
            for i, selectedId in selectedCards {
                if selectedId == cardId {
                    isSelected = true
                    break
                }
            }
            if isSelected == false {
                List.Append(availableCardIds, cardId)
            }
        }
        
        // 如果没有可用卡牌，返回空
        if List.Length(availableCardIds) == 0 {
            LogWarning("技能" + Convert.ToString(CurrentSkill) + "的所有卡牌都已选择过")
            return nil
        }
        
        // 随机选择一个卡牌ID
        var randomIndex = RandomInt(0, List.Length(availableCardIds))
        var randomCardId = availableCardIds[randomIndex]
        
        // 返回对应的卡牌数据
        return cardDataMap[randomCardId]
    }
//———————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————//
    // 选择卡牌（当玩家选择某张卡牌时调用）
    func SelectCard(cardId int, CurrentSkill int) {
        var selectedCards = List<int>{}
        
        if CurrentSkill == 1 {
            selectedCards = SelectedCards_1
        } else if CurrentSkill == 2 {
            selectedCards = SelectedCards_2
        } else {
            LogError("无效的技能索引:" + Convert.ToString(CurrentSkill))
            return
        }
        
        // 检查是否已选择过
        var alreadySelected = false
        for i, selectedId in selectedCards {
            if selectedId == cardId {
                alreadySelected = true
                break
            }
        }
        
        if alreadySelected == false {
            List.Append(selectedCards, cardId)
            LogInfo("卡牌" + Convert.ToString(cardId) + "已添加到已选列表，技能" + Convert.ToString(CurrentSkill))
            LogInfo("当前已选卡牌数量:" + Convert.ToString(List.Length(selectedCards)))
        }
    }
//———————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————//
//———————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————//
//———————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————//
    // 应用卡牌效果
    func ApplyCardEffect(cardId int, CurrentSkill int) {
        var cardDataMap = Map<int, Map<string, object>>{}
    
        if CurrentSkill == 1 {
            cardDataMap = Skill_1_CardData
        } else if CurrentSkill == 2 {
            cardDataMap = Skill_2_CardData
        }
        
        var cardInfo = cardDataMap[cardId]
        LogInfo(cardInfo)
        LogInfo(cardDataMap[cardId])
        if cardInfo != nil {
            var nature = Convert.ToString(cardInfo["Nature"])
            var value = cardInfo["Value"] as float
            
            LogInfo("应用卡牌效果 - 技能" + Convert.ToString(CurrentSkill) + 
                    " ID:" + Convert.ToString(cardId) + 
                    " 属性:" + nature + 
                    " 数值:" + Convert.ToString(value))
            
            // 根据当前技能和属性应用效果
            ApplySkillCardEffect(CurrentSkill, nature, value)
        }
    }
    
    // 应用三选一卡牌效果
    func ApplySkillCardEffect(skillNum int, attributeName string, value float) {
        // 玩家基础属性（基于局外天赋加成数据再应用局内加成）
        if attributeName == "movespeed" {
            // 移动速度加成 - 百分比
            var finalSpeed = 0.0
            if IsNextThreeChoiceOne == 0 {
                // 第一次选择：局外移速 × (1 + 加成)
                var outerSpeed = PlayerDataWithOuterBonus["MoveSpeed"] as float
                finalSpeed = outerSpeed * (1.0 + value)
            } else if IsNextThreeChoiceOne == 1 {
                // 后续选择：当前移速 + (局外移速 × 加成)
                var currentSpeed = PlayerDataInGame["MoveSpeed"] as float
                var outerSpeed = PlayerDataWithOuterBonus["MoveSpeed"] as float
                finalSpeed = currentSpeed + (outerSpeed * value)
            }
            PlayerDataInGame["MoveSpeed"] = finalSpeed
            LogInfo("局内移速: " + Convert.ToString(PlayerDataInGame["MoveSpeed"]))
        }
        
        // 技能1专属属性
        if skillNum == 1 {
            if attributeName == "SkillRange" {
                // 爆裂轰炸范围 - 固定值
                var finalRange = 0.0
                if IsNextThreeChoiceOne == 0 {
                    var outerRange = Skill1DataWithOuterBonus["SkillRange"] as float
                    finalRange = outerRange + value
                } else if IsNextThreeChoiceOne == 1 {
                    var currentRange = Skill1DataInGame["SkillRange"] as float
                    finalRange = currentRange + value
                }
                Skill1DataInGame["SkillRange"] = finalRange
                LogInfo("技能1范围: " + Convert.ToString(Skill1DataInGame["SkillRange"]))
                
            } else if attributeName == "SkillCD" {
                // 爆裂轰炸冷却减少 - 百分比
                var finalCD = 0
                if IsNextThreeChoiceOne == 0 {
                    var outerCD = Skill1DataWithOuterBonus["SkillCD"] as int
                    finalCD = Round(outerCD * (1.0 - value)) as int
                    // 记录当前总减少百分比
                    Skill1DataInGame["SkillCD_Reduction"] = value
                } else if IsNextThreeChoiceOne == 1 {
                    var outerCD = Skill1DataWithOuterBonus["SkillCD"] as int
                    // 获取当前总减少百分比
                    var totalReduction = value  // 初始为本次减少值
                    if Skill1DataInGame["SkillCD_Reduction"] != nil {
                        // 累加之前的总减少百分比
                        totalReduction = Skill1DataInGame["SkillCD_Reduction"] as float + value
                    }
                    // 从基础CD上计算最终CD
                    finalCD = Round(outerCD * (1.0 - totalReduction)) as int
                    // 更新总减少百分比记录
                    Skill1DataInGame["SkillCD_Reduction"] = totalReduction
                }
                Skill1DataInGame["SkillCD"] = finalCD
                LogInfo("技能1冷却: " + Convert.ToString(Skill1DataInGame["SkillCD"]))

            } else if attributeName == "SkillDamage" {
                // 爆裂轰炸伤害加成 - 百分比
                var finalDamage = 0
                if IsNextThreeChoiceOne == 0 {
                    var outerDamage = Skill1DataWithOuterBonus["SkillDamage"] as int
                    finalDamage = Round(outerDamage * (1.0 + value)) as int
                } else if IsNextThreeChoiceOne == 1 {
                    var currentDamage = Skill1DataInGame["SkillDamage"] as int
                    var outerDamage = Skill1DataWithOuterBonus["SkillDamage"] as int
                    finalDamage = currentDamage + Round(outerDamage * value) as int
                }
                Skill1DataInGame["SkillDamage"] = finalDamage
                LogInfo("技能1伤害: " + Convert.ToString(Skill1DataInGame["SkillDamage"]))
                
            } else if attributeName == "SkillAmount" {
