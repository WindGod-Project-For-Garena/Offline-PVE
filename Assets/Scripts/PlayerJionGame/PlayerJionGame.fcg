    // 计算天赋卡牌总加成百分比
    func CalculateGiftedCardBonusPercentages() Map<string, float> {
        var totalBonuses = Map<string, float>{}
        // 初始化所有天赋类型
        var bonusTypes = List<string>{"HP", "MoveSpeed", "WeaponDamage", "SkillDamage"}
        for i, type in bonusTypes {
            totalBonuses[type] = 0.0
        }
        // 遍历所有已抽取的天赋卡牌
        for cardId, count in Gifted_Card_Count {
            if count > 0 {
                var cardInfo = Gifted_CardData[cardId]
                if cardInfo != nil {
                    var nature = Convert.ToString(cardInfo["Nature"])
                    var value = cardInfo["Value"] as float
                    var currentCount = count
                    // 累加该天赋类型的总加成
                    if totalBonuses[nature] != nil {
                        totalBonuses[nature] = totalBonuses[nature] + (value * currentCount)
                    } else {
                        totalBonuses[nature] = value * currentCount
                    }
                }
            }
        }
        // 计算百分比（有些是固定值，有些是百分比）
        var result = Map<string, float>{}
        for bonusType, totalValue in totalBonuses {
            if bonusType == "HP" {
                // HP显示为固定值
                result["HP"] = totalValue
            } else if bonusType == "MoveSpeed" {
                // 移动速度是百分比加成，直接显示
                result["MoveSpeed"] = totalValue * 100.0
            } else if bonusType == "WeaponDamage" {
                // 武器伤害是百分比加成
                result["WeaponDamage"] = totalValue * 100.0
            } else if bonusType == "SkillDamage" {
                // 技能伤害是百分比加成
                result["SkillDamage"] = totalValue * 100.0
            } else {
                // 其他类型保持原值
                result[bonusType] = totalValue * 100.0
            }
        }
        return result
    }

    // 在UI中显示天赋卡牌加成百分比
    func DisplayGiftedCardBonusesInUI() {
        // 计算所有天赋的加成百分比
        var bonuses = CalculateGiftedCardBonusPercentages()
        // HP加成显示
        var hpBonusWidget = GetWidgetByPath(GetLocalPlayer(), GiftedUI, "/AllPanel/IFMLang/HPLogo/Name/Num")
        if hpBonusWidget != nil {
            var hpBonus = 0.0
            if bonuses["HP"] != nil {
                hpBonus = bonuses["HP"]
            }
            hpBonusWidget<UIWidgetLabel>.Content = "+"+Convert.ToString(Math.Round(hpBonus))
        }
        // 移动速度加成显示
        var moveSpeedBonusWidget = GetWidgetByPath(GetLocalPlayer(), GiftedUI, "/AllPanel/IFMLang/MoveSpeedLogo/Name/Num")
        if moveSpeedBonusWidget != nil {
            var moveSpeedBonus = 0.0
            if bonuses["MoveSpeed"] != nil {
                moveSpeedBonus = bonuses["MoveSpeed"]
            }
            moveSpeedBonusWidget<UIWidgetLabel>.Content = "+"+Convert.ToString(Math.Round(moveSpeedBonus)) + "%"
        }
        // 武器伤害加成显示
        var weaponDamageBonusWidget = GetWidgetByPath(GetLocalPlayer(), GiftedUI, "/AllPanel/IFMLang/WeaponDamageLogo/Name/Num")
        if weaponDamageBonusWidget != nil {
            var weaponDamageBonus = 0.0
            if bonuses["WeaponDamage"] != nil {
                weaponDamageBonus = bonuses["WeaponDamage"]
            }
            weaponDamageBonusWidget<UIWidgetLabel>.Content = "+"+Convert.ToString(Math.Round(weaponDamageBonus)) + "%"
        }
        // 技能伤害加成显示
        var skillDamageBonusWidget = GetWidgetByPath(GetLocalPlayer(), GiftedUI, "/AllPanel/IFMLang/SkillLogo/Name/Num")
        if skillDamageBonusWidget != nil {
            var skillDamageBonus = 0.0
            if bonuses["SkillDamage"] != nil {
                skillDamageBonus = bonuses["SkillDamage"]
            }
            skillDamageBonusWidget<UIWidgetLabel>.Content = "+"+Convert.ToString(Math.Round(skillDamageBonus)) + "%"
        }
        LogInfo("天赋卡牌加成百分比已更新到UI")
    }

    // 获取卡牌最大抽取次数
    func GetMaxDrawCount(nature string) int {
        // 需要限制最高等级就在这个条件后面加
        if nature == "HP" || nature == "MoveSpeed" {
            return 5
        }
        // 其他属性无限制
        return 99999999
    }
