import "StdLibrary.fcc" as std
import "EditorGenLib.fcc" as gen
import "Player.fcc" as player
import "List.fcc" as list
import "./FC_PVEMonsterManager.fcg" as monsterManager
import "../Static/FC_Utilities.fcg" as Utilities
import "Convert.fcc" as Convert
import "Items.fcc" as Items
import "../CustomEvent.fcc" as CustomEvent
import "Math.fcc" as Math
import "../SoundFunc/SoundFunc.fcg" as SoundFunc
import "../PlayerJionGame/PlayerJionGame.fcg" as PlayerJionGame
import "../MobScripts/BossButcher.fcg" as C_BossButcher
import "../PVE/FC_PVEMonsterManager.fcg" as FC_MonsterManager
import "Hud.fcc" as Hud

[platform_client]
static graph PVEController {
    // 控制器状态
    IsGameActive bool = false
    CurrentLevel int = 1
    CurrentWave int = 0
    MaxLevels int = 10
    MaxWaves int = 4

    currPlayer entity<Player> = nil
    
    // 游戏配置
    WaveTimeLimit int = 60000  // 每波次时间限制（ms）
    
    // 统计信息
    GameStartTime int = 0
    
    // 波次倒计时
    WaveStartTime int = 0  // 波次开始时间/ms
    WaveCountdownInterval int = 1000  // 倒计时更新间隔（毫秒）
    IsCountdownActive bool = false

    // 游戲成功或失敗
    IsGameSuccess bool = false

    event OnPlayerJoin(player entity<Player>) {
        currPlayer = player
    }

    //开始下一波事件
    func StartNextWave() {
        CurrentWave = CurrentWave + 1
        StartWave(CurrentWave)
        // 显示波次和时间信息
        GetLocalPlayer()<PlayerJionGame>.TimeInGameUI<CustomUI>.IsVisible = true
        GetLocalPlayer()<PlayerJionGame>.RighTabIFMUI<CustomUI>.IsVisible = true
        // 隐藏金钱UI
        var MoneyEntity = GetWidgetByPath(GetLocalPlayer(), GetLocalPlayer()<PlayerJionGame>.RighTabIFMUI, "/Money")
        MoneyEntity<UIWidget>.IsVisible = false
        // 更新金钱UI
        var MoneyNumEntity = GetWidgetByPath(GetLocalPlayer(), GetLocalPlayer()<PlayerJionGame>.RighTabIFMUI, "/Panel/Money/logo/Num")
        MoneyNumEntity<UIWidgetLabel>.Content = GetLocalPlayer()<PlayerJionGame>.Money
        // 更新总击杀数UI
        var KillCountEntity = GetWidgetByPath(GetLocalPlayer(), GetLocalPlayer()<PlayerJionGame>.RighTabIFMUI, "/Panel/Killed/logo/Num")
        KillCountEntity<UIWidgetLabel>.Content = 0
        GetLocalPlayer()<PlayerJionGame>.KillCount = 0
        GetLocalPlayer()<PlayerJionGame>.KillCountTAG = 0
        GetLocalPlayer()<PlayerJionGame>.KillCountSound = 0
    }

    // 开始PVE游戏（指定关卡）
    func PVELevelStartInitialization(level int) {
        if IsGameActive {
            LogWarning("游戏已在进行中")
            return
        }
        
        // 验证关卡范围
        if level < 1 || level > MaxLevels {
            LogWarning("无效的关卡: " + level + "，有效范围: 1-" + MaxLevels)
            return
        }
        
        // LogInfo("开始PVE游戏 - 关卡: " + level)
        IsGameActive = true
        GameStartTime = globalEntity<Global>.GameTimeCount
        CurrentLevel = level
        CurrentWave = 0

        // 重置玩家buff
        start GetLocalPlayer()<PlayerJionGame>.StopAllBuffsAndReset()
        // 删除所有掉落道具
        GetLocalPlayer()<PlayerJionGame>.RemoveAllDrops()

        // 通知怪物管理器开始关卡
        monsterManager.LevelInitialize(level)
    }
    
    // 开始指定波次
    func StartWave(wave int) {
        CurrentWave = wave
        WaveStartTime = globalEntity<Global>.GameTimeCount
        IsCountdownActive = true
        
        // LogInfo("开始关卡 " + CurrentLevel + " 波次 " + wave + "，时间限制: " + WaveTimeLimit/1000 + "秒")
        
        // 通知怪物管理器开始波次
        monsterManager.StartWave(wave)

        // 检查当前波次是否有Boss
        var isBossWave = monsterManager.HasBossInWave(wave)
        
        if isBossWave {
            IsCountdownActive = false  // Boss波次不进行倒计时
        }
        
        // 更新UI显示
        UpdateTimeInGameUI(WaveTimeLimit/1000, isBossWave)

        // 如果是普通波次，开始倒计时
        if !isBossWave {
            start WaveCountdownTimer()
            SoundFunc.PlayCreatedSound("Battle_Normal")
        } else {
            // Boss波次：启动专门的存活检测
            start BossWaveSurvivalCheck()
            SoundFunc.PlayCreatedSound("Battle_Boss")
        }
    }


    // 波次倒计时器
    async func WaveCountdownTimer() {
        var waveTime int = globalEntity<Global>.GameTimeCount - WaveStartTime
        var hasShown5sWarning bool = false  // 标记是否已显示5秒警告
        
        while IsCountdownActive && waveTime < WaveTimeLimit {
            waveTime = globalEntity<Global>.GameTimeCount - WaveStartTime
            var remainTime int = (WaveTimeLimit - waveTime)/1000
            
            // 更新UI
            UpdateTimeInGameUI(remainTime, false)
            
            // 检查是否需要显示5秒倒计时提示
            if remainTime <= 5 && !hasShown5sWarning {
                start ShowCountdownWarning(remainTime)
                hasShown5sWarning = true
            }
            
            WaitForMillisecond(WaveCountdownInterval)
            
            var DeadOrAlive bool = CheckPlayersAlive() // 检查玩家存活状态
            if DeadOrAlive == false {
                start OnGameOver()
                return
            }
        }
        
        // 倒计时结束，检查玩家存活状态
        if IsCountdownActive && CurrentWave < 5 {  // 只有前4波有倒计时
            IsCountdownActive = false
            monsterManager.ForceEndWave()
            
            // 在进入三选一之前停止所有buff
            start GetLocalPlayer()<PlayerJionGame>.StopAllBuffsAndReset()
            // 删除所有掉落道具
            GetLocalPlayer()<PlayerJionGame>.RemoveAllDrops()

            //显示通关小横幅
            var WaveCompleteUI = GetLocalPlayer()<PlayerJionGame>.WaveCompleteUI
            WaveCompleteUI<CustomUI>.IsVisible = true
            var WaveText = GetWidgetByPath(GetLocalPlayer(), WaveCompleteUI, "/WaveShow/Text")
            if WaveText != nil {
                // 直接使用翻译文本
                var CurrentWaveTTT = LocString{"WAVE_CLEAR", List<string>{CurrentWave}}
                WaveText<UIWidgetLabel>.Content = CurrentWaveTTT
            }

            // 停止关卡音效
            SoundFunc.PauseTheSound("Battle_Normal")

            // 播放通关音效
            SoundFunc.PlayCreatedSound("Victory")

            WaitForMillisecond(2000)
            //隐藏通关小横幅
            WaveCompleteUI<CustomUI>.IsVisible = false
            //显示三选一
            GetLocalPlayer()<PlayerJionGame>.ToClient_DisplaySkillThreeChoiceOne()
        }
    }

    // 显示倒计时警告
    async func ShowCountdownWarning(remainTime int) {
        CreateBuiltInUIClient(out var createdEntity6, BuiltInUIType.FiveSecondCountDownHud)
        createdEntity6<UICountDown5>.IsVisible = true
        createdEntity6<UICountDown5>.LocalPosition = Vector3{0, -200, 0}
        WaitForMillisecond(5500)
        Destroy(createdEntity6)
    }

    // Boss波次存活检测
    async func BossWaveSurvivalCheck() {
        // LogInfo("开始玩家Boss波次存活检测")
        
        // 记录当前波次
        var currentBossWave = CurrentWave
        WaitForMillisecond(1000)
        
        while IsGameActive && CurrentWave == currentBossWave {
            // 检查玩家是否存活
            var DeadOrAlive bool = CheckPlayersAlive()
            if DeadOrAlive == false {
                // LogInfo("Boss波次中玩家死亡")
                start OnGameOver()
                return
            }
            
            // 检查是否有存活Boss
            var hasAliveBoss = list.Length(monsterManager.ActiveBossMonsters) > 0
           // LogInfo("存活Boss数量: " + list.Length(monsterManager.ActiveBossMonsters))
            if !hasAliveBoss {
                // LogInfo("Boss已被击败")
                OnBossDefeated()
                return
            }
            
            // 等待一段时间再检查
            WaitForMillisecond(WaveCountdownInterval)
        }
        
        // LogInfo("Boss波次存活检测结束")
    }



    // Boss被击败后的处理
    async func OnBossDefeated() {
        // LogInfo("Boss被击败，进入下一波")
        
        // 强制结束当前波次
        monsterManager.ForceEndWave()
        
        start GetLocalPlayer()<PlayerJionGame>.StopAllBuffsAndReset()
        // 删除所有掉落道具
        GetLocalPlayer()<PlayerJionGame>.RemoveAllDrops()

        //显示BOOYAH!横幅
        CreateBuiltInUIClient(out var resultBanner, BuiltInUIType.ResultBannerHud)
        resultBanner<UIWinOrLoseBanner>.Result = 1

        // 停止局内BOOS战背景音效
        SoundFunc.PauseTheSound("Battle_Boss")
        // 播放胜利音效
        SoundFunc.PlayCreatedSound("Victory")
        
        WaitForMillisecond(2000)
        start OnGameComplete()
        Destroy(resultBanner)
        // // 显示通关小横幅
        // var WaveCompleteUI = GetLocalPlayer()<PlayerJionGame>.WaveCompleteUI
        // WaveCompleteUI<CustomUI>.IsVisible = true
        // var WaveText = GetWidgetByPath(GetLocalPlayer(), WaveCompleteUI, "/WaveShow/Text")
        // if WaveText != nil {
        //     WaveText<UIWidgetLabel>.Content = "Boss击败！第" + CurrentWave + "波完成"
        // }

        // WaitForMillisecond(2000)
        // //隐藏通关小横幅
        // WaveCompleteUI<CustomUI>.IsVisible = false
        // //显示三选一
        // GetLocalPlayer()<PlayerJionGame>.ToClient_DisplaySkillThreeChoiceOne()
    }

      //DEbug的临时初始化
    func S_Debug_NextWave() {
        IsCountdownActive = false
    }
    
    // 更新UI
    func UpdateTimeInGameUI(remainTime int, isBossWave bool) {
        var TimeInGameUIEntity = GetLocalPlayer()<PlayerJionGame>.TimeInGameUI
        
        // 查找UI组件
        var TimeText = GetWidgetByPath(GetLocalPlayer(), TimeInGameUIEntity, "/Time/TimePanel/Logo/Text")
        var WaveText = GetWidgetByPath(GetLocalPlayer(), TimeInGameUIEntity, "/Time/TimePanel/Text")
        var LogoPanel = GetWidgetByPath(GetLocalPlayer(), TimeInGameUIEntity, "/Time/TimePanel/Logo")
        var BossPanel = GetWidgetByPath(GetLocalPlayer(), TimeInGameUIEntity, "/Time/TimePanel/Boss")
        
        // 根据是否是Boss波次显示不同的UI
        if isBossWave {
            // Boss波次：显示Boss面板，隐藏Logo面板
            if LogoPanel != nil {
                LogoPanel<UIWidget>.IsVisible = false
            }
            if BossPanel != nil {
                BossPanel<UIWidget>.IsVisible = true
            }
            if WaveText != nil {
                // 直接使用翻译文本
                var WaveTexttt = LocString{"Wave", List<string>{}}
                WaveText<UIWidgetLabel>.Content = WaveTexttt + ": " + CurrentWave + "/5"
            }
            if TimeText != nil {
                TimeText<UIWidgetLabel>.Content = "--:--"  // Boss战没有时间限制
            }
        } else {
            // 普通波次：显示Logo面板，隐藏Boss面板
            if LogoPanel != nil {
                LogoPanel<UIWidget>.IsVisible = true
            }
            if BossPanel != nil {
                BossPanel<UIWidget>.IsVisible = false
            }
            if WaveText != nil {
                // 直接使用翻译文本
                var WaveTexttt = LocString{"Wave", List<string>{}}
                WaveText<UIWidgetLabel>.Content = WaveTexttt + ": " + CurrentWave + "/5"
            }
            if TimeText != nil {
                TimeText<UIWidgetLabel>.Content = FormatTimeMMSS(remainTime)
            }
        }
    }

    // 通用的格式化时间函数
    func FormatTimeMMSS(totalSeconds int) string {
        var minutes int = Math.Floor(totalSeconds / 60)
        var seconds int = totalSeconds % 60
        
        var result string = ""
        if minutes < 10 {
            result = result + "0"
        }
        result = result + Convert.ToString(minutes) + ":"
        if seconds < 10 {
            result = result + "0"
        }
        result = result + Convert.ToString(seconds)
        
        return result
    }

    // 检查玩家存活状态
    func CheckPlayersAlive() bool {
        var allPlayers = GetAllPlayers()
        for i = 0, list.Length(allPlayers), 1 {
            var player = allPlayers[i]
            if player<Player>.HP > 0 {
                return true  // 至少有一个玩家存活
            }
        }
        return false  // 所有玩家都死亡
    }
    
    // 显示最终统计
    func ShowFinalStats() {        
        var currTime int = globalEntity<Global>.GameTimeCount as int
        var totalTime int = (currTime - GameStartTime) / 1000
        GetLocalPlayer()<PlayerJionGame>.ToClient_ShowFinalStats(currTime, GameStartTime, IsGameSuccess, totalTime, CurrentLevel)
        // 隐藏波次,时间信息,HP条
        GetLocalPlayer()<PlayerJionGame>.TimeInGameUI<CustomUI>.IsVisible = false
        GetLocalPlayer()<PlayerJionGame>.RighTabIFMUI<CustomUI>.IsVisible = false
        GetLocalPlayer()<PlayerJionGame>.BossHPBar<CustomUI>.IsVisible = false
        FC_MonsterManager.TotalGold = 0
    }
    
    // 获取游戏状态
    func GetGameStatus() string {
        var status = "=== PVE游戏状态 ==="
        var gameState = "未开始"
        if IsGameActive {
            gameState = "进行中"
        }
        status = status + " 游戏状态: " + gameState
        if CurrentLevel > 0 {
            status = status + " 当前关卡: " + CurrentLevel
            status = status + " 当前波次: " + CurrentWave
            if IsCountdownActive {
                status = status + " 剩余时间: " + (WaveTimeLimit - (globalEntity<Global>.GameTimeCount - WaveStartTime))/1000 + "秒"
            }
        } else {
            status = status + " 当前关卡: 未开始"
            status = status + " 当前波次: 未开始"
        }
        status = status + " 最大关卡数: " + MaxLevels
        status = status + " 波次时间限制: " + WaveTimeLimit + "秒"
        
        return status
    }
    
    // 游戏失败
    async func OnGameOver() {
        // LogInfo("PVE游戏失败！")
        IsGameSuccess = false
        EndPVEGame()
        // 停止所有buff并恢复伤害
        start GetLocalPlayer()<PlayerJionGame>.StopAllBuffsAndReset()
        // 删除所有掉落道具
        GetLocalPlayer()<PlayerJionGame>.RemoveAllDrops()
        //显示战败横幅
        CreateBuiltInUIClient(out var resultBanner, BuiltInUIType.ResultBannerHud)
        resultBanner<UIWinOrLoseBanner>.Result = 2

        // 停止关卡音效
        SoundFunc.PauseTheSound("Battle_Normal")
        // 停止BOSS音效
        SoundFunc.PauseTheSound("Battle_Boss")
        // 播放失败音效
        SoundFunc.PlayCreatedSound("Failuer")

        WaitForMillisecond(2000)

        //隐藏战败横幅
        Destroy(resultBanner)
        // 显示最终统计
        ShowFinalStats()
    }
    
    // 游戏完成
    async func OnGameComplete() {
        // LogInfo("PVE游戏完成！")
        EndPVEGame()

        IsGameSuccess = true
        // 停止所有buff并恢复伤害
        start GetLocalPlayer()<PlayerJionGame>.StopAllBuffsAndReset()
        // 删除所有掉落道具
        GetLocalPlayer()<PlayerJionGame>.RemoveAllDrops()

        var localPlayer entity<Player> = GetAllPlayers()[0]
        localPlayer<Player>.Invincible = true
        
        // 奖励金币
        GetLocalPlayer()<PlayerJionGame>.GivePlayerWinnerMoney(CurrentLevel)

        // 等待一段时间后显示最终统计
        WaitForMillisecond(1000)

        // 显示最终统计
        ShowFinalStats()
    }

    // 结束PVE游戏
    func EndPVEGame() {
        // LogInfo("结束PVE游戏")
        IsGameActive = false
        IsCountdownActive = false

        // 清理所有怪物
        monsterManager.ClearAllMonsters()
        
        // 清理BOSS
        //bossHandler.ForceEndBossFight()
        
        var localPlayer entity<Player> = GetAllPlayers()[0]
        localPlayer<Player>.Invincible = false
    }
}
