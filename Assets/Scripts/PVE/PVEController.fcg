import "StdLibrary.fcc" as std
import "EditorGenLib.fcc" as gen
import "Player.fcc" as player
import "List.fcc" as list
import "./FC_PVEMonsterManager.fcg" as monsterManager
import "../Static/FC_Utilities.fcg" as Utilities
import "Convert.fcc" as Convert
import "Items.fcc" as Items
import "../CustomEvent.fcc" as CustomEvent
import "Math.fcc" as Math
import "../PlayerJionGame/PlayerJionGame.fcg" as PlayerJionGame
import "../MobScripts/C_BossButcher.fcg" as C_BossButcher
import "Hud.fcc" as Hud

[platform_client]
static graph PVEController {
    // 控制器状态
    IsGameActive bool = false
    CurrentLevel int = 1
    CurrentWave int = 0
    MaxLevels int = 10
    MaxWaves int = 4

    currPlayer entity<Player> = nil
    
    // 游戏配置
    WaveTimeLimit int = 30000  // 每波次时间限制（ms）
    
    // 统计信息
    GameStartTime int = 0
    
    // 波次倒计时
    WaveStartTime int = 0  // 波次开始时间/ms
    WaveCountdownInterval int = 1000  // 倒计时更新间隔（毫秒）
    IsCountdownActive bool = false

    // 游戲成功或失敗
    IsGameSuccess bool = false

    event OnPlayerJoin(player entity<Player>) {
        currPlayer = player
    }

    //开始下一波事件
    func StartNextWave() {
        CurrentWave = CurrentWave + 1
        StartWave(CurrentWave)
        // 显示波次和时间信息
        var TimeInGameUIEntity = GetLocalPlayer()<PlayerJionGame>.TimeInGameUI
        TimeInGameUIEntity<CustomUI>.IsVisible = true
    }

    // 开始PVE游戏（指定关卡）
    func PVELevelStartInitialization(level int) {
        if IsGameActive {
            LogWarning("游戏已在进行中")
            return
        }
        
        // 验证关卡范围
        if level < 1 || level > MaxLevels {
            LogWarning("无效的关卡: " + level + "，有效范围: 1-" + MaxLevels)
            return
        }
        
        LogInfo("开始PVE游戏 - 关卡: " + level)
        IsGameActive = true
        GameStartTime = globalEntity<Global>.GameTimeCount
        CurrentLevel = level
        CurrentWave = 0
        // 通知所有玩家
        Utilities.NotifyAllPlayers("PVE游戏开始！关卡: " + level, #00FF00FF, 5000)

        // 通知怪物管理器开始关卡
        monsterManager.LevelInitialize(level)
    }
    
    // 开始指定波次
    func StartWave(wave int) {
        CurrentWave = wave
        WaveStartTime = globalEntity<Global>.GameTimeCount
        IsCountdownActive = true
        
        LogInfo("开始关卡 " + CurrentLevel + " 波次 " + wave + "，时间限制: " + WaveTimeLimit/1000 + "秒")
        
        // 通知怪物管理器开始波次
        monsterManager.StartWave(wave)
        
        // 开始倒计时
        start WaveCountdownTimer()
    }

      //DEbug的临时初始化
    func S_Debug_NextWave() {
        IsCountdownActive = false
    }
    
    // 波次倒计时器
    async func WaveCountdownTimer() {
        var waveTime int = globalEntity<Global>.GameTimeCount - WaveStartTime
        while IsCountdownActive && waveTime < WaveTimeLimit {
            waveTime = globalEntity<Global>.GameTimeCount - WaveStartTime
            var remainTime int = (WaveTimeLimit - waveTime)/1000
            // 实时更新倒计时UI
            UpdateTimeInGameUI(remainTime)
            WaitForMillisecond(WaveCountdownInterval)
            var DeadOrAlive bool = CheckPlayersAlive() // 检查玩家存活状态
            if DeadOrAlive == false {
                start OnGameOver()
                return
            }
        }
        // 倒计时结束，检查玩家存活状态
        if IsCountdownActive && MaxWaves > CurrentWave {
            IsCountdownActive = false
            monsterManager.ForceEndWave()
            //显示三选一
            if CurrentWave < 5 {
                //显示通关小横幅
                var WaveCompleteUI = GetLocalPlayer()<PlayerJionGame>.WaveCompleteUI
                WaveCompleteUI<CustomUI>.IsVisible = true
                var WaveText = GetWidgetByPath(GetLocalPlayer(), WaveCompleteUI, "/WaveShow/Text")
                if WaveText != nil {
                    WaveText<UIWidgetLabel>.Content = "第" + CurrentWave + "波完成"
                }

                WaitForMillisecond(2000)
                //隐藏通关小横幅
                WaveCompleteUI<CustomUI>.IsVisible = false
                //显示三选一
                GetLocalPlayer()<PlayerJionGame>.ToClient_DisplaySkillThreeChoiceOne()

            } else if CurrentWave == 5 {
                //显示BOOYAH!横幅
                CreateBuiltInUIClient(out var resultBanner, BuiltInUIType.ResultBannerHud)
                resultBanner<UIWinOrLoseBanner>.Result = 1
            }
        }else{
            monsterManager.ForceEndWave()
            OnGameComplete()
        }
    }
    
    // 更新游戏时间UI
    func UpdateTimeInGameUI(remainTime int) {
        var TimeInGameUIEntity = GetLocalPlayer()<PlayerJionGame>.TimeInGameUI
        var TimeText = GetWidgetByPath(GetLocalPlayer(), TimeInGameUIEntity, "/Time/TimePanel/Logo/Text")
        if TimeText != nil {
            TimeText<UIWidgetLabel>.Content = FormatTimeMMSS(remainTime)
        }
        var WaveText = GetWidgetByPath(GetLocalPlayer(), TimeInGameUIEntity, "/Time/TimePanel/Text")
        if WaveText != nil {
            WaveText<UIWidgetLabel>.Content = "波数：" + (CurrentWave) + "/6"
        }
    }

    // 通用的格式化时间函数
    func FormatTimeMMSS(totalSeconds int) string {
        var minutes int = Math.Floor(totalSeconds / 60)
        var seconds int = totalSeconds % 60
        
        var result string = ""
        if minutes < 10 {
            result = result + "0"
        }
        result = result + Convert.ToString(minutes) + ":"
        if seconds < 10 {
            result = result + "0"
        }
        result = result + Convert.ToString(seconds)
        
        return result
    }

    // 检查玩家存活状态
    func CheckPlayersAlive() bool {
        var allPlayers = GetAllPlayers()
        for i = 0, list.Length(allPlayers), 1 {
            var player = allPlayers[i]
            if player<Player>.HP > 0 {
                return true  // 至少有一个玩家存活
            }
        }
        return false  // 所有玩家都死亡
    }
    
    // 显示最终统计
    func ShowFinalStats() {        
        var currTime int = globalEntity<Global>.GameTimeCount as int
        var totalTime int = (currTime - GameStartTime) / 1000
        GetLocalPlayer()<PlayerJionGame>.ToClient_ShowFinalStats(currTime, GameStartTime, IsGameSuccess, totalTime, CurrentLevel)
        // 隐藏波次和时间信息
        var TimeInGameUIEntity = GetLocalPlayer()<PlayerJionGame>.TimeInGameUI
        TimeInGameUIEntity<CustomUI>.IsVisible = false
    }
    
    // 获取游戏状态
    func GetGameStatus() string {
        var status = "=== PVE游戏状态 ==="
        var gameState = "未开始"
        if IsGameActive {
            gameState = "进行中"
        }
        status = status + " 游戏状态: " + gameState
        if CurrentLevel > 0 {
            status = status + " 当前关卡: " + CurrentLevel
            status = status + " 当前波次: " + CurrentWave
            if IsCountdownActive {
                status = status + " 剩余时间: " + (WaveTimeLimit - (globalEntity<Global>.GameTimeCount - WaveStartTime))/1000 + "秒"
            }
        } else {
            status = status + " 当前关卡: 未开始"
            status = status + " 当前波次: 未开始"
        }
        status = status + " 最大关卡数: " + MaxLevels
        status = status + " 波次时间限制: " + WaveTimeLimit + "秒"
        
        return status
    }
    
    // 游戏失败
    async func OnGameOver() {
        LogInfo("PVE游戏失败！")
        IsGameSuccess = false
        EndPVEGame()

        //显示战败横幅
        CreateBuiltInUIClient(out var resultBanner, BuiltInUIType.ResultBannerHud)
        resultBanner<UIWinOrLoseBanner>.Result = 2

        WaitForMillisecond(2000)

        //隐藏战败横幅
        Destroy(resultBanner)
        // 显示最终统计
        ShowFinalStats()
    }
    
    // 游戏完成
    async func OnGameComplete() {
        LogInfo("PVE游戏完成！")
        IsGameSuccess = true
        //GetAllPlayers()[0]<Player>
        var localPlayer entity<Player> = GetAllPlayers()[0]
        localPlayer<Player>.Invincible = true
        // 显示最终统计
        ShowFinalStats()

        // 等待一段时间后结束游戏
        WaitForMillisecond(1000)
        EndPVEGame()
    }

     // 结束PVE游戏
     func EndPVEGame() {
        LogInfo("结束PVE游戏")
        IsGameActive = false
        IsCountdownActive = false

        // 清理所有怪物
        monsterManager.ClearAllMonsters()
        
        // 清理BOSS
        //bossHandler.ForceEndBossFight()
        
        var localPlayer entity<Player> = GetAllPlayers()[0]
        localPlayer<Player>.Invincible = false

        GetLocalPlayer()<PlayerJionGame>.ToClient_GameComplete()
    }
}
