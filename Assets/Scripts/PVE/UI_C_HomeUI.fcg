import "StdLibrary.fcc" as StdLib
import "EditorGenLib.fcc" as EditorLib
import "Hud.fcc" as Hud
import "Convert.fcc" as Convert
import "Math.fcc" as Math
import "../CustomEvent.fcc" as CustomEvent
import "../PlayerJionGame/PlayerJionGame.fcg" as PlayerJionGame
import "../SkillUI/SkillUI.fcg" as SkillUI
import "../SoundFunc/SoundFunc.fcg" as SoundFunc
import "../PVE/PVEController.fcg" as PVEController


[platform_client]
graph UI_HomeUI {

    buttonLeft entity<UIWidgetButton> = nil
    buttonRight entity<UIWidgetButton> = nil
    levelNum entity<UIWidgetLabel> = nil

    skill1 entity<UIWidgetButton> = nil
    skill2 entity<UIWidgetButton> = nil
    skill3 entity<UIWidgetButton> = nil

    ability1Text entity<UIWidgetLabel> = nil
    ability2Text entity<UIWidgetLabel> = nil
    ability3Text entity<UIWidgetLabel> = nil

    level int = 1
    ability1Level int = 0
    ability2Level int = 0
    ability3Level int = 0
    
    event OnAwake() {
        levelNum = GetWidgetFromCustomUI(GetLocalPlayer(),thisEntity as entity<CustomUI> , EResUIChoiceHero.LevelNum) as entity<UIWidgetLabel>
        skill1 = GetWidgetFromCustomUI(GetLocalPlayer(),thisEntity as entity<CustomUI> , EResUIChoiceHero.Hero_1) as entity<UIWidgetButton>
        skill2 = GetWidgetFromCustomUI(GetLocalPlayer(),thisEntity as entity<CustomUI> , EResUIChoiceHero.Hero_2) as entity<UIWidgetButton>
        skill3 = GetWidgetFromCustomUI(GetLocalPlayer(),thisEntity as entity<CustomUI> , EResUIChoiceHero.Hero_3) as entity<UIWidgetButton>
    }

    // 检测当前是否是最高的解锁关卡
    func IsMaxUnlockedLevel() bool {
        var MaxLevel int = GetLocalPlayer()<PlayerJionGame>.MaxLevel
        if level >= MaxLevel {
            return true
        } else {
            return false
        }
    }

    // 更新右按钮状态
    func UpdateRightButtonState() {
        if IsMaxUnlockedLevel() {
            // 到达最高解锁关卡，置灰右按钮
            buttonRight<UIWidgetButton>.Color = #808080  // 灰色
        } else {
            // 未到达最高解锁关卡，恢复按钮状态
            buttonRight<UIWidgetButton>.Color = #FFBA00  // 橙色
        }
    }

    // 更新左按钮状态
    func UpdateLeftButtonState() {
        if level <= 1 {
            // 到达第一关，置灰左按钮
            buttonLeft<UIWidgetButton>.Color = #808080  // 灰色
        } else {
            // 不是第一关，恢复按钮状态
            buttonLeft<UIWidgetButton>.Color = #FFBA00  // 橙色
        }
    }

    // 更新关卡显示和按钮状态
    func UpdateLevelDisplay() {
        // 直接使用翻译文本
        var levelNumTTT = LocString{"LEVEL_FORMAT", List<string>{level}}
        // 更新关卡文本
        levelNum<UIWidgetLabel>.Content = levelNumTTT
        // 保存到PlayerJionGame
        GetLocalPlayer()<PlayerJionGame>.level = level
        // 更新按钮状态
        UpdateLeftButtonState()
        UpdateRightButtonState()
    }

    func onLeftButtonClick(button entity<UIWidgetButton>, triggerPlayer entity<Player>) {
        SoundFunc.PlayCreatedSound("Click_Common_Default")

        buttonLeft = button
        level = level - 1
        
        if level < 1 {
            level = 1
        }
        
        UpdateLevelDisplay()
    }

    func onRightButtonClick(button entity<UIWidgetButton>, triggerPlayer entity<Player>) {
        SoundFunc.PlayCreatedSound("Click_Common_Default")

        var buttonLeftEntity = GetWidgetByPath(GetLocalPlayer(), GetLocalPlayer()<PlayerJionGame>.ChoiceHeroUI, "/ChoiceLevel/Button_left")
        buttonLeft = buttonLeftEntity as entity<UIWidgetButton>
        buttonRight = button
        var MaxLevel int = GetLocalPlayer()<PlayerJionGame>.MaxLevel
        level = level + 1
        
        // 不能超过已解锁的关卡
        if level > MaxLevel {
            level = MaxLevel
        }
        
        // 也不能超过最大关卡数10
        if level > 10 {
            level = 10
        }
        
        UpdateLevelDisplay()
    }

    func OnSkill1Click(button entity<UIWidgetButton>, triggerPlayer entity<Player>) {
        SoundFunc.PlayCreatedSound("Click_Common_Default")

        GetLocalPlayer()<PlayerJionGame>.CurrentSkill = 1
        var HeroButtonEntity1 = GetWidgetByPath(GetLocalPlayer(), GetLocalPlayer()<PlayerJionGame>.ChoiceHeroUI, "/ChoiceHero/Hero_1/BBIMAGE")
        var HeroButtonEntity2 = GetWidgetByPath(GetLocalPlayer(), GetLocalPlayer()<PlayerJionGame>.ChoiceHeroUI, "/ChoiceHero/Hero_2/BBIMAGE")
        var HeroButtonEntity3 = GetWidgetByPath(GetLocalPlayer(), GetLocalPlayer()<PlayerJionGame>.ChoiceHeroUI, "/ChoiceHero/Hero_3/BBIMAGE")
        HeroButtonEntity1<UIWidget>.IsVisible = true
        HeroButtonEntity2<UIWidget>.IsVisible = false
        HeroButtonEntity3<UIWidget>.IsVisible = false
    }

    func OnSkill2Click(button entity<UIWidgetButton>, triggerPlayer entity<Player>) {
        SoundFunc.PlayCreatedSound("Click_Common_Default")

        GetLocalPlayer()<PlayerJionGame>.CurrentSkill = 2
        var HeroButtonEntity1 = GetWidgetByPath(GetLocalPlayer(), GetLocalPlayer()<PlayerJionGame>.ChoiceHeroUI, "/ChoiceHero/Hero_1/BBIMAGE")
        var HeroButtonEntity2 = GetWidgetByPath(GetLocalPlayer(), GetLocalPlayer()<PlayerJionGame>.ChoiceHeroUI, "/ChoiceHero/Hero_2/BBIMAGE")
        var HeroButtonEntity3 = GetWidgetByPath(GetLocalPlayer(), GetLocalPlayer()<PlayerJionGame>.ChoiceHeroUI, "/ChoiceHero/Hero_3/BBIMAGE")
        HeroButtonEntity1<UIWidget>.IsVisible = false
        HeroButtonEntity2<UIWidget>.IsVisible = true
        HeroButtonEntity3<UIWidget>.IsVisible = false
    }

    func OnSkill3Click(button entity<UIWidgetButton>, triggerPlayer entity<Player>) {
        SoundFunc.PlayCreatedSound("Click_Common_Default")

        GetLocalPlayer()<PlayerJionGame>.CurrentSkill = 0
        var HeroButtonEntity1 = GetWidgetByPath(GetLocalPlayer(), GetLocalPlayer()<PlayerJionGame>.ChoiceHeroUI, "/ChoiceHero/Hero_1/BBIMAGE")
        var HeroButtonEntity2 = GetWidgetByPath(GetLocalPlayer(), GetLocalPlayer()<PlayerJionGame>.ChoiceHeroUI, "/ChoiceHero/Hero_2/BBIMAGE")
        var HeroButtonEntity3 = GetWidgetByPath(GetLocalPlayer(), GetLocalPlayer()<PlayerJionGame>.ChoiceHeroUI, "/ChoiceHero/Hero_3/BBIMAGE")
        HeroButtonEntity1<UIWidget>.IsVisible = false
        HeroButtonEntity2<UIWidget>.IsVisible = false
        HeroButtonEntity3<UIWidget>.IsVisible = true
    }

    func OnStartButtonClick(button entity<UIWidgetButton>, triggerPlayer entity<Player>) {
        SoundFunc.PlayCreatedSound("Click_Common_Default")

        //临时处理，因为客户端服务端不互通
        if GetLocalPlayer()<PlayerJionGame>.CurrentSkill == 0 {
            return
        }
        var currentLevel = GetLocalPlayer()<PlayerJionGame>.level
        var skillMultiplier float = 1.0 * ability3Level + 1
        GetLocalPlayer()<PlayerJionGame>.SkillUI<SkillUI>.skillMultiplier = skillMultiplier
        thisEntity<CustomUI>.IsVisible = false

        start GetLocalPlayer()<PlayerJionGame>.displaySkillByIndex(GetLocalPlayer()<PlayerJionGame>.CurrentSkill)
        start GetLocalPlayer()<PlayerJionGame>.ShowChoiceThreeCardUI(currentLevel)
        
        // 发送角色选择完毕事件
        var CurrentSkill = GetLocalPlayer()<PlayerJionGame>.CurrentSkill
        start GetLocalPlayer()<PlayerJionGame>.ChoiceHeroOver(currentLevel, CurrentSkill)

        // 初始化已选卡牌的列表颜色
        var ChoiceThreeCardUIEntity = GetLocalPlayer()<PlayerJionGame>.ChoiceThreeCardUI
        for i = 1, 6, 1 {
            // 按钮路径
            var buttonPath = "/NowChoicePanel/List/Card (" + Convert.ToString(i) + ")"
            // 获取图标控件
            var buttonWidget = GetWidgetByPath(GetLocalPlayer(), ChoiceThreeCardUIEntity, buttonPath)
            if buttonWidget != nil {
                // 设置按钮的图标
                buttonWidget<UIWidgetButton>.Color = #FFFFFF
            }
        }
        PVEController.PVELevelStartInitialization(currentLevel)

        // 停止主界面音效
        SoundFunc.PauseTheSound("MainMenu")
        // 播放三选一界面音效
        SoundFunc.PlayCreatedSound("Menu_Pickup")

        var Skill1_Detail_Entity = GetWidgetByPath(GetLocalPlayer(), GetLocalPlayer()<PlayerJionGame>.ChoiceHeroUI, "/ChoiceHero/TextImage")
        Skill1_Detail_Entity<UIWidget>.IsVisible = false

        // 切换随机地图
        GetLocalPlayer()<PlayerJionGame>.ChangeRandomMap()
    }

    //前往天赋面板
    func ToGiftedPanel(button entity<UIWidgetButton>, triggerPlayer entity<Player>) {
        SoundFunc.PlayCreatedSound("Click_Common_Default")
        SoundFunc.PlayCreatedSound("Page_Default_Open")

        var GiftedUIEntity = GetLocalPlayer()<PlayerJionGame>.GiftedUI
        GiftedUIEntity<CustomUI>.IsVisible = true
        var ChoiceHeroUIEntity = GetLocalPlayer()<PlayerJionGame>.ChoiceHeroUI
        ChoiceHeroUIEntity<CustomUI>.IsVisible = false
        // 隐藏弹窗
        var PopupPanel = GetWidgetByPath(GetLocalPlayer(), GetLocalPlayer()<PlayerJionGame>.GiftedUI, "/PopupPanel")
        PopupPanel<UIWidget>.IsVisible = false
        //初始化天赋面板
        GetLocalPlayer()<PlayerJionGame>.InitAllGiftedCardUI()
    }

    //前往角色面板
    func ToHeroPanel(button entity<UIWidgetButton>, triggerPlayer entity<Player>) {
        SoundFunc.PlayCreatedSound("Click_Common_Default")
        SoundFunc.PlayCreatedSound("Page_Default_Open")

        var HeroUIEntity = GetLocalPlayer()<PlayerJionGame>.HeroUI
        HeroUIEntity<CustomUI>.IsVisible = true
        var ChoiceHeroUIEntity = GetLocalPlayer()<PlayerJionGame>.ChoiceHeroUI
        ChoiceHeroUIEntity<CustomUI>.IsVisible = false
        var hero int = 1
        GetLocalPlayer()<PlayerJionGame>.InitAllCardBookUI(hero)
        var HeroEntity1 = GetWidgetByPath(GetLocalPlayer(), GetLocalPlayer()<PlayerJionGame>.HeroUI, "/HeroIFMPanel/HeroIFMPanel_1")
        var HeroEntity2 = GetWidgetByPath(GetLocalPlayer(), GetLocalPlayer()<PlayerJionGame>.HeroUI, "/HeroIFMPanel/HeroIFMPanel_2")
        HeroEntity1<UIWidget>.IsVisible = true
        HeroEntity2<UIWidget>.IsVisible = false
    }

    //前往排行榜面板
    func ToRankingPanel(button entity<UIWidgetButton>, triggerPlayer entity<Player>) {
        SoundFunc.PlayCreatedSound("Click_Common_Default")
        SoundFunc.PlayCreatedSound("Page_Default_Open")

        var RankingListUIEntity = GetLocalPlayer()<PlayerJionGame>.RankingListUI
        RankingListUIEntity<CustomUI>.IsVisible = true
        // 默认显示通关数排行
        var LevelAmountIFMEntity = GetWidgetByPath(GetLocalPlayer(), GetLocalPlayer()<PlayerJionGame>.RankingListUI, "/RankPanel/TitleBoard/IFMPanel/IFMPanelBB/LevelAmountIFM")
        var DamageIFMEntity = GetWidgetByPath(GetLocalPlayer(), GetLocalPlayer()<PlayerJionGame>.RankingListUI, "/RankPanel/TitleBoard/IFMPanel/IFMPanelBB/DamageIFM")
        LevelAmountIFMEntity<UIWidget>.IsVisible = true
        DamageIFMEntity<UIWidget>.IsVisible = false
        var NumberOfPassesButtonEntity = GetWidgetByPath(GetLocalPlayer(), GetLocalPlayer()<PlayerJionGame>.RankingListUI, "/RankPanel/TitleBoard/LeftPanel/LeftPanelBB/LevelAmounts")
        var DamageButtonEntity = GetWidgetByPath(GetLocalPlayer(), GetLocalPlayer()<PlayerJionGame>.RankingListUI, "/RankPanel/TitleBoard/LeftPanel/LeftPanelBB/Damage")
        NumberOfPassesButtonEntity<UIWidgetButton>.Color = #FFFFFF
        DamageButtonEntity<UIWidgetButton>.Color = #000000
        // 判断是否有记录，如果没有则不显示（！！！！！！！！！！！！）
        var LevelAmountIFMPart3Entity = GetWidgetByPath(GetLocalPlayer(), GetLocalPlayer()<PlayerJionGame>.RankingListUI, "/RankPanel/TitleBoard/IFMPanel/IFMPanelBB/LevelAmountIFM/TitleIFM/Part3")
        LevelAmountIFMPart3Entity<UIWidget>.IsVisible = false
        // 初始化排行榜
        GetLocalPlayer()<PlayerJionGame>.ShowRankingListUI()
    }
}