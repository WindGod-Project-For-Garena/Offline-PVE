import "StdLibrary.fcc" as std
import "EditorGenLib.fcc" as gen
import "Player.fcc" as player
import "List.fcc" as list
import "Map.fcc" as Map
import "Strings.fcc" as strings
import "CSVData.fcc" as CSVData
import "Math.fcc" as math
import "../Static/FC_Utilities.fcg" as Utilities
import "../Static/FC_Config.fcg" as Config
import "Avatar.fcc" as Avatar
import "Playable.fcc" as Playable
import "Animation.fcc" as Animation
import "LevelObject.fcc" as LevelObject
import "Convert.fcc" as Convert
import "Hud.fcc" as Hud
import "../PlayerJionGame/PlayerJionGame.fcg" as PlayerJionGame
import "Camera.fcc" as Camera
import "Economy.fcc" as Economy
import "List.fcc" as List
import "../CustomEvent.fcc" as CustomEvent
import "../SoundFunc/SoundFunc.fcg" as SoundFunc
import "Items.fcc" as Items

[platform_client]
static graph FC_PVEMonsterManager {
    // 配置参数（已按 14只/20 即 70% 折算：场上最多 14 只，每批普通怪 2 只）
    MaxMonstersOnField int = 14   // 原 20，70%（14只）
    SpawnInterval int = 5000  // 毫秒
    EliteSpawnCD int = 10000  // Elite怪物生成CD(毫秒)
    // 怪物生成数量全局系数（1.0=原数量，0.7=14只，约下降30%）
    SpawnCountScale float = 0.7
    
    // 当前状态
    CurrentLevel int = 1
    CurrentWave int = 1
    CurrentWaveMonsterCount int = 0  // 当前波次怪物总数量（用于掉钱计算）
    WaveMonsterDroppedMoney int = 0  // 当前关卡小怪已掉钱累计，最多为通关奖励的50%，掉满不再掉
    IsWaveActive bool = false
    currSpawnerIndex int = 0 //当前生成器索引
    
    // 怪物追踪
    ActiveMonsters List<entity<LevelObject>> = List<entity<LevelObject>>{}
    ActiveNormalMonsters List<entity<LevelObject>> = List<entity<LevelObject>>{}
    ActiveEliteMonsters List<entity<LevelObject>> = List<entity<LevelObject>>{}
    ActiveBossMonsters List<entity<LevelObject>> = List<entity<LevelObject>>{} //Boss怪物列表

    BossSpawnedCount Map<int, int> = Map<int, int>{}  // MonsterID -> 已生成数量
    EliteCurrentCount Map<int, int> = Map<int, int>{}  // MonsterID -> 当前存在数量

    CloneMoneyList List<entity<UIWidget>> = List<entity<UIWidget>>{} //存放克隆的金币

    // 总计获得金币数量
    TotalGold int = 0
    // 记录Boss存活时间
    BossliveTime int = 0
    // 本波BOSS是否被玩家击杀（仅当在 OnMonsterKilled 中移除时置 true；失败时 ClearAllMonsters 不触发，不解锁下一关）
    BossKilledByPlayerThisWave bool = false
    
    // CSV缓存（仅缓存当前Level行、按需缓存怪物行）
    LevelRowInfos Map<int, Map<string, object>> = Map<int, Map<string, object>>{} //LevelID -> LevelInfo
    //WaveID -> MonsterInfo(MonsterID, MaxNum, Possibility, Name_key, BaseHP, BaseDamage, MoveSpeed, IsElite, IsBoss, PrefabID)
    WaveMonsterInfos List<Map<string, object>> = List<Map<string, object>>{} 
    
    // 当前波次信息 - 使用基础类型
    CurrentHPModifier float = 1.0
    CurrentDamageModifier float = 1.0
    // 无尽模式每波次倍率（由 PVEController 在 StartNextWave 时设置为 1.3^EndlessWaveCount）
    EndlessWaveScale float = 1.0
    
    // 普通怪物生成CD
    NormalSpawnCD int = 5000  // 毫秒
    NormalSpawnBatchSize int = 2  // 每次生成的普通怪物数量（原 3，下降 20%）
    NormalLastSpawnTime int = 0  // 普通怪物最后生成时间（全局CD）

    // 僵尸环境音是否正在播放（避免怪物>=3时每次生成都重复播放）
    ZombieVoicePlaying bool = false

    // 怪物父节点
    ActiveMonsterParentNode entity<Entity> = nil
    PendingRemoveMonsterParentNode entity<Entity> = nil

    //出生相关的对象池
    spawnEffectPool List<entity<Effect>> = List<entity<Effect>>{}
    spawnTweenPool List<entity<Tween>> = List<entity<Tween>>{}

    // 怪物对象池（定义见 MonsterInfo.csv）：
    // - key = 实体ID，即 MonsterInfo 的 Name_key，如 NormalZombie、NormalZombie_Blue、GrenadeZombie_Red
    // - value = 该实体类型对应的未在场怪物实体列表（三选一环节创建，波次内从池取/归还，波次结束清空）
    MonsterPool Map<string, List<entity<LevelObject>>> = Map<string, List<entity<LevelObject>>>{}
    MonsterPoolParentNode entity<Entity> = nil  // 池中怪物挂载节点（与 PendingRemoveMobs 共用，池中怪物在此节点下且 IsActive=false）

    event OnAwake() {
        ActiveMonsterParentNode = EResSceneIsleLand.ActiveMobs as entity<Entity>
        PendingRemoveMonsterParentNode = EResSceneIsleLand.PendingRemoveMobs as entity<Entity>
        MonsterPoolParentNode = PendingRemoveMonsterParentNode
    }

    // 将原始生成数量按 SpawnCountScale 缩放（minCount 用于 Boss 等至少保留的数量）
    func ScaleSpawnCount(rawCount int, minCount int) int {
        var f float = Convert.IntToFloat(rawCount) * SpawnCountScale
        var scaled int = math.Floor(f)
        if scaled < minCount {
            return minCount
        }
        return scaled
    }

    // 三选一卡牌环节调用：清空旧池并预创建下一波所需怪物（Active 关掉），用的时候从池取并设 Active=true
    func InitializeMonsterPool() {
        ClearMonsterPool()
        var nextWave int = CurrentWave + 1
        if nextWave > 5 {
            nextWave = 1
        }
        PreWarmMonsterPool(nextWave)
    }

    // 预创建下一波怪物并放入池（CreateFromPrefab 后 IsActive=false，挂到池节点下）
    func PreWarmMonsterPool(nextWave int) {
        if nextWave == 5 {
            var sceneBossID int = GetSceneBossMonsterID()
            var monsterRow List<object> = CSVData.ReadCSVRow(EResCSV.MonsterInfo, GetMonsterInfoRowID(sceneBossID)+2)
            var name_key string = monsterRow[1] as string
            var prefabID = Config.MobPrefabIDs[name_key]
            CreateFromPrefab(out var bossEntity, prefabID)
            var monster = bossEntity as entity<LevelObject>
            if monster != nil && HasComponent(monster, typeof(Mob)) {
                monster<Mob>.MobName = name_key
                monster<Mob>.IsActive = false
                monster<Transform>.Position = Vector3{0, -1000, 0}
                SetParentClient(MonsterPoolParentNode<Transform>, monster<Transform>, true)
                if !Map.ContainKey(MonsterPool, name_key) {
                    MonsterPool[name_key] = list.New(0, 0)
                }
                list.Append(MonsterPool[name_key], monster)
            }
            return
        }
        var waveRowInfo Map<string, object> = LevelRowInfos[nextWave]
        if waveRowInfo == nil {
            LoadCurrentLevelRows(CurrentLevel)
            waveRowInfo = LevelRowInfos[nextWave]
        }
        if waveRowInfo == nil {
            return
        }
        var monsterCupIds List<int> = waveRowInfo["MonsterCupIds"] as List<int>
        if monsterCupIds == nil || list.Length(monsterCupIds) == 0 {
            return
        }
        var nameKeyToCount Map<string, int> = Map<string, int>{}
        for cupIdx = 0, list.Length(monsterCupIds), 1 {
            var cupId int = monsterCupIds[cupIdx]
            var cupRow List<object> = CSVData.ReadCSVRow(EResCSV.MonsterCup, cupId + 2)
            var monsterIdsStr string = cupRow[1] as string
            var amountStr string = cupRow[2] as string
            var monsterIdList List<int> = Utilities.SplitStringToInt(monsterIdsStr)
            var amountList List<int> = Utilities.SplitStringToInt(amountStr)
            for i = 0, list.Length(monsterIdList), 1 {
                var monsterID int = monsterIdList[i]
                var amount int = ScaleSpawnCount(amountList[i], 0)
                var monsterRow List<object> = CSVData.ReadCSVRow(EResCSV.MonsterInfo, GetMonsterInfoRowID(monsterID)+2)
                var name_key string = monsterRow[1] as string
                var existing int = 0
                if Map.ContainKey(nameKeyToCount, name_key) {
                    existing = nameKeyToCount[name_key]
                }
                if amount > existing {
                    nameKeyToCount[name_key] = amount
                }
            }
        }
        var keys = Map.GetAllKeys(nameKeyToCount)
        for ki = 0, list.Length(keys), 1 {
            var name_key string = keys[ki]
            var count int = nameKeyToCount[name_key]
            var prefabID = Config.MobPrefabIDs[name_key]
            if !Map.ContainKey(MonsterPool, name_key) {
                MonsterPool[name_key] = list.New(0, 0)
            }
            for c = 0, count, 1 {
                CreateFromPrefab(out var newEntity, prefabID)
                var monster = newEntity as entity<LevelObject>
                if monster != nil && HasComponent(monster, typeof(Mob)) {
                    monster<Mob>.MobName = name_key
                    monster<Mob>.IsActive = false
                    monster<Transform>.Position = Vector3{0, -1000, 0}
                    SetParentClient(MonsterPoolParentNode<Transform>, monster<Transform>, true)
                    list.Append(MonsterPool[name_key], monster)
                }
            }
        }
    }

    // 从对象池取出一只怪物（key = 实体ID，即 MonsterInfo.Name_key），池中无则返回 nil
    func GetMonsterFromPool(name_key string) entity<LevelObject> {
        if !Map.ContainKey(MonsterPool, name_key) {
            return nil
        }
        var poolList = MonsterPool[name_key]
        if list.Length(poolList) <= 0 {
            return nil
        }
        var monster = poolList[0]
        list.Remove(poolList, monster)
        return monster
    }

    // 判断是否为 Boss（Boss 死亡后先播完动画再放回对象池）
    func IsBossMonster(monster entity<LevelObject>) bool {
        if monster == nil || !HasComponent(monster, typeof(Mob)) {
            return false
        }
        var name_key string = monster<Mob>.MobName
        return name_key == "BossButcher" || name_key == "BossFlower"
    }

    // Boss 死亡动画播放后再放回对象池（延迟回收，避免直接消失不播动画）
    async func DelayedReturnBossToPool(monster entity<LevelObject>) {
        WaitForMillisecond(3500)
        if monster != nil {
            ReturnMonsterToPool(monster)
        }
    }

    // 将怪物回收到对象池（不 Destroy，移入池节点并设为未激活；按 MobName 即实体ID 归入对应 value 列表）
    func ReturnMonsterToPool(monster entity<LevelObject>) {
        if monster == nil || !HasComponent(monster, typeof(Mob)) {
            return
        }
        var name_key string = monster<Mob>.MobName  // 实体ID，与 MonsterInfo.Name_key 一致
        if name_key == "" {
            return
        }
        monster<Mob>.IsActive = false
        monster<Transform>.Position = Vector3{0, -1000, 0}
        SetParentClient(MonsterPoolParentNode<Transform>, monster<Transform>, true)
        if !Map.ContainKey(MonsterPool, name_key) {
            MonsterPool[name_key] = list.New(0, 0)
        }
        list.Append(MonsterPool[name_key], monster)
    }

    // 清空对象池：先同步销毁池中所有怪物实体，再清空池数据（波次结束或 ClearAllMonsters 时调用）
    func ClearMonsterPool() {
        var keys = Map.GetAllKeys(MonsterPool)
        for i = 0, list.Length(keys), 1 {
            var name_key = keys[i]
            var poolList = MonsterPool[name_key]
            if poolList == nil { continue }
            for j = 0, list.Length(poolList), 1 {
                var monster = poolList[j]
                if monster != nil {
                    Destroy(monster)
                }
            }
        }
        Map.Clear(MonsterPool)
    }

    // 更新Boss血条的函数 - 实时获取怪物血量并更新UI
    async func UpdateBossHPBar() {
        var localPlayer = GetLocalPlayer()
        if localPlayer == nil { return }
        var BossHPBar = localPlayer<PlayerJionGame>.BossHPBar
        if BossHPBar == nil { return }
        // 无 Boss 时直接隐藏血条并返回，避免 ActiveBossMonsters[0] 越界
        if list.Length(ActiveBossMonsters) <= 0 {
            BossHPBar<CustomUI>.IsVisible = false
            return
        }
        var boss = ActiveBossMonsters[0]

        while boss != nil {
            // 获取Boss当前血量和最大血量
            var currentHP = boss<Mob>.HP
            var maxHP = boss<Mob>.MaxHP

            // 计算血量百分比 (0.0 - 1.0)
            var hpPercent float = 0.0
            if maxHP > 0 {
                hpPercent = IntToFloat(currentHP) / IntToFloat(maxHP)
                // 获取血条UI并更新
                BossHPBar<CustomUI>.IsVisible = true
            }
            if currentHP <= 0 {
                // 先隐藏再回满，避免隐藏前闪一下
                BossHPBar<CustomUI>.IsVisible = false
                var BossHPNow = GetWidgetByPath(GetLocalPlayer(), BossHPBar, "/Panel/HP")
                if BossHPNow != nil {
                    BossHPNow<UIWidgetImage>.FillAmount = 1.0
                }
                break
            }
            var BossHPNow = GetWidgetByPath(GetLocalPlayer(), BossHPBar, "/Panel/HP")
            BossHPNow<UIWidgetImage>.FillAmount = hpPercent
            WaitForNextFrame()
        }

        if boss == nil {
            // 先隐藏再回满，避免隐藏前闪一下
            BossHPBar<CustomUI>.IsVisible = false
            var BossHPNow = GetWidgetByPath(GetLocalPlayer(), BossHPBar, "/Panel/HP")
            if BossHPNow != nil {
                BossHPNow<UIWidgetImage>.FillAmount = 1.0
            }
        }
    }
    
    // 获取当前关卡通关奖励（PassMoney），用于怪物掉钱计算
    func GetPassMoneyForCurrentLevel() int {
        var passMoney int = 100
        if ContainKey(GetLocalPlayer()<PlayerJionGame>.LevelData, CurrentLevel) {
            var row = GetLocalPlayer()<PlayerJionGame>.LevelData[CurrentLevel]
            if ContainKey(row, "PassMoney") {
                passMoney = row["PassMoney"] as int
            }
        }
        return passMoney
    }

    // 检查当前波次配置中是否有Boss（波次 5 固定为 Boss 波）
    func HasBossInWave(wave int) bool {
        if wave == 5 {
            return true
        }
        for i = 0, list.Length(WaveMonsterInfos), 1 {
            var monsterInfo = WaveMonsterInfos[i]
            if monsterInfo["IsBoss"] as bool == true {
                return true
            }
        }
        return false
    }

    // 仅加载当前Level的LevelConfig行（参考 PlayerJionGame 的 CSV 读取方式：从第三行开始读）
    // LevelRowInfos: WaveNumber -> { MonsterCupIds, DamageModifier, HPModifier }
    func LoadCurrentLevelRows(level int) {
        Map.Clear(LevelRowInfos)
        for rowIndex = 3, 163, 1 {
            var rowInfo List<object> = CSVData.ReadCSVRow(EResCSV.LevelConfig, rowIndex)
            var levelID int = 0
            if GetType(rowInfo[0]) == typeof(string) {
                StringToInt(rowInfo[0] as string, out var r, out var e)
                levelID = r
            } else {
                levelID = rowInfo[0] as int
            }
            if levelID != level {
                continue
            }
            var waveNum int = 0
            if GetType(rowInfo[1]) == typeof(string) {
                StringToInt(rowInfo[1] as string, out var w, out var err)
                waveNum = w
            } else {
                waveNum = rowInfo[1] as int
            }
            var levelInfo Map<string, object> = Map<string, object>{}
            levelInfo["WaveNumber"] = waveNum
            levelInfo["MonsterCupIds"] = Utilities.SplitStringToInt(rowInfo[2] as string)
            levelInfo["DamageModifier"] = rowInfo[3]
            levelInfo["HPModifier"] = rowInfo[4]
            LevelRowInfos[waveNum] = levelInfo
        }
    }
    
    
    // 开始新的关卡, 关卡开启并不代表波次开始, 波次开始需要手动调用StartWave
    func LevelInitialize(level int) {
        CurrentLevel = level
        CurrentWave = 1
        WaveMonsterDroppedMoney = 0  // 新关卡重置小怪掉钱累计

        // 仅读取该Level的LevelConfig
        LoadCurrentLevelRows(level)

        // 清理所有怪物
        ClearAllMonsters()

        // 预填第一波对象池（否则第一波生成时池为空，会当场 CreateFromPrefab 导致卡顿）
        PreWarmMonsterPool(1)
    }
    
    // 开始新的波次：波次 1–4 用 LevelConfig（MonsterCup）；波次 5 固定为 Boss 波（按当前场景生成 Boss）
    func StartWave(wave int) {
        CurrentWave = wave
        // LogInfo("开始关卡 " + CurrentLevel + " 波次 " + wave)
        if wave == 5 {
            StartWaveBossOnly()
            return
        }
        var waveRowInfo Map<string, object> = LevelRowInfos[wave]
        if waveRowInfo == nil {
            LoadCurrentLevelRows(CurrentLevel)
            waveRowInfo = LevelRowInfos[wave]
        }
        if waveRowInfo == nil {
            LogWarning("波次 " + wave + " 无 LevelConfig 配置")
            return
        }
        var monsterCupIds List<int> = waveRowInfo["MonsterCupIds"] as List<int>
        if monsterCupIds == nil || list.Length(monsterCupIds) == 0 {
            LogWarning("波次 " + wave + " 无 MonsterCup 配置")
            return
        }
        // 随机选一个 MonsterCup ID
        var cupIndex int = math.RandomInt(0, list.Length(monsterCupIds))
        var cupId int = monsterCupIds[cupIndex]
        // 从 MonsterCup 表读取该 ID 行：MonsterIDs, Amount, Timeinterval
        var cupRow List<object> = CSVData.ReadCSVRow(EResCSV.MonsterCup, cupId + 2)
        var monsterIdsStr string = cupRow[1] as string
        var amountStr string = cupRow[2] as string
        var timeintervalStr string = cupRow[3] as string
        var monsterIdList List<int> = Utilities.SplitStringToInt(monsterIdsStr)
        var amountList List<int> = Utilities.SplitStringToInt(amountStr)
        var timeintervalList List<float> = Utilities.SplitStringToFloat(timeintervalStr)

        list.Clear(WaveMonsterInfos)
        for i = 0, list.Length(monsterIdList), 1 {
            var monsterInfo Map<string, object> = Map<string, object>{}
            monsterInfo["MonsterID"] = monsterIdList[i]
            monsterInfo["MaxNum"] = ScaleSpawnCount(amountList[i], 0)
            monsterInfo["SpawnIntervalSec"] = timeintervalList[i]

            var monsterRow List<object> = CSVData.ReadCSVRow(EResCSV.MonsterInfo, GetMonsterInfoRowID(monsterInfo["MonsterID"] as int)+2)
            monsterInfo["Name_key"] = monsterRow[1]
            monsterInfo["BaseHP"] = monsterRow[2]
            monsterInfo["BaseDamage"] = monsterRow[3]
            monsterInfo["MoveSpeed"] = monsterRow[4]
            monsterInfo["IsElite"] = monsterRow[5]
            monsterInfo["IsBoss"] = monsterRow[6]

            monsterInfo["Possibility"] = 1.0
            list.Append(WaveMonsterInfos, monsterInfo)
        }
        // 当前波次怪物总数量（用于掉钱：每关波次小怪掉钱 = 通关奖励/2/4/当前波次怪物数）
        CurrentWaveMonsterCount = 0
        for i = 0, list.Length(WaveMonsterInfos), 1 {
            CurrentWaveMonsterCount = CurrentWaveMonsterCount + WaveMonsterInfos[i]["MaxNum"] as int
        }

        CurrentDamageModifier = waveRowInfo["DamageModifier"] as float
        CurrentHPModifier = waveRowInfo["HPModifier"] as float
        // 关卡血量倍率（LevelStatus）与波次倍率（LevelConfig）相乘，而不是覆盖
        if ContainKey(GetLocalPlayer()<PlayerJionGame>.LevelData, CurrentLevel) {
            var levelRow = GetLocalPlayer()<PlayerJionGame>.LevelData[CurrentLevel]
            if ContainKey(levelRow, "HPMultiplying") {
                CurrentHPModifier = CurrentHPModifier * (levelRow["HPMultiplying"] as float)
            }
        }
        // 无尽模式：每波次伤害与血量再乘 1.3^EndlessWaveCount（由 PVEController 设置 EndlessWaveScale）
        if GetLocalPlayer()<PlayerJionGame>.EndlessToggle {
            CurrentHPModifier = CurrentHPModifier * EndlessWaveScale
        }

        var bossQueue List<Map<string, object>> = List<Map<string, object>>{}
        var eliteQueue List<Map<string, object>> = List<Map<string, object>>{}
        var normalQueue List<Map<string, object>> = List<Map<string, object>>{}
        for i = 0, list.Length(WaveMonsterInfos), 1 {
            var monsterInfo = WaveMonsterInfos[i]
            var isElite = monsterInfo["IsElite"] as bool
            var isBoss = monsterInfo["IsBoss"] as bool
            if isBoss {
                list.Append(bossQueue, monsterInfo)
            } else if isElite {
                list.Append(eliteQueue, monsterInfo)
            } else {
                list.Append(normalQueue, monsterInfo)
            }
        }

        IsWaveActive = true
        start SpawnWaveMonsters(bossQueue, eliteQueue, normalQueue)
    }

    // 波次 5 固定 Boss 波：只生成当前场景 Boss（森林=Boss9，雪地=Boss8，拆迁大楼=Boss7）
    func StartWaveBossOnly() {
        list.Clear(WaveMonsterInfos)
        var sceneBossID int = GetSceneBossMonsterID()
        var monsterRow List<object> = CSVData.ReadCSVRow(EResCSV.MonsterInfo, GetMonsterInfoRowID(sceneBossID)+2)
        var monsterInfo Map<string, object> = Map<string, object>{}
        monsterInfo["MonsterID"] = sceneBossID
        monsterInfo["MaxNum"] = 1
        monsterInfo["SpawnIntervalSec"] = 0.0
        monsterInfo["Name_key"] = monsterRow[1]
        monsterInfo["BaseHP"] = monsterRow[2]
        monsterInfo["BaseDamage"] = monsterRow[3]
        monsterInfo["MoveSpeed"] = monsterRow[4]
        monsterInfo["IsElite"] = monsterRow[5]
        monsterInfo["IsBoss"] = monsterRow[6]
        monsterInfo["Possibility"] = 1.0
        list.Append(WaveMonsterInfos, monsterInfo)
        CurrentWaveMonsterCount = 1  // Boss 波只有 1 只怪

        var wave4Row Map<string, object> = LevelRowInfos[4]
        if wave4Row != nil {
            CurrentDamageModifier = wave4Row["DamageModifier"] as float
        } else {
            CurrentDamageModifier = 1.0
        }
        // BOSS 波血量只按关卡倍率 LevelStatus.HPMultiplying，不乘波次倍率
        CurrentHPModifier = 1.0
        if ContainKey(GetLocalPlayer()<PlayerJionGame>.LevelData, CurrentLevel) {
            var levelRow = GetLocalPlayer()<PlayerJionGame>.LevelData[CurrentLevel]
            if ContainKey(levelRow, "HPMultiplying") {
                CurrentHPModifier = levelRow["HPMultiplying"] as float
            }
        }
        // 无尽模式：Boss 波同样应用每波次 1.3 倍率
        if GetLocalPlayer()<PlayerJionGame>.EndlessToggle {
            CurrentHPModifier = EndlessWaveScale
        }

        var bossQueue List<Map<string, object>> = List<Map<string, object>>{}
        var eliteQueue List<Map<string, object>> = List<Map<string, object>>{}
        var normalQueue List<Map<string, object>> = List<Map<string, object>>{}
        list.Append(bossQueue, monsterInfo)
        IsWaveActive = true
        start SpawnWaveMonsters(bossQueue, eliteQueue, normalQueue)
    }

    async func SpawnWaveMonsters(bossQueue List<Map<string, object>>, eliteQueue List<Map<string, object>>, normalQueue List<Map<string, object>>) {
        Map.Clear(BossSpawnedCount)
        Map.Clear(EliteCurrentCount)
        NormalLastSpawnTime = 0
        currSpawnerIndex = currSpawnerIndex + 1
        start SpawnBossLoop(bossQueue, currSpawnerIndex)
        start SpawnEliteLoop(eliteQueue, currSpawnerIndex)
        start SpawnNormalLoop(normalQueue, currSpawnerIndex)
    }

    async func SpawnBossLoop(bossQueue List<Map<string, object>>, spawnerIndex int) {
        while IsWaveActive && (spawnerIndex == currSpawnerIndex) {
            var allBossSpawned = true
            for i = 0, list.Length(bossQueue), 1 {
                if !IsWaveActive { break }
                var monsterInfo = bossQueue[i]
                var monsterID = monsterInfo["MonsterID"] as int
                var maxNum = monsterInfo["MaxNum"] as int
                if BossSpawnedCount[monsterID] != nil && BossSpawnedCount[monsterID] >= maxNum {
                    continue
                } else if BossSpawnedCount[monsterID] == nil {
                    BossSpawnedCount[monsterID] = 0
                }
                allBossSpawned = false
                while BossSpawnedCount[monsterID] < maxNum && IsWaveActive && (spawnerIndex == currSpawnerIndex) {
                    if GetActiveMonsterCount() >= MaxMonstersOnField {
                        WaitForMillisecond(500)
                        continue
                    }
                    if !IsWaveActive { break }
                    start CreateSingleMonster(monsterInfo)
                    BossSpawnedCount[monsterID] = BossSpawnedCount[monsterID] + 1
                }
            }
            if allBossSpawned { break }
            if !IsWaveActive { break }
            WaitForMillisecond(SpawnInterval)
        }
    }

    async func SpawnEliteLoop(eliteQueue List<Map<string, object>>, spawnerIndex int) {
        var EliteLastSpawnTime int = 0
        while IsWaveActive && (spawnerIndex == currSpawnerIndex) {
            if (globalEntity<Global>.GameTimeCount - EliteLastSpawnTime) < EliteSpawnCD {
                WaitForMillisecond(1000)
                continue
            }
            EliteLastSpawnTime = globalEntity<Global>.GameTimeCount
            for i = 0, list.Length(eliteQueue), 1 {
                if !IsWaveActive { break }
                var monsterInfo = eliteQueue[i]
                var monsterID = monsterInfo["MonsterID"] as int
                var maxNum = monsterInfo["MaxNum"] as int
                if Map.ContainKey(EliteCurrentCount, monsterID) == false {
                    EliteCurrentCount[monsterID] = 0
                }
                var currentCount = EliteCurrentCount[monsterID]
                if currentCount >= maxNum { continue }
                while GetActiveMonsterCount() >= MaxMonstersOnField && IsWaveActive {
                    WaitForMillisecond(500)
                }
                if !IsWaveActive || (spawnerIndex != currSpawnerIndex) { break }
                start CreateSingleMonster(monsterInfo)
                EliteCurrentCount[monsterID] = currentCount + 1
            }
            WaitForMillisecond(SpawnInterval)
        }
    }

    // 按 MonsterCup 单个 slot：延迟 Timeinterval 秒后生成 Amount(MaxNum) 只
    async func SpawnNormalSlotDelayed(monsterInfo Map<string, object>, spawnerIndex int) {
        var delaySec float = monsterInfo["SpawnIntervalSec"] as float
        var delayMs int = math.Floor(delaySec * 1000.0)
        if delayMs > 0 {
            WaitForMillisecond(delayMs)
        }
        if !IsWaveActive || spawnerIndex != currSpawnerIndex { return }
        var amount int = monsterInfo["MaxNum"] as int
        for j = 0, amount, 1 {
            if !IsWaveActive || spawnerIndex != currSpawnerIndex { break }
            while GetActiveMonsterCount() >= MaxMonstersOnField && IsWaveActive { WaitForMillisecond(500) }
            if GetActiveMonsterCount() >= MaxMonstersOnField { break }
            start CreateSingleMonster(monsterInfo)
        }
    }

    async func SpawnNormalLoop(normalQueue List<Map<string, object>>, spawnerIndex int) {
        while IsWaveActive && (spawnerIndex == currSpawnerIndex) {
            var now int = globalEntity<Global>.GameTimeCount
            var hasNormalAlive = HasNormalMonstersAlive()
            var canSpawn = false
            if !hasNormalAlive {
                canSpawn = true
            } else if (now - NormalLastSpawnTime) >= NormalSpawnCD {
                canSpawn = true
            }
            if canSpawn {
                if GetActiveMonsterCount() >= MaxMonstersOnField {
                    WaitForMillisecond(500)
                    continue
                }
                var selectedMonster = SelectMonsterByPossibility(normalQueue)
                if selectedMonster == nil {
                    WaitForMillisecond(500)
                    continue
                }
                var availableSlots = MaxMonstersOnField - GetActiveMonsterCount()
                var spawnCount = selectedMonster["MaxNum"] as int
                if spawnCount > availableSlots { spawnCount = availableSlots }
                for j = 0, spawnCount, 1 {
                    if !IsWaveActive || (spawnerIndex != currSpawnerIndex) { break }
                    if GetActiveMonsterCount() >= MaxMonstersOnField { break }
                    start CreateSingleMonster(selectedMonster)
                }
                NormalLastSpawnTime = now
            }
            WaitForMillisecond(SpawnInterval)
        }
    }

    func HasNormalMonstersAlive() bool {
        return list.Length(ActiveNormalMonsters) > 0
    }

    func SelectMonsterByPossibility(normalQueue List<Map<string, object>>) Map<string, object> {
        if list.Length(normalQueue) == 0 { return nil }
        var totalPossibility float = 0.0
        for i = 0, list.Length(normalQueue), 1 {
            totalPossibility = totalPossibility + (normalQueue[i]["Possibility"] as float)
        }
        if totalPossibility <= 0.0 {
            var randomIndex = math.RandomInt(0, list.Length(normalQueue))
            return normalQueue[randomIndex]
        }
        var randomValue = math.RandomFloat(0.0, 1.0) * totalPossibility
        var accumulated float = 0.0
        for i = 0, list.Length(normalQueue), 1 {
            var monsterInfo = normalQueue[i]
            accumulated = accumulated + (monsterInfo["Possibility"] as float)
            if randomValue < accumulated { return monsterInfo }
        }
        return normalQueue[list.Length(normalQueue) - 1]
    }

    // 第一关使用残废属性怪物(MonsterInfo ID 11-20)，第二关及以后使用正常属性(ID 1-10)
    func GetMonsterInfoRowID(monsterID int) int {
        if CurrentLevel == 1 && monsterID >= 1 && monsterID <= 10 {
            return monsterID + 10
        }
        return monsterID
    }

    // 根据当前场景返回本场景 Boss 的 MonsterInfo 表 ID：森林=Boss9(ID9)，雪地=Boss8(ID8)，拆迁大楼=Boss7(ID7)
    func GetSceneBossMonsterID() int {
        var mapName string = GetLocalPlayer()<PlayerJionGame>.CurrentRandomMap
        if mapName == "forest" {
            return 9
        } else if mapName == "snow" {
            return 8
        } else if mapName == "ruins" {
            return 7
        }
        return 9
    }

    // 创建单个怪物（Boss 会根据当前场景替换为对应 Boss：森林=Boss9，雪地=Boss8，拆迁大楼=Boss7）
    async func CreateSingleMonster(monsterInfo Map<string, object>) {
        if monsterInfo["IsBoss"] as bool {
            var sceneBossID int = GetSceneBossMonsterID()
            var sceneBossRow List<object> = CSVData.ReadCSVRow(EResCSV.MonsterInfo, GetMonsterInfoRowID(sceneBossID)+2)
            monsterInfo["MonsterID"] = sceneBossID
            monsterInfo["Name_key"] = sceneBossRow[1]
            monsterInfo["BaseHP"] = sceneBossRow[2]
            monsterInfo["BaseDamage"] = sceneBossRow[3]
            monsterInfo["MoveSpeed"] = sceneBossRow[4]
            monsterInfo["IsElite"] = sceneBossRow[5]
            monsterInfo["IsBoss"] = sceneBossRow[6]
        }
        //出生相关特效和Tween对象池取对象
        var spawnEffect entity<Effect> = nil
        var spawnTween entity<Tween> = nil
        if list.Length(spawnEffectPool) > 0 {
            spawnEffect = spawnEffectPool[0]
            list.Remove(spawnEffectPool, spawnEffect)
        }else{
            CreateEffectClient(out var effect,VFXType.PoisonGas,LoopType.Once,true)       
            spawnEffect = effect
            spawnEffect<Transform>.Scale = Vector3{1.5,1,1.5}
        }
        if list.Length(spawnTweenPool) > 0 {
            spawnTween = spawnTweenPool[0]
            list.Remove(spawnTweenPool, spawnTween)
        }else{
            var monster entity<LevelObject> = thisEntity as entity<LevelObject>
            CreateTween(monster,Transform.Position,Vector3{0,0,0},Vector3{0,0,0},TweenStyle.Once,CreateCurve({0.25, 0.1, 0.25, 1}),1000,out var tweenEntity,true)
            spawnTween = tweenEntity
        }


        // 创建怪物：优先从对象池取，池中无则新建
        var name_key = monsterInfo["Name_key"] as string
        var prefabID = Config.MobPrefabIDs[name_key]
        var monster entity<LevelObject> = GetMonsterFromPool(name_key)
        if monster == nil {
            CreateFromPrefab(out var newEntity, prefabID)
            monster = newEntity as entity<LevelObject>
        }

        //初始化到指定位置
        monster<Transform>.Position = Vector3{30, 0, 0}

        // 注册怪物
        if monster != nil {
            list.Append(ActiveMonsters, monster)
        }
        
        if monsterInfo["IsElite"] as bool {
            list.Append(ActiveEliteMonsters, monster)
        } else if monsterInfo["IsBoss"] as bool {
            list.Append(ActiveBossMonsters, monster)
            // Boss特殊处理：显示血条并标记为Boss
            var BossHPBar = GetLocalPlayer()<PlayerJionGame>.BossHPBar
            BossHPBar<CustomUI>.IsVisible = true
            BossHPBar<UIWidgetImage>.FillAmount = 1.0
            
        } else {
            list.Append(ActiveNormalMonsters, monster)
        }
        // 场上怪物数量达到3个及以上时，若当前没有僵尸音效在播则随机播放一条（避免重复播放造成性能问题）
        if list.Length(ActiveMonsters) >= 3 && !ZombieVoicePlaying {
            ZombieVoicePlaying = true
            SoundFunc.PlayCreatedSound("ZombieVoice_1")
            SoundFunc.PlayCreatedSound("ZombieVoice_2")
            SoundFunc.PlayCreatedSound("ZombieVoice_3")
        }
        SetParentClient(ActiveMonsterParentNode<Transform>, monster<Transform>, true) 

        //对应怪物外观组

        WaitForNextFrame()             
        ShowAppearanceGroup(monster as entity<Appearance>, name_key)

        // 设置怪物属性
        if HasComponent(monster, typeof(Mob)) {
            monster<Mob>.MobName = monsterInfo["Name_key"] as string
            var baseHP = monsterInfo["BaseHP"] as int
            var baseDmg = monsterInfo["BaseDamage"] as int
            var spd = monsterInfo["MoveSpeed"] as float
            
            // 修复类型转换：将float计算结果转换为int
            var calculatedMaxHP int = Floor(baseHP * CurrentHPModifier)
            var calculatedDamage int = Floor(baseDmg * CurrentDamageModifier)
            var calculatedSpeed float = spd
            monster<Mob>.MaxHP = calculatedMaxHP
            monster<Mob>.HP = monster<Mob>.MaxHP
            monster<Mob>.Damage = calculatedDamage
            monster<Mob>.WalkSpeed = calculatedSpeed
        }

        // 在属性设置后检查是否是精英怪
        if monsterInfo["IsElite"] as bool {
            WaitForNextFrame()
            // 调用精英怪专属函数
            start ProcessEliteMonster(monster)
        }

        // 在属性设置后检查是否是Boss怪
        if monsterInfo["IsBoss"] as bool {
            WaitForNextFrame()
            // 调用Boss怪专属函数
            start StartRecordBossLiveTime(monster)
        }

        if monster<Mob>.MobName == "ShieldZombie_Gold" {
            // LogInfo("ShieldZombie_Gold特殊处理")
            monster<Mob>.StatusDic["IsShield"] = true
            monster<Transform>.Scale = Vector3{2, 2, 2}
            monster<Mob>.StatusDic["ShieldHP"] = math.Ceil(0.5*monster<Mob>.MaxHP)
            monster<Mob>.StatusDic["ShieldMaxHP"] = math.Ceil(0.5*monster<Mob>.MaxHP)
            ShowAppearanceGroup(monster as entity<Appearance>, "Shield")
            
        }
        //设置怪物位置
        var spawnPosition = GetRandomSpawnPosition(monster as entity<Mob>)
        var offSetPosition Vector3 = Vector3{0,-1,0}

        spawnTween<Tween>.StartValue = spawnPosition + offSetPosition
        spawnTween<Tween>.EndValue = spawnPosition
        spawnTween<Tween>.Target = monster
        Play(spawnTween,true)
 
        spawnEffect<Transform>.Position = spawnPosition - Vector3{0,0.3,0}
        Pause(spawnEffect)
        Play(spawnEffect,true)

        WaitForMillisecond(1100)

        // 游戏已结束或怪物已被清理时不再激活，避免对已销毁实体操作导致 nil 报错
        if monster == nil || !IsWaveActive {
            if spawnEffect != nil { list.Append(spawnEffectPool, spawnEffect) }
            if spawnTween != nil { list.Append(spawnTweenPool, spawnTween) }
            return
        }
        //激活怪物
        //isLogInfo("------激活怪物: " + monster<Mob>.MobName)
        monster<Mob>.IsActive = true

        DispatchEventToEntity(OnMobActived, monster, PlatformType.Client, List<object>{})
        //对象池回收对象
        list.Append(spawnEffectPool, spawnEffect)
        list.Append(spawnTweenPool, spawnTween)

        // 仅 Boss 需要血条更新协程，避免每生成一只普通/精英怪都启动一次造成性能浪费
        if monsterInfo["IsBoss"] as bool {
            start UpdateBossHPBar()
        }
    }

    // 给精英怪头上带标记
    async func ProcessEliteMonster(monster entity<LevelObject>) {
        // LogInfo("给精英怪添加标记")
        var monsterPos = monster<Transform>.Position
        CreateFromPrefab(out var MarkEntity, EResPrefab.Mark)
        MarkEntity<Transform>.Position = monsterPos + Vector3{0, 2, 0}
        SetParentClient(monster, MarkEntity as entity<Transform>, true)
    }

    async func StartRecordBossLiveTime(monster entity<LevelObject>) {
        // LogInfo("开始记录Boss存活时间")
        BossliveTime = 0
        BossKilledByPlayerThisWave = false  // 仅当 OnMonsterKilled 中移除本波 BOSS 时才置 true，失败清场不解锁
        while monster != nil && monster<Mob>.HP > 0 {
            WaitForMillisecond(1000)
            BossliveTime = BossliveTime + 1000
        }
        if monster == nil || monster<Mob>.HP <= 0 {
            WaitForMillisecond(2000)
            
            // 只有本波 BOSS 被玩家击杀（OnMonsterKilled 中移除）才解锁；失败时 ClearAllMonsters 不会触发 OnMonsterKilled，不会误解锁
            if !BossKilledByPlayerThisWave {
                return
            }
            // 获取当前玩家数据
            var currentHighestLevel = GetLocalPlayer()<PlayerJionGame>.MaxLevel  // 已解锁的最高关卡
            
            // 只有当当前关卡等于最高解锁关卡时才解锁下一关
            if  CurrentLevel == currentHighestLevel {
                // 解锁下一关
                GetLocalPlayer()<PlayerJionGame>.MaxLevel = GetLocalPlayer()<PlayerJionGame>.MaxLevel + 1
                GetLocalPlayer()<PlayerJionGame>.SaveLevel()
                // LogInfo("击败最高关卡BOSS，解锁新关卡: " + GetLocalPlayer()<PlayerJionGame>.MaxLevel)
                
                // 更新主界面的关卡显示
                GetLocalPlayer()<PlayerJionGame>.UpdateHomeLevelDisplay()
            } else {
                // LogInfo("击败已通关关卡BOSS，不更新最高关卡。当前关卡:" + CurrentLevel + "，最高关卡:" + currentHighestLevel)
            }
        }
    }
        
    func GetRandomSpawnPosition(monster entity<Mob>) Vector3 {
        // 简单的随机生成位置，实际应该根据地图设计
        //LogInfo("monster<Mob>.MobName: " + monster<Mob>.MobName)
        if monster<Mob>.MobName == "GrenadeZombie" || monster<Mob>.MobName == "GrenadeZombie_Red" {
            // 森林区域
            if GetLocalPlayer()<PlayerJionGame>.CurrentRandomMap == "forest" {
                var x float = RandomFloat(-1, 8)
                var z float = RandomFloat(15, 11.5)
                return Vector3{x, 2.87, z}
            // 雪地区域
            } else if GetLocalPlayer()<PlayerJionGame>.CurrentRandomMap == "snow" {
                if RandomInt(0,1) == 0 {
                    var x float = RandomFloat(10, 11)
                    var z float = RandomFloat(0, 12)
                    return Vector3{x, 2.8, z}
                } else {
                    var x float = RandomFloat(-12, -11)
                    var z float = RandomFloat(-10, -2.5)
                    return Vector3{x, 3.3, z}
                }
            // 拆迁大楼区域
            } else if GetLocalPlayer()<PlayerJionGame>.CurrentRandomMap == "ruins" {
                var x float = RandomFloat(2.5, -3.5)
                var z float = RandomFloat(-13.5, -12)
                return Vector3{x, 1.76, z}
            }
        }else {
            // 森林区域
            if GetLocalPlayer()<PlayerJionGame>.CurrentRandomMap == "forest" {
                var x = RandomFloat(-8, 8)
                var z = RandomFloat(7, -7)
                return Vector3{x, -0.003616458, z}
            // 雪地区域
            } else if GetLocalPlayer()<PlayerJionGame>.CurrentRandomMap == "snow" {
                var x = RandomFloat(-7, 6.5)
                var z = RandomFloat(-8.5, 11)
                return Vector3{x, 0.1774065, z}
            // 拆迁大楼区域
            } else if GetLocalPlayer()<PlayerJionGame>.CurrentRandomMap == "ruins" {
                var x = RandomFloat(-10, 8)
                var z = RandomFloat(-10, 7)
                return Vector3{x, 0.01, z}
            }
        }
    }
    
    // 清理所有怪物（必需的基础方程）
    func ClearAllMonsters() {
        // LogInfo("清理所有怪物")
        
        // 停止生成
        IsWaveActive = false

        // 清空对象池（波次结束销毁池中怪物）
        ClearMonsterPool()

        // 销毁所有在场怪物
        for i = 0, list.Length(ActiveMonsters), 1 {
            var monster = ActiveMonsters[i]
            if monster != nil {
                start myDestroyMonster(monster)
            }
        }
        
        // 清理数据结构
        list.Clear(ActiveMonsters)
        list.Clear(ActiveEliteMonsters)
        list.Clear(ActiveNormalMonsters)
        list.Clear(ActiveBossMonsters)
        Map.Clear(BossSpawnedCount)
        Map.Clear(EliteCurrentCount)

        NormalLastSpawnTime = 0
        //map.Clear(EliteLastSpawnTime)
        
        // 怪物少于3个时停止播放僵尸音效
        SoundFunc.PauseTheSound("ZombieVoice_1")
        SoundFunc.PauseTheSound("ZombieVoice_2")
        SoundFunc.PauseTheSound("ZombieVoice_3")
        ZombieVoicePlaying = false
        
        // 重置状态
        GetLocalPlayer()<PlayerJionGame>.KillCount = 0
        
        // LogInfo("所有怪物已清理，状态已重置")
    }
    
    // 获取活跃怪物数量
    func GetActiveMonsterCount() int {
        var count = 0
        for i = 0, list.Length(ActiveMonsters), 1 {
            var monster = ActiveMonsters[i]
            if monster != nil {
                count = count + 1
            }
        }
        return count
    }
    
    // 强制结束当前波次（必需的基础方程）
    func ForceEndWave() {
        // LogInfo("强制结束当前波次")
        ClearAllMonsters()
    }
    
    func OnMonsterKilled(monster entity<LevelObject>) {
        if monster != nil && HasComponent(monster, typeof(Mob)) {
            //LogInfo("-------------------------OnMonsterKilled-------------------------")
            // 所有怪都不在此处移走，留在原位播死亡动画，等动画触发 DestroyDeath / OnMonsterKilledAnimationFinished 再回池
            list.Remove(ActiveMonsters, monster)
            list.Remove(ActiveNormalMonsters, monster)
            // 处理Elite死亡与CD记录
            if list.Contain(ActiveEliteMonsters, monster) {
                list.Remove(ActiveEliteMonsters,monster)
                // 减少对应MonsterID的Elite计数（EliteCurrentCount 可能无该 key，先判空再减）
                var mobName = monster<Mob>.MobName
                for i = 0, list.Length(WaveMonsterInfos), 1 {
                    var monsterInfo = WaveMonsterInfos[i]
                    if monsterInfo["Name_key"] as string == mobName {
                        var monsterID = monsterInfo["MonsterID"] as int
                        var currentCount int = 0
                        if Map.ContainKey(EliteCurrentCount, monsterID) {
                            currentCount = EliteCurrentCount[monsterID]
                        }
                        if currentCount > 0 {
                            EliteCurrentCount[monsterID] = currentCount - 1
                        }
                        break
                    }
                }
                //LogInfo("Elite怪物死亡，CD开始: " + EliteSpawnCD + "ms")
            }else if list.Contain(ActiveBossMonsters, monster) {
                list.Remove(ActiveBossMonsters, monster)
                BossKilledByPlayerThisWave = true  // 本波 BOSS 被玩家击杀，允许解锁下一关
            }
            // 怪物少于3个时停止播放僵尸音效
            if list.Length(ActiveMonsters) < 3 {
                SoundFunc.PauseTheSound("ZombieVoice_1")
                SoundFunc.PauseTheSound("ZombieVoice_2")
                SoundFunc.PauseTheSound("ZombieVoice_3")
                ZombieVoicePlaying = false
            }
        }
    }

    // 怪物死亡动画结束后：掉落处理，再回池（所有怪都等动画播完才消失）
    func OnMonsterKilledAnimationFinished(monster entity<LevelObject>) {
        if monster != nil {
             // 八分之一的概率掉落妙妙工具
            if RandomDropChance() {
                DropMiaomiaoTools(monster)
            }
            // 死亡掉落货币
            start DropMoney(monster)
            ReturnMonsterToPool(monster)
        }
    }

    func NoItemDropDeath(monster entity<LevelObject>) {
        if monster != nil {
            OnMonsterKilled(monster)
            // 死亡掉落货币
            start DropMoney(monster)
            // 所有怪都不在此处回池，等死亡动画播到指定位置触发 DestroyDeath 或 OnMonsterKilledAnimationFinished 再回池
        }
    }

    // 死亡动画播到指定位置时由动画事件触发，此时才回池
    func DestroyDeath(monster entity<LevelObject>) {
        if monster != nil {
            if list.Contain(ActiveMonsters, monster) {
                OnMonsterKilled(monster)
            }
            ReturnMonsterToPool(monster)
        }
    }

    // 随机掉落概率判断
    func RandomDropChance() bool {
        var randomNum = RandomInt(1, 11)
        // 如果随机到1（即1/10的概率），返回true
        return randomNum == 1
    }

    // 死亡掉落妙妙道具（动态设置图标版本）
    func DropMiaomiaoTools(monster entity<LevelObject>) {
        var MiaomiaoToolEntity entity<LevelObject> = nil
        var monsterPos = monster<Transform>.Position
        
        // 随机选择具体道具类型
        var itemType = RandomInt(0, 3) // 随机0,1,2（对应三种类型）
        var iconResource = EResSprite.WeaponDamage // 默认武器伤害图标
        var itemTypeName = ""
        var BuffColor = #000000
        
        // 设置图标类型
        if itemType == 0 {
            iconResource = EResSprite.WeaponDamage
            itemTypeName = "武器伤害"
            BuffColor = #FF4848FF

        } else if itemType == 1 {
            iconResource = EResSprite.SkillDamage
            itemTypeName = "技能伤害"
            BuffColor = #FFFF51FF

        } else {
            iconResource = EResSprite.HP
            itemTypeName = "生命值"
            BuffColor = #00FF55FF
        }
        
        // 创建基础道具
        CreateFromPrefab(out var largeItem, EResPrefab.ITEM)
        // 把道具添加到列表，方便删除
        List.Append(GetLocalPlayer()<PlayerJionGame>.DropItemList, largeItem)
        MiaomiaoToolEntity = largeItem as entity<LevelObject>
        // 设置地面圈圈颜色
        MiaomiaoToolEntity<Icon>.Color = BuffColor
        // 设置光效颜色（GetChildren 可能为空，先判长度再访问 [0]）
        var light = GetChildren(MiaomiaoToolEntity)
        if light != nil && list.Length(light) > 0 {
            light[0]<Icon>.Color = BuffColor
        }
        // LogInfo("掉落道具-" + itemTypeName)
        
        if MiaomiaoToolEntity != nil {
            // 设置初始位置
            MiaomiaoToolEntity<Transform>.Position = monsterPos + Vector3{0, 0.1, 0}
            
            // 设置道具的图标
            SetItemIcon(MiaomiaoToolEntity, iconResource)
            
            // 添加弹出动画
            start AddItemPopAnimation(MiaomiaoToolEntity, monsterPos)
        }
    }

    // 设置道具图标
    func SetItemIcon(item entity<LevelObject>, iconType EResSprite) {
        if item == nil { return }
        var buff = GetChildren(item)
        if buff == nil || list.Length(buff) <= 0 { return }
        var light = GetChildren(buff[0])
        if light == nil || list.Length(light) <= 0 { return }
        var icon = light[0] as entity<LevelObject>
        if icon != nil {
            icon<Icon>.Resource = iconType
        }
    }

    // 添加道具弹出动画
    async func AddItemPopAnimation(item entity<LevelObject>, spawnPos Vector3) {
        // 道具弹出高度
        var popHeight float = 1.0 // 默认高度
        var duration int = 400    // 动画时长
        // 初始位置
        var startPos = spawnPos + Vector3{0, 0.1, 0}
        // 计算随机偏移，让道具散落开来
        var randomOffsetX = RandomFloat(-0.5, 0.5)
        var randomOffsetZ = RandomFloat(-0.5, 0.5)
        // 弹出目标位置
        var popTargetPos = spawnPos + Vector3{randomOffsetX, popHeight, randomOffsetZ}
        // 创建弹出动画
        CreateTween(
            item,
            Transform.Position,
            startPos,
            popTargetPos,
            TweenStyle.Once,
            CreateCurve({0.25, 0.1, 0.75, 0.9}), // 弹跳曲线
            duration,
            out var popTween,
            true,
        )
        // 等待弹出动画完成
        WaitForMillisecond(duration + 50)
        Destroy(popTween)
        
        // 添加落地弹跳效果
        var finalPos = spawnPos + Vector3{randomOffsetX, 0.2, randomOffsetZ}
        CreateTween(
            item,
            Transform.Position,
            popTargetPos,
            finalPos,
            TweenStyle.Once,
            CreateCurve({0.25, 0.1, 0.25, 1}), // 缓入缓出
            200,
            out var landTween,
            true,
        )
        WaitForMillisecond(250)
        Destroy(landTween)
    }

    // 死亡掉落货币
    async func DropMoney(monster entity<LevelObject>) {
        if monster == nil { return }
        // 先计算掉钱数量：Boss = 通关奖励/2；小怪 = 通关奖励/2/4/当前波次怪物数，且当前关卡小怪总掉钱不超过通关奖励50%，掉满不再掉
        var passMoney int = GetPassMoneyForCurrentLevel()
        var amount int = 0
        var isBossDrop bool = IsBossMonster(monster) || CurrentWave == 5
        if isBossDrop {
            amount = passMoney / 2
            if amount < 1 {
                amount = 1
            }
        } else {
            var cap int = passMoney / 2  // 当前关卡小怪最多掉50%
            if WaveMonsterDroppedMoney >= cap {
                return  // 已掉满，不再掉
            }
            var waveCount int = CurrentWaveMonsterCount
            if waveCount < 1 {
                waveCount = 1
            }
            amount = passMoney / 2 / 4 / waveCount
            if amount < 1 {
                amount = 1
            }
            var remaining int = cap - WaveMonsterDroppedMoney
            if amount > remaining {
                amount = remaining
            }
            if amount <= 0 {
                return
            }
            WaveMonsterDroppedMoney = WaveMonsterDroppedMoney + amount
        }
        if amount <= 0 {
            return
        }

        var RighTabIFMUI = GetLocalPlayer()<PlayerJionGame>.RighTabIFMUI
        if RighTabIFMUI == nil { return }
        var monsterPos = monster<Transform>.Position
        var MoneyEntity = GetWidgetByPath(GetLocalPlayer(), RighTabIFMUI, "/Money")

        var MoneyEntityClone entity<UIWidget> = nil
        
        // 查找可用的（不可见的）克隆体
        for i, clone in CloneMoneyList {
            if clone<UIWidget>.IsVisible == false {
                MoneyEntityClone = clone
                break
            }
        }
        
        // 如果没有可用的，且池子未满，创建新的
        if MoneyEntityClone == nil {
            if List.Length(CloneMoneyList) < 20 {
                std.Clone(out var newClone, MoneyEntity)
                MoneyEntityClone = newClone as entity<UIWidget>
                List.Append(CloneMoneyList, MoneyEntityClone)
            } else {
                // 池子满了，复用最旧的
                return 
            }
        }

        // 设置初始位置
        WorldToScreenPoint(monsterPos, out var isMappedInScreen, out var mappedPosition)
        var MoneyStartPos = Vector3{mappedPosition.X, mappedPosition.Y, 0}
        var RighTabIFMMoneyEntity = GetWidgetByPath(GetLocalPlayer(), RighTabIFMUI, "/Panel/Money/logo")
        var MoneyEndPos = RighTabIFMMoneyEntity<UIWidget>.ActualPosition
        
        MoneyEntityClone<UIWidget>.ActualPosition = MoneyStartPos
        MoneyEntityClone<UIWidget>.IsVisible = true
        
        // 创建动画
        CreateTween(
            MoneyEntityClone,
            UIWidget.ActualPosition,
            MoneyStartPos,
            MoneyEndPos,
            TweenStyle.Once,
            CreateCurve({0, 0, 0.58, 1}),
            500,
            out var MoneyTween,
            true,
        )
        
        // 等待动画完成
        WaitForMillisecond(600)
        Destroy(MoneyTween)
        MoneyEntityClone<UIWidget>.IsVisible = false
        GivePlayerMoney(amount)
    }

    // RNM给钱（amount：本次掉落金币数，取整至少为1）
    func GivePlayerMoney(amount int) {
        // 增加玩家货币
        GetLocalPlayer()<PlayerJionGame>.Money = GetLocalPlayer()<PlayerJionGame>.Money + amount
        TotalGold = TotalGold + amount
        var MoneyNumEntity = GetWidgetByPath(GetLocalPlayer(), GetLocalPlayer()<PlayerJionGame>.RighTabIFMUI, "/Panel/Money/logo/Num")
        MoneyNumEntity<UIWidgetLabel>.Content = GetLocalPlayer()<PlayerJionGame>.Money
    }
    
    // 设置普通怪物生成CD
    func SetNormalSpawnCD(cd int) {
        NormalSpawnCD = cd
        // LogInfo("普通怪物生成CD设置为: " + cd + "毫秒")
    }


    async func myDestroyMonster(monster entity<LevelObject>) {
        if monster != nil {
            //LogInfo("-------------------------Destroy Monster 3-------------------------")
            CreateFromPrefab(out var effect, EResPrefab.ElemationAsh)
            effect<Transform>.Position = monster<Transform>.Position - Vector3{0,0.3,0}
          
            Destroy(monster)
            WaitForMillisecond(1500)
            Destroy(effect)
        }
    }  
}