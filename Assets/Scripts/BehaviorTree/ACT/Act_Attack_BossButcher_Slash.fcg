import "Animation.fcc" as Animation
import "StdLibrary.fcc" as StdLib
import "EditorGenLib.fcc" as EditorLib
import "BehaviourTree.fcc" as BehaviourTree
import "Math.fcc" as Math
import "../../MobScripts/BossButcher.fcg" as BossButcher
import "../../Static/FC_Utilities.fcg" as Utilities

[platform_client]
graph Script_1_ {
    _Duration int
    _AttackBeginTime int
    //Executed when entity is created
 
    event OnNodeEnterForClient(nodeName string, owner entity<BevTreeAttachableForClient>) {
        owner<Mob>.StatusDic["InAttack"] = true
        GetNodeVariable(thisEntity<BevTreeCustomNode>,"AttackName",out var attackName) 
        var duration int = owner<Mob>.StatusDic["Duration_" + attackName] as int
        var attackScale float= 1
        _Duration = Ceil(duration as int * attackScale)
        var curTarget entity<Player> = owner<Mob>.CurrTarget

        _AttackBeginTime = globalEntity<Global>.GameTimeCount

        owner<Mob>.StatusDic["LastAttackTime_" + attackName] = _AttackBeginTime
        //SetBlackboardValue(owner<BevTreeAttachableForClient>.AttachTarget,"LastAttackTime",_AttackBeginTime)
        var attackspeed float = 1.0/attackScale
        Utilities.myLookAt(owner<Transform>,curTarget as entity<Player>,Vector3{0, 0, 0})

       // mob<Transform>.Forward


        PlayAnimation(owner<AnimationControllerAttachable>,attackName,attackspeed,LoopType.Once)
        start owner<BossButcher>.startBossButcherSkill_Slash(curTarget)
    }
    func PlayAction(owner entity<BevTreeAttachableForClient>) BevTreeNodeStatus{
        if(globalEntity<Global>.GameTimeCount >= _AttackBeginTime+_Duration){
            return BevTreeNodeStatus.Finish
        }else{
            return BevTreeNodeStatus.Running
        }
    }
    func IsInRange(mob entity<Transform>,player1 entity<Player>,range1 float) bool{
        var zombiePos = mob<Transform>.Position
        var playerPos = player1<Player>.Position
   
        if (Distance(zombiePos,playerPos) <= range1) {
            return true
        }else{
            return false
        }
    }
    event OnNodeExitForClient(nodeName string, owner entity<BevTreeAttachableForClient>) {
        //LogInfo("OnNodeExit: Attack")
        owner<Mob>.StatusDic["InAttack"] = false
    }
}