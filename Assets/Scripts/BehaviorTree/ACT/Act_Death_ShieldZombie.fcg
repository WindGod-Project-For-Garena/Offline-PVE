import "StdLibrary.fcc" as StdLib
import "EditorGenLib.fcc" as EditorLib
import "BehaviourTree.fcc" as BehaviourTree
import "Animation.fcc" as Animation
import "Strings.fcc" as Strings
import "../../PVE/FC_PVEMonsterManager.fcg" as PVEMonsterManager

[platform_client]
//Fake Client: Currently using server script
graph FC_Act_Death {
    //Executed when entity is created
    //funcID: PlayAction
	func PlayAction(Owner entity<BevTreeAttachableForClient>) BTreeNodeState {
		//LogInfo("running death")
		return BevTreeNodeStatus.Running
	}

	//eventID: 42//s8004_dup_block
	event OnNodeEnterForClient(NodeName string, Owner entity<BevTreeAttachableForClient>) {
		var isShield bool= Owner<Mob>.StatusDic["IsShield"] as bool
		if (isShield) {
			PlayAnimation(Owner as entity<AnimationControllerAttachable>, "Dead", 1, LoopType.Once)
		} else {
			PlayAnimation(Owner as entity<AnimationControllerAttachable>, "Dead_NoShield", 1, LoopType.Once)
		}
		
		PVEMonsterManager.OnMonsterKilled(Owner as entity<LevelObject>)

	}
}