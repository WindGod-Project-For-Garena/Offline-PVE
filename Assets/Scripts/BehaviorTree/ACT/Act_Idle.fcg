import "StdLibrary.fcc" as StdLib
import "EditorGenLib.fcc" as EditorLib
import "BehaviourTree.fcc" as BehaviourTree
import "Animation.fcc" as Animation

[platform_client]
graph FC_Act_Idle {
    //Executed when entity is created
    event OnAwake() {

    }

    event OnNodeEnterForClient(nodeName string, owner entity<BevTreeAttachableForClient>) {
        PlayAnimation(owner<AnimationControllerAttachable>,"Idle",1,LoopType.Loop)
    }
    func PlayAction(owner entity<BevTreeAttachableForClient>) BevTreeNodeStatus{
        return BevTreeNodeStatus.Running
    }
}