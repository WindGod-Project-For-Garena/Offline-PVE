import "StdLibrary.fcc" as StdLib
import "EditorGenLib.fcc" as EditorLib
import "BehaviourTree.fcc" as BehaviourTree
import "Math.fcc" as Math

[platform_client]
graph Script_1_ {
    //Executed when entity is created
    /*ATTACK属性说明
    AttackName:攻击的名称

    存在StatusDic的属性：
    CD_AttackName:攻击的CD
    Range_AttackName:攻击的范围
    Duration_AttackName:攻击的持续时间
    LastAttackTime_AttackName:攻击的最后一次时间
    */

    nextTime int = 0
    event OnAwake() {
        
    }
    func IsInRange(mob entity<Transform>,player1 entity<Player>,range1 float) bool{
        var zombiePos = mob<Transform>.Position
        var playerPos = player1<Player>.Position
        //LogInfo(Distance(zombiePos,playerPos))
        if (Distance(zombiePos,playerPos) <= range1) {
            return true
        }else{
            return false
        }
    }
    func playCondition(owner entity<BevTreeAttachableForClient>) bool{
        if (owner<Mob>.StatusDic["InAttack"] as bool){
            return false
        }
        GetNodeVariable(thisEntity<BevTreeCustomNode>,"AttackName",out var attackName)
        var cd int = owner<Mob>.StatusDic["CD_" + attackName] as int
        var range float = owner<Mob>.StatusDic["Range_" + attackName] as float
        //LogInfo("playCondition: CanAttack range: " + range)

        //var duration = owner<Mob>.StatusDic["Duration_" + attackName] as int
        var lastAttackTime = owner<Mob>.StatusDic["LastAttackTime_" + attackName] as int
        if (lastAttackTime == nil){
            nextTime = Math.Ceil(globalEntity<Global>.GameTimeCount + RandomFloat(1,2) * cd)
            owner<Mob>.StatusDic["LastAttackTime_" + attackName] = nextTime
            return true
        }
        if (globalEntity<Global>.GameTimeCount < nextTime){
            //LogInfo("playCondition: CanAttack false")
            return false
        }
        nextTime = Math.Ceil(globalEntity<Global>.GameTimeCount + RandomFloat(1,2) * cd)
        var curTarget entity<Player> = owner<Mob>.CurrTarget
        if (curTarget == nil){
            //LogInfo("playCondition: CanAttack false curTarget == nil")
            return false
        }
        var TempPlayer = curTarget as entity<Player>
        var result = IsInRange(owner<Transform>,TempPlayer<Player>,range as float)
        
       // LogInfo("playCondition: CanAttack result: " + result)
        return result
    }




    
    
}