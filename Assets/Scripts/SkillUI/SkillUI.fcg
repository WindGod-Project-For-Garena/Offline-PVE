import "StdLibrary.fcc" as StdLib
import "EditorGenLib.fcc" as EditorLib
import "Player.fcc" as Player
import "Hud.fcc" as Hud
import "Math.fcc" as Math
import "Camera.fcc" as Camera
import "Playable.fcc" as Playable
import "Animation.fcc" as Animation
import "../PlayerJionGame/PlayerJionGame.fcg" as PlayerJionGame
import "../SuperFcc/TransferList.fcc" as TransferList
import "../SoundFunc/SoundFunc.fcg" as SoundFunc
import "List.fcc" as List
import "Convert.fcc" as Convert
import "Items.fcc" as Items
import "../CustomEvent.fcc" as CustomEvent
import "../PVE/FC_PVEMonsterManager.fcg" as PVEMonsterManager
import "../Static/ExplosionEffectPool.fcg" as ExplosionEffectPool

[platform_client]
graph SkillUI {
    previewEffectEntity entity<Effect>
    effectEntity entity<Effect>
    ScreenLayer int = 0
    tween entity<Tween>
    RotTime int = 1000
    ReleasedEffectPosition Vector3
    JoyStickButton entity<UIWidget>
    FillAmountTween entity<Tween>

    skillMultiplier float = 1

    event OnAwake() {
    }

    // 特效颜色
    func  BoomColor(createdEntity entity<Effect>,value int){
        var color = #FF98D4FF
        if value == 1 {
            color = #FF98D4FF 
        } else if value == 2 {
            color = #98FFFFFF 
        } else if value == 3 {
            color = #D400FFFF
        } else if value == 4 {
            color = #98CDFFFF 
        } else if value == 5 {
            color = #FF5B5BFF 
        } else if value == 6 {
            color = #FFF098FF 
        }
        createdEntity<Effect>.Color = color
    }

    func StartRotTween(createdEntity entity<Effect>){
        if tween == nil{
            var rotstart = Vector3{0, 0, 0}
            var rotend = Vector3{0, 360, 0}     
            CreateTween(
                createdEntity,
                Transform.Rotation,
                rotstart,
                rotend,
                TweenStyle.Loop,
                CreateCurve({0, 0, 1, 1}),
                RotTime,
                out var RotTweenEntity,
                true)
            tween = RotTweenEntity
        }
    }
    
    //————————————————————————————————————————————————//
    event OnJoyStickMove(player entity<Player>, delta Vector2){
        var TouchPoint Vector2 = Vector2{0,0}
        ScreenTouchRay(TouchPoint, out var startPosition, out var direction)
        var layerMask List<int> = List<int>{ScreenLayer}
        ScreenSingleRaycast(TouchPoint, 100, layerMask, true, out var hitEntity, out var hitPosition, out var hitDistance, out var hitNormal)
        ReleasedEffectPosition = hitPosition
        
        var CurrentSkill = GetLocalPlayer()<PlayerJionGame>.CurrentSkill
        if CurrentSkill == 1 {     
            Skill_1(CurrentSkill, hitPosition)
        }
        if CurrentSkill == 2 {
            Skill_2(CurrentSkill, hitPosition)
        }
    }

    // 技能1（范围预览从对象池取，摇杆释放时归还）
    func Skill_1(CurrentSkill int, hitPosition Vector3){
        if previewEffectEntity == nil {
            ExplosionEffectPool.GetLightBeamPreviewFromPool(out var previewEffect)
            previewEffectEntity = previewEffect
            SetActive(previewEffectEntity, true)
            Play(previewEffectEntity, true)
        }
        
        // 获取技能1的范围等级
        var Size int = Round(GetLocalPlayer()<PlayerJionGame>.Skill1DataInGame["SkillRange"] as int)
        
        previewEffectEntity<Transform>.Scale = Vector3{Size, 0.1, Size}
        BoomColor(previewEffectEntity, 5)
        previewEffectEntity<Transform>.Position = hitPosition
        StartRotTween(previewEffectEntity)
    }

    // 技能2
    func Skill_2(CurrentSkill int, hitPosition Vector3){
        // 技能2不需要特效
        return
    }

    //————————————————————————————————————————————————//
    event OnJoyStickReleased(player entity<Player>){
        if previewEffectEntity != nil {
            ExplosionEffectPool.ReturnLightBeamPreviewToPool(previewEffectEntity)
            previewEffectEntity = nil
        }
        Destroy(tween)
        
        var CurrentSkill = GetLocalPlayer()<PlayerJionGame>.CurrentSkill
        if CurrentSkill == 1 {     
            // 燃烧伤害
            var SkillFireDamage int = Round(GetLocalPlayer()<PlayerJionGame>.Skill1DataInGame["SkillFireDamage"] as int)
            // LogInfo("燃烧伤害"+SkillFireDamage)
            // 技能数量
            var SkillAmount int = Round(GetLocalPlayer()<PlayerJionGame>.Skill1DataInGame["SkillAmount"] as int)
            // 技能释放立刻装弹
            var ReloadNow int = Round(GetLocalPlayer()<PlayerJionGame>.Skill1DataInGame["ReloadNow"] as int)
            //————————————————————————————————————————————————//
            // 爆裂轰炸
            start Skill_1_Released(CurrentSkill)
            //————————————————————————————————————————————————//
            // 二次爆炸
            if SkillAmount == 2 {
                WaitForMillisecond(300)
                Skill_1_Released(CurrentSkill)
            }
            // 燃烧伤害
            if SkillFireDamage > 5 {
                Skill_1_FireReleased(SkillFireDamage)
            }
            // 立刻装弹
            if ReloadNow == 1{
                var currentWeapon = GetLocalPlayer()<PlayerJionGame>.currentWeapon
                currentWeapon<Weapon>.CurrentAmmo = currentWeapon<Weapon>.AmmoMagSize
                // 更新玩家当前武器属性（使用局内数据）
                GetLocalPlayer()<PlayerJionGame>.OnWeaponUpdate()
            }
            //————————————————————————————————————————————————//

        }
        if CurrentSkill == 2 {
            // 技能释放立刻装弹
            var ReloadNow int = Round(GetLocalPlayer()<PlayerJionGame>.Skill2DataInGame["ReloadNow"] as int)
            //————————————————————————————————————————————————//
            start Skill_2_Released(CurrentSkill)
            //————————————————————————————————————————————————//
            // 立刻装弹
            if ReloadNow == 1{
                // LogInfo("立刻装弹")
                // 更新玩家当前武器属性（使用局内数据）
                GetLocalPlayer()<PlayerJionGame>.OnWeaponUpdate()
            }
            //————————————————————————————————————————————————//
        }
    }

    // 技能1释放
    async func Skill_1_Released(CurrentSkill int){
        // 技能伤害
        var CurrentDamage int = Round(GetLocalPlayer()<PlayerJionGame>.Skill1DataInGame["SkillDamage"] as int)
        // 技能范围
        var Size int = Round(GetLocalPlayer()<PlayerJionGame>.Skill1DataInGame["SkillRange"] as int)
        // 冷却时间
        var CurrentcdTime int = Round(GetLocalPlayer()<PlayerJionGame>.Skill1DataInGame["SkillCD"] as int)
        
        // 设置CD
        StartSkillCD(CurrentSkill, CurrentcdTime)
        
        // 音效
        SoundFunc.PlayCreatedSound("Skill_Boming")

        // 从对象池取爆炸特效
        ExplosionEffectPool.GetFromPool(out var explosionEffect)
        effectEntity = explosionEffect
        effectEntity<Transform>.Position = ReleasedEffectPosition
        effectEntity<Transform>.Scale = Vector3{Size, Size, Size}
        BoomColor(effectEntity, 5)
        SetActive(explosionEffect, true)
        Play(explosionEffect, true)
        
        // 造成伤害
        var monsters = getMonsterWithinDistance(Size)
        for j = 0, List.Length(monsters), 1 {
            var monster = monsters[j]
            var damage int = Math.Ceil(CurrentDamage * skillMultiplier)
            DispatchEventToEntity(OnDamageMob, monster, PlatformType.Client, List<object>{monster, nil, damage, GetLocalPlayer()})
            GetLocalPlayer()<PlayerJionGame>.Skill1Damage += damage
            CreateDamageNum(damage, 10, #FF5B5BFF, 800, monster as entity<Entity>, Vector3{0,1,0}, Vector2{60, 60}, true)
        }
        WaitForMillisecond(2000)
        ExplosionEffectPool.ReturnToPool(explosionEffect)
    }

    func Skill_1_FireReleased(SkillFireDamage int){
        // 技能范围
        var Size int = Round(GetLocalPlayer()<PlayerJionGame>.Skill1DataInGame["SkillRange"] as int)
        var monsters = getMonsterWithinDistance(Size)
        // 应用燃烧效果到所有怪物
        for j = 0, List.Length(monsters), 1 {
            var monster = monsters[j]
            // 启动燃烧
            start ApplyBurnEffect(monster, SkillFireDamage)
        }
    }

    // 燃烧效果函数
    async func ApplyBurnEffect(monster entity<Entity>, SkillFireDamage int) {
        // 3秒燃烧，每0.5秒一次，共6次
        var tickInterval int = 500    // 500毫秒 = 0.5秒
        var tickCount int = 6           // 6次
        
        // 计算每次的伤害
        var damagePerTick = Math.Ceil(SkillFireDamage)
        
        for i = 0, tickCount, 1 {
            // 造成燃烧伤害
            if monster == nil {
                return
            }
            DispatchEventToEntity(OnDamageMob, monster, PlatformType.Client, List<object>{monster, nil, damagePerTick, GetLocalPlayer()})
            GetLocalPlayer()<PlayerJionGame>.BurningDamage += damagePerTick
            CreateDamageNum(damagePerTick, 10, #ff6600, 500, monster as entity<Entity>, Vector3{0,1.2,0}, Vector2{50, 50}, true)
            // 等待0.5秒
        WaitForMillisecond(tickInterval)
        }
    }
    
    // 技能2释放
    async func Skill_2_Released(CurrentSkill int){
        // 获取技能2的各个属性等级
        var CurrentDamage = GetLocalPlayer()<PlayerJionGame>.Skill2DataInGame["SkillDamage"] as int
        var LightningAmountCount = GetLocalPlayer()<PlayerJionGame>.Skill2DataInGame["LightningAmount"] as int
        var CurrentcdTime = GetLocalPlayer()<PlayerJionGame>.Skill2DataInGame["SkillCD"] as int
        var LightningRange = Round(GetLocalPlayer()<PlayerJionGame>.Skill2DataInGame["LightningRange"] as int)
        var LightningExplosion = GetLocalPlayer()<PlayerJionGame>.Skill2DataInGame["LightningExplosion"] as float
        // 设置CD
        StartSkillCD(CurrentSkill, CurrentcdTime)
        
        // 释放雷击
        start PlayThunderEffects(LightningAmountCount, CurrentDamage,LightningRange,LightningExplosion)
    }

    // 启动技能CD
    func StartSkillCD(skillNum int, cdTime int) {
        var SkillUI entity<CustomUI> = GetLocalPlayer()<PlayerJionGame>.SkillUI
        var buttonPath = "/Skill_" + skillNum + "/JoyStickFillAmount"
        JoyStickButton = GetWidgetByPath(GetLocalPlayer(), SkillUI, buttonPath)
        JoyStickButton<UIWidget>.IsVisible = true
        JoyStickButton<UIWidgetButton>.FillAmount = 1

        // 显示并初始化冷却时间文本（保留一位小数）
        var timePath = "/Skill_" + skillNum + "/JoyStickFillAmount/Time"
        var TimeWidget = GetWidgetByPath(GetLocalPlayer(), SkillUI, timePath)
        if TimeWidget != nil {
            TimeWidget<UIWidget>.IsVisible = true
            TimeWidget<UIWidgetLabel>.Content = FormatSecToOneDecimal(cdTime * 1.0 / 1000.0)
        }

        if FillAmountTween == nil {
            CreateTween(
                JoyStickButton,
                UIWidgetButton.FillAmount,
                1,
                0,
                TweenStyle.Once,
                CreateCurve({0, 0, 1, 1}),
                cdTime,
                out var FillAmountTweenEntity,
                true)
            FillAmountTween = FillAmountTweenEntity
            start HandleSkillCD(skillNum, cdTime)
        }
    }

    // 将秒数格式化为一位小数字符串（如 4.9、5.0），用 Floor 避免剩余时间被四舍五入
    func FormatSecToOneDecimal(sec float) string {
        var totalTenths int = Math.Floor(sec * 10)
        if totalTenths < 0 {
            totalTenths = 0
        }
        var intPart int = totalTenths / 10
        var tenths int = totalTenths - intPart * 10
        return Convert.ToString(intPart) + "." + Convert.ToString(tenths)
    }

    // 处理技能CD：倒计时跟 FillAmount 同步；以 FillAmount<=0 为结束条件，结束瞬间立刻执行炸光与收尾
    async func HandleSkillCD(skillNum int, cdTime int) {
        var SkillUI entity<CustomUI> = GetLocalPlayer()<PlayerJionGame>.SkillUI
        var timePath = "/Skill_" + skillNum + "/JoyStickFillAmount/Time"
        var TimeWidget = GetWidgetByPath(GetLocalPlayer(), SkillUI, timePath)

        while true {
            if JoyStickButton != nil {
                var fill float = JoyStickButton<UIWidgetButton>.FillAmount
                if TimeWidget != nil {
                    var remainingSec float = fill * cdTime * 1.0 / 1000.0
                    TimeWidget<UIWidgetLabel>.Content = FormatSecToOneDecimal(remainingSec)
                }
                if fill <= 0 {
                    break
                }
            }
            WaitForNextFrame()
        }

        if TimeWidget != nil {
            TimeWidget<UIWidgetLabel>.Content = "0.0"
            TimeWidget<UIWidget>.IsVisible = false
        }

        Destroy(FillAmountTween)

        // 显示技能可按动按钮
        JoyStickButton<UIWidget>.IsVisible = false

        var buttonPath = "/Skill_" + skillNum + "/Effect"
        var JoyStickEffect_1 = GetWidgetByPath(GetLocalPlayer(), SkillUI, buttonPath)
        JoyStickEffect_1<UIWidget>.IsVisible = true
        CreateTween(
            JoyStickEffect_1,
            UIWidgetImage.Alpha,
            0,
            1,
            TweenStyle.Once,
            CreateCurve({0, 0, 1, 1}),
            200, 
            out var EffectOut,
            true)
        CreateTween(
            JoyStickEffect_1,
            UIWidget.SizeDelta,
            Vector2{0, 0},
            Vector2{160, 160},
            TweenStyle.Once,
            CreateCurve({0, 0, 1, 1}),
            200, 
            out var EffectBig,
            true)
        WaitForMillisecond(400)
        Destroy(EffectOut)
        Destroy(EffectBig)
        JoyStickEffect_1<UIWidget>.SizeDelta = Vector2{0, 0}
        JoyStickEffect_1<UIWidget>.IsVisible = false
    }

    // 播放雷击特效（每道雷尽量打不同怪，避免多道雷叠在同一只上导致只显示一道）
    async func PlayThunderEffects(LightningAmountCount int, damage int, LightningRange int,LightningExplosion float) {
        var targetMonsters = GetShuffledMonsterTargets(LightningAmountCount)
        if List.Length(targetMonsters) == 0 { return }
        for i = 0, LightningAmountCount, 1 {
            var randomMonster = targetMonsters[i] as entity<LevelObject>
            if randomMonster != nil {
                if  LightningExplosion == 0 {
                    start CreateThunder(i, randomMonster, damage)
                    GetLocalPlayer()<PlayerJionGame>.Skill2Damage += damage
                }
                if  LightningExplosion > 0 {
                    start CreateThunder(i, randomMonster, damage)
                    GetLocalPlayer()<PlayerJionGame>.Skill2Damage += damage
                    var monsterPosition = randomMonster<Transform>.Position
                    start ThunderBoom(i, monsterPosition, damage, LightningRange, LightningExplosion)
                }
                if RandomInt(0, 1) == 0 {
                    SoundFunc.PlayCreatedSound("Skill_ElectricArc_A")
                } else {
                    SoundFunc.PlayCreatedSound("Skill_ElectricArc_B")
                }
                WaitForMillisecond(200)
            }
        }
    }

    // 获取本轮雷击目标列表（洗牌后不重复选取，怪物数不足时循环使用，保证每道雷有目标）
    func GetShuffledMonsterTargets(needCount int) List<entity<LevelObject>> {
        var activeMonsters = PVEMonsterManager.ActiveMonsters
        var total = List.Length(activeMonsters)
        if total == 0 { return List<entity<LevelObject>>{} }
        var shuffled List<entity<LevelObject>> = List<entity<LevelObject>>{}
        for i = 0, total, 1 {
            List.Append(shuffled, activeMonsters[i])
        }
        List.Shuffle(shuffled)
        var result List<entity<LevelObject>> = List<entity<LevelObject>>{}
        for i = 0, needCount, 1 {
            List.Append(result, shuffled[i % total])
        }
        return result
    }

    // 获取随机怪物（保留用于其他逻辑）
    func GetRandomMonster() entity<LevelObject> {
        var activeMonsters = PVEMonsterManager.ActiveMonsters
        if List.Length(activeMonsters) == 0 { return nil }
        var randomIndex = RandomInt(0, List.Length(activeMonsters) - 1)
        return activeMonsters[randomIndex] as entity<LevelObject>
    }

    // 创建单道雷（从对象池取/还，不 Destroy）
    async func CreateThunder(index int, targetMonster entity<LevelObject>, damage int) {
        if targetMonster == nil {
            return
        }
        ExplosionEffectPool.GetThunderFromPool(out var thunderEffect)
        var thunderPosition = targetMonster<Transform>.Position
        thunderEffect<Transform>.Position = thunderPosition
        thunderEffect<Transform>.Scale = Vector3{0.8,2,0.8}
        // 不挂到怪物身上，避免怪物死亡时特效被一起销毁导致归还池时收到 nil
        BoomColor(thunderEffect, 3)
        SetActive(thunderEffect, true)
        Play(thunderEffect, true)

        var realDamage int = Math.Ceil(damage * skillMultiplier)
        DispatchEventToEntity(OnDamageMob, targetMonster, PlatformType.Client, List<object>{targetMonster, nil, realDamage, GetLocalPlayer()})
        CreateDamageNum(realDamage, 10, #D400FFFF, 800, targetMonster as entity<Entity>, Vector3{0,1,0}, Vector2{60, 60}, true)

        WaitForMillisecond(2000)
        ExplosionEffectPool.ReturnThunderToPool(thunderEffect)
    }

    // 创建闪电爆炸（从对象池取特效，用毕归还）
    async func ThunderBoom(index int, explosionPosition Vector3, damage int, LightningRange int, LightningExplosion float) {
        ExplosionEffectPool.GetFromPool(out var explosionEffect)
        effectEntity = explosionEffect
        effectEntity<Transform>.Position = explosionPosition
        effectEntity<Transform>.Scale = Vector3{LightningRange, LightningRange, LightningRange}
        BoomColor(effectEntity, 3)
        SetActive(explosionEffect, true)
        Play(explosionEffect, true)
        
        // 造成伤害
        var Boomdamage int = Math.Ceil(LightningExplosion * damage)
        
        // 获取爆炸范围内的怪物
        var monsters = getMonsterWithinDistanceFromPosition(explosionPosition, LightningRange)
        for j = 0, List.Length(monsters), 1 {
            var monster = monsters[j]
            DispatchEventToEntity(OnDamageMob, monster, PlatformType.Client, List<object>{monster, nil, Boomdamage, GetLocalPlayer()})
            GetLocalPlayer()<PlayerJionGame>.LightningExplosionDamage += Boomdamage
            CreateDamageNum(Boomdamage, 10, #D400FFFF, 800, monster as entity<Entity>, Vector3{0,1,0}, Vector2{60, 60}, true)
        }

        WaitForMillisecond(2000)
        ExplosionEffectPool.ReturnToPool(explosionEffect)
    }

    // 从指定位置获取范围内的怪物（新函数）
    func getMonsterWithinDistanceFromPosition(position Vector3, distance int) List<entity<LevelObject>> {
        var monsters List<entity<LevelObject>> = List<entity<LevelObject>>{}
        var activeMonsters List<entity<LevelObject>> = PVEMonsterManager.ActiveMonsters
        for i = 0, List.Length(activeMonsters), 1 {
            var monster = activeMonsters[i]
            if Distance(monster<Transform>.Position, position) <= distance {
                List.Append(monsters, monster)
            }
        }
        return monsters
    }

    // 获取范围内怪物
    func getMonsterWithinDistance(distance int) List<entity<LevelObject>> {
        var monsters List<entity<LevelObject>> = List<entity<LevelObject>>{}
        var activeMonsters List<entity<LevelObject>> = PVEMonsterManager.ActiveMonsters
        for i = 0, List.Length(activeMonsters), 1 {
            var monster = activeMonsters[i]
            if Distance(monster<Transform>.Position, ReleasedEffectPosition) <= distance {
                List.Append(monsters, monster)
            }
        }
        return monsters
    }

    
}